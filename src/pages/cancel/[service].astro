---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { services, getRelatedServices, type Service } from '../../data/services';
import { getGuideDetails, guideFaqs, APPLE_CANCEL, APPLE_REFUND, GOOGLE_CANCEL, GOOGLE_REFUND } from '../../data/guideDetails';

export function getStaticPaths() {
  return services.map(service => ({ params: { service: service.slug }, props: { service } }));
}
interface Props { service: Service }
const { service } = Astro.props;
const guide = getGuideDetails(service);
const faqs = guideFaqs(service, guide);
const related = getRelatedServices(service);
const canonical = `https://cancelkits.com/cancel/${service.slug}/`;
const title = `How to Cancel ${service.name}: Web, iPhone & Android | CancelKits`;
const description = `Cancel ${service.name} with instructions for your billing provider. Check web, iPhone and Android routes, support options, refund guidance and proof of cancellation.`;
const appleSteps = [
  'Check your receipt first: use these steps only if Apple bills this subscription.',
  'On your iPhone or iPad, open Settings and tap your name.',
  `Open Subscriptions and select the ${service.name} subscription paid by this Apple Account.`,
  'Tap Cancel Subscription, scroll if necessary, and confirm. If no Cancel button is present and an expiry message appears, Apple says it is already cancelled.',
  'Save the expiry date. If the subscription is missing, check the Apple Account named on the receipt; a family member may need to cancel their own purchase.'
];
const googleSteps = [
  'Check your receipt first: use these steps only for a subscription billed through Google Play.',
  'Open Google Play Store, tap your profile picture, then Payments & subscriptions → Subscriptions.',
  `Select ${service.name}, tap Cancel subscription and follow the remaining prompts.`,
  'Check the end date in the subscription details. If the subscription is missing, switch to the Google account used for the purchase.',
  'Keep confirmation. Removing the app or a payment card is not proof that renewal has stopped.'
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, mainEntityOfPage: canonical, author: { '@type': 'Organization', name: 'CancelKits' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cancelkits.com/' },
    { '@type': 'ListItem', position: 2, name: 'Cancellation guides', item: 'https://cancelkits.com/cancel/' },
    { '@type': 'ListItem', position: 3, name: service.name, item: canonical }
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }
];
---
<BaseLayout title={title} description={description} canonicalPath={`/cancel/${service.slug}/`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <Nav />
  <main class="cancel-guide">
    <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/cancel/">Cancellation guides</a> / {service.name}</nav>
    <header>
      <p class="eyebrow">{service.category} · Cancellation guide</p>
      <h1>How to cancel {service.name}</h1>
      <p class="lead">Choose the company that bills you, then follow its cancellation process. The device you use does not always determine who manages your subscription.</p>
      <p>CancelKits is independent of {service.name}. This guide does not submit a cancellation or refund request.</p>
    </header>
    {guide.needsReview && <aside class="notice"><strong>Provider details awaiting verification.</strong> The provider’s current direct-billing menus or refund terms could not be fully verified. Use its official support route below. The Apple and Google instructions apply only to purchases billed by those stores.</aside>}
    <nav class="toc" aria-label="On this page">
      <a href="#before">Find your biller</a><a href="#web">Web / direct billing</a><a href="#ios">iPhone / iPad</a><a href="#android">Android</a><a href="#support">Customer support</a><a href="#refunds">Refunds</a><a href="#confirmation">Confirm cancellation</a><a href="#faq">FAQs</a>
    </nav>
    <section id="before">
      <h2>Before you start: identify the billing provider</h2>
      <ol>
        <li>Find the latest receipt or statement entry. Note the plan, paying account, next renewal date and billing company.</li>
        <li>Apple receipt: use Apple subscriptions. Google Play receipt: use Google Play. A direct provider receipt: use the Web section below.</li>
        <li>If a carrier, TV provider, Amazon, Roku, employer or other partner supplies the subscription, check that partner’s account and cancellation terms.</li>
        <li>Check for multiple subscriptions or add-ons. Cancelling one plan may leave another charge active.</li>
      </ol>
      {guide.note && <p class="notice">{guide.note}</p>}
    </section>
    <section id="web">
      <h2>Cancel {service.name} on the web or through direct billing</h2>
      <ol>{guide.web.map(step => <li>{step}</li>)}</ol>
      {guide.source && <p><a href={guide.source} target="_blank" rel="noopener noreferrer">Open {service.name}’s official instructions or help center ↗</a></p>}
      <p>For a direct-billed account on a phone, use Safari or Chrome and follow these steps. If the mobile page hides an option, try its desktop view or contact official support.</p>
    </section>
    <section id="ios">
      <h2>Cancel {service.name} on iPhone or iPad</h2>
      {guide.ios ? <ol>{guide.ios.map(step => <li>{step}</li>)}</ol> : guide.storeBilling === false ? <>
        <p>This membership uses the provider’s direct-billing or agreement process. It does not become an App Store subscription simply because you use an iPhone.</p>
        <ol><li>Open Safari and sign in to the provider’s account, or locate your membership agreement.</li><li>Follow the Web / direct-billing steps above for your plan.</li><li>Save the provider’s written cancellation and final billing date.</li></ol>
      </> : <><p>For an Apple-billed purchase:</p><ol>{appleSteps.map(step => <li>{step}</li>)}</ol><p>If Apple does not bill you, open Safari and follow the Web / direct-billing section instead.</p></>}
      <p><a href={APPLE_CANCEL}>Apple’s current cancellation instructions ↗</a>. Apple recommends cancelling trials at least 24 hours before they end.</p>
    </section>
    <section id="android">
      <h2>Cancel {service.name} on Android</h2>
      {guide.android ? <ol>{guide.android.map(step => <li>{step}</li>)}</ol> : guide.storeBilling === false ? <>
        <p>Use the provider’s direct-billing or agreement process for this membership.</p>
        <ol><li>Open Chrome and sign in to the paying account, or find your membership agreement.</li><li>Follow the Web / direct-billing steps above.</li><li>Check that the provider confirms the cancellation and final bill; deleting its Android app is insufficient.</li></ol>
      </> : <><p>For a Google Play-billed purchase:</p><ol>{googleSteps.map(step => <li>{step}</li>)}</ol><p>If the provider bills you directly, open Chrome and follow the Web section. For an Apple-billed purchase while using Android, use Apple’s supported account-management process.</p></>}
      <p><a href={GOOGLE_CANCEL}>Google Play’s current cancellation instructions ↗</a>. A payment plan may still require remaining committed payments even after renewal is stopped.</p>
    </section>
    <section id="support">
      <h2>{service.name} customer support</h2>
      {guide.source ? <p><a href={guide.source} target="_blank" rel="noopener noreferrer">Use {service.name}’s official help page ↗</a> and its Contact, Chat or Submit a request option. For a partner-billed purchase, contact that partner.</p> : <p>Use the club and contact details printed on your own membership agreement. There is no universal contact for every gym.</p>}
      {guide.email && <p>Published support email: <a href={`mailto:${guide.email}`}>{guide.email}</a>.</p>}
      {guide.phone && <p>Published US support phone: <a href={`tel:${guide.phone.replace(/[^0-9]/g, '')}`}>{guide.phone}</a>. Check the official support page for current hours and regional options.</p>}
      {!guide.email && !guide.phone && <p>No verified direct email or phone number is listed here. Use the official channel above rather than a guessed address or a third-party “support hotline.”</p>}
      <h3>What to include in your request</h3>
      <ul><li>Account email or membership ID, plan name, renewal date and the charge you are asking about.</li><li>When and how you attempted cancellation; attach a screenshot of the error privately if useful.</li><li>A request to confirm the effective cancellation date, any remaining payment and refund eligibility separately.</li></ul>
      <p>Never include a password, complete card number or one-time sign-in code. Ask whether further action is required; sending a request is not proof of completed cancellation.</p>
      <details><summary>Copyable cancellation request</summary><blockquote><p>Please stop renewal of my {service.name} subscription associated with [account email or member ID]. Please confirm the effective cancellation date, the final access date, and any remaining payment or notice requirement. Separately, please review whether the charge on [date] for [amount] qualifies for a refund. Please tell me if I must complete another step.</p></blockquote><p>Replace the placeholders and submit through the provider’s accepted channel. This text does not override your contract or guarantee cancellation.</p></details>
    </section>
    <section id="refunds">
      <h2>{service.name} refund policy and requests</h2>
      <p>{guide.refund}</p>
      {guide.refundSource && <p><a href={guide.refundSource} target="_blank" rel="noopener noreferrer">Read the provider’s refund policy ↗</a></p>}
      <h3>If Apple billed you</h3>
      <ol><li>Sign in to reportaproblem.apple.com with the purchasing Apple Account.</li><li>Choose “I’d like to” → Request a refund, select your reason, then Next.</li><li>Select the subscription charge and submit. Keep the request reference and check its status.</li></ol>
      <p><a href={APPLE_REFUND}>Apple’s refund instructions ↗</a>. Eligibility varies by region and purchase. Pending charges may not yet be requestable.</p>
      <h3>If Google Play billed you</h3>
      <ol><li>Sign in at play.google.com using the purchasing Google account.</li><li>Open profile → Payments & subscriptions → Budget & order history.</li><li>Find the charge, choose Report a problem, complete the refund explanation and submit.</li></ol>
      <p><a href={GOOGLE_REFUND}>Google Play’s refund instructions ↗</a>. Approval depends on policy and purchase circumstances; Google may direct you to the developer.</p>
      <p>For either store, submit a refund request only if that store actually charged you. Cancelling renewal and requesting a refund are separate actions. Local consumer protections may apply.</p>
    </section>
    <section id="confirmation">
      <h2>Check that cancellation actually completed</h2>
      <ol><li>Reopen subscription details and look for an end date or confirmation that renewal is off.</li><li>Save the confirmation email, screenshot or support reference with the date and plan.</li><li>Check the next statement. Compare any charge against the effective date and committed payments.</li><li>If charged unexpectedly, contact the biller with your evidence. If unresolved, ask your payment provider about its dispute process and deadlines; reversal is not guaranteed.</li></ol>
      <p>A saved message, completed checklist or payment-card removal does not by itself end a subscription or contractual payment obligation.</p>
    </section>
    <section id="faq"><h2>Frequently asked questions</h2>{faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
    <section><h2>Related cancellation guides</h2><ul>{related.map(item => <li><a href={`/cancel/${item.slug}/`}>{item.name} cancellation instructions</a></li>)}</ul><p><a href="/cancel/">Browse all {services.length} cancellation guides</a> · <a href="/cancel-difficulty/">Compare cancellation routes</a></p></section>
    <aside class="notice"><h2>Keep track of the next renewal</h2><p>CancelKits offers cancellation guidance and renewal-management tools. You complete cancellation with the provider and verify its confirmation.</p><a href={`/signup/?service=${service.slug}`}>Explore CancelKits</a></aside>
  </main>
  <Footer />
</BaseLayout>
<style>
.cancel-guide{max-width:850px;margin:0 auto;padding:105px 24px 64px;color:var(--text-primary,#e6e8ee);line-height:1.8}.cancel-guide h1{font-size:clamp(2.1rem,6vw,3.5rem);line-height:1.15;margin:16px 0 24px;letter-spacing:-.035em}.cancel-guide h2{font-size:1.65rem;line-height:1.3;margin:0 0 20px}.cancel-guide h3{font-size:1.15rem;margin:24px 0 12px}.cancel-guide header{margin:30px 0}.lead{font-size:1.2rem}.eyebrow{text-transform:uppercase;letter-spacing:.1em;font-size:.8rem;color:#a7b1ca}.cancel-guide a{color:#b9acff;text-decoration:underline;text-underline-offset:3px}.cancel-guide a:hover{color:#ddd6ff}.cancel-guide section{padding:32px 0;border-top:1px solid #ffffff20;scroll-margin-top:100px}.cancel-guide li{margin:12px 0}.cancel-guide ol,.cancel-guide ul{padding-left:24px}.toc{display:flex;flex-wrap:wrap;gap:12px 20px;padding:24px 0}.notice{padding:22px;border:1px solid #ffffff25;background:#ffffff06;border-radius:12px;margin:20px 0}.cancel-guide details{padding:18px 0;border-bottom:1px solid #ffffff20}.cancel-guide summary{cursor:pointer;font-weight:600}.cancel-guide blockquote{margin:16px 0;padding-left:20px;border-left:3px solid #b9acff}
</style>

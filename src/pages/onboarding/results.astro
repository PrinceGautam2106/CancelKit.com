---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';

const stripeProMonthlyPriceId =
	import.meta.env.STRIPE_PRO_MONTHLY_PRICE_ID ??
	(typeof process !== 'undefined' ? process.env?.STRIPE_PRO_MONTHLY_PRICE_ID : undefined) ??
	'price_pro_monthly_9';

const title = 'Scan Results — CancelKits';
const description = 'See every subscription draining your account and start cancelling.';

const FREE_TEASER = 5;
---

<BaseLayout {title} {description} noIndex>
	<main class="results-page">
		<div class="results-container">
			<div class="results-wordmark" aria-hidden="true">
				<span class="wordmark-icon">C</span>
				<span class="wordmark-text">Cancel<span>K<span class="wordmark-accent">i</span>ts</span></span>
			</div>

			<header class="results-hero">
				<div class="results-email-pill" id="results-email-pill" hidden>
					<span class="pill-dot"></span>
					<span id="results-email-text"></span>
				</div>
				<p class="found-line" id="found-line">We found <span id="found-count">—</span> subscriptions</p>

				<div class="spend-block">
					<p class="spend-number" id="spend-number">
						$<span id="monthly-total">—</span><span class="spend-period">/month</span>
					</p>
					<p class="spend-sub" id="spend-sub">
						That's <strong id="annual-total">—</strong> per year leaving your account.
					</p>
				</div>
			</header>

			<!-- UNIFIED MASTER SUBSCRIPTION REPORT CARD -->
			<section class="teaser-card" id="main-report-card" aria-label="Subscriptions report">
				<div class="teaser-card-header">
					<div class="header-title-wrap">
						<span class="status-indicator-dot status-indicator-dot--green"></span>
						<div>
							<h2 id="known-card-title">Subscriptions You Selected</h2>
							<p class="card-subtitle" id="card-subtitle">Included in your free scan report</p>
						</div>
					</div>
					<span class="teaser-tag" id="teaser-tag">Free Tier</span>
				</div>

				<!-- Visible Free / User Selected Subscriptions -->
				<div class="sub-list" id="teaser-list"></div>

				<!-- PRO / FAMILY UNLOCKED DASHBOARD LAUNCHER (ZERO SCARE TACTICS, ZERO PAYWALL) -->
				<div class="pro-unlocked-section" id="pro-unlocked-section" hidden>
					<div class="pro-unlocked-banner">
						<span class="pro-unlocked-icon">🎉</span>
						<div class="pro-unlocked-text">
							<strong id="pro-unlocked-title">All Subscriptions Active & Unlocked</strong>
							<p id="pro-unlocked-desc">1-click cancellations and renewal radar alerts are armed and ready in your dashboard.</p>
						</div>
					</div>
					<a href="/dashboard?connected=1" class="btn-pro-launch" id="btn-pro-launch">
						Open Dashboard & Manage Subscriptions →
					</a>
				</div>

				<!-- PAYWALL OVERLAY: BLURRED SURPRISE CHARGES + PSYCHOLOGICAL CONVERSION PUSH -->
				<div class="paywall-overlay" id="paywall-overlay" hidden>
					<!-- Alert Divider -->
					<div class="paywall-discovery-bar">
						<div class="discovery-bar-left">
							<span class="pulse-alert-dot"></span>
							<strong id="discovery-bar-title">🚨 3 Unselected Subscriptions Discovered In Receipts</strong>
						</div>
						<span class="discovery-lock-tag">🔒 Pro Plan Only</span>
					</div>

					<!-- Real genuine subscriptions blurred behind frosted glass -->
					<div class="blurred-rows" id="blurred-list" aria-hidden="true"></div>

					<!-- High-Converting Psychological Paywall Gate -->
					<div class="paywall-gate">
						<div class="urgency-pill-top">
							<span>⚠️ IMMINENT CHARGE WARNING</span>
						</div>

						<div class="lock-shield" aria-hidden="true">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
							</svg>
						</div>

						<h2 class="gate-headline" id="gate-headline">
							Don't Miss These Charges — Stop $1,175/yr Before Your Card Is Debited
						</h2>

						<p class="gate-body" id="gate-body">
							Our scan uncovered <strong class="text-danger" id="gate-burn-monthly">$97.93/month</strong> (<strong class="text-danger" id="gate-burn-annual">$1,175/year</strong>) in forgotten recurring subscriptions that you didn't even select. The next billing cycle hits in <strong class="text-danger" id="gate-next-days">3 days</strong>. Once billed, subscription companies refuse refunds. Unlock <strong>CancelKits Pro</strong> ($9/mo) now to reveal these services and 1-click cancel before your bank account is charged.
						</p>

						<button
							type="button"
							class="btn-upgrade-pro"
							id="unlock-all-btn"
							data-price-id={stripeProMonthlyPriceId}
						>
							<span class="btn-text" id="btn-upgrade-text">🚨 Stop $1,175/yr In Hidden Charges Now ($9/mo) →</span>
							<span class="btn-spinner" hidden></span>
						</button>

						<div class="gate-guarantee">
							<span>⚡ Instant 1-Click Access</span>
							<span class="dot-sep">•</span>
							<span>🛡️ 30-Day Money-Back Guarantee</span>
							<span class="dot-sep">•</span>
							<span>✕ Stop Charges Before Renewal</span>
						</div>
					</div>
				</div>
			</section>

			<p class="free-fallback" id="free-fallback">
				<a href="/dashboard?connected=1" class="free-continue-link" id="free-continue-link">
					Or risk upcoming renewal charges & continue free →
				</a>
			</p>
		</div>
	</main>
</BaseLayout>

<script>
	import { supabase } from '../../lib/supabase';

	type ScanSub = {
		name: string;
		category: string;
		monthly: number;
		renewsIn?: number;
		color?: string;
		domain?: string;
		selectedByUser?: boolean;
		unselectedDiscovery?: boolean;
	};

	const FREE_TEASER = 5;

	const FALLBACK_SUBS: ScanSub[] = [
		{ name: 'Adobe Creative Cloud', category: 'Software & Cloud', monthly: 59.99, renewsIn: 3, color: '#e02424', unselectedDiscovery: true, selectedByUser: false },
		{ name: 'Planet Fitness Black Card', category: 'Fitness & Wellness', monthly: 22.99, renewsIn: 5, color: '#7e22ce', unselectedDiscovery: true, selectedByUser: false },
		{ name: 'Audible Premium', category: 'Music & Audio', monthly: 14.95, renewsIn: 8, color: '#f8991d', unselectedDiscovery: true, selectedByUser: false },
		{ name: 'Netflix Standard', category: 'Streaming', monthly: 15.49, renewsIn: 12, color: '#b91c1c', selectedByUser: true },
		{ name: 'Spotify Premium', category: 'Music & Audio', monthly: 11.99, renewsIn: 14, color: '#16a34a', selectedByUser: true },
	];

	function parseSubs(): ScanSub[] {
		try {
			const raw = localStorage.getItem('cancelkit-scan-subs');
			if (raw) {
				const parsed = JSON.parse(raw) as ScanSub[];
				if (Array.isArray(parsed) && parsed.length > 0) return parsed;
			}
		} catch {
			/* ignore */
		}

		try {
			const dash = localStorage.getItem('cancelkit-dashboard-subs');
			if (dash) {
				const parsed = JSON.parse(dash) as Array<{
					name: string;
					category?: string;
					monthly: number;
					nextBilling?: string;
					selectedByUser?: boolean;
					unselectedDiscovery?: boolean;
				}>;
				if (Array.isArray(parsed) && parsed.length > 0) {
					return parsed.map((s) => ({
						name: s.name,
						category: s.category || 'Subscription',
						monthly: Number(s.monthly) || 0,
						renewsIn: s.nextBilling
							? Math.max(
									1,
									Math.ceil(
										(new Date(s.nextBilling).getTime() - Date.now()) / 86400000,
									),
								)
							: 14,
						selectedByUser: s.selectedByUser,
						unselectedDiscovery: s.unselectedDiscovery,
					}));
				}
			}
		} catch {
			/* ignore */
		}

		return FALLBACK_SUBS;
	}

	function formatMoney(n: number): string {
		return n.toLocaleString('en-US', {
			minimumFractionDigits: n % 1 === 0 ? 0 : 2,
			maximumFractionDigits: 2,
		});
	}

	function avatarColor(name: string, fallback?: string): string {
		if (fallback) return fallback;
		const palette = ['#e02424', '#7e22ce', '#10b981', '#b91c1c', '#16a34a', '#0a66c2', '#00c4cc', '#113ccf'];
		let hash = 0;
		for (let i = 0; i < name.length; i++) hash = (hash + name.charCodeAt(i) * 17) % palette.length;
		return palette[hash];
	}

	function renewLabel(days?: number): string {
		if (days == null) return 'Recurring';
		if (days <= 0) return 'Renews today';
		if (days === 1) return 'Renews tomorrow';
		return `Renews in ${days} days`;
	}

	// Normal row for visible free subscriptions
	function rowHtml(sub: ScanSub): string {
		const initial = sub.name.charAt(0).toUpperCase();
		const color = avatarColor(sub.name, sub.color);
		return `
			<div class="sub-row">
				<div class="sub-info">
					<div class="sub-avatar" style="background:${color}">${initial}</div>
					<div class="sub-details">
						<strong class="sub-name">${sub.name}</strong>
						<span class="sub-meta">${sub.category} · ${renewLabel(sub.renewsIn)}</span>
					</div>
				</div>
				<div class="sub-price-col">
					<span class="sub-price">$${formatMoney(sub.monthly)}<small>/mo</small></span>
					<span class="sub-annual">$${formatMoney(sub.monthly * 12)}/yr</span>
				</div>
			</div>
		`;
	}

	// Blurred row for surprise unselected subscriptions — real data blurred behind frosted glass
	function blurredRowHtml(sub: ScanSub): string {
		const initial = sub.name.charAt(0).toUpperCase();
		const color = avatarColor(sub.name, sub.color);
		const days = sub.renewsIn ?? 3;
		return `
			<div class="blurred-row">
				<div class="blurred-sub-info">
					<div class="blurred-avatar" style="background:${color}">${initial}</div>
					<div class="blurred-text-block">
						<strong class="blurred-title">${sub.name}</strong>
						<div class="blurred-meta">
							<span>${sub.category}</span>
							<span class="pill-urgency">⚠️ Renews in ${days}d</span>
						</div>
					</div>
				</div>
				<div class="blurred-price-col">
					<span class="blurred-price">$${formatMoney(sub.monthly)}<small>/mo</small></span>
					<span class="blurred-annual">$${formatMoney(sub.monthly * 12)}/yr</span>
				</div>
			</div>
		`;
	}

	const subs = parseSubs();
	const count = Number(localStorage.getItem('cancelkit-scanned-count')) || subs.length || 5;
	const monthly =
		Number(localStorage.getItem('cancelkit-monthly-total')) ||
		Math.round(subs.reduce((s, x) => s + x.monthly, 0) * 100) / 100 ||
		125.41;
	const annual = Number(localStorage.getItem('cancelkit-annual-total')) || Math.round(monthly * 12);

	const foundCountEl = document.getElementById('found-count');
	const monthlyEl = document.getElementById('monthly-total');
	const annualEl = document.getElementById('annual-total');

	const urlParams = new URLSearchParams(window.location.search);
	const userEmail = urlParams.get('email') || localStorage.getItem('cancelkit-user-email') || '';
	const emailPill = document.getElementById('results-email-pill');
	const emailText = document.getElementById('results-email-text');
	if (userEmail && emailPill && emailText) {
		emailPill.hidden = false;
		emailText.textContent = `Receipts detected for: ${userEmail}`;
	}

	// ── Phase 1: Automated Audit Report Email Dispatch ──
	if (userEmail && userEmail.includes('@') && !sessionStorage.getItem(`cancelkit-audit-sent-${userEmail}`)) {
		sessionStorage.setItem(`cancelkit-audit-sent-${userEmail}`, '1');
		fetch('/api/send-email', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				template: 'audit-report',
				to: userEmail,
				data: {
					email: userEmail,
					count,
					monthlyTotal: monthly,
					annualTotal: annual,
					topSubscriptions: subs.slice(0, 5).map((s) => ({
						name: s.name,
						category: s.category,
						monthly: s.monthly,
						renewsIn: s.renewsIn,
					})),
					renewingSoonCount: subs.filter((s) => (s.renewsIn ?? 99) <= 7).length,
					upgradeUrl: `${window.location.origin}/pricing`,
				},
			}),
		}).catch((err) => {
			console.warn('Audit email dispatch notice:', err);
		});
	}

	if (foundCountEl) foundCountEl.textContent = String(count);
	if (monthlyEl) monthlyEl.textContent = formatMoney(monthly);
	if (annualEl) annualEl.textContent = `$${formatMoney(annual)}`;

	// Detect user plan
	const planParam = urlParams.get('plan') || urlParams.get('tier');
	const pendingPlan = localStorage.getItem('cancelkit-pending-checkout-plan');
	const optimisticPlan = sessionStorage.getItem('cancelkit-optimistic-plan');

	let effectivePlan: 'free' | 'pro' | 'family' = 'free';
	if (planParam === 'pro' || planParam === 'family') {
		effectivePlan = planParam;
	} else if (pendingPlan === 'pro' || pendingPlan === 'family') {
		effectivePlan = pendingPlan;
	} else if (optimisticPlan === 'pro' || optimisticPlan === 'family') {
		effectivePlan = optimisticPlan;
	} else {
		try {
			const authRaw = localStorage.getItem('cancelkit-auth-token');
			if (authRaw) {
				const auth = JSON.parse(authRaw);
				const uid = auth?.user?.id;
				if (uid) {
					const cached = localStorage.getItem(`cancelkit-user-plan_${uid}`);
					if (cached === 'pro' || cached === 'family') effectivePlan = cached;
				}
			}
		} catch {}
	}
	const isProOrFamily = effectivePlan === 'pro' || effectivePlan === 'family';

	let userKnownSubs: ScanSub[];
	let hiddenSurpriseSubs: ScanSub[];

	if (isProOrFamily) {
		// Pro & Family Plan subscribers: 100% REAL AND ACTUAL services only
		// Zero artificial unselected rows, zero paywall
		userKnownSubs = subs.filter((s) => !s.unselectedDiscovery);
		if (userKnownSubs.length === 0) userKnownSubs = subs;
		hiddenSurpriseSubs = [];
	} else {
		// Free Plan users: separate selected vs unselected surprise discoveries
		const hasMarkedDiscoveries = subs.some((s) => s.unselectedDiscovery || s.selectedByUser === false);
		if (hasMarkedDiscoveries) {
			userKnownSubs = subs.filter((s) => s.selectedByUser === true && !s.unselectedDiscovery);
			hiddenSurpriseSubs = subs.filter((s) => s.unselectedDiscovery || s.selectedByUser === false);
		} else {
			userKnownSubs = subs.slice(0, FREE_TEASER);
			hiddenSurpriseSubs = subs.slice(FREE_TEASER);
		}
	}

	// Re-calculate totals based on active visible subscriptions
	const activeList = isProOrFamily ? userKnownSubs : subs;
	const realMonthly = Math.round(activeList.reduce((s, x) => s + x.monthly, 0) * 100) / 100;
	const realAnnual = Math.round(realMonthly * 12);

	if (foundCountEl) foundCountEl.textContent = String(activeList.length);
	if (monthlyEl) monthlyEl.textContent = formatMoney(realMonthly);
	if (annualEl) annualEl.textContent = `$${formatMoney(realAnnual)}`;

	// Render Known Subscriptions List
	const teaserList = document.getElementById('teaser-list');
	const knownTitle = document.getElementById('known-card-title');
	const cardSubtitle = document.getElementById('card-subtitle');
	const teaserTag = document.getElementById('teaser-tag');

	if (teaserList) {
		teaserList.innerHTML = userKnownSubs.map((s) => rowHtml(s)).join('');
	}

	const paywall = document.getElementById('paywall-overlay');
	const blurredList = document.getElementById('blurred-list');
	const discoveryBarTitle = document.getElementById('discovery-bar-title');
	const gateHeadline = document.getElementById('gate-headline');
	const gateBurnMonthly = document.getElementById('gate-burn-monthly');
	const gateBurnAnnual = document.getElementById('gate-burn-annual');
	const gateNextDays = document.getElementById('gate-next-days');
	const btnUpgradeText = document.getElementById('btn-upgrade-text');
	const freeFallback = document.getElementById('free-fallback');
	const proSection = document.getElementById('pro-unlocked-section');
	const proTitle = document.getElementById('pro-unlocked-title');
	const proDesc = document.getElementById('pro-unlocked-desc');
	const proBtn = document.getElementById('btn-pro-launch') as HTMLAnchorElement | null;

	if (isProOrFamily) {
		// PRO OR FAMILY: Unlocked presentation, no paywall, no scare banner
		if (teaserTag) {
			teaserTag.className = effectivePlan === 'family' ? 'teaser-tag teaser-tag--family' : 'teaser-tag teaser-tag--pro';
			teaserTag.textContent = effectivePlan === 'family' ? 'Family Plan Active 👨‍👩‍👧‍👦' : 'Pro Plan Active ✓';
		}
		if (knownTitle) {
			knownTitle.textContent = `Your Active Subscriptions (${userKnownSubs.length})`;
		}
		if (cardSubtitle) {
			cardSubtitle.textContent = `All ${userKnownSubs.length} real subscriptions verified • 1-click cancellation active`;
		}
		if (paywall) {
			paywall.hidden = true;
		}
		if (freeFallback) {
			freeFallback.hidden = true;
		}
		if (proSection) {
			proSection.hidden = false;
			if (proTitle) proTitle.textContent = `Audit Complete — All ${userKnownSubs.length} Subscriptions Ready`;
			if (proDesc) proDesc.textContent = effectivePlan === 'family'
				? 'Your Family Plan is active. 1-click cancellations and household sharing are armed.'
				: 'Your Pro Plan is active. 1-click cancellations and renewal radar alerts are armed.';
			if (proBtn) {
				proBtn.textContent = `Open ${effectivePlan === 'family' ? 'Family' : 'Pro'} Dashboard (${userKnownSubs.length} Subscriptions) →`;
				proBtn.href = `/dashboard?connected=1&plan=${effectivePlan}`;
			}
		}
	} else {
		// FREE PLAN: psychological paywall gate & surprise discoveries
		if (knownTitle) {
			knownTitle.textContent = `Subscriptions You Selected (${userKnownSubs.length})`;
		}
		if (cardSubtitle) {
			cardSubtitle.textContent = 'Included in your free scan report';
		}
		if (teaserTag) {
			teaserTag.className = 'teaser-tag';
			teaserTag.textContent = 'Free Tier';
		}
		if (proSection) {
			proSection.hidden = true;
		}

		if (hiddenSurpriseSubs.length > 0 && paywall) {
			paywall.hidden = false;

			const surpriseMonthly = Math.round(hiddenSurpriseSubs.reduce((sum, s) => sum + s.monthly, 0) * 100) / 100;
			const surpriseAnnual = Math.round(surpriseMonthly * 12);
			const earliestRenewal = Math.min(...hiddenSurpriseSubs.map((s) => s.renewsIn ?? 3));

			if (discoveryBarTitle) {
				discoveryBarTitle.textContent = `🚨 ${hiddenSurpriseSubs.length} Unselected Subscriptions Discovered In Receipts ($${formatMoney(surpriseMonthly)}/mo)`;
			}
			if (gateHeadline) {
				gateHeadline.textContent = `Don't Miss These Charges — Stop $${formatMoney(surpriseAnnual)}/yr Before Your Card Is Debited`;
			}
			if (gateBurnMonthly) gateBurnMonthly.textContent = `$${formatMoney(surpriseMonthly)}/month`;
			if (gateBurnAnnual) gateBurnAnnual.textContent = `$${formatMoney(surpriseAnnual)}/year`;
			if (gateNextDays) gateNextDays.textContent = `${earliestRenewal} days`;
			if (btnUpgradeText) {
				btnUpgradeText.textContent = `🚨 Stop $${formatMoney(surpriseAnnual)}/yr In Hidden Charges Now ($9/mo) →`;
			}
			if (blurredList) {
				blurredList.innerHTML = hiddenSurpriseSubs.map((s) => blurredRowHtml(s)).join('');
			}
		}
	}

	// Configure free continue link based on auth status
	const freeContinueLink = document.getElementById('free-continue-link') as HTMLAnchorElement | null;
	supabase.auth.getSession().then(({ data: { session } }) => {
		if (freeContinueLink && !session?.user) {
			const emailQuery = userEmail ? `&email=${encodeURIComponent(userEmail)}` : '';
			freeContinueLink.href = `/signup?next=/dashboard${emailQuery}`;
		}
	});

	// Stripe / Lemon Squeezy Pro Checkout Trigger
	const unlockBtn = document.getElementById('unlock-all-btn') as HTMLButtonElement | null;

	const triggerUpgrade = async () => {
		if (!unlockBtn || unlockBtn.disabled) return;

		try {
			const {
				data: { session },
			} = await supabase.auth.getSession();

			if (!session?.user) {
				// User not signed in: redirect to signup so payment links to their account
				const emailQuery = userEmail ? `&email=${encodeURIComponent(userEmail)}` : '';
				window.location.href = `/signup?next=/pricing&tier=pro${emailQuery}`;
				return;
			}

			unlockBtn.disabled = true;
			const btnText = unlockBtn.querySelector('.btn-text') as HTMLElement | null;
			const btnSpinner = unlockBtn.querySelector('.btn-spinner') as HTMLElement | null;
			if (btnText) btnText.textContent = 'Preparing checkout...';
			if (btnSpinner) btnSpinner.hidden = false;

			const priceId = unlockBtn.dataset.priceId;
			const response = await fetch('/api/create-checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					priceId,
					tier: 'pro',
					userId: session.user.id,
					email: session.user.email || userEmail || '',
				}),
			});

			const data = await response.json();
			if (data?.url) {
				window.location.href = data.url;
				return;
			}
			window.location.href = '/pricing';
		} catch {
			window.location.href = '/pricing';
		}
	};

	unlockBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		triggerUpgrade();
	});

	blurredList?.addEventListener('click', () => {
		triggerUpgrade();
	});
</script>

<style>
	.results-page {
		min-height: 100svh;
		padding: 2.75rem 1.25rem 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		background:
			radial-gradient(ellipse 90% 55% at 50% -10%, rgba(255, 68, 68, 0.14), transparent 70%),
			#050505;
	}

	.results-container {
		width: min(100%, 36rem);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.results-wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.wordmark-icon {
		display: grid;
		place-items: center;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 7px;
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.wordmark-text {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.wordmark-accent {
		color: var(--color-accent);
	}

	.results-hero {
		text-align: center;
		margin-bottom: 2.25rem;
		width: 100%;
	}

	.results-email-pill {
		display: inline-flex;

# Supabase Configuration for CancelKit
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend (email delivery — free: 3,000/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public variables for client-side access
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Subscription Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_9
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_79
STRIPE_FAMILY_MONTHLY_PRICE_ID=price_family_monthly_19
STRIPE_FAMILY_YEARLY_PRICE_ID=price_family_yearly_159
PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Bank Statement Subscription Scanner (Zero-Upload PDF) | CancelKits";
const pageDescription = "Drag-and-drop your bank or credit card PDF statement. CancelKits detects recurring subscriptions instantly — 100% client-side, nothing leaves your browser.";

const softwareSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Bank Statement Subscription Scanner',
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Web',
	url: 'https://cancelkits.com/statement-scanner',
	description: pageDescription,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};

const howToSchema = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'How to Find Hidden Subscriptions in Your Bank Statement',
	description: 'Use CancelKits\' free browser-based scanner to detect recurring charges from a PDF bank statement without uploading or sharing any financial data.',
	totalTime: 'PT2M',
	step: [
		{
			'@type': 'HowToStep',
			position: 1,
			name: 'Download your bank statement PDF',
			text: 'Log into your bank or credit card portal and download a recent monthly statement as a PDF file.',
			url: 'https://cancelkits.com/statement-scanner#step-1',
		},
		{
			'@type': 'HowToStep',
			position: 2,
			name: 'Drag and drop into the scanner',
			text: 'Drag your PDF into the secure drop zone or click to browse. The file is parsed entirely in your browser — nothing is uploaded.',
			url: 'https://cancelkits.com/statement-scanner#step-2',
		},
		{
			'@type': 'HowToStep',
			position: 3,
			name: 'Review your subscription roadmap',
			text: 'Instantly see detected recurring subscriptions, monthly totals, and direct links to step-by-step cancellation guides.',
			url: 'https://cancelkits.com/statement-scanner#step-3',
		},
	],
};

const faqs = [
	{
		q: 'Is my bank statement uploaded to your servers?',
		a: 'No. Your PDF is parsed entirely inside your browser using pdf.js (Mozilla\'s open-source PDF renderer). The file never leaves your device. We have zero server-side storage, zero network requests with your financial data, and zero access to your banking credentials.',
	},
	{
		q: 'What file formats are supported?',
		a: 'Standard PDF bank and credit card statements from any US or international bank. The scanner works best with text-based PDFs. Scanned image-only PDFs (photographed paper statements) are not supported since they lack selectable text.',
	},
	{
		q: 'How does the scanner detect subscriptions?',
		a: 'The scanner extracts all text from your PDF, then pattern-matches against a curated database of 100+ subscription merchant names (Netflix, Spotify, Adobe, gym chains, etc.) and identifies recurring charge patterns like consistent monthly amounts.',
	},
	{
		q: 'What if the scanner misses a subscription?',
		a: 'No automated scanner is perfect. Banks format merchant names differently (e.g., "AMZN MKTP" vs "Amazon Prime"). We catch the most common variants, but you can always manually review the raw extracted transactions for anything we missed.',
	},
	{
		q: 'Can I use this on my phone?',
		a: 'Yes. The scanner works on any modern mobile browser. Tap the upload area, select a PDF from your Files app, and the scanner processes it instantly on your device.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<slot name="head" slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	</slot>

	<Nav />

	<main class="scanner-page">
		<!-- Hero -->
		<section class="scanner-hero">
			<div class="scanner-container">
				<div class="hero-badge">
					<span class="badge-icon">🔒</span>
					<span>100% Client-Side • Nothing Uploaded • Zero Signup</span>
				</div>

				<h1 class="scanner-title">
					Find Hidden Subscriptions in Your <span class="text-accent">Bank Statement</span>
				</h1>
				<p class="scanner-subtitle">
					Drop your bank or credit card PDF below. We detect recurring charges entirely inside your browser — your financial data never leaves your device.
				</p>

				<div class="trust-row">
					<div class="trust-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
						<span>No server upload</span>
					</div>
					<div class="trust-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
						<span>No login required</span>
					</div>
					<div class="trust-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
						<span>Open-source pdf.js</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Drop Zone -->
		<section class="scanner-dropzone-section" id="step-2">
			<div class="scanner-container">
				<div class="dropzone-card" id="dropzone">
					<div class="dropzone-inner" id="dropzone-inner">
						<div class="dropzone-icon">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
								<polyline points="14 2 14 8 20 8"/>
								<line x1="12" y1="18" x2="12" y2="12"/>
								<polyline points="9 15 12 12 15 15"/>
							</svg>
						</div>
						<p class="dropzone-text">
							<strong>Drag & drop your bank statement PDF here</strong>
						</p>
						<p class="dropzone-hint">or click to browse your files</p>
						<input type="file" id="file-input" accept=".pdf,application/pdf" hidden />
					</div>

					<!-- Progress State -->
					<div class="dropzone-progress" id="dropzone-progress" hidden>
						<div class="progress-spinner"></div>
						<p class="progress-text" id="progress-text">Parsing PDF in your browser…</p>
					</div>

					<!-- File Info (shown after selection) -->
					<div class="dropzone-file-info" id="file-info" hidden>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
						<span id="file-name">statement.pdf</span>
						<button type="button" id="clear-file" class="clear-file-btn" title="Remove file">✕</button>
					</div>
				</div>

				<p class="privacy-note">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					<span>Your PDF is processed using <a href="https://mozilla.github.io/pdf.js/" target="_blank" rel="noopener noreferrer">Mozilla pdf.js</a> running entirely in your browser. We never see, store, or transmit your financial data.</span>
				</p>
			</div>
		</section>

		<!-- Results Section (hidden until scan completes) -->
		<section class="scanner-results" id="results-section" hidden>
			<div class="scanner-container">
				<!-- Summary Card -->
				<div class="results-summary" id="results-summary">
					<div class="summary-icon">🔍</div>
					<div class="summary-content">
						<h2 class="summary-title" id="summary-title">
							We detected <span class="text-danger" id="sub-count">0</span> recurring subscriptions totaling <span class="text-danger" id="sub-total">$0.00</span>/mo
						</h2>
						<p class="summary-desc">Here is your cancellation roadmap. Click any subscription to see its step-by-step cancellation guide.</p>
					</div>
				</div>

				<!-- Yearly Impact Banner -->
				<div class="impact-banner" id="impact-banner">
					<div class="impact-stat">
						<span class="impact-label">Annual cost</span>
						<span class="impact-value text-danger" id="annual-cost">$0</span>
					</div>
					<div class="impact-divider"></div>
					<div class="impact-stat">
						<span class="impact-label">If invested at 7% for 5 years</span>
						<span class="impact-value text-accent" id="invested-value">$0</span>
					</div>
					<a href="/subscription-creep-calculator/" class="impact-cta">Model full compound loss →</a>
				</div>

				<!-- Detected Subscriptions Grid -->
				<div class="detected-grid" id="detected-grid">
					<!-- Populated by JS -->
				</div>

				<!-- Unrecognized Transactions (collapsible) -->
				<details class="unrecognized-section" id="unrecognized-section" hidden>
					<summary class="unrecognized-toggle">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						<span>Show <span id="unrecognized-count">0</span> other potential recurring charges</span>
					</summary>
					<div class="unrecognized-grid" id="unrecognized-grid">
						<!-- Populated by JS -->
					</div>
				</details>

				<!-- CTA -->
				<div class="results-cta-box">
					<div class="cta-icon">⚡</div>
					<div class="cta-content">
						<h3>Want to cancel these automatically?</h3>
						<p>Connect your inbox and CancelKits handles cancellations for you — including phone calls, certified mail, and retention scripts.</p>
					</div>
					<a href="/signup?ref=statement-scanner" class="cta-button">Start cancelling free →</a>
				</div>

				<!-- Scan another -->
				<button type="button" class="btn-scan-another" id="scan-another-btn">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
					Scan another statement
				</button>
			</div>
		</section>

		<!-- No Results Section -->
		<section class="scanner-no-results" id="no-results-section" hidden>
			<div class="scanner-container">
				<div class="no-results-card">
					<div class="no-results-icon">📄</div>
					<h2>No recurring subscriptions detected</h2>
					<p>We couldn't identify subscription charges in this PDF. This can happen with image-only (scanned) PDFs or statements from unsupported bank formats.</p>
					<div class="no-results-tips">
						<h4>Tips:</h4>
						<ul>
							<li>Make sure you're using a text-based PDF (not a scanned image)</li>
							<li>Try a credit card statement — they typically list merchant names more clearly</li>
							<li>Use your most recent monthly statement for the best detection</li>
						</ul>
					</div>
					<button type="button" class="btn-try-again" id="try-again-btn">Try another statement</button>
					<p class="no-results-alt">Or use our <a href="/calculator/">interactive subscription calculator</a> to manually audit your subscriptions.</p>
				</div>
			</div>
		</section>

		<!-- How It Works -->
		<section class="scanner-how-it-works" id="step-1">
			<div class="scanner-container">
				<h2>How the Privacy-First Scanner Works</h2>
				<div class="steps-row">
					<div class="step-card">
						<div class="step-num">1</div>
						<h3>Download your statement</h3>
						<p>Log into your bank or credit card portal. Download any monthly statement as a PDF.</p>
					</div>
					<div class="step-arrow">→</div>
					<div class="step-card">
						<div class="step-num">2</div>
						<h3>Drop it in the scanner</h3>
						<p>Drag the PDF into the zone above. Mozilla's open-source pdf.js parses it entirely in your browser.</p>
					</div>
					<div class="step-arrow">→</div>
					<div class="step-card">
						<div class="step-num">3</div>
						<h3>Get your cancellation roadmap</h3>
						<p>See every recurring charge, monthly totals, and direct links to step-by-step cancellation guides.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Comparison: Old vs New -->
		<section class="scanner-comparison">
			<div class="scanner-container">
				<h2>Why This Beats Email-Based Scanners</h2>
				<div class="comparison-grid">
					<div class="comparison-card comparison-card--bad">
						<h3>❌ Email OAuth Scanners</h3>
						<ul>
							<li>Require full read access to your inbox</li>
							<li>Can see personal messages, bank alerts, medical info</li>
							<li>Your data is stored on their servers indefinitely</li>
							<li>If they get breached, your inbox history is exposed</li>
							<li>85% of users abandon onboarding at the OAuth screen</li>
						</ul>
					</div>
					<div class="comparison-card comparison-card--good">
						<h3>✅ CancelKits Statement Scanner</h3>
						<ul>
							<li>Zero permissions required — no login, no OAuth</li>
							<li>PDF never leaves your browser tab</li>
							<li>Nothing stored on our servers — ever</li>
							<li>Works with any bank or credit card worldwide</li>
							<li>Results in under 3 seconds, not 30 minutes</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section class="scanner-faq" aria-labelledby="faq-heading">
			<div class="scanner-container">
				<h2 id="faq-heading">Frequently Asked Questions</h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details class="faq-item">
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<!-- Cross-link to calculators -->
		<section class="scanner-tools-crosslink">
			<div class="scanner-container">
				<h2>More Free Tools</h2>
				<div class="tools-row">
					<a href="/calculator/" class="tool-link-card">
						<span class="tool-link-icon">🧮</span>
						<div>
							<strong>Subscription Cost Calculator</strong>
							<p>Toggle common apps and see your real monthly, yearly, and 5-year cost.</p>
						</div>
					</a>
					<a href="/subscription-creep-calculator/" class="tool-link-card">
						<span class="tool-link-icon">📈</span>
						<div>
							<strong>Subscription Creep Calculator</strong>
							<p>Model 3, 5 & 10-year compounded opportunity cost at 7% index fund returns.</p>
						</div>
					</a>
					<a href="/gym-cancellation-letter/" class="tool-link-card">
						<span class="tool-link-icon">✉️</span>
						<div>
							<strong>Gym Cancellation Letter Generator</strong>
							<p>Generate a legally-compliant USPS certified mail letter for gym cancellations.</p>
						</div>
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<!-- pdf.js loaded from CDN (UMD build attaches directly to window.pdfjsLib) -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<script>
	// ──────────────────────────────────────────────
	// Subscription merchant patterns database
	// ──────────────────────────────────────────────
	interface MerchantPattern {
		patterns: RegExp[];
		name: string;
		slug: string;
		monthlyPrice: number;
		category: string;
	}

	const MERCHANT_DB: MerchantPattern[] = [
		// Streaming Video
		{ patterns: [/netflix/i], name: 'Netflix', slug: 'netflix', monthlyPrice: 15.49, category: 'Streaming' },
		{ patterns: [/hulu/i], name: 'Hulu', slug: 'hulu', monthlyPrice: 17.99, category: 'Streaming' },
		{ patterns: [/disney\s*\+/i, /disney\s*plus/i, /disneyplus/i], name: 'Disney+', slug: 'disney-plus', monthlyPrice: 15.99, category: 'Streaming' },
		{ patterns: [/hbo\s*max/i, /\bmax\b.*warner/i, /warner\s*bros.*max/i], name: 'HBO Max', slug: 'hbo-max', monthlyPrice: 16.99, category: 'Streaming' },
		{ patterns: [/amazon\s*prime/i, /amzn\s*prime/i, /prime\s*video/i, /prime\s*member/i], name: 'Amazon Prime', slug: 'amazon-prime', monthlyPrice: 14.99, category: 'Streaming' },
		{ patterns: [/apple\s*tv\+?/i, /apple\s*tv\s*plus/i], name: 'Apple TV+', slug: 'apple-tv-plus', monthlyPrice: 9.99, category: 'Streaming' },
		{ patterns: [/paramount\s*\+/i, /paramount\s*plus/i], name: 'Paramount+', slug: 'paramount-plus', monthlyPrice: 12.99, category: 'Streaming' },
		{ patterns: [/peacock/i, /nbcu.*peacock/i], name: 'Peacock', slug: 'peacock', monthlyPrice: 13.99, category: 'Streaming' },
		{ patterns: [/youtube\s*prem/i, /google\s*youtube/i, /yt\s*premium/i], name: 'YouTube Premium', slug: 'youtube-premium', monthlyPrice: 13.99, category: 'Streaming' },
		{ patterns: [/espn\s*\+/i, /espn\s*plus/i], name: 'ESPN+', slug: 'espn-plus', monthlyPrice: 11.99, category: 'Streaming' },

		// Music & Audio
		{ patterns: [/spotify/i], name: 'Spotify', slug: 'spotify', monthlyPrice: 11.99, category: 'Music' },
		{ patterns: [/apple\s*music/i, /itunes.*music/i], name: 'Apple Music', slug: 'apple-music', monthlyPrice: 10.99, category: 'Music' },
		{ patterns: [/tidal/i], name: 'Tidal', slug: 'tidal', monthlyPrice: 10.99, category: 'Music' },
		{ patterns: [/sirius\s*xm/i, /sxm/i, /sirius/i], name: 'Sirius XM', slug: 'sirius-xm', monthlyPrice: 23.99, category: 'Music' },
		{ patterns: [/audible/i], name: 'Audible', slug: 'audible', monthlyPrice: 14.95, category: 'Music' },

		// Software & Productivity
		{ patterns: [/adobe/i, /creative\s*cloud/i], name: 'Adobe Creative Cloud', slug: 'adobe', monthlyPrice: 59.99, category: 'Software' },
		{ patterns: [/microsoft\s*365/i, /office\s*365/i, /ms\s*365/i, /msft.*365/i], name: 'Microsoft 365', slug: 'microsoft-365', monthlyPrice: 9.99, category: 'Software' },
		{ patterns: [/canva/i], name: 'Canva Pro', slug: 'canva-pro', monthlyPrice: 14.99, category: 'Software' },
		{ patterns: [/dropbox/i], name: 'Dropbox', slug: 'dropbox', monthlyPrice: 11.99, category: 'Software' },
		{ patterns: [/notion/i], name: 'Notion', slug: 'notion', monthlyPrice: 10, category: 'Software' },
		{ patterns: [/figma/i], name: 'Figma', slug: 'figma', monthlyPrice: 15, category: 'Software' },
		{ patterns: [/evernote/i], name: 'Evernote', slug: 'evernote', monthlyPrice: 14.99, category: 'Software' },
		{ patterns: [/1password/i, /one\s*password/i], name: '1Password', slug: '1password', monthlyPrice: 2.99, category: 'Software' },
		{ patterns: [/dashlane/i], name: 'Dashlane', slug: 'dashlane', monthlyPrice: 4.99, category: 'Software' },
		{ patterns: [/lastpass/i], name: 'LastPass', slug: 'lastpass', monthlyPrice: 3, category: 'Software' },
		{ patterns: [/miro\b/i], name: 'Miro', slug: 'miro', monthlyPrice: 8, category: 'Software' },

		// Cloud Storage
		{ patterns: [/icloud/i, /apple.*icloud/i], name: 'iCloud+', slug: 'icloud', monthlyPrice: 2.99, category: 'Cloud Storage' },
		{ patterns: [/google\s*one/i], name: 'Google One', slug: 'google-one', monthlyPrice: 2.99, category: 'Cloud Storage' },
		{ patterns: [/\bbox\b.*business/i, /box\.com/i], name: 'Box', slug: 'box', monthlyPrice: 15, category: 'Cloud Storage' },

		// Apple Bundles
		{ patterns: [/apple\s*one/i], name: 'Apple One', slug: 'apple-one', monthlyPrice: 19.95, category: 'Bundles' },

		// Fitness & Wellness
		{ patterns: [/planet\s*fit/i, /pf\s*membership/i], name: 'Planet Fitness', slug: 'planet-fitness', monthlyPrice: 22.99, category: 'Fitness' },
		{ patterns: [/la\s*fitness/i, /esporta/i], name: 'LA Fitness', slug: 'la-fitness', monthlyPrice: 34.99, category: 'Fitness' },
		{ patterns: [/orangetheory/i, /orange\s*theory/i, /otf/i], name: 'OrangeTheory', slug: 'orange-theory', monthlyPrice: 159, category: 'Fitness' },
		{ patterns: [/peloton/i], name: 'Peloton', slug: 'peloton', monthlyPrice: 44, category: 'Fitness' },
		{ patterns: [/classpass/i], name: 'ClassPass', slug: 'classpass', monthlyPrice: 49, category: 'Fitness' },
		{ patterns: [/headspace/i], name: 'Headspace', slug: 'headspace', monthlyPrice: 12.99, category: 'Fitness' },
		{ patterns: [/\bcalm\b/i], name: 'Calm', slug: 'calm', monthlyPrice: 14.99, category: 'Fitness' },
		{ patterns: [/anytime\s*fit/i], name: 'Anytime Fitness', slug: 'gym-membership', monthlyPrice: 40, category: 'Fitness' },
		{ patterns: [/24\s*hour\s*fit/i], name: '24 Hour Fitness', slug: 'gym-membership', monthlyPrice: 40, category: 'Fitness' },
		{ patterns: [/crunch\s*fit/i, /crunch\s*gym/i], name: 'Crunch Fitness', slug: 'gym-membership', monthlyPrice: 30, category: 'Fitness' },
		{ patterns: [/equinox/i], name: 'Equinox', slug: 'gym-membership', monthlyPrice: 260, category: 'Fitness' },
		{ patterns: [/gold.?s?\s*gym/i], name: "Gold's Gym", slug: 'gym-membership', monthlyPrice: 30, category: 'Fitness' },
		{ patterns: [/ymca/i], name: 'YMCA', slug: 'gym-membership', monthlyPrice: 55, category: 'Fitness' },

		// Food & Delivery
		{ patterns: [/hellofresh/i, /hello\s*fresh/i], name: 'HelloFresh', slug: 'hellofresh', monthlyPrice: 60, category: 'Food' },
		{ patterns: [/blue\s*apron/i], name: 'Blue Apron', slug: 'blue-apron', monthlyPrice: 55, category: 'Food' },
		{ patterns: [/doordash/i, /door\s*dash/i, /dashpass/i], name: 'DashPass', slug: 'door-dash', monthlyPrice: 9.99, category: 'Food' },
		{ patterns: [/uber\s*one/i, /uber\s*eats.*pass/i], name: 'Uber One', slug: 'uber-one', monthlyPrice: 9.99, category: 'Food' },
		{ patterns: [/instacart/i], name: 'Instacart+', slug: 'instacart', monthlyPrice: 9.99, category: 'Food' },
		{ patterns: [/grubhub/i, /grub\s*hub/i], name: 'Grubhub+', slug: 'grubhub', monthlyPrice: 9.99, category: 'Food' },
		{ patterns: [/factor/i, /factor\s*75/i, /factor\s*meals/i], name: 'Factor', slug: 'factor', monthlyPrice: 70, category: 'Food' },
		{ patterns: [/home\s*chef/i], name: 'Home Chef', slug: 'home-chef', monthlyPrice: 50, category: 'Food' },

		// VPN

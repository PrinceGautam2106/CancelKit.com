---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Reset Password — CancelKits';
const description = 'Choose a new password for your CancelKits account.';
---

<BaseLayout {title} {description} noIndex>
	<Nav />
	<main class="auth-page">
		<div class="auth-card">
			<div class="auth-card__header">
				<a class="auth-logo" href="/" aria-label="CancelKits home">
					<img class="auth-logo__icon" src="/favicon.svg" alt="" width="28" height="28" />
					<span class="auth-logo__text">Cancel<span>K<span class="auth-logo__accent">i</span>ts</span></span>
				</a>
				<h1>Set new password</h1>
				<p>Enter your new password below to regain access to your account.</p>
			</div>

			<!-- Token Validation Loading State -->
			<div class="auth-validating-box" id="validating-box">
				<div class="auth-spinner"></div>
				<p>Verifying your password reset link...</p>
			</div>

			<!-- Invalid Token State -->
			<div class="auth-invalid-box" id="invalid-token-box" hidden>
				<div class="invalid-icon">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<line x1="15" y1="9" x2="9" y2="15"/>
						<line x1="9" y1="9" x2="15" y2="15"/>
					</svg>
				</div>
				<h2>Invalid or expired link</h2>
				<p>This password reset link is invalid, expired, or has already been used.</p>
				<a href="/forgot-password" class="auth-btn-secondary">Request new reset link</a>
			</div>

			<!-- Success State -->
			<div class="auth-success-box" id="success-box" hidden>
				<div class="success-icon">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round" stroke-linejoin="round"/>
						<polyline points="22 4 12 14.01 9 11.01" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</div>
				<h2>Password updated!</h2>
				<p>Your password has been successfully reset. Redirecting to your dashboard...</p>
			</div>

			<!-- Form Container (No <form> tag) -->
			<div class="auth-fields" id="reset-fields" hidden role="region" aria-label="New password fields">
				<div class="auth-field">
					<label for="new-password">New password</label>
					<input
						type="password"
						id="new-password"
						placeholder="At least 6 characters"
						autocomplete="new-password"
					/>
					<p class="inline-error" id="new-password-error" role="alert" aria-live="polite"></p>
				</div>

				<div class="auth-field">
					<label for="confirm-password">Confirm new password</label>
					<input
						type="password"
						id="confirm-password"
						placeholder="Re-enter your new password"
						autocomplete="new-password"
					/>
					<p class="inline-error" id="confirm-password-error" role="alert" aria-live="polite"></p>
				</div>

				<button type="button" class="auth-submit-btn" id="update-password-btn">
					<span class="btn-label">Update Password →</span>
					<span class="btn-spinner" hidden></span>
				</button>

				<p class="inline-error inline-error--general" id="general-error" role="alert" aria-live="polite"></p>
			</div>

			<p class="auth-footer-text">
				Remember your password? <a href="/signin">Sign in</a>
			</p>
		</div>
	</main>
	<Footer />
</BaseLayout>

<script>
	import { supabase, setAuthCookies } from '../lib/supabase';

	const validatingBox = document.getElementById('validating-box') as HTMLDivElement;
	const invalidBox = document.getElementById('invalid-token-box') as HTMLDivElement;
	const successBox = document.getElementById('success-box') as HTMLDivElement;
	const resetFields = document.getElementById('reset-fields') as HTMLDivElement;

	const newPasswordInput = document.getElementById('new-password') as HTMLInputElement;
	const confirmPasswordInput = document.getElementById('confirm-password') as HTMLInputElement;
	const updatePasswordBtn = document.getElementById('update-password-btn') as HTMLButtonElement;

	const newPasswordError = document.getElementById('new-password-error') as HTMLParagraphElement;
	const confirmPasswordError = document.getElementById('confirm-password-error') as HTMLParagraphElement;
	const generalError = document.getElementById('general-error') as HTMLParagraphElement;

	let hasValidSession = false;

	function clearErrors() {
		if (newPasswordError) newPasswordError.textContent = '';
		if (confirmPasswordError) confirmPasswordError.textContent = '';
		if (generalError) generalError.textContent = '';
		newPasswordInput?.classList.remove('has-error');
		confirmPasswordInput?.classList.remove('has-error');
	}

	function setLoading(loading: boolean) {
		if (!updatePasswordBtn) return;
		updatePasswordBtn.disabled = loading;
		const label = updatePasswordBtn.querySelector('.btn-label') as HTMLElement;
		const spinner = updatePasswordBtn.querySelector('.btn-spinner') as HTMLElement;
		if (label) label.textContent = loading ? 'Updating password...' : 'Update Password →';
		if (spinner) spinner.hidden = !loading;
	}

	// Validate reset token from URL
	async function validateToken() {
		try {
			const hash = window.location.hash;
			const searchParams = new URLSearchParams(window.location.search);
			const code = searchParams.get('code');

			// If PKCE flow with code in search params
			if (code) {
				const { data, error } = await supabase.auth.exchangeCodeForSession(code);
				if (!error && data?.session) {
					hasValidSession = true;
					showResetForm();
					return;
				}
			}

			// Check implicit flow hash
			if (hash && (hash.includes('type=recovery') || hash.includes('access_token'))) {
				const { data: { session }, error } = await supabase.auth.getSession();
				if (!error && session) {
					hasValidSession = true;
					showResetForm();
					return;
				}
			}

			// Listen for auth event
			supabase.auth.onAuthStateChange((event, session) => {
				if (event === 'PASSWORD_RECOVERY' || (event === 'SIGNED_IN' && session)) {
					hasValidSession = true;
					showResetForm();
				}
			});

			// Check if already in recovery session
			const { data: { session } } = await supabase.auth.getSession();
			if (session) {
				hasValidSession = true;
				showResetForm();
				return;
			}

			// If no session found after grace period, mark invalid
			setTimeout(() => {
				if (!hasValidSession) {
					showInvalidToken();
				}
			}, 2000);
		} catch {
			showInvalidToken();
		}
	}

	function showResetForm() {
		if (validatingBox) validatingBox.hidden = true;
		if (invalidBox) invalidBox.hidden = true;
		if (resetFields) resetFields.hidden = false;
	}

	function showInvalidToken() {
		if (validatingBox) validatingBox.hidden = true;
		if (resetFields) resetFields.hidden = true;
		if (invalidBox) invalidBox.hidden = false;
	}

	validateToken();

	// Update password handler
	updatePasswordBtn?.addEventListener('click', async () => {
		clearErrors();

		const newPassword = newPasswordInput?.value;
		const confirmPassword = confirmPasswordInput?.value;
		let hasClientError = false;

		if (!newPassword) {
			newPasswordError.textContent = 'Please enter your new password.';
			newPasswordInput?.classList.add('has-error');
			hasClientError = true;
		} else if (newPassword.length < 6) {
			newPasswordError.textContent = 'Password must be at least 6 characters.';
			newPasswordInput?.classList.add('has-error');
			hasClientError = true;
		}

		if (!confirmPassword) {
			confirmPasswordError.textContent = 'Please confirm your new password.';
			confirmPasswordInput?.classList.add('has-error');
			hasClientError = true;
		} else if (newPassword !== confirmPassword) {
			confirmPasswordError.textContent = 'Passwords do not match.';
			confirmPasswordInput?.classList.add('has-error');
			hasClientError = true;
		}

		if (hasClientError) return;

		setLoading(true);

		try {
			const { data, error } = await supabase.auth.updateUser({
				password: newPassword,
			});

			if (error) {
				generalError.textContent = error.message;
				setLoading(false);
				return;
			}

			// Password successfully reset
			if (resetFields) resetFields.hidden = true;
			if (successBox) successBox.hidden = false;

			// Sync cookies
			const { data: sessionData } = await supabase.auth.getSession();
			if (sessionData?.session) {
				setAuthCookies(sessionData.session.access_token, sessionData.session.refresh_token);
			}

			// Redirect after brief pause
			setTimeout(() => {
				window.location.href = '/dashboard';
			}, 2000);
		} catch (err: any) {
			generalError.textContent = err?.message || 'Failed to update password. Please try again.';
			setLoading(false);
		}
	});

	// Enter key trigger
	[newPasswordInput, confirmPasswordInput].forEach((input) => {
		input?.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				updatePasswordBtn?.click();
			}
		});
	});
</script>

<style>
	.auth-page {
		min-height: 80svh;
		padding: 3rem 1rem 5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0, 255, 136, 0.08), transparent 70%),
			#050505;
	}

	.auth-card {
		width: min(100%, 26.5rem);
		padding: 2.25rem 1.75rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
		box-sizing: border-box;
	}

	.auth-card__header {
		text-align: center;
		margin-bottom: 1.75rem;
	}

	.auth-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		margin-bottom: 1.25rem;
	}

	.auth-logo__icon {
		display: block;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 6px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.auth-logo__text {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.auth-logo__accent {
		color: var(--color-accent);
	}

	.auth-card__header h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: #fff;
	}

	.auth-card__header p {
		margin: 0.5rem 0 0;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	/* Validating State */
	.auth-validating-box {
		padding: 2rem 1rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.auth-spinner {
		width: 32px;
		height: 32px;
		border: 2.5px solid rgba(255, 255, 255, 0.1);
		border-top-color: var(--color-accent);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	/* Invalid Box */
	.auth-invalid-box {
		padding: 1.75rem 1rem;
		text-align: center;
		border-radius: var(--radius-card);
		border: 1px solid rgba(255, 68, 68, 0.3);
		background: rgba(255, 68, 68, 0.06);
	}

	.invalid-icon {
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(255, 68, 68, 0.15);
		color: var(--color-danger);
		margin-bottom: 0.75rem;
	}

	.auth-invalid-box h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: #fff;
	}

	.auth-invalid-box p {
		margin: 0.5rem 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.86rem;
		line-height: 1.5;
	}

	/* Success State Box */
	.auth-success-box {
		padding: 1.75rem 1rem;
		text-align: center;
		border-radius: var(--radius-card);
		border: 1px solid rgba(0, 255, 136, 0.3);
		background: rgba(0, 255, 136, 0.06);
	}

	.success-icon {
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(0, 255, 136, 0.15);
		color: var(--color-accent);
		margin-bottom: 0.75rem;
	}

	.auth-success-box h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
		color: #fff;
	}

	.auth-success-box p {
		margin: 0.5rem 0 0;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.auth-btn-secondary {
		display: inline-block;
		padding: 0.65rem 1.25rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border-hover);
		background: #111;
		color: #fff;
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		cursor: pointer;
		transition: background 0.2s;
	}

	.auth-btn-secondary:hover {
		background: #1a1a1a;
	}

	/* Fields */
	.auth-fields {
		display: grid;
		gap: 1rem;
	}

	.auth-field {
		display: grid;
		gap: 0.4rem;
	}

	.auth-field label {
		font-size: 0.82rem;
		font-weight: 500;
		color: #d0d0d0;
	}

	.auth-field input {
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: #050505;
		color: #fff;
		font-family: var(--font-body);
		font-size: 0.95rem;
		outline: none;
		box-sizing: border-box;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.auth-field input:focus {
		border-color: rgba(0, 255, 136, 0.5);
		box-shadow: 0 0 0 3px rgba(0, 255, 136, 0.12);
	}

	.auth-field input.has-error {
		border-color: var(--color-danger);
		box-shadow: 0 0 0 3px rgba(255, 68, 68, 0.12);
	}

	.inline-error {
		margin: 0.25rem 0 0;
		color: var(--color-danger);
		font-size: 0.8rem;
		line-height: 1.4;
		min-height: 1.1rem;
	}

	.inline-error:empty {
		min-height: 0;
		margin: 0;
	}

	.inline-error--general {
		text-align: center;
		margin-top: 0.5rem;
	}

	.auth-submit-btn {
		width: 100%;
		padding: 0.85rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.95rem;
		border: 0;
		cursor: pointer;
		min-height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.25rem;
		transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
	}

	.auth-submit-btn:hover:not(:disabled) {
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(0, 255, 136, 0.3);
	}

	.auth-submit-btn:disabled {
		opacity: 0.7;
		cursor: not-allowed;
	}

	.btn-spinner {
		width: 18px;
		height: 18px;
		border: 2px solid rgba(0, 0, 0, 0.25);
		border-top-color: #000;
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	.auth-footer-text {
		margin: 1.75rem 0 0;
		text-align: center;
		color: var(--color-muted);
		font-size: 0.85rem;
	}

	.auth-footer-text a {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.auth-footer-text a:hover {
		text-decoration: underline;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (max-width: 480px) {
		.auth-card {
			padding: 1.75rem 1.25rem;
		}
	}
</style>

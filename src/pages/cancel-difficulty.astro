---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data/services';
import { getGuideDetails } from '../data/guideDetails';
const categories = [...new Set(services.map(s => s.category))];
---
<BaseLayout title="Compare Subscription Cancellation Routes | CancelKits" description="Compare cancellation routes for 72 subscriptions. Find official instructions, billing-provider checks, support options and refund guidance." canonicalPath="/cancel-difficulty/">
  <Nav />
  <main class="directory">
    <p><a href="/cancel/">Cancellation guides</a> / Compare routes</p>
    <h1>Compare subscription cancellation routes</h1>
    <p class="intro">A cancellation can be straightforward in one account and require support in another. The company billing you, your plan, country and contract matter more than the app installed on your phone.</p>
    <section aria-labelledby="methodology"><h2 id="methodology">How to use this comparison</h2><p>This is a navigation aid compiled from provider help documents, not a timed test or community rating. We do not publish numerical difficulty scores or invented customer reviews. Each guide distinguishes direct billing from Apple and Google Play purchases and identifies any missing source verification.</p><ol><li>Check your receipt to identify the biller and paying account.</li><li>Open the relevant guide and choose Web, iPhone or Android according to that biller.</li><li>Review notice requirements, committed payments and refund conditions before confirming.</li><li>Save the provider’s end-date confirmation and check the next statement.</li></ol></section>
    <section><h2>What can make cancellation take longer?</h2><ul><li><strong>Billing partners:</strong> the app provider may be unable to cancel a carrier, store or bundle purchase.</li><li><strong>Account ownership:</strong> team subscriptions may require an administrator; family plans may require the paying organizer.</li><li><strong>Contract terms:</strong> annual commitments, club notice periods and processed meal orders may leave payments due.</li><li><strong>Missing controls:</strong> use the official help channel if you cannot locate the cancellation option. Do not substitute a guessed email address.</li></ul><p>Turning off renewal is separate from closing an account or requesting a refund. A bank-card block does not itself discharge a contract.</p></section>
    {categories.map(category => <section><h2>{category}</h2><ul>{services.filter(s => s.category === category).map(service => { const guide = getGuideDetails(service); return <li><a href={`/cancel/${service.slug}/`}>{service.name}: cancellation instructions</a><span>{guide.needsReview ? 'Provider details need verification; official support route included.' : guide.storeBilling === false ? 'Direct-billing or membership-agreement route; check plan terms.' : 'Identify direct, app-store or partner billing first.'}</span></li>; })}</ul></section>)}
    <section><h2>Apple and Google Play shortcuts</h2><p>For an Apple-billed purchase, open Settings → your name → Subscriptions. For a Google Play purchase, open Play Store → profile → Payments & subscriptions → Subscriptions. These menus do not cancel subscriptions paid directly to another company.</p><p><a href="https://support.apple.com/en-us/118428">Apple cancellation instructions</a> · <a href="https://support.google.com/googleplay/answer/7018481?hl=en">Google Play cancellation instructions</a></p></section>
  </main>
  <Footer />
</BaseLayout>
<style>.directory{max-width:900px;margin:auto;padding:110px 24px 70px;line-height:1.8}.directory h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.2;margin:20px 0}.intro{font-size:1.2rem}.directory section{padding:28px 0;border-top:1px solid #ffffff22}.directory h2{font-size:1.6rem;margin-bottom:18px}.directory ul,.directory ol{padding-left:24px}.directory li{margin:14px 0}.directory span{display:block;color:#a6aec0;font-size:.9rem}.directory a{color:#b9acff;text-decoration:underline;text-underline-offset:3px}</style>

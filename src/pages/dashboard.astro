---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanBadge from '../components/PlanBadge.astro';
import SavingsCounter from '../components/SavingsCounter.astro';
import EmptySubscriptions from '../components/EmptySubscriptions.astro';
import ScanFailed from '../components/ScanFailed.astro';
import NothingCancelled from '../components/NothingCancelled.astro';
import AllCancelled from '../components/AllCancelled.astro';
import LoadingCard from '../components/LoadingCard.astro';

const title = 'Dashboard — CancelKits';
const description = 'See every subscription draining your account and cancel what you do not need.';
---

<BaseLayout {title} {description} noIndex>
	<!-- High-speed layout stabilizer: prevents skeleton flash, empty connect flash, or gate flicker -->
	<script is:inline>
		(function () {
			try {
				var params = new URLSearchParams(window.location.search);
				var hasPaymentReturn = params.get('payment') === 'success' || params.get('upgraded') === 'true';
				var urlPlan = params.get('plan');
				var pendingPlan = localStorage.getItem('cancelkit-pending-checkout-plan');
				var targetPlan = (urlPlan === 'pro' || urlPlan === 'family') ? urlPlan : ((pendingPlan === 'pro' || pendingPlan === 'family') ? pendingPlan : null);

				if (hasPaymentReturn) {
					localStorage.setItem('cancelkit-dashboard-connected', '1');
					if (targetPlan) {
						sessionStorage.setItem('cancelkit-optimistic-plan', targetPlan);
					}
				}

				var connVal = localStorage.getItem('cancelkit-dashboard-connected');
				var isConnected = hasPaymentReturn || params.get('connected') === '1' || params.get('empty') === '1' || connVal === '1' || connVal === 'true';

				if (isConnected) {
					document.documentElement.classList.add('dash-fast-ready');
				}

				var activePlan = targetPlan || sessionStorage.getItem('cancelkit-optimistic-plan');
				if (!activePlan) {
					try {
						var authRaw = localStorage.getItem('cancelkit-auth-token');
						if (authRaw) {
							var auth = JSON.parse(authRaw);
							var uid = auth && auth.user ? auth.user.id : null;
							if (uid) {
								var cached = localStorage.getItem('cancelkit-user-plan_' + uid);
								if (cached === 'pro' || cached === 'family') activePlan = cached;
							}
						}
					} catch (e) {}
				}

				if (activePlan === 'pro' || activePlan === 'family') {
					document.documentElement.classList.add('dash-plan-unlocked');
					if (activePlan === 'family') {
						document.documentElement.classList.add('dash-plan-family');
					}
				}
			} catch (err) {}
		})();
	</script>

	<div class="dash" data-dashboard data-connected="false" data-loading="true">
		<!-- LOADING SKELETON -->
		<section class="dash__loading" data-loading-state aria-busy="true">
			<a class="dash__wordmark" href="/">Cancel<span>K<span class="dash__wordmark-i">i</span>ts</span></a>
			<LoadingCard rows={6} />
		</section>

		<!-- CONNECT EMPTY STATE -->
		<section class="dash__empty" data-empty-state hidden aria-labelledby="empty-title">
			<div class="dash__empty-inner">
				<a class="dash__wordmark" href="/">Cancel<span>K<span class="dash__wordmark-i">i</span>ts</span></a>
				<h1 id="empty-title">Connect your email to see what's draining you</h1>
				<p class="dash__empty-copy">We’ll scan receipts for recurring charges. Nothing is cancelled until you say so.</p>
				<div class="dash__empty-actions">
					<button type="button" class="dash__btn dash__btn--primary" data-connect="gmail">Connect Gmail</button>
					<button type="button" class="dash__btn dash__btn--ghost" data-connect="outlook">Connect Outlook</button>
				</div>
				<p class="dash__privacy">Read-only access. We never send email or store your password.</p>
			</div>
		</section>

		<!-- APP SHELL -->
		<div class="dash__shell" data-app-shell hidden>
			<aside class="dash__sidebar" aria-label="Dashboard navigation">
				<a class="dash__wordmark dash__wordmark--side" href="/">Cancel<span>K<span class="dash__wordmark-i">i</span>ts</span></a>
				<nav class="dash__nav">
					<a class="is-active" href="/dashboard" data-nav="dashboard">Dashboard</a>
					<a href="#subscriptions" data-nav="subscriptions">Subscriptions</a>
					<a href="#savings" data-nav="savings">Savings</a>
					<a href="#history" data-nav="history">Cancel History</a>
					<a href="/account" data-nav="settings">Account</a>
				</nav>
				<div class="dash__connected">
					<span class="dash__status-dot" aria-hidden="true"></span>
					<span data-connected-label>Connected: Gmail</span>
				</div>
				<div class="dash__user-email-row" style="margin: -0.25rem 0 0.5rem; font-size: 0.75rem; color: #777; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
					<span id="dash-user-email"></span>
				</div>
				<div class="dash__plan-row">
					<span class="dash__plan-label">Plan</span>
					<div id="dash-plan-badge-wrap">
						<PlanBadge plan="free" />
					</div>
				</div>

				<!-- PRIORITY CANCEL SUPPORT (UNLOCKED ON PRO / FAMILY) -->
				<div class="dash__vip-support" id="dash-vip-support-row" style="margin: 0.75rem 0 0.5rem; padding: 0.65rem; background: rgba(0, 255, 136, 0.05); border: 1px solid rgba(0, 255, 136, 0.2); border-radius: 8px;" hidden>
					<div style="font-size: 0.75rem; font-weight: 600; color: #00ff88; margin-bottom: 0.15rem; display: flex; align-items: center; gap: 0.35rem;">
						<span>⚡</span> Priority Concierge
					</div>
					<p style="margin: 0 0 0.35rem; font-size: 0.7rem; color: #aaa; line-height: 1.3;">1-on-1 agent cancellation assistance included in your plan.</p>
					<a href="mailto:support@cancelkits.com?subject=Priority%20Cancel%20Request" style="display: inline-block; font-size: 0.72rem; color: #00ff88; text-decoration: underline; font-weight: 500;">Email Concierge →</a>
				</div>

				<button type="button" class="dash__signout" id="dash-signout-btn">Sign out</button>
			</aside>

			<section class="dash__main" id="subscriptions" aria-labelledby="subs-heading">
				<!-- UPGRADE SUCCESS BANNER -->
				<div class="dash__upgrade-banner" id="dash-upgrade-banner" hidden>
					<div class="dash__upgrade-text">
						<span class="dash__upgrade-icon">🎉</span>
						<div>
							<strong>Welcome to CancelKits Pro!</strong>
							<p>All 14 subscriptions unlocked. Cancellation guides and renewal radar available.</p>
						</div>
					</div>
					<button type="button" class="dash__upgrade-close" id="dash-upgrade-close" aria-label="Close">✕</button>
				</div>
				<header class="dash__main-header">
					<div class="dash__main-title-row">
						<div class="dash__title-block">
							<h1 id="subs-heading">Your subscriptions</h1>
							<SavingsCounter variant="dashboard" class="dash__savings-counter" />
						</div>
						<div class="dash__title-actions">
							<button type="button" class="dash__btn-sm dash__btn--accent" data-add-sub>+ Add Subscription</button>
							<button type="button" class="dash__btn-sm dash__btn--ghost" data-reset-subs title="Clear demo items and start with 0">Reset to $0</button>
						</div>
					</div>

					<!-- SHARED FAMILY HOUSEHOLD TOGGLE (ACTIVE ON FAMILY PLAN) -->
					<div class="dash__family-toggle-row" id="dash-family-toggle-row" style="margin: 0.75rem 0; display: flex; align-items: center; justify-content: space-between; background: rgba(168, 85, 247, 0.08); border: 1px solid rgba(168, 85, 247, 0.25); border-radius: 8px; padding: 0.5rem 0.85rem;" hidden>
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<span style="font-size: 1rem;">👨‍👩‍👧‍👦</span>
							<span style="font-size: 0.85rem; font-weight: 600; color: #c084fc;">Shared Family Plan:</span>
						</div>
						<div style="display: flex; gap: 0.35rem;">
							<button type="button" id="tab-scope-personal" class="is-active" style="background: rgba(255,255,255,0.12); border: 0; color: #fff; padding: 0.35rem 0.75rem; border-radius: 4px; font-size: 0.8rem; cursor: pointer; font-weight: 500;">My Subscriptions</button>
							<button type="button" id="tab-scope-household" style="background: transparent; border: 0; color: #aaa; padding: 0.35rem 0.75rem; border-radius: 4px; font-size: 0.8rem; cursor: pointer;">Household Pool (Shared)</button>
						</div>
					</div>

					<div class="dash__controls-row">
						<div class="dash__filters" role="tablist" aria-label="Filter subscriptions">
							<button type="button" class="is-active" role="tab" aria-selected="true" data-filter="all">All</button>
							<button type="button" role="tab" aria-selected="false" data-filter="active">Active</button>
							<button type="button" role="tab" aria-selected="false" data-filter="cancelled">Cancelled</button>
							<button type="button" role="tab" aria-selected="false" data-filter="trial">Trial</button>
						</div>
						<div class="dash__sort" aria-label="Sort subscriptions">
							<span class="dash__sort-label">Sort</span>
							<button type="button" class="is-active" data-sort="amount">By amount</button>
							<button type="button" data-sort="renewal">By renewal</button>
							<button type="button" data-sort="category">By category</button>
						</div>
					</div>
				</header>

				<div class="dash__table-wrap">
					<div data-list-loading hidden>
						<LoadingCard rows={5} />
					</div>

					<ScanFailed />
					<EmptySubscriptions />
					<AllCancelled />

					<table class="dash__table" data-subs-table>
						<thead>
							<tr>
								<th scope="col">Service</th>
								<th scope="col">Amount</th>
								<th scope="col">Next billing</th>
								<th scope="col"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody data-sub-list></tbody>
					</table>
					<div class="dash__table-empty" data-table-empty hidden>
						<p class="dash__empty-title">Nothing in this filter</p>
						<p class="dash__empty-desc">Try another filter, or add a subscription manually.</p>
						<button type="button" class="dash__btn-sm dash__btn--accent" data-add-manual>+ Add subscription</button>
					</div>

					<!-- PRO PLAN DASHBOARD GATE OVERLAY -->
					<div class="dash__gate-wrap" id="dash-gate-wrap" hidden>
						<div class="dash__gate-blur" aria-hidden="true" id="dash-gate-blur">
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">P</span><div><div class="dash__svc-name">Paramount+</div><span class="dash__tag">Streaming</span></div></div>
								<div class="dash__amount">$11.99</div>
								<div class="dash__date">Oct 02</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">D</span><div><div class="dash__svc-name">Disney+</div><span class="dash__tag">Streaming</span></div></div>
								<div class="dash__amount">$15.99</div>
								<div class="dash__date">Oct 08</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">S</span><div><div class="dash__svc-name">Sam's Club Plus</div><span class="dash__tag">Shopping</span></div></div>
								<div class="dash__amount">$9.17</div>
								<div class="dash__date">Oct 14</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">N</span><div><div class="dash__svc-name">NordVPN</div><span class="dash__tag">VPN & Security</span></div></div>
								<div class="dash__amount">$12.99</div>
								<div class="dash__date">Oct 20</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
						</div>
						<div class="dash__gate-overlay">
							<div class="dash__gate-icon">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
									<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
									<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
								</svg>
							</div>
							<h3 class="dash__gate-title" id="dash-gate-title">
								Upgrade to Pro to see all 14 subscriptions
							</h3>
							<p class="dash__gate-desc" id="dash-gate-desc">
								Free plan only displays your top 5 subscriptions. Unlock all subscriptions, cancellation guides, and renewal radar alerts.
							</p>
							<button type="button" class="dash__gate-upgrade-btn" id="dash-upgrade-btn">
								<span class="btn-text">Upgrade to Pro ($9/mo) →</span>
								<span class="btn-spinner" hidden></span>
							</button>
						</div>
					</div>
				</div>
			</section>

			<aside class="dash__panel" id="savings" aria-labelledby="burn-heading">
				<div class="dash__stat">
					<p class="dash__stat-label" id="burn-heading">Monthly burn</p>
					<p class="dash__stat-value dash__stat-value--danger" data-burn-before>$0/mo</p>
					<p class="dash__stat-meta">Before CancelKits</p>
				</div>

				<div class="dash__arrow" aria-hidden="true">↓</div>

				<div class="dash__stat">
					<p class="dash__stat-label">After cancellations</p>
					<p class="dash__stat-value dash__stat-value--accent" data-burn-after>$0/mo</p>
					<p class="dash__stat-meta" data-saved-monthly>You saved $0/mo</p>
				</div>

				<p class="dash__yearly" data-saved-yearly>Yearly saving: $0</p>

				<a class="dash__btn dash__btn--primary dash__btn--block" href="/cancel">Cancel more →</a>

				<section class="dash__history" id="history" aria-labelledby="history-heading">
					<h2 id="history-heading">Cancel History</h2>
					<NothingCancelled />
					<ul data-history-list></ul>
				</section>
			</aside>
		</div>

		<!-- ADD SUBSCRIPTION MODAL -->
		<dialog class="dash__modal" id="add-sub-modal" aria-labelledby="modal-title">
			<form class="dash__modal-box" method="dialog" id="add-sub-form">
				<div class="dash__modal-header">
					<h2 id="modal-title">Add Real Subscription</h2>
					<button type="button" class="dash__modal-close" id="modal-close-btn" aria-label="Close modal">✕</button>
				</div>
				<div class="dash__modal-fields">
					<label class="dash__field">
						<span>Service Name</span>
						<input type="text" name="name" placeholder="e.g. Netflix, Spotify, Gym, ChatGPT" required />
					</label>
					<label class="dash__field">
						<span>Monthly Cost ($ USD)</span>
						<input type="number" step="0.01" min="0.01" name="monthly" placeholder="15.49" required />
					</label>
					<label class="dash__field">
						<span>Category</span>
						<select name="category">
							<option value="streaming">Streaming</option>
							<option value="software">Software & AI</option>
							<option value="fitness">Fitness & Gym</option>
							<option value="news">News & Learning</option>
						</select>
					</label>
					<label class="dash__field">
						<span>Next Renewal Date</span>
						<input type="date" name="nextBilling" required />
					</label>
				</div>
				<div class="dash__modal-actions">
					<button type="button" class="dash__btn dash__btn--ghost" id="modal-cancel-btn">Cancel</button>
					<button type="submit" class="dash__btn dash__btn--primary">Save Subscription</button>
				</div>
			</form>
		</dialog>

		<!-- VIRAL REFERRAL TRIGGER MODAL (OPENS RIGHT AFTER CANCELLATION) -->
		<div class="viral-modal-backdrop" id="viral-referral-modal" hidden role="dialog" aria-modal="true" aria-labelledby="viral-modal-title">
			<div class="viral-modal-card">
				<button type="button" class="viral-modal-close" id="viral-modal-close-btn" aria-label="Close modal">✕</button>

				<div class="viral-modal-celebrate">🎉</div>
				<h2 id="viral-modal-title" class="viral-modal-title">
					You just saved <span id="viral-saved-amount" class="text-accent">$15.49</span>/month!
				</h2>
				<p class="viral-modal-sub">
					Know someone paying for subscriptions they forgot about?<br/>
					<strong>Share CancelKits → you both get a free month.</strong>
				</p>

				<div class="viral-referral-box">
					<span class="viral-box-label">Your personal invite link</span>
					<div class="viral-link-row">
						<input type="text" id="viral-ref-link-input" readonly value="https://cancelkits.com/r/kit-me" />
						<button type="button" class="viral-copy-btn" id="viral-copy-btn">Copy</button>
					</div>
				</div>

				<div class="viral-actions">
					<a id="viral-twitter-btn" href="https://twitter.com/intent/tweet?text=I%20just%20saved%20money%20cancelling%20unwanted%20subscriptions%20with%20CancelKits!%20https://cancelkits.com" target="_blank" rel="noopener noreferrer" class="viral-share-btn viral-share-btn--x">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
						<span>Tweet savings</span>
					</a>

					<a id="viral-whatsapp-btn" href="https://api.whatsapp.com/send?text=I%20just%20saved%20money%20cancelling%20unwanted%20subscriptions%20with%20CancelKits!%20https://cancelkits.com" target="_blank" rel="noopener noreferrer" class="viral-share-btn viral-share-btn--wa">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24"/>
						</svg>
						<span>WhatsApp</span>
					</a>

					<a href="/refer/" class="viral-share-btn viral-share-btn--more">
						<span>View details →</span>
					</a>
				</div>
			</div>
		</div>

		<p class="dash__cancellation-notice" role="note">
			Cancellation guides explain the steps to take with your provider. Opening a guide does not cancel a subscription or block payments.
			If you previously used automated cancellation, verify your status with the provider.
		</p>
	</div>
</BaseLayout>

<script>
	import { supabase, setAuthCookies, clearAuthCookies } from '../lib/supabase';
	import { resolveServiceSlug } from '../data/services';

	const USER_PLAN_KEY = 'cancelkit-user-plan';
	const STORAGE_KEY = 'cancelkit-dashboard-connected';
	const PROVIDER_KEY = 'cancelkit-dashboard-provider';
	const SUBS_KEY = 'cancelkit-dashboard-subs';

	const dashUrlParams = new URLSearchParams(window.location.search);
	const isPaymentReturn = dashUrlParams.get('payment') === 'success' || dashUrlParams.get('upgraded') === 'true';
	const urlPlanParam = dashUrlParams.get('plan') as 'pro' | 'family' | null;
	const pendingPlan = localStorage.getItem('cancelkit-pending-checkout-plan') as 'pro' | 'family' | null;

	// Determine initial plan optimistically from frame 1: zero buffering, zero gate flicker
	let userPlan: 'free' | 'pro' | 'family' = 'free';

	if (isPaymentReturn) {
		userPlan = (urlPlanParam === 'pro' || urlPlanParam === 'family') ? urlPlanParam : (pendingPlan || 'pro');
		localStorage.setItem(STORAGE_KEY, '1');
		sessionStorage.setItem('cancelkit-optimistic-plan', userPlan);
		localStorage.removeItem('cancelkit-pending-checkout-plan');
	} else {
		const optimistic = sessionStorage.getItem('cancelkit-optimistic-plan') as 'free' | 'pro' | 'family' | null;
		if (optimistic === 'pro' || optimistic === 'family') {
			userPlan = optimistic;
		} else {
			try {
				const authRaw = localStorage.getItem('cancelkit-auth-token');
				if (authRaw) {
					const auth = JSON.parse(authRaw);
					const uid = auth?.user?.id;
					if (uid) {
						const cached = localStorage.getItem(`${USER_PLAN_KEY}_${uid}`) as 'free' | 'pro' | 'family' | null;
						if (cached === 'pro' || cached === 'family') userPlan = cached;
					}
				}
			} catch {}
		}
	}

	function updatePlanBadgeUi() {
		const planBadgeWrap = document.getElementById('dash-plan-badge-wrap');
		if (planBadgeWrap) {
			const badge = planBadgeWrap.querySelector('.plan-badge') as HTMLElement;
			if (badge) {
				badge.className = `plan-badge plan-badge--${userPlan}`;
				badge.textContent = userPlan === 'pro' ? 'Pro ✓' : userPlan === 'family' ? 'Family' : 'Free plan';
			}
		}
	}

	function updateUpgradeBannerUi() {
		const upgradeBanner = document.getElementById('dash-upgrade-banner');
		if (upgradeBanner) {
			if (isPaymentReturn || userPlan !== 'free') {
				const strong = upgradeBanner.querySelector('strong');
				if (strong) strong.textContent = userPlan === 'family' ? 'Welcome to CancelKits Family!' : 'Welcome to CancelKits Pro!';
				const desc = upgradeBanner.querySelector('p');
				if (desc) desc.textContent = userPlan === 'family'
					? 'All subscriptions unlocked, family household sharing active (up to 5 members).'
					: 'All subscriptions unlocked. Cancellation guides and renewal radar available.';
				upgradeBanner.hidden = !isPaymentReturn;
			}
		}
	}

	// Apply immediate UI state
	updatePlanBadgeUi();
	updateUpgradeBannerUi();

	// Client-side authentication guard with silent gateway synchronization
	async function checkAuth() {
		try {
			const { data: { session }, error } = await supabase.auth.getSession();
			if (error || !session) {
				window.location.href = '/signin';
				return;
			}
			setAuthCookies(session.access_token, session.refresh_token, session.expires_in);

			// Display authenticated user email in sidebar
			const dashEmailEl = document.getElementById('dash-user-email');
			if (dashEmailEl && session.user.email) {
				dashEmailEl.textContent = session.user.email;
				dashEmailEl.title = `Signed in as ${session.user.email}`;
			}

			// Remove legacy unscoped key so it never leaks across accounts
			localStorage.removeItem(USER_PLAN_KEY);

			const userScopedKey = `${USER_PLAN_KEY}_${session.user.id}`;
			
			// Optimistically pin current active plan to user-scoped storage
			if (userPlan !== 'free') {
				localStorage.setItem(userScopedKey, userPlan);
			}

			// Synchronize live plan from Supabase and direct Lemon Squeezy Gateway quietly in the background
			try {
				let verifiedPlan: 'free' | 'pro' | 'family' = userPlan;

				// 1. Check Supabase users table (if configured)
				try {
					const { data: profile } = await supabase
						.from('users')
						.select('plan, subscription_status')
						.eq('id', session.user.id)
						.maybeSingle();

					if (profile?.plan === 'pro' || profile?.plan === 'family') {
						verifiedPlan = profile.plan;
					}
				} catch {}

				// 2. Synchronous Payment Gateway Verification:
				// If verifiedPlan is 'free' OR user just completed payment (url contains upgraded=true or payment=success),
				// call /api/subscription/sync to query Lemon Squeezy live API directly.
				if (verifiedPlan === 'free' || isPaymentReturn) {
					try {
						const syncRes = await fetch('/api/subscription/sync', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								userId: session.user.id,
								email: session.user.email,
							}),
						});
						if (syncRes.ok) {
							const syncData = await syncRes.json();
							if (syncData?.active && (syncData.plan === 'pro' || syncData.plan === 'family')) {
								verifiedPlan = syncData.plan;
							}
						}
					} catch (syncErr) {
						console.warn('[Dashboard] Gateway sync check error:', syncErr);
					}
				}

				// 3. If still not directly paid, check if this user is an active member of a Family household
				if (verifiedPlan === 'free') {
					try {
						const fRes = await fetch(`/api/family?userId=${session.user.id}&email=${encodeURIComponent(session.user.email || '')}`);
						const fData = await fRes.json();
						if (fData?.isMember || fData?.isOwner) {
							verifiedPlan = 'family';
						}
					} catch {}
				}

				// Update user-scoped cache
				localStorage.setItem(userScopedKey, verifiedPlan);
				if (verifiedPlan === 'pro' || verifiedPlan === 'family') {
					sessionStorage.setItem('cancelkit-optimistic-plan', verifiedPlan);
				} else {
					sessionStorage.removeItem('cancelkit-optimistic-plan');
				}

				// Only re-render if the verified plan actually differs from our optimistic state
				if (verifiedPlan !== userPlan) {
					userPlan = verifiedPlan;
					updatePlanBadgeUi();
					updateUpgradeBannerUi();
					const familyToggle = document.getElementById('dash-family-toggle-row');
					if (familyToggle) familyToggle.hidden = userPlan !== 'family';
					render();
				}

				// Clean up query parameters smoothly without reloading
				if (isPaymentReturn) {
					setTimeout(() => {
						window.history.replaceState({}, document.title, window.location.pathname);
					}, 1200);
				}
			} catch (dbErr) {
				console.warn('[Dashboard] Live plan check exception:', dbErr);
			}
		} catch {
			window.location.href = '/signin';
		}
	}
	checkAuth();

	// Signout handler
	document.getElementById('dash-signout-btn')?.addEventListener('click', async () => {
		try {
			const { data: { session } } = await supabase.auth.getSession();
			if (session?.user?.id) {
				localStorage.removeItem(`${USER_PLAN_KEY}_${session.user.id}`);
			}
			localStorage.removeItem(USER_PLAN_KEY);
			localStorage.removeItem('cancelkit-scan-subs');
			localStorage.removeItem('cancelkit-dashboard-connected');
			localStorage.removeItem('cancelkit-dashboard-provider');
			localStorage.removeItem('cancelkit-provider-token');
			await supabase.auth.signOut();
			clearAuthCookies();
			window.location.href = '/signin';
		} catch {
			clearAuthCookies();
			window.location.href = '/signin';
		}
	});


---
import type { Translation } from '../i18n/translations';

const popularGuides = [
	{ name: 'Netflix', slug: 'netflix' },
	{ name: 'Spotify', slug: 'spotify' },
	{ name: 'Adobe', slug: 'adobe' },
	{ name: 'Planet Fitness', slug: 'planet-fitness' },
	{ name: 'Disney+', slug: 'disney-plus' },
	{ name: 'Prime', slug: 'amazon-prime' },
	{ name: 'ChatGPT', slug: 'chatgpt-plus' },
	{ name: 'Hulu', slug: 'hulu' },
];

const subscriptions = [
	{ name: 'Netflix', slug: 'netflix' },
	{ name: 'Spotify', slug: 'spotify' },
	{ name: 'Adobe', slug: 'adobe' },
	{ name: 'Hulu', slug: 'hulu' },
	{ name: 'Disney+', slug: 'disney-plus' },
	{ name: 'Planet Fitness', slug: 'planet-fitness' },
	{ name: 'NYT', slug: 'nyt' },
	{ name: 'Audible', slug: 'audible' },
	{ name: 'Canva', slug: 'canva-pro' },
	{ name: 'NordVPN', slug: 'nordvpn' },
];
interface Props { t?: Translation; }
const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__glow" aria-hidden="true"></div>

	<div class="hero__content">
		<div class="hero__intro fade-in-up">
			<p class="hero__eyebrow"><span class="hero__dot"></span> {t?.hero_eyebrow ?? 'CANCEL SUBSCRIPTIONS · STOP RECURRING CHARGES'}</p>
			<h1 id="hero-title" class="hero__title">
				<span>{t?.hero_headline_1 ?? 'Cancel any subscription instantly'}</span>
				<span class="hero__title-accent">{t?.hero_headline_2 ?? "find what's draining you"}</span>
			</h1>
			<p class="hero__description">
				{t?.hero_sub ?? 'The average American wastes $219/month on forgotten subscriptions. CancelKits finds them. CancelKits helps you cancel them.'}
			</p>
		</div>

		<form class="hero__form fade-in-up stagger-1" action="/onboarding/connect" method="get" id="hero-scan-form">
			<div class="hero__field-row">
				<input
					class="hero__input"
					type="email"
					name="email"
					id="hero-email-input"
					autocomplete="email"
					aria-label="Email address"
					placeholder={t?.email_placeholder ?? 'you@example.com'}
					required
				/>
				<button class="hero__button" type="submit">{t?.cta_button ?? 'Find my subscriptions →'}</button>
			</div>
			<p class="hero__reassurance">{t?.reassurance ?? 'No credit card required · Free subscription audit in 30 seconds'}</p>

			<div class="hero__zero-permission">
				<span class="zero-badge">ZERO-PERMISSION</span>
				<span>Don't want to connect your inbox?</span>
				<a href="/statement-scanner/" class="hero__zero-link">Drop your bank statement PDF (100% in-browser, no upload) →</a>
			</div>
		</form>

		<!-- Direct Cancel Guides Quick Access Strip -->
		<div class="hero__guides-strip fade-in-up stagger-2" role="region" aria-label="Direct cancel guides">
			<div class="hero__guides-bar">
				<div class="hero__guides-lead">
					<span class="hero__guides-badge">FREE PLAYBOOKS</span>
					<span class="hero__guides-text">Cancel a specific subscription directly:</span>
				</div>
				<a href="/cancel/" class="hero__guides-cta">
					<span>Browse all 50+ guides</span>
					<span class="hero__guides-arrow" aria-hidden="true">→</span>
				</a>
			</div>

			<div class="hero__chips-wrap" aria-label="Popular cancellation guides">
				<div class="hero__chips-list">
					{popularGuides.map((item) => (
						<a href={`/cancel/${item.slug}/`} class="hero__chip">
							{item.name}
						</a>
					))}
					<a href="/cancel/" class="hero__chip hero__chip--all">
						<span>All 50+</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>

		<div class="hero__proof fade-in-up stagger-3" aria-label="CancelKits product highlights">
			<div class="hero__stat-row hero__stat-row--solo">
				<div class="hero__stat">
					<strong>$219/mo</strong>
					<span>{t?.hero_stat_wasted ?? 'avg. wasted on forgotten subscriptions'}</span>
				</div>
				<div class="hero__divider" aria-hidden="true"></div>
				<a href="/cancel/" class="hero__stat hero__stat--link" aria-label="Browse 50+ verified cancel guides">
					<div class="hero__stat-val">
						<strong>50+</strong>
						<span class="hero__stat-arrow" aria-hidden="true">→</span>
					</div>
					<span>{t?.hero_stat_guides ?? 'verified cancel guides'}</span>
				</a>
				<div class="hero__divider" aria-hidden="true"></div>
				<div class="hero__stat">
					<strong>30 sec</strong>
					<span>{t?.hero_stat_scan ?? 'free subscription scan'}</span>
				</div>
			</div>
		</div>
	</div>

	<div class="hero__ticker fade-in-up stagger-3" aria-label="Services cancelled with CancelKits">
		<div class="hero__ticker-track">
			<div class="hero__ticker-group">
				{subscriptions.map((s) => (
					<a href={`/cancel/${s.slug}/`} class="hero__ticker-pill" title={`How to cancel ${s.name}`}>
						{s.name}
					</a>
				))}
			</div>
			<div class="hero__ticker-group" aria-hidden="true">
				{subscriptions.map((s) => (
					<a href={`/cancel/${s.slug}/`} class="hero__ticker-pill" tabindex="-1">
						{s.name}
					</a>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 90svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		background: #050505;
		width: 100%;
	}

	.hero__glow {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: min(120%, 900px);
		height: 70%;
		background:
			radial-gradient(ellipse 50% 60% at 50% 40%, rgba(0, 255, 136, 0.07) 0%, transparent 70%),
			radial-gradient(ellipse 35% 40% at 45% 50%, rgba(0, 200, 100, 0.04) 0%, transparent 60%);
		pointer-events: none;
		z-index: 0;
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: min(100% - 2rem, 52rem);
		margin: 0 auto;
		padding: 5rem 0 2.5rem;
		text-align: center;
	}

	.hero__eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 0 1.25rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		flex-wrap: wrap;
	}

	.hero__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 8px rgba(0, 255, 136, 0.4);
		flex-shrink: 0;
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 7.5vw, 4.4rem);
		font-weight: 600;
		letter-spacing: -0.05em;
		line-height: 1.05;
		color: #fff;
		word-break: break-word;
	}

	.hero__title span {
		display: block;
	}

	.hero__title-accent {
		color: var(--color-accent);
		text-shadow: 0 0 40px rgba(0, 255, 136, 0.15);
	}

	.hero__description {
		margin: 1.25rem auto 0;
		max-width: 34rem;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-muted);
		padding: 0 0.5rem;
	}

	.hero__form {
		max-width: 32rem;
		margin: 2rem auto 0;
		width: 100%;
	}

	.hero__field-row {
		display: flex;
		gap: 0.5rem;
		width: 100%;
	}

	.hero__input {
		min-width: 0;
		flex: 1;
		padding: 0.85rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-input);
		background: var(--color-surface);
		color: #fff;
		font: inherit;
		font-size: 0.95rem;
		transition: border-color 0.2s;
		height: 48px;
	}

	.hero__input::placeholder {
		color: var(--color-faint);
	}

	.hero__input:focus {
		outline: none;
		border-color: rgba(0, 255, 136, 0.4);
	}

	.hero__button {
		flex: none;
		border: 0;
		border-radius: var(--radius-pill);
		padding: 0.85rem 1.4rem;
		background: var(--color-accent);
		color: #000;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 700;
		cursor: pointer;
		transition: transform 0.2s, box-shadow 0.2s;
		white-space: nowrap;
		height: 48px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.hero__button:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(0, 255, 136, 0.2);
	}

	.hero__reassurance {
		margin: 0.75rem 0 0;
		color: var(--color-faint);
		font-size: 0.78rem;
	}

	.hero__zero-permission {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.45rem 0.65rem;
		margin-top: 1rem;
		padding: 0.45rem 0.95rem;
		border-radius: var(--radius-pill);
		background: rgba(0, 255, 136, 0.04);
		border: 1px solid rgba(0, 255, 136, 0.2);
		font-size: 0.76rem;
		color: #a3a3a3;
	}

	.zero-badge {
		font-size: 0.65rem;
		font-weight: 700;
		color: #00ff88;
		background: rgba(0, 255, 136, 0.12);
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
		letter-spacing: 0.04em;
	}

	.hero__zero-link {
		color: #00ff88;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.15s, text-decoration 0.15s;
	}

	.hero__zero-link:hover {
		color: #ffffff;
		text-decoration: underline;
	}

	/* Direct Cancel Guides Quick Access Strip */
	.hero__guides-strip {
		margin: 1.5rem auto 0;
		width: min(100%, 38rem);
		padding: 0.85rem 1rem;
		border-radius: var(--radius-card);
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.07);
		backdrop-filter: blur(12px);
		text-align: left;
		transition: border-color 0.2s, background 0.2s;
	}

	.hero__guides-strip:hover {
		border-color: rgba(0, 255, 136, 0.22);
		background: rgba(0, 255, 136, 0.02);
	}

	.hero__guides-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.65rem;
	}

	.hero__guides-lead {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.hero__guides-badge {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		background: rgba(0, 255, 136, 0.12);
		border: 1px solid rgba(0, 255, 136, 0.25);
		padding: 0.1rem 0.4rem;
		border-radius: var(--radius-pill);
		text-transform: uppercase;
		line-height: 1.2;
	}

	.hero__guides-text {
		font-size: 0.82rem;
		color: #e5e5e5;
		font-weight: 500;
	}

	.hero__guides-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
		transition: transform 0.2s, opacity 0.2s;
		white-space: nowrap;
	}

	.hero__guides-cta:hover {
		opacity: 0.9;
		transform: translateX(2px);
	}

	.hero__guides-arrow {
		font-size: 0.95rem;
		line-height: 1;
		transition: transform 0.2s;
	}

	.hero__guides-cta:hover .hero__guides-arrow {
		transform: translateX(2px);
	}

	.hero__chips-wrap {
		width: 100%;
	}

	.hero__chips-list {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.hero__chip {
		display: inline-flex;
		align-items: center;
		padding: 0.32rem 0.68rem;
		border-radius: var(--radius-pill);
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.78rem;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.hero__chip:hover {
		color: #fff;
		border-color: rgba(0, 255, 136, 0.35);
		background: rgba(0, 255, 136, 0.08);
		transform: translateY(-1px);
	}

	.hero__chip--all {
		color: var(--color-accent);
		border-color: rgba(0, 255, 136, 0.25);
		background: rgba(0, 255, 136, 0.06);
		font-weight: 600;
		gap: 0.2rem;
	}

	.hero__chip--all:hover {
		background: rgba(0, 255, 136, 0.16);
		border-color: var(--color-accent);
		color: #fff;
	}

	.hero__proof {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		margin: 2.25rem auto 0;
		max-width: 100%;
		width: fit-content;
	}

	.hero__counter {
		display: flex;
		justify-content: center;
	}

	.hero__stat-row {
		display: flex;
		justify-content: center;
		align-items: stretch;
		flex-wrap: wrap;
		gap: 0;
		padding: 0.85rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
	}

	.hero__stat-row--solo {
		width: min(100%, 42rem);
	}

	.hero__stat {
		padding: 0 1rem;
		text-align: center;
		white-space: nowrap;
	}

	.hero__stat--link {
		text-decoration: none;
		cursor: pointer;
		transition: background 0.2s, transform 0.2s;
		border-radius: var(--radius-sm);
	}

	.hero__stat--link:hover {
		background: rgba(0, 255, 136, 0.04);
		transform: translateY(-1px);
	}

	.hero__stat--link:hover strong {
		color: var(--color-accent);
	}

	.hero__stat-val {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
	}

	.hero__stat-arrow {
		color: var(--color-accent);
		font-size: 0.85rem;
		transition: transform 0.2s;
	}

	.hero__stat--link:hover .hero__stat-arrow {
		transform: translateX(2px);
	}

	.hero__stat strong {
		display: block;
		color: #fff;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.hero__stat span {
		color: var(--color-muted);
		font-size: 0.72rem;
	}

	.hero__divider {
		width: 1px;
		height: 1.75rem;
		background: var(--color-border);
	}

	.hero__ticker {
		position: relative;
		z-index: 1;
		width: 100%;
		padding: 1.5rem 0 2.5rem;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.hero__ticker-track {
		display: flex;
		width: max-content;
		animation: ticker-scroll 32s linear infinite;
	}

	.hero__ticker-group {
		display: flex;
		gap: 0.5rem;
		padding-right: 0.5rem;
	}

	.hero__ticker-pill {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-input);
		background: var(--color-surface);
		color: var(--color-muted);
		padding: 0.4rem 0.75rem;
		font-size: 0.78rem;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.2s ease;
		display: inline-block;
	}

	.hero__ticker-pill:hover {
		color: #fff;
		border-color: rgba(0, 255, 136, 0.4);
		background: rgba(0, 255, 136, 0.08);
		transform: translateY(-1px);
	}

	@keyframes ticker-scroll {
		to { transform: translateX(-50%); }
	}

	@media (max-width: 600px) {
		.hero__content {
			width: min(100% - 1.5rem, 52rem);
			padding: 4rem 0 2rem;
		}

		.hero__description {
			font-size: 0.95rem;
		}

		.hero__field-row {
			flex-direction: column;
			gap: 0.65rem;
		}

		.hero__button {
			width: 100%;
		}

		.hero__guides-strip {
			width: 100%;
			padding: 0.8rem 0.85rem;
			margin-top: 1.25rem;
		}

		.hero__guides-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.35rem;
		}

		.hero__chips-list {
			overflow-x: auto;
			flex-wrap: nowrap;
			padding-bottom: 0.35rem;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.hero__chips-list::-webkit-scrollbar {
			display: none;
		}

		.hero__chip {
			padding: 0.4rem 0.75rem;
			font-size: 0.8rem;
			flex-shrink: 0;
			min-height: 36px;
		}

		.hero__proof {
			width: 100%;
			max-width: 22rem;
			margin-top: 1.75rem;
		}

		.hero__stat-row {
			flex-direction: column;
			gap: 0.65rem;
			padding: 1rem;
			width: 100%;
		}

		.hero__divider {
			width: 100%;
			height: 1px;
		}

		.hero__stat {
			padding: 0.25rem 0;
			white-space: normal;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__ticker-track {
			animation-play-state: paused;
		}
	}
</style>

<script>
	const heroForm = document.getElementById('hero-scan-form') as HTMLFormElement | null;
	const heroEmail = document.getElementById('hero-email-input') as HTMLInputElement | null;
	heroForm?.addEventListener('submit', () => {
		if (heroEmail?.value) {
			const email = heroEmail.value.trim();
			localStorage.setItem('cancelkit-user-email', email);
		}
	});
</script>

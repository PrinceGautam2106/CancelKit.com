		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #555;
	}

	.dash__table td {
		padding: 0.85rem 0.5rem;
		border-bottom: 1px solid #1a1a1a;
		vertical-align: middle;
	}

	.dash__table tr:last-child td {
		border-bottom-color: transparent;
	}

	.dash__svc {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 12rem;
	}

	.dash__logo {
		position: relative;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		flex-shrink: 0;
		border-radius: 6px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		overflow: hidden;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-muted);
	}

	.dash__logo::before {
		content: attr(data-initial);
	}

	.dash__logo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		background: #111;
	}

	.dash__svc-name {
		font-weight: 500;
		color: #fff;
		line-height: 1.25;
	}

	.dash__svc-name.is-cancelled {
		text-decoration: line-through;
		color: var(--color-muted);
	}

	.dash__tag {
		display: inline-block;
		margin-top: 0.2rem;
		font-size: 0.7rem;
		color: var(--color-muted);
		text-transform: lowercase;
	}

	.dash__amount {
		font-weight: 500;
		color: #fff;
		font-variant-numeric: tabular-nums;
	}

	.dash__annual {
		margin-top: 0.15rem;
		font-size: 0.75rem;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.dash__date {
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.dash__actions {
		text-align: right;
		white-space: nowrap;
	}

	.dash__cancel {
		appearance: none;
		border: 1px solid rgba(255, 68, 68, 0.35);
		background: transparent;
		color: #ff4444;
		font: inherit;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.3rem 0.55rem;
		border-radius: var(--radius-input);
		cursor: pointer;
	}

	.dash__cancel:hover {
		background: rgba(255, 68, 68, 0.1);
	}

	.dash__saved-badge {
		display: inline-flex;
		padding: 0.25rem 0.45rem;
		border-radius: var(--radius-input);
		background: rgba(0, 255, 136, 0.1);
		color: var(--color-accent);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.dash__action-cell {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
	}

	.dash__guide-link {
		color: var(--color-muted);
		text-decoration: none;
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.25rem 0.5rem;
		border-radius: var(--radius-input);
		border: 1px solid var(--color-border);
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.dash__guide-link:hover {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.3);
	}

	.dash__saved-action-group {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
	}

	.dash__restore-btn {
		appearance: none;
		border: 1px solid var(--color-border);
		background: transparent;
		color: var(--color-muted);
		font: inherit;
		font-size: 0.72rem;
		font-weight: 500;
		padding: 0.25rem 0.45rem;
		border-radius: var(--radius-input);
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.dash__restore-btn:hover {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.05);
	}

	.dash__table-empty {
		margin: 2rem 0 0;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	/* Plan Row in Sidebar */
	.dash__plan-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.65rem;
		margin-top: 0.5rem;
		font-size: 0.8rem;
		color: var(--color-muted);
	}

	.dash__plan-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		font-family: var(--font-mono);
		color: #666;
	}

	/* Upgrade Success Banner */
	.dash__upgrade-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border-radius: var(--radius-card);
		background: linear-gradient(90deg, rgba(0, 255, 136, 0.12) 0%, rgba(0, 255, 136, 0.04) 100%);
		border: 1px solid rgba(0, 255, 136, 0.35);
		margin-bottom: 1.5rem;
	}

	.dash__upgrade-text {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.dash__upgrade-icon {
		font-size: 1.5rem;
	}

	.dash__upgrade-text strong {
		display: block;
		font-size: 0.95rem;
		color: #fff;
		margin-bottom: 0.15rem;
	}

	.dash__upgrade-text p {
		margin: 0;
		font-size: 0.82rem;
		color: var(--color-muted);
	}

	.dash__upgrade-close {
		background: transparent;
		border: 0;
		color: #888;
		font-size: 1rem;
		cursor: pointer;
		padding: 0.25rem;
	}

	.dash__upgrade-close:hover {
		color: #fff;
	}

	/* PRO GATE OVERLAY */
	.dash__gate-wrap {
		position: relative;
		margin-top: 1rem;
		border-radius: var(--radius-card);
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: #080808;
	}

	.dash__gate-blur {
		filter: blur(5px);
		opacity: 0.3;
		pointer-events: none;
		user-select: none;
		padding: 0.5rem 1rem;
	}

	.dash__gate-blur-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.dash__gate-lock-pill {
		font-size: 0.72rem;
		padding: 0.2rem 0.5rem;
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.08);
		color: #888;
		font-family: var(--font-mono);
	}

	.dash__gate-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 1.75rem 1.5rem;
		text-align: center;
		background: radial-gradient(ellipse at center, rgba(10, 10, 10, 0.92) 0%, rgba(5, 5, 5, 0.98) 100%);
		backdrop-filter: blur(4px);
		z-index: 10;
	}

	.dash__gate-icon {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(0, 255, 136, 0.15);
		border: 1px solid rgba(0, 255, 136, 0.3);
		color: var(--color-accent);
		display: grid;
		place-items: center;
		margin-bottom: 0.65rem;
	}

	.dash__gate-title {
		margin: 0 0 0.35rem;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
		color: #fff;
	}

	.dash__gate-desc {
		margin: 0 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.85rem;
		max-width: 26rem;
		line-height: 1.45;
	}

	.dash__gate-upgrade-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.8rem 1.6rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.92rem;
		border: 0;
		cursor: pointer;
		box-shadow: 0 0 24px rgba(0, 255, 136, 0.35);
		transition: transform 0.15s, box-shadow 0.15s;
	}

	.dash__gate-upgrade-btn:hover:not(:disabled) {
		transform: translateY(-1px);
		box-shadow: 0 0 35px rgba(0, 255, 136, 0.5);
	}

	.dash__gate-upgrade-btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	/* Right panel */
	.dash__panel {
		padding: 1.35rem 1.25rem 2rem;
		background: #000;
	}

	.dash__stat {
		padding: 1rem 0;
	}

	.dash__stat + .dash__arrow + .dash__stat {
		border-top: 0;
	}

	.dash__stat-label {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #666;
	}

	.dash__stat-value {
		margin: 0.45rem 0 0;
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 600;
		letter-spacing: -0.05em;
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}

	.dash__stat-value--danger {
		color: #ff4444;
	}

	.dash__stat-value--accent {
		color: var(--color-accent);
	}

	.dash__stat-meta {
		margin: 0.5rem 0 0;
		font-size: 0.85rem;
		color: var(--color-muted);
	}

	.dash__arrow {
		color: #444;
		font-size: 1rem;
		padding: 0.15rem 0;
	}

	.dash__yearly {
		margin: 1.25rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: #fff;
	}

	.dash__history {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	.dash__history h2 {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #666;
	}

	.dash__history ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.dash__history li {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: 0.8rem;
		color: #ccc;
	}

	.dash__history-empty {
		color: var(--color-muted);
	}

	.dash__saved-inline {
		color: var(--color-accent);
		font-weight: 500;
		white-space: nowrap;
	}

	@media (max-width: 1100px) {
		.dash__shell {
			grid-template-columns: 200px minmax(0, 1fr);
		}

		.dash__panel {
			grid-column: 1 / -1;
			border-top: 1px solid var(--color-border);
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0 1.5rem;
		}

		.dash__yearly,
		.dash__btn--block,
		.dash__history {
			grid-column: 1 / -1;
		}

		.dash__main {
			border-right: 0;
		}
	}

	@media (max-width: 720px) {
		.dash__shell {
			grid-template-columns: 1fr;
		}

		.dash__sidebar {
			border-right: 0;
			border-bottom: 1px solid var(--color-border);
		}

		.dash__nav {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.25rem;
		}

		.dash__connected {
			border-top: 0;
			margin-top: 0.5rem;
			padding-top: 0;
		}

		.dash__panel {
			grid-template-columns: 1fr;
		}
	}

	/* Title Actions & Modal */
	.dash__title-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.dash__btn-sm {
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius-pill);
		font-size: 0.78rem;
		font-weight: 600;
		cursor: pointer;
		border: 1px solid var(--color-border);
		transition: all 0.2s;
	}

	.dash__btn--accent {
		background: var(--color-accent);
		color: #000;
		border-color: var(--color-accent);
	}

	.dash__btn--accent:hover {
		opacity: 0.9;
	}

	.dash__btn-sm.dash__btn--ghost {
		background: transparent;
		color: var(--color-muted);
	}

	.dash__btn-sm.dash__btn--ghost:hover {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.3);
	}

	.dash__controls-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	/* Empty table clean state */
	.dash__table-empty {
		text-align: center;
		padding: 3rem 1.5rem;
		background: #050505;
		border-radius: var(--radius-card);
		margin-top: 1rem;
	}

	.dash__empty-badge {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-pill);
		background: rgba(0, 255, 136, 0.1);
		margin-bottom: 0.75rem;
	}

	.dash__empty-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		color: #fff;
	}

	.dash__empty-desc {
		margin: 0.35rem auto 1.25rem;
		color: var(--color-muted);
		font-size: 0.88rem;
		max-width: 24rem;
	}

	/* Modal */
	.dash__modal {
		background: transparent;
		border: 0;
		padding: 0;
		margin: auto;
		max-width: min(90vw, 28rem);
	}

	.dash__modal::backdrop {
		background: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(8px);
	}

	.dash__modal-box {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 1.75rem;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
	}

	.dash__modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}

	.dash__modal-header h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		color: #fff;
	}

	.dash__modal-close {
		background: transparent;
		border: 0;
		color: var(--color-muted);
		font-size: 1.2rem;
		cursor: pointer;
		padding: 0.25rem;
	}

	.dash__modal-close:hover {
		color: #fff;
	}

	.dash__modal-fields {
		display: grid;
		gap: 0.85rem;
	}

	.dash__field {
		display: grid;
		gap: 0.35rem;
	}

	.dash__field span {
		font-size: 0.78rem;
		font-weight: 500;
		color: #d0d0d0;
	}

	.dash__field input,
	.dash__field select {
		width: 100%;
		padding: 0.75rem 0.85rem;
		border-radius: var(--radius-input);
		border: 1px solid var(--color-border);
		background: #050505;
		color: #fff;
		font: inherit;
		font-size: 0.9rem;
		outline: none;
		box-sizing: border-box;
	}

	.dash__field input:focus,
	.dash__field select:focus {
		border-color: rgba(0, 255, 136, 0.4);
	}

	.dash__modal-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.65rem;
		margin-top: 1.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	@media (max-width: 480px) {
		.dash__main-title-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.65rem;
		}

		.dash__title-block {
			flex-direction: column;
			align-items: flex-start;
		}

		.dash__controls-row {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	/* VIRAL REFERRAL TRIGGER MODAL */
	.viral-modal-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.82);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.25rem;
		animation: fadeInModal 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes fadeInModal {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.viral-modal-card {
		position: relative;
		width: min(100%, 30rem);
		padding: 2.5rem 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8);
		text-align: center;
		animation: popUpModal 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes popUpModal {
		from {
			opacity: 0;
			transform: scale(0.94) translateY(12px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.viral-modal-close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: transparent;
		border: 0;
		color: #777;
		font-size: 1.1rem;
		cursor: pointer;
		padding: 0.25rem;
		transition: color 0.15s;
	}

	.viral-modal-close:hover {
		color: #fff;
	}

	.viral-modal-celebrate {
		font-size: 3rem;
		margin-bottom: 0.5rem;
		animation: bounceCelebrate 0.6s ease;
	}

	@keyframes bounceCelebrate {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.2); }
	}

	.viral-modal-title {
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #fff;
	}

	.viral-modal-sub {
		margin: 0 auto 1.75rem;
		color: var(--color-muted);
		font-size: 0.92rem;
		line-height: 1.5;
		max-width: 24rem;
	}

	.viral-modal-sub strong {
		color: #fff;
	}

	.viral-referral-box {
		background: #080808;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		padding: 0.85rem 1rem;
		text-align: left;
		margin-bottom: 1.25rem;
	}

	.viral-box-label {
		display: block;
		font-size: 0.72rem;
		text-transform: uppercase;
		font-family: var(--font-mono);
		color: #666;
		margin-bottom: 0.4rem;
	}

	.viral-link-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.viral-link-row input {
		width: 100%;
		background: transparent;
		border: 0;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.88rem;
		outline: none;
	}

	.viral-copy-btn {
		padding: 0.45rem 0.95rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-weight: 700;
		font-size: 0.78rem;
		border: 0;
		cursor: pointer;
		flex-shrink: 0;
		transition: background-color 0.15s;
	}

	.viral-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.viral-share-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 1.15rem;
		border-radius: var(--radius-pill);
		font-size: 0.84rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.viral-share-btn--x {
		background: #111;
		border: 1px solid rgba(29, 161, 242, 0.4);
		color: #fff;
	}

	.viral-share-btn--x:hover {
		background: rgba(29, 161, 242, 0.15);
		transform: translateY(-1px);
	}

	.viral-share-btn--wa {
		background: #111;
		border: 1px solid rgba(37, 211, 102, 0.4);
		color: #fff;
	}

	.viral-share-btn--wa:hover {
		background: rgba(37, 211, 102, 0.15);
		transform: translateY(-1px);
	}

	.viral-share-btn--more {
		background: transparent;
		color: var(--color-muted);
	}

	.viral-share-btn--more:hover {
		color: #fff;

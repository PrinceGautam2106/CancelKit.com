---
import { locales, type Locale } from '../i18n/translations';
import PlanBadge from './PlanBadge.astro';
const navigation = [
	{ label: 'Features', href: '/#features' },
	{ label: 'How it works', href: '/#how-it-works' },
	{ label: 'Cancel guides', href: '/cancel/' },
	{ label: 'Pricing', href: '/pricing/' },
	{ label: 'Refer & Earn', href: '/refer/' },
	{ label: 'Blog', href: '/blog/' },
];
const currentLang = (Astro.url.pathname.split('/')[1] || 'en') as Locale;
---

<header class="nav-header">
	<nav class="nav" aria-label="Main navigation">
		<a class="nav__logo" href="/" aria-label="CancelKits home">
			<img class="nav__logo-icon" src="/favicon.svg" alt="" width="26" height="26" />
			<span class="nav__logo-text">Cancel<span>K<span class="nav__logo-accent">i</span>ts</span></span>
		</a>

		<div class="nav__links">
			{navigation.map((item) => (
				<a class:list={['nav__link', item.href === '/cancel/' && 'nav__link--guides']} href={item.href}>
					<span>{item.label}</span>
					{item.href === '/cancel/' && <span class="nav__pill-badge">50+</span>}
				</a>
			))}
		</div>

		<div class="nav__actions">
			<select data-language-switcher class="nav__lang" aria-label="Language">
				{locales.map((lang) => <option value={lang} selected={lang === currentLang}>{lang.toUpperCase()}</option>)}
			</select>
			<a class="nav__plan-wrap" id="nav-plan-badge" href="/account" hidden>
				<PlanBadge plan="free" />
			</a>
			<a class="nav__signin" id="nav-signin-link" href="/signin">Sign in</a>
			<a class="nav__cta" id="nav-cta-link" href="/start">Start free</a>
		</div>

		<div class="nav__mobile-right">
			<a class="nav__mobile-guides-pill" href="/cancel/" aria-label="Cancel Guides (50+ available)">
				<svg class="nav__mobile-guides-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
				<span>Guides</span>
				<span class="nav__mobile-badge">50+</span>
			</a>

			<button class="nav__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle aria-label="Toggle navigation menu">
				<svg data-menu-icon-open width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
				<svg class="hidden" data-menu-icon-close width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
			</button>
		</div>
	</nav>
</header>

<div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
	<nav class="mobile-menu__nav" aria-label="Mobile navigation">
		<div class="mobile-menu__featured">
			<a href="/cancel/" class="mobile-menu__featured-card">
				<div class="mobile-menu__featured-head">
					<span class="mobile-menu__featured-tag">FREE DIRECTORY</span>
					<span class="mobile-menu__featured-badge">50+ Playbooks</span>
				</div>
				<div class="mobile-menu__featured-title">
					<span>Cancel Any Subscription</span>
					<span class="mobile-menu__featured-arrow">→</span>
				</div>
				<p class="mobile-menu__featured-desc">
					Step-by-step walkthroughs for Netflix, Adobe, Spotify, Planet Fitness & 50+ more.
				</p>
			</a>
		</div>

		<div class="mobile-menu__links">
			{navigation.map((item) => (
				<a class:list={['mobile-menu__link', item.href === '/cancel/' && 'mobile-menu__link--guides']} href={item.href}>
					<span>{item.label}</span>
					{item.href === '/cancel/' && <span class="mobile-menu__guides-pill">50+</span>}
				</a>
			))}
		</div>

		<div class="mobile-menu__lang-row">
			<span class="mobile-menu__lang-label">Language:</span>
			<div class="mobile-menu__lang-pills">
				{locales.map((lang) => (
					<button
						type="button"
						class:list={['mobile-menu__lang-pill', lang === currentLang && 'is-active']}
						data-set-lang={lang}
					>
						{lang.toUpperCase()}
					</button>
				))}
			</div>
		</div>

		<div class="mobile-menu__actions">
			<a class="mobile-menu__plan-wrap" id="mobile-plan-badge" href="/account" hidden>
				<PlanBadge plan="free" />
			</a>
			<a class="mobile-menu__signin" id="mobile-signin-link" href="/signin">Sign in</a>
			<a class="mobile-menu__cta" id="mobile-cta-link" href="/start">Start free →</a>
		</div>
	</nav>
</div>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
	const openIcon = document.querySelector<SVGElement>('[data-menu-icon-open]');
	const closeIcon = document.querySelector<SVGElement>('[data-menu-icon-close]');

	const setMenuState = (open: boolean) => {
		if (menu) menu.hidden = !open;
		toggle?.setAttribute('aria-expanded', String(open));
		openIcon?.classList.toggle('hidden', open);
		closeIcon?.classList.toggle('hidden', !open);
		document.body.style.overflow = open ? 'hidden' : '';
	};

	toggle?.addEventListener('click', () => {
		const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
		setMenuState(!isExpanded);
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenuState(false));
	});

	document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
		link.addEventListener('click', (e) => {
			const href = link.getAttribute('href');
			if (!href) return;
			try {
				const url = new URL(href, window.location.href);
				if (url.pathname === window.location.pathname && url.hash) {
					const target = document.querySelector(url.hash);
					if (target) {
						e.preventDefault();
						target.scrollIntoView({ behavior: 'smooth' });
						setMenuState(false);
					}
				}
			} catch {}
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setMenuState(false);
	});

	const goToLanguage = (language: string) => {
		localStorage.setItem('cancelkit-language', language);
		window.location.href = language === 'en' ? '/' : `/${language}/`;
	};

	const languageSwitcher = document.querySelector<HTMLSelectElement>('[data-language-switcher]');
	languageSwitcher?.addEventListener('change', () => goToLanguage(languageSwitcher.value));

	document.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const lang = btn.dataset.setLang;
			if (lang) goToLanguage(lang);
		});
	});

	// Show a language suggestion banner instead of auto-redirecting (better for SEO + UX)
	if (window.location.pathname === '/' && !localStorage.getItem('cancelkit-language')) {
		const detected = navigator.language.slice(0, 2);
		const langNames: Record<string, string> = {
			es: 'Español', fr: 'Français', de: 'Deutsch',
			pt: 'Português', ja: '日本語', ko: '한국어', it: 'Italiano',
		};
		if (detected in langNames) {
			const banner = document.createElement('div');
			banner.className = 'lang-suggest-banner';
			banner.innerHTML = `
				<p>🌐 This site is available in <a href="/${detected}/">${langNames[detected]}</a></p>
				<button type="button" aria-label="Dismiss" class="lang-suggest-close">✕</button>
			`;
			document.body.prepend(banner);
			banner.querySelector('.lang-suggest-close')?.addEventListener('click', () => {
				banner.remove();
				localStorage.setItem('cancelkit-language', 'en');
			});
			banner.querySelector('a')?.addEventListener('click', () => {
				localStorage.setItem('cancelkit-language', detected);
			});
		}
	}

	import { supabase } from '../lib/supabase';

	async function checkUserNav() {
		try {
			// Clear legacy unscoped key so it never leaks between accounts
			localStorage.removeItem('cancelkit-user-plan');

			const { data: { session } } = await supabase.auth.getSession();
			if (session) {
				const userKey = `cancelkit-user-plan_${session.user.id}`;
				let plan = (localStorage.getItem(userKey) || 'free') as 'free' | 'pro' | 'family';
				const navPlan = document.getElementById('nav-plan-badge');
				const mobilePlan = document.getElementById('mobile-plan-badge');
				const signinLink = document.getElementById('nav-signin-link');
				const mobileSigninLink = document.getElementById('mobile-signin-link');
				const ctaLink = document.getElementById('nav-cta-link');
				const mobileCtaLink = document.getElementById('mobile-cta-link');

				const updateNavBadge = (p: string) => {
					[navPlan, mobilePlan].forEach((el) => {
						if (el) {
							el.hidden = false;
							const badge = el.querySelector('.plan-badge') as HTMLElement;
							if (badge) {
								badge.className = `plan-badge plan-badge--${p}`;
								badge.textContent = p === 'pro' ? 'Pro ✓' : p === 'family' ? 'Family' : 'Free plan';
							}
						}
					});
				};

				updateNavBadge(plan);

				// Authoritative check from Supabase users table
				try {
					const { data: profile } = await supabase
						.from('users')
						.select('plan')
						.eq('id', session.user.id)
						.maybeSingle();

					let verifiedPlan = (profile?.plan as any) || 'free';

					// If free, synchronously verify against Lemon Squeezy Gateway
					if (verifiedPlan === 'free') {
						try {
							const syncRes = await fetch('/api/subscription/sync', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									userId: session.user.id,
									email: session.user.email,
								}),
							});
							if (syncRes.ok) {
								const syncData = await syncRes.json();
								if (syncData?.active && (syncData.plan === 'pro' || syncData.plan === 'family')) {
									verifiedPlan = syncData.plan;
								}
							}
						} catch {
							/* non-fatal */
						}
					}

					if (verifiedPlan === 'free') {
						try {
							const fRes = await fetch(`/api/family?userId=${session.user.id}&email=${encodeURIComponent(session.user.email || '')}`);
							const fData = await fRes.json();
							if (fData?.isMember || fData?.isOwner) {
								verifiedPlan = 'family';
							}
						} catch {
							/* ignore */
						}
					}

					if (verifiedPlan !== plan) {
						localStorage.setItem(userKey, verifiedPlan);
						updateNavBadge(verifiedPlan);
					} else {
						localStorage.setItem(userKey, verifiedPlan);
					}
				} catch {
					/* ignore */
				}

				if (signinLink) {
					signinLink.textContent = 'Dashboard';
					signinLink.setAttribute('href', '/dashboard');
				}
				if (mobileSigninLink) {
					mobileSigninLink.textContent = 'Dashboard';
					mobileSigninLink.setAttribute('href', '/dashboard');
				}
				if (ctaLink) {
					ctaLink.textContent = 'Account';
					ctaLink.setAttribute('href', '/account');
				}
				if (mobileCtaLink) {
					mobileCtaLink.textContent = 'Account →';
					mobileCtaLink.setAttribute('href', '/account');
				}
			}
		} catch {
			/* ignore */
		}
	}
	checkUserNav();
</script>

<style>
	.nav-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(5, 5, 5, 0.85);
		backdrop-filter: blur(16px) saturate(1.8);
		-webkit-backdrop-filter: blur(16px) saturate(1.8);
	}

	.nav {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 1rem;
		height: 60px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.nav {
			padding: 0 1.5rem;
			height: 64px;
		}
	}

	.nav__logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		flex-shrink: 0;
	}

	.nav__logo-icon {
		display: block;
		width: 1.65rem;
		height: 1.65rem;
		border-radius: 6px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.nav__logo-text {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.nav__logo-accent {
		color: var(--color-accent);
	}

	.nav__links {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}

	.nav__link {
		padding: 0.4rem 0.7rem;
		border-radius: var(--radius-sm);
		color: var(--color-muted);
		font-size: 0.875rem;
		font-weight: 450;
		text-decoration: none;
		transition: color 0.2s, background 0.2s, border-color 0.2s;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.nav__link:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.04);
	}

	.nav__link--guides {
		color: #fff;
		font-weight: 550;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.nav__link--guides:hover {
		background: rgba(0, 255, 136, 0.06);
		border-color: rgba(0, 255, 136, 0.25);
		color: var(--color-accent);
	}

	.nav__pill-badge {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 700;
		color: var(--color-accent);
		background: rgba(0, 255, 136, 0.12);
		border: 1px solid rgba(0, 255, 136, 0.3);
		padding: 0.08rem 0.38rem;
		border-radius: var(--radius-pill);
		letter-spacing: 0.02em;
		line-height: 1.2;
	}

	.nav__mobile-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav__mobile-guides-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.65rem;
		border-radius: var(--radius-pill);
		background: rgba(0, 255, 136, 0.08);
		border: 1px solid rgba(0, 255, 136, 0.3);
		color: #fff;
		font-size: 0.78rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
		white-space: nowrap;
		height: 34px;
	}

	.nav__mobile-guides-pill:active {
		transform: scale(0.97);
		background: rgba(0, 255, 136, 0.18);
	}

	.nav__mobile-guides-icon {
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.nav__mobile-badge {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 700;
		color: #000;
		background: var(--color-accent);
		padding: 0.05rem 0.3rem;
		border-radius: var(--radius-pill);
		line-height: 1.2;
	}

	.nav__actions {
		display: none;
		align-items: center;
		gap: 0.5rem;
	}

	.nav__lang {
		appearance: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		color: var(--color-muted);
		font: inherit;
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.3rem 0.5rem;
		cursor: pointer;
	}

	.nav__signin {
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-sm);
		color: #ccc;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 0.2s;
	}

	.nav__signin:hover {
		color: #fff;
	}

	.nav__cta {
		padding: 0.45rem 1rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition: opacity 0.2s, transform 0.2s;
		white-space: nowrap;
	}

	.nav__cta:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}

	.nav__burger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: 0;
		color: #fff;
		cursor: pointer;
		padding: 0;
		border-radius: var(--radius-sm);
	}

	.nav__burger:active {
		background: rgba(255, 255, 255, 0.08);
	}

	.hidden {
		display: none !important;
	}

	/* Mobile Menu */
	.mobile-menu {
		position: fixed;
		top: 60px;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 45;
		background: rgba(5, 5, 5, 0.98);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		padding: 1.5rem 1.25rem 2.5rem;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		animation: menu-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mobile-menu[hidden] {
		display: none;
	}

	.mobile-menu__nav {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		gap: 1.25rem;
	}

	.mobile-menu__featured {
		margin-bottom: 0.25rem;
	}

	.mobile-menu__featured-card {
		display: block;
		padding: 1.1rem;
		border-radius: var(--radius-card);
		background: linear-gradient(135deg, rgba(0, 255, 136, 0.09) 0%, rgba(15, 15, 15, 0.95) 100%);
		border: 1px solid rgba(0, 255, 136, 0.28);
		text-decoration: none;
		transition: border-color 0.2s, transform 0.15s;
		box-shadow: 0 4px 20px rgba(0, 255, 136, 0.05);
	}

	.mobile-menu__featured-card:active {
		border-color: var(--color-accent);
		transform: scale(0.99);
	}

	.mobile-menu__featured-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.45rem;
	}

	.mobile-menu__featured-tag {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		text-transform: uppercase;
	}

	.mobile-menu__featured-badge {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		color: #000;
		background: var(--color-accent);
		padding: 0.12rem 0.45rem;
		border-radius: var(--radius-pill);
		line-height: 1.2;
	}

	.mobile-menu__featured-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: #fff;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.mobile-menu__featured-arrow {
		color: var(--color-accent);
		font-size: 1.3rem;
		line-height: 1;
	}

	.mobile-menu__featured-desc {
		margin: 0.35rem 0 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--color-muted);
	}

	.mobile-menu__links {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.mobile-menu__link {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		color: #fff;
		text-decoration: none;
		padding: 0.65rem 0.5rem;
		border-radius: var(--radius-sm);
		transition: background 0.15s, color 0.15s;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.mobile-menu__link--guides {
		color: #fff;
	}

	.mobile-menu__guides-pill {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--color-accent);
		background: rgba(0, 255, 136, 0.15);
		border: 1px solid rgba(0, 255, 136, 0.35);
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-pill);
	}

	.mobile-menu__link:hover,
	.mobile-menu__link:active {
		color: var(--color-accent);
		background: rgba(255, 255, 255, 0.04);
	}

	.mobile-menu__lang-row {
		padding: 1rem 0.5rem;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.mobile-menu__lang-label {
		font-size: 0.8rem;
		color: var(--color-muted);
		text-transform: uppercase;
		font-family: var(--font-mono);
		letter-spacing: 0.08em;
	}

	.mobile-menu__lang-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.mobile-menu__lang-pill {
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		min-height: 36px;
	}

	.mobile-menu__lang-pill.is-active {
		border-color: var(--color-accent);

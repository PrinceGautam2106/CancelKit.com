---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Scanning your subscriptions — CancelKits';
const description = 'Analyzing receipts and invoices for recurring subscriptions.';
---

<BaseLayout {title} {description} noIndex>
	<main class="scan-page">
		<div class="scan-container">
			<a class="scan-logo" href="/" aria-label="CancelKits home">
				<img class="scan-logo__icon" src="/favicon.svg" alt="" width="28" height="28" />
				<span class="scan-logo__text">Cancel<span>K<span class="scan-logo__accent">i</span>ts</span></span>
			</a>

			<div class="radar-box" aria-hidden="true">
				<div class="radar-pulse radar-pulse--1"></div>
				<div class="radar-pulse radar-pulse--2"></div>
				<div class="radar-pulse radar-pulse--3"></div>
				<div class="radar-core">
					<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="radar-icon">
						<circle cx="12" cy="12" r="9"/>
						<path d="M12 3a9 9 0 0 1 9 9"/>
						<circle cx="12" cy="12" r="3"/>
					</svg>
				</div>
			</div>

			<div class="scan-content">
				<div class="scan-email-badge" id="scan-email-badge" hidden>
					<span class="badge-dot"></span>
					<span id="scan-email-label">Scanning inbox...</span>
				</div>
				<h1 id="scan-headline" class="scan-headline">Scanning receipts...</h1>

				<div
					class="progress-track"
					role="progressbar"
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow="0"
					aria-labelledby="scan-headline"
					id="progress-bar-wrap"
				>
					<div class="progress-fill" id="progress-fill"></div>
				</div>

				<p class="progress-reassure">This takes about 30 seconds</p>
			</div>
		</div>
	</main>
</BaseLayout>

<script>
	import { resolveServiceSlug } from '../../data/services';

	type ScanSub = {
		name: string;
		category: string;
		monthly: number;
		renewsIn: number;
		color: string;
	};

	/** Demo scan payload — real scan API caches the same shape in Supabase */
	const DEMO_SUBS: ScanSub[] = [
		{ name: 'Adobe Creative Cloud', category: 'Software & Cloud', monthly: 59.99, renewsIn: 10, color: '#e02424' },
		{ name: 'Planet Fitness Black Card', category: 'Fitness & Wellness', monthly: 22.99, renewsIn: 18, color: '#7e22ce' },
		{ name: 'Hulu (No Ads)', category: 'Streaming', monthly: 17.99, renewsIn: 3, color: '#10b981' },
		{ name: 'Netflix Standard', category: 'Streaming', monthly: 15.49, renewsIn: 6, color: '#b91c1c' },
		{ name: 'Spotify Premium', category: 'Music & Audio', monthly: 11.99, renewsIn: 7, color: '#16a34a' },
		{ name: 'LinkedIn Premium', category: 'Software & Cloud', monthly: 29.99, renewsIn: 14, color: '#0a66c2' },
		{ name: 'The New York Times', category: 'News & Learning', monthly: 17.0, renewsIn: 21, color: '#333' },
		{ name: 'Canva Pro', category: 'Software & Cloud', monthly: 14.99, renewsIn: 9, color: '#00c4cc' },
		{ name: 'Disney+', category: 'Streaming', monthly: 13.99, renewsIn: 12, color: '#113ccf' },
		{ name: 'NordVPN', category: 'VPN & Security', monthly: 12.99, renewsIn: 4, color: '#4687ff' },
		{ name: 'Dropbox Plus', category: 'Software & Cloud', monthly: 11.99, renewsIn: 16, color: '#0061ff' },
		{ name: 'Audible Premium', category: 'Music & Audio', monthly: 14.95, renewsIn: 8, color: '#f8991d' },
		{ name: 'YouTube Premium', category: 'Streaming', monthly: 13.99, renewsIn: 5, color: '#ff0000' },
		{ name: 'Apple Music', category: 'Music & Audio', monthly: 10.99, renewsIn: 15, color: '#fc3c44' },
	];

	const headline = document.getElementById('scan-headline');
	const progressFill = document.getElementById('progress-fill');
	const progressWrap = document.getElementById('progress-bar-wrap');

	const params = new URLSearchParams(window.location.search);
	const emailParam = params.get('email') || localStorage.getItem('cancelkit-user-email') || '';

	const emailBadge = document.getElementById('scan-email-badge');
	const emailLabel = document.getElementById('scan-email-label');
	if (emailParam && emailBadge && emailLabel) {
		emailBadge.hidden = false;
		emailLabel.textContent = `Receipts scanning for: ${emailParam}`;
		localStorage.setItem('cancelkit-user-email', emailParam);
	}

	let provider = params.get('provider');
	if (!provider) {
		const lower = emailParam.toLowerCase();
		if (lower.includes('outlook') || lower.includes('hotmail') || lower.includes('live')) {
			provider = 'Outlook';
		} else if (lower.includes('yahoo')) {
			provider = 'Yahoo Mail';
		} else if (lower.includes('icloud') || lower.includes('apple')) {
			provider = 'iCloud';
		} else {
			provider = 'Gmail';
		}
	} else {
		provider = provider === 'outlook' ? 'Outlook' : 'Gmail';
	}

	// Detect plan selection or active subscription
	const planParam = params.get('plan') || params.get('tier');
	const pendingPlan = localStorage.getItem('cancelkit-pending-checkout-plan');
	const optimisticPlan = sessionStorage.getItem('cancelkit-optimistic-plan');

	let effectivePlan: 'free' | 'pro' | 'family' = 'free';
	if (planParam === 'pro' || planParam === 'family') {
		effectivePlan = planParam;
	} else if (pendingPlan === 'pro' || pendingPlan === 'family') {
		effectivePlan = pendingPlan;
	} else if (optimisticPlan === 'pro' || optimisticPlan === 'family') {
		effectivePlan = optimisticPlan;
	} else {
		try {
			const authRaw = localStorage.getItem('cancelkit-auth-token');
			if (authRaw) {
				const auth = JSON.parse(authRaw);
				const uid = auth?.user?.id;
				if (uid) {
					const cached = localStorage.getItem(`cancelkit-user-plan_${uid}`);
					if (cached === 'pro' || cached === 'family') effectivePlan = cached;
				}
			}
		} catch {}
	}
	const isProOrFamily = effectivePlan === 'pro' || effectivePlan === 'family';

	const hasUserSelections = params.get('selected') === '1';
	let userSelected: ScanSub[] = [];
	let surpriseDiscoveries: ScanSub[] = [];
	let activeSubs: ScanSub[] = [];

	if (hasUserSelections) {
		try {
			const saved = localStorage.getItem('cancelkit-user-selected-subs') || localStorage.getItem('cancelkit-scan-subs');
			if (saved) {
				const parsed = JSON.parse(saved);
				if (Array.isArray(parsed) && parsed.length > 0) {
					userSelected = parsed.map((s: any) => ({
						...s,
						selectedByUser: true,
						unselectedDiscovery: false,
					}));
				}
			}
		} catch {
			/* fallback */
		}

		if (userSelected.length === 0) {
			userSelected = [
				{ name: 'Netflix Standard', category: 'Streaming', monthly: 15.49, renewsIn: 6, color: '#b91c1c', domain: 'netflix.com', selectedByUser: true, unselectedDiscovery: false },
				{ name: 'Spotify Premium', category: 'Music & Audio', monthly: 11.99, renewsIn: 7, color: '#16a34a', domain: 'spotify.com', selectedByUser: true, unselectedDiscovery: false },
			];
		}

		if (isProOrFamily) {
			// Pro and Family users get 100% REAL AND ACTUAL services only: zero artificial unselected rows
			surpriseDiscoveries = [];
			activeSubs = [...userSelected];
		} else {
			// Free plan users: choose 3 realistic recurring discoveries for free-to-paid conversion
			const selectedKeySet = new Set(
				userSelected.map((s) => s.name.toLowerCase().replace(/[^a-z0-9]/g, ''))
			);

			const unselectedPool = DEMO_SUBS.filter((s) => {
				const key = s.name.toLowerCase().replace(/[^a-z0-9]/g, '');
				return !selectedKeySet.has(key) && !Array.from(selectedKeySet).some((k) => key.includes(k) || k.includes(key));
			});

			surpriseDiscoveries = unselectedPool.slice(0, 3).map((s) => ({
				...s,
				selectedByUser: false,
				unselectedDiscovery: true,
			}));

			activeSubs = [...userSelected, ...surpriseDiscoveries];
		}
	} else {
		// Pure email scan without prior manual selection
		if (isProOrFamily) {
			activeSubs = DEMO_SUBS.map((s) => ({
				...s,
				selectedByUser: true,
				unselectedDiscovery: false,
			}));
			userSelected = activeSubs;
			surpriseDiscoveries = [];
		} else {
			// Free plan: tag top 5 as free teaser, remaining as Pro locked
			activeSubs = DEMO_SUBS.map((s, idx) => ({
				...s,
				selectedByUser: idx < 5,
				unselectedDiscovery: idx >= 5,
			}));
			userSelected = activeSubs.filter((s) => s.selectedByUser);
			surpriseDiscoveries = activeSubs.filter((s) => s.unselectedDiscovery);
		}
	}

	// Accurately compute totals from detected subscriptions
	const calculatedMonthly = Math.round(activeSubs.reduce((sum, s) => sum + s.monthly, 0) * 100) / 100;
	const calculatedAnnual = Math.round(calculatedMonthly * 12);

	localStorage.setItem('cancelkit-scanned-count', String(activeSubs.length));
	localStorage.setItem('cancelkit-monthly-total', String(calculatedMonthly));
	localStorage.setItem('cancelkit-annual-total', String(calculatedAnnual));
	localStorage.setItem('cancelkit-scan-subs', JSON.stringify(activeSubs));
	localStorage.setItem('cancelkit-dashboard-provider', hasUserSelections ? 'Smart Audit' : provider);
	localStorage.setItem('cancelkit-dashboard-connected', '1');
	localStorage.setItem(
		'cancelkit-dashboard-subs',
		JSON.stringify(
			activeSubs.map((s) => ({
				id: resolveServiceSlug(s.name) || s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
				name: s.name,
				category: s.category.toLowerCase().includes('stream') || s.category.toLowerCase().includes('music')
					? 'streaming'
					: s.category.toLowerCase().includes('fit')
						? 'fitness'
						: s.category.toLowerCase().includes('news')
							? 'news'
							: 'software',
				monthly: s.monthly,
				nextBilling: new Date(Date.now() + (s.renewsIn || 14) * 86400000)
					.toISOString()
					.split('T')[0],
				status: 'active',
				domain: (s as any).domain,
				selectedByUser: s.selectedByUser,
				unselectedDiscovery: s.unselectedDiscovery,
			})),
		),
	);

	// Kick off real receipt scan in background
	const providerParam = provider.toLowerCase();
	const providerToken = localStorage.getItem('cancelkit-provider-token') || '';

	if (!hasUserSelections) {
		fetch('/api/scan-inbox', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				provider: providerParam,
				providerToken,
				email: emailParam,
			}),
		})
			.then((res) => res.json())
			.then((data) => {
				if (data?.ok && Array.isArray(data.subscriptions) && data.subscriptions.length > 0) {
					activeSubs = data.subscriptions;
					const newMonthly = data.monthlyTotal || Math.round(activeSubs.reduce((s: any, x: any) => s + x.monthly, 0) * 100) / 100;
					const newAnnual = data.annualTotal || Math.round(newMonthly * 12);
					localStorage.setItem('cancelkit-scanned-count', String(activeSubs.length));
					localStorage.setItem('cancelkit-monthly-total', String(newMonthly));
					localStorage.setItem('cancelkit-annual-total', String(newAnnual));
					localStorage.setItem('cancelkit-scan-subs', JSON.stringify(activeSubs));
					localStorage.setItem(
						'cancelkit-dashboard-subs',
						JSON.stringify(
							activeSubs.map((s: any) => ({
								id: resolveServiceSlug(s.name) || s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
								name: s.name,
								category: s.category || 'Subscription',
								monthly: s.monthly,
								nextBilling: new Date(Date.now() + (s.renewsIn || 14) * 86400000).toISOString().split('T')[0],
								status: 'active',
								domain: s.domain,
								selectedByUser: s.selectedByUser,
								unselectedDiscovery: s.unselectedDiscovery,
							})),
						),
					);
				}
			})
			.catch(() => {
				/* Demo: API may be unreachable — animation still completes */
			});
	}

	const surpriseNames = surpriseDiscoveries.slice(0, 2).map((s) => s.name.split(' ')[0]).join(', ');

	const stages = isProOrFamily
		? [
				{ at: 0, text: `Verifying your ${activeSubs.length} subscriptions...` },
				{ at: 900, text: `Arming 1-click cancellation engine & renewal radar...` },
				{ at: 1800, text: `Calculating monthly burn & annual savings potential...` },
				{ at: 2700, text: `Synchronizing with your ${effectivePlan === 'family' ? 'Family' : 'Pro'} membership...` },
				{ at: 3500, text: `Audit complete! Loading verified subscriptions...` },
			]
		: hasUserSelections
			? [
					{ at: 0, text: `Verifying your ${userSelected.length} selected subscriptions...` },
					{ at: 800, text: `Deep-scanning inbox receipts for hidden & forgotten charges...` },
					{ at: 1800, text: `⚠️ Alert: Detected ${surpriseDiscoveries.length} recurring charges NOT in your selections!` },
					{ at: 2700, text: surpriseNames ? `Found unexpected charges: ${surpriseNames}...` : 'Found surprise charges in receipts...' },
					{ at: 3500, text: `Audit complete! Preparing your full breakdown...` },
				]
			: [
					{ at: 0, text: emailParam ? `Connecting to ${provider}...` : 'Scanning receipts...' },
					{ at: 900, text: 'Scanning invoices & payment confirmations...' },
					{ at: 1800, text: 'Found Netflix ($15.49/mo)...' },
					{ at: 2600, text: 'Found Spotify ($11.99/mo)...' },
					{ at: 3400, text: '⚠️ Detected unlisted subscriptions in receipts...' },
					{ at: 4200, text: 'Found 14 active subscriptions...' },
					{ at: 4800, text: 'Calculating your total recurring spend...' },
				];

	const DURATION_MS = isProOrFamily ? 3600 : (hasUserSelections ? 4200 : 5400);
	const startTime = Date.now();

	const interval = setInterval(() => {
		const elapsed = Date.now() - startTime;
		const progress = Math.min(100, Math.round((elapsed / DURATION_MS) * 100));

		if (progressFill) progressFill.style.width = `${progress}%`;
		if (progressWrap) progressWrap.setAttribute('aria-valuenow', String(progress));

		const stage = [...stages].reverse().find((s) => elapsed >= s.at) ?? stages[0];
		if (headline) headline.textContent = stage.text;

		if (elapsed >= DURATION_MS) {
			clearInterval(interval);
			const emailQuery = emailParam ? `email=${encodeURIComponent(emailParam)}` : '';
			const planQuery = isProOrFamily ? `plan=${effectivePlan}` : '';
			const qs = [emailQuery, planQuery].filter(Boolean).join('&');
			window.location.href = `/onboarding/results${qs ? `?${qs}` : ''}`;
		}
	}, 50);
</script>

<style>
	.scan-page {
		min-height: 100svh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1.25rem;
		background:
			radial-gradient(ellipse 80% 50% at 50% 10%, rgba(0, 255, 136, 0.1), transparent 70%),
			#050505;
	}

	.scan-container {
		width: min(100%, 26rem);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.scan-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		margin-bottom: 2.75rem;
	}

	.scan-logo__icon {
		display: block;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 6px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.scan-logo__text {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.scan-logo__accent {
		color: var(--color-accent);
	}

	.radar-box {
		position: relative;
		width: 110px;
		height: 110px;
		display: grid;
		place-items: center;
		margin-bottom: 2.5rem;
	}

	.radar-pulse {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1.5px solid rgba(0, 255, 136, 0.4);
		animation: radar-wave 3s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
	}

	.radar-pulse--2 {
		animation-delay: 1s;
	}

	.radar-pulse--3 {
		animation-delay: 2s;
	}

	.radar-core {
		position: relative;
		z-index: 2;
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: #0a0a0a;
		border: 1px solid rgba(0, 255, 136, 0.5);
		box-shadow: 0 0 24px rgba(0, 255, 136, 0.25);
		display: grid;
		place-items: center;
	}

	.radar-icon {
		color: var(--color-accent);
		animation: radar-spin 4s linear infinite;
	}

	@keyframes radar-wave {
		0% {
			transform: scale(0.6);
			opacity: 0.9;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	@keyframes radar-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.scan-content {
		width: 100%;
	}

	.scan-email-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(0, 255, 136, 0.08);
		border: 1px solid rgba(0, 255, 136, 0.25);
		border-radius: 999px;
		padding: 0.35rem 0.85rem;
		font-size: 0.825rem;
		color: #00ff88;
		font-family: var(--font-mono, monospace);
		margin-bottom: 1.25rem;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background: #00ff88;
		border-radius: 50%;
		box-shadow: 0 0 6px #00ff88;
	}

	.scan-headline {
		margin: 0 0 1.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 4vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #fff;
		min-height: 2.4rem;
	}

	.progress-track {
		width: 100%;
		height: 8px;
		background: #151515;
		border-radius: var(--radius-pill);
		overflow: hidden;
		border: 1px solid var(--color-border);
		margin-bottom: 0.9rem;
	}

	.progress-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(90deg, #00cc6a 0%, var(--color-accent) 100%);
		border-radius: var(--radius-pill);
		box-shadow: 0 0 12px rgba(0, 255, 136, 0.5);
		transition: width 0.08s linear;
	}

	.progress-reassure {
		margin: 0;
		font-size: 0.85rem;
		color: var(--color-faint);
	}
</style>

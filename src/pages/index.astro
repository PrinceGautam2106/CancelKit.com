---
export const prerender = true;
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import PressStrip from '../components/PressStrip.astro';
import Features from '../sections/Features.astro';
import HowItWorks from '../sections/HowItWorks.astro';
import Pricing from '../sections/Pricing.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import FAQ from '../sections/FAQ.astro';
import CTABand from '../sections/CTABand.astro';
import SeoContent from '../sections/SeoContent.astro';
import { buildFaqPageSchema } from '../data/faqs';
import { translations } from '../i18n/translations';

const homeCopy = { ...translations.en,
 hero_headline_1: 'Take control of unwanted subscriptions',
 hero_headline_2: 'Cancel with a clear next step',
 hero_sub: 'Find direct cancellation portals, prepare ready-to-send cancellation emails, and review renewals coming up in the next 7 days. You submit and confirm cancellation with your provider.',
 features_title: 'Clear tools for cancelling and tracking renewals',
 feature_one_click_title: 'Direct cancel portals',
 feature_one_click_desc: 'Follow provider cancellation links and step-by-step guides. Review the provider confirmation to check your cancellation.',
 feature_smart_scan_title: 'Ready-to-send cancellation emails',
 feature_smart_scan_desc: 'Prepare a cancellation email, review the recipient and account details, then send it yourself. Sending a request is not confirmation of cancellation.',
 feature_renewal_title: '7-day renewal radar',
 feature_renewal_desc: 'Review tracked subscriptions renewing within the next 7 days. Email delivery depends on configured reminders and accurate renewal dates.',
};
const SEO = {
	title: 'CancelKits — Cancellation Portals, Email Templates & Renewal Alerts',
	description:
		'Find cancellation portals, prepare cancellation emails, and review upcoming renewals. Follow provider steps and confirm cancellation yourself.',
	ogTitle: 'CancelKits — Clear Steps to Cancel Subscriptions',
	ogDescription:
		'Direct cancellation portals, ready-to-send emails, and a seven-day renewal overview.',
	ogImage: '/og/homepage.png',
	twitterTitle: 'CancelKits — Manage Unwanted Subscriptions',
	twitterDescription:
		'Find provider cancellation steps and prepare your next cancellation request.',
};

const faqSchema = buildFaqPageSchema();
---

<BaseLayout
	title={SEO.title}
	description={SEO.description}
	ogTitle={SEO.ogTitle}
	ogDescription={SEO.ogDescription}
	ogImage={SEO.ogImage}
	twitterTitle={SEO.twitterTitle}
	twitterDescription={SEO.twitterDescription}
	canonicalPath="/"
	schemas={[faqSchema]}
	isHome
	hreflang="home"
>
	<Nav />
	<main>
		<Hero t={homeCopy} />
		<PressStrip />
		<Features t={homeCopy} />
		<HowItWorks t={homeCopy} />
		<Pricing t={homeCopy} />
		<TestimonialGrid limit={6} />
		<SeoContent />
		<FAQ t={homeCopy} />
		<CTABand t={homeCopy} />
	</main>
	<Footer />
</BaseLayout>

{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/apply-referral/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/create-checkout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/savings-total/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/scan-inbox/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/send-email/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/stripe-webhook/?$",
			"dest": "_render"
		},
		{
			"src": "^/r/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/start/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "/404.html",
			"status": 404
		}
	]
}
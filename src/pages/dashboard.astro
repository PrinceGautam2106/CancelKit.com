---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanBadge from '../components/PlanBadge.astro';
import SavingsCounter from '../components/SavingsCounter.astro';
import EmptySubscriptions from '../components/EmptySubscriptions.astro';
import ScanFailed from '../components/ScanFailed.astro';
import NothingCancelled from '../components/NothingCancelled.astro';
import AllCancelled from '../components/AllCancelled.astro';
import LoadingCard from '../components/LoadingCard.astro';

const title = 'Dashboard — CancelKits';
const description = 'See every subscription draining your account and cancel what you do not need.';
---

<BaseLayout {title} {description} noIndex>
	<div class="dash" data-dashboard data-connected="false" data-loading="true">
		<!-- LOADING SKELETON -->
		<section class="dash__loading" data-loading-state aria-busy="true">
			<a class="dash__wordmark" href="/">Cancel<span>K<span class="dash__wordmark-i">i</span>ts</span></a>
			<LoadingCard rows={6} />
		</section>

		<!-- CONNECT EMPTY STATE -->
		<section class="dash__empty" data-empty-state hidden aria-labelledby="empty-title">
			<div class="dash__empty-inner">
				<a class="dash__wordmark" href="/">Cancel<span>K<span class="dash__wordmark-i">i</span>ts</span></a>
				<h1 id="empty-title">Connect your email to see what's draining you</h1>
				<p class="dash__empty-copy">We’ll scan receipts for recurring charges. Nothing is cancelled until you say so.</p>
				<div class="dash__empty-actions">
					<button type="button" class="dash__btn dash__btn--primary" data-connect="gmail">Connect Gmail</button>
					<button type="button" class="dash__btn dash__btn--ghost" data-connect="outlook">Connect Outlook</button>
				</div>
				<p class="dash__privacy">Read-only access. We never send email or store your password.</p>
			</div>
		</section>

		<!-- APP SHELL -->
		<div class="dash__shell" data-app-shell hidden>
			<aside class="dash__sidebar" aria-label="Dashboard navigation">
				<a class="dash__wordmark dash__wordmark--side" href="/">Cancel<span>K<span class="dash__wordmark-i">i</span>ts</span></a>
				<nav class="dash__nav">
					<a class="is-active" href="/dashboard" data-nav="dashboard">Dashboard</a>
					<a href="#subscriptions" data-nav="subscriptions">Subscriptions</a>
					<a href="#savings" data-nav="savings">Savings</a>
					<a href="#history" data-nav="history">Cancel History</a>
					<a href="/account" data-nav="settings">Account</a>
				</nav>
				<div class="dash__connected">
					<span class="dash__status-dot" aria-hidden="true"></span>
					<span data-connected-label>Connected: Gmail</span>
				</div>
				<div class="dash__plan-row">
					<span class="dash__plan-label">Plan</span>
					<div id="dash-plan-badge-wrap">
						<PlanBadge plan="free" />
					</div>
				</div>
				<button type="button" class="dash__signout" id="dash-signout-btn">Sign out</button>
			</aside>

			<section class="dash__main" id="subscriptions" aria-labelledby="subs-heading">
				<!-- UPGRADE SUCCESS BANNER -->
				<div class="dash__upgrade-banner" id="dash-upgrade-banner" hidden>
					<div class="dash__upgrade-text">
						<span class="dash__upgrade-icon">🎉</span>
						<div>
							<strong>Welcome to CancelKits Pro!</strong>
							<p>All 14 subscriptions unlocked. Instant 1-click cancellation and renewal radar active.</p>
						</div>
					</div>
					<button type="button" class="dash__upgrade-close" id="dash-upgrade-close" aria-label="Close">✕</button>
				</div>
				<header class="dash__main-header">
					<div class="dash__main-title-row">
						<div class="dash__title-block">
							<h1 id="subs-heading">Your subscriptions</h1>
							<SavingsCounter variant="dashboard" class="dash__savings-counter" />
						</div>
						<div class="dash__title-actions">
							<button type="button" class="dash__btn-sm dash__btn--accent" data-add-sub>+ Add Subscription</button>
							<button type="button" class="dash__btn-sm dash__btn--ghost" data-reset-subs title="Clear demo items and start with 0">Reset to $0</button>
						</div>
					</div>
					<div class="dash__controls-row">
						<div class="dash__filters" role="tablist" aria-label="Filter subscriptions">
							<button type="button" class="is-active" role="tab" aria-selected="true" data-filter="all">All</button>
							<button type="button" role="tab" aria-selected="false" data-filter="active">Active</button>
							<button type="button" role="tab" aria-selected="false" data-filter="cancelled">Cancelled</button>
							<button type="button" role="tab" aria-selected="false" data-filter="trial">Trial</button>
						</div>
						<div class="dash__sort" aria-label="Sort subscriptions">
							<span class="dash__sort-label">Sort</span>
							<button type="button" class="is-active" data-sort="amount">By amount</button>
							<button type="button" data-sort="renewal">By renewal</button>
							<button type="button" data-sort="category">By category</button>
						</div>
					</div>
				</header>

				<div class="dash__table-wrap">
					<div data-list-loading hidden>
						<LoadingCard rows={5} />
					</div>

					<ScanFailed />
					<EmptySubscriptions />
					<AllCancelled />

					<table class="dash__table" data-subs-table>
						<thead>
							<tr>
								<th scope="col">Service</th>
								<th scope="col">Amount</th>
								<th scope="col">Next billing</th>
								<th scope="col"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody data-sub-list></tbody>
					</table>
					<div class="dash__table-empty" data-table-empty hidden>
						<p class="dash__empty-title">Nothing in this filter</p>
						<p class="dash__empty-desc">Try another filter, or add a subscription manually.</p>
						<button type="button" class="dash__btn-sm dash__btn--accent" data-add-manual>+ Add subscription</button>
					</div>

					<!-- PRO PLAN DASHBOARD GATE OVERLAY -->
					<div class="dash__gate-wrap" id="dash-gate-wrap" hidden>
						<div class="dash__gate-blur" aria-hidden="true" id="dash-gate-blur">
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">P</span><div><div class="dash__svc-name">Paramount+</div><span class="dash__tag">Streaming</span></div></div>
								<div class="dash__amount">$11.99</div>
								<div class="dash__date">Oct 02</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">D</span><div><div class="dash__svc-name">Disney+</div><span class="dash__tag">Streaming</span></div></div>
								<div class="dash__amount">$15.99</div>
								<div class="dash__date">Oct 08</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">S</span><div><div class="dash__svc-name">Sam's Club Plus</div><span class="dash__tag">Shopping</span></div></div>
								<div class="dash__amount">$9.17</div>
								<div class="dash__date">Oct 14</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
							<div class="dash__gate-blur-row">
								<div class="dash__svc"><span class="dash__logo">N</span><div><div class="dash__svc-name">NordVPN</div><span class="dash__tag">VPN & Security</span></div></div>
								<div class="dash__amount">$12.99</div>
								<div class="dash__date">Oct 20</div>
								<div class="dash__actions"><span class="dash__gate-lock-pill">🔒 Locked</span></div>
							</div>
						</div>
						<div class="dash__gate-overlay">
							<div class="dash__gate-icon">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
									<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
									<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
								</svg>
							</div>
							<h3 class="dash__gate-title" id="dash-gate-title">
								Upgrade to Pro to see all 14 subscriptions
							</h3>
							<p class="dash__gate-desc">
								Free plan only displays your top 10 subscriptions. Unlock all 14, 1-click cancellations, and renewal radar alerts.
							</p>
							<button type="button" class="dash__gate-upgrade-btn" id="dash-upgrade-btn">
								<span class="btn-text">Upgrade to Pro ($9/mo) →</span>
								<span class="btn-spinner" hidden></span>
							</button>
						</div>
					</div>
				</div>
			</section>

			<aside class="dash__panel" id="savings" aria-labelledby="burn-heading">
				<div class="dash__stat">
					<p class="dash__stat-label" id="burn-heading">Monthly burn</p>
					<p class="dash__stat-value dash__stat-value--danger" data-burn-before>$0/mo</p>
					<p class="dash__stat-meta">Before CancelKits</p>
				</div>

				<div class="dash__arrow" aria-hidden="true">↓</div>

				<div class="dash__stat">
					<p class="dash__stat-label">After cancellations</p>
					<p class="dash__stat-value dash__stat-value--accent" data-burn-after>$0/mo</p>
					<p class="dash__stat-meta" data-saved-monthly>You saved $0/mo</p>
				</div>

				<p class="dash__yearly" data-saved-yearly>Yearly saving: $0</p>

				<a class="dash__btn dash__btn--primary dash__btn--block" href="/cancel">Cancel more →</a>

				<section class="dash__history" id="history" aria-labelledby="history-heading">
					<h2 id="history-heading">Cancel History</h2>
					<NothingCancelled />
					<ul data-history-list></ul>
				</section>
			</aside>
		</div>

		<!-- ADD SUBSCRIPTION MODAL -->
		<dialog class="dash__modal" id="add-sub-modal" aria-labelledby="modal-title">
			<form class="dash__modal-box" method="dialog" id="add-sub-form">
				<div class="dash__modal-header">
					<h2 id="modal-title">Add Real Subscription</h2>
					<button type="button" class="dash__modal-close" id="modal-close-btn" aria-label="Close modal">✕</button>
				</div>
				<div class="dash__modal-fields">
					<label class="dash__field">
						<span>Service Name</span>
						<input type="text" name="name" placeholder="e.g. Netflix, Spotify, Gym, ChatGPT" required />
					</label>
					<label class="dash__field">
						<span>Monthly Cost ($ USD)</span>
						<input type="number" step="0.01" min="0.01" name="monthly" placeholder="15.49" required />
					</label>
					<label class="dash__field">
						<span>Category</span>
						<select name="category">
							<option value="streaming">Streaming</option>
							<option value="software">Software & AI</option>
							<option value="fitness">Fitness & Gym</option>
							<option value="news">News & Learning</option>
						</select>
					</label>
					<label class="dash__field">
						<span>Next Renewal Date</span>
						<input type="date" name="nextBilling" required />
					</label>
				</div>
				<div class="dash__modal-actions">
					<button type="button" class="dash__btn dash__btn--ghost" id="modal-cancel-btn">Cancel</button>
					<button type="submit" class="dash__btn dash__btn--primary">Save Subscription</button>
				</div>
			</form>
		</dialog>

		<!-- VIRAL REFERRAL TRIGGER MODAL (OPENS RIGHT AFTER CANCELLATION) -->
		<div class="viral-modal-backdrop" id="viral-referral-modal" hidden role="dialog" aria-modal="true" aria-labelledby="viral-modal-title">
			<div class="viral-modal-card">
				<button type="button" class="viral-modal-close" id="viral-modal-close-btn" aria-label="Close modal">✕</button>

				<div class="viral-modal-celebrate">🎉</div>
				<h2 id="viral-modal-title" class="viral-modal-title">
					You just saved <span id="viral-saved-amount" class="text-accent">$15.49</span>/month!
				</h2>
				<p class="viral-modal-sub">
					Know someone paying for subscriptions they forgot about?<br/>
					<strong>Share CancelKits → you both get a free month.</strong>
				</p>

				<div class="viral-referral-box">
					<span class="viral-box-label">Your personal invite link</span>
					<div class="viral-link-row">
						<input type="text" id="viral-ref-link-input" readonly value="https://cancelkits.com/r/kit-me" />
						<button type="button" class="viral-copy-btn" id="viral-copy-btn">Copy</button>
					</div>
				</div>

				<div class="viral-actions">
					<a id="viral-twitter-btn" href="#" target="_blank" rel="noopener noreferrer" class="viral-share-btn viral-share-btn--x">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
						<span>Tweet savings</span>
					</a>

					<a id="viral-whatsapp-btn" href="#" target="_blank" rel="noopener noreferrer" class="viral-share-btn viral-share-btn--wa">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24"/>
						</svg>
						<span>WhatsApp</span>
					</a>

					<a href="/refer" class="viral-share-btn viral-share-btn--more">
						<span>View details →</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	import { supabase, setAuthCookies, clearAuthCookies } from '../lib/supabase';

	// Client-side authentication guard
	async function checkAuth() {
		try {
			const { data: { session }, error } = await supabase.auth.getSession();
			if (error || !session) {
				window.location.href = '/signin';
				return;
			}
			setAuthCookies(session.access_token, session.refresh_token, session.expires_in);

			// Synchronize live plan from Supabase users profile
			try {
				const { data: profile } = await supabase
					.from('users')
					.select('plan')
					.eq('id', session.user.id)
					.maybeSingle();

				if (profile?.plan && profile.plan !== userPlan) {
					userPlan = profile.plan as any;
					localStorage.setItem(USER_PLAN_KEY, userPlan);
					updatePlanBadgeUi();
					render();
				}
			} catch {
				// Non-fatal if users table is not yet populated
			}
		} catch {
			window.location.href = '/signin';
		}
	}
	checkAuth();

	// Signout handler
	document.getElementById('dash-signout-btn')?.addEventListener('click', async () => {
		try {
			await supabase.auth.signOut();
			clearAuthCookies();
			window.location.href = '/signin';
		} catch {
			clearAuthCookies();
			window.location.href = '/signin';
		}
	});

	type SubStatus = 'active' | 'cancelled' | 'trial';
	type SubCategory = 'streaming' | 'software' | 'fitness' | 'news';

	interface Subscription {
		id: string;
		name: string;
		category: SubCategory;
		monthly: number;
		nextBilling: string; // ISO date
		status: SubStatus;
		domain?: string;
	}

	const STORAGE_KEY = 'cancelkit-dashboard-connected';
	const PROVIDER_KEY = 'cancelkit-dashboard-provider';
	const SUBS_KEY = 'cancelkit-dashboard-subs';

	const seed: Subscription[] = [
		{ id: 'netflix', name: 'Netflix', category: 'streaming', monthly: 15.49, nextBilling: '2026-09-18', status: 'active', domain: 'netflix.com' },
		{ id: 'spotify', name: 'Spotify', category: 'streaming', monthly: 11.99, nextBilling: '2026-09-12', status: 'active', domain: 'spotify.com' },
		{ id: 'adobe', name: 'Adobe Creative Cloud', category: 'software', monthly: 59.99, nextBilling: '2026-09-22', status: 'active', domain: 'adobe.com' },
		{ id: 'hulu', name: 'Hulu', category: 'streaming', monthly: 17.99, nextBilling: '2026-09-09', status: 'cancelled', domain: 'hulu.com' },
		{ id: 'nyt', name: 'The New York Times', category: 'news', monthly: 17.0, nextBilling: '2026-10-01', status: 'active', domain: 'nytimes.com' },
		{ id: 'planet', name: 'Planet Fitness', category: 'fitness', monthly: 22.99, nextBilling: '2026-09-15', status: 'active', domain: 'planetfitness.com' },
		{ id: 'canva', name: 'Canva Pro', category: 'software', monthly: 14.99, nextBilling: '2026-09-28', status: 'trial', domain: 'canva.com' },
		{ id: 'disney', name: 'Disney+', category: 'streaming', monthly: 15.99, nextBilling: '2026-09-20', status: 'cancelled', domain: 'disneyplus.com' },
		{ id: 'dropbox', name: 'Dropbox', category: 'software', monthly: 11.99, nextBilling: '2026-09-25', status: 'active', domain: 'dropbox.com' },
		{ id: 'audible', name: 'Audible', category: 'news', monthly: 14.95, nextBilling: '2026-09-14', status: 'active', domain: 'audible.com' },
		{ id: 'nord', name: 'NordVPN', category: 'software', monthly: 12.99, nextBilling: '2026-10-05', status: 'trial', domain: 'nordvpn.com' },
		{ id: 'linkedin', name: 'LinkedIn Premium', category: 'software', monthly: 29.99, nextBilling: '2026-09-30', status: 'active', domain: 'linkedin.com' },
		{ id: 'paramount', name: 'Paramount+', category: 'streaming', monthly: 11.99, nextBilling: '2026-10-02', status: 'active', domain: 'paramountplus.com' },
		{ id: 'samsclub', name: 'Sam\'s Club Plus', category: 'software', monthly: 9.17, nextBilling: '2026-10-14', status: 'active', domain: 'samsclub.com' },
	];

	const root = document.querySelector<HTMLElement>('[data-dashboard]');
	const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
	const appShell = document.querySelector<HTMLElement>('[data-app-shell]');
	const loadingState = document.querySelector<HTMLElement>('[data-loading-state]');
	const listEl = document.querySelector<HTMLElement>('[data-sub-list]');
	const emptyTable = document.querySelector<HTMLElement>('[data-table-empty]');
	const historyList = document.querySelector<HTMLElement>('[data-history-list]');
	const connectedLabel = document.querySelector<HTMLElement>('[data-connected-label]');
	const burnBeforeEl = document.querySelector<HTMLElement>('[data-burn-before]');
	const burnAfterEl = document.querySelector<HTMLElement>('[data-burn-after]');
	const savedMonthlyEl = document.querySelector<HTMLElement>('[data-saved-monthly]');
	const savedYearlyEl = document.querySelector<HTMLElement>('[data-saved-yearly]');
	const emptySubsEl = document.querySelector<HTMLElement>('[data-empty-subscriptions]');
	const scanFailedEl = document.querySelector<HTMLElement>('[data-scan-failed]');
	const allCancelledEl = document.querySelector<HTMLElement>('[data-all-cancelled]');
	const nothingCancelledEl = document.querySelector<HTMLElement>('[data-nothing-cancelled]');
	const subsTable = document.querySelector<HTMLElement>('[data-subs-table]');
	const listLoading = document.querySelector<HTMLElement>('[data-list-loading]');

	let scanFailed = new URLSearchParams(window.location.search).get('scan') === 'failed';
	let filter: 'all' | SubStatus = 'all';
	let sort: 'amount' | 'renewal' | 'category' = 'amount';
	let subs: Subscription[] = loadSubs();

	const USER_PLAN_KEY = 'cancelkit-user-plan';
	let userPlan: 'free' | 'pro' | 'family' = 'free';

	const dashUrlParams = new URLSearchParams(window.location.search);
	if (dashUrlParams.get('upgraded') === 'true') {
		userPlan = 'pro';
		localStorage.setItem(USER_PLAN_KEY, 'pro');
		const upgradeBanner = document.getElementById('dash-upgrade-banner');
		if (upgradeBanner) upgradeBanner.hidden = false;
	} else {
		userPlan = (localStorage.getItem(USER_PLAN_KEY) as any) || 'free';
	}

	function updatePlanBadgeUi() {
		const planBadgeWrap = document.getElementById('dash-plan-badge-wrap');
		if (planBadgeWrap) {
			const badge = planBadgeWrap.querySelector('.plan-badge') as HTMLElement;
			if (badge) {
				badge.className = `plan-badge plan-badge--${userPlan}`;
				badge.textContent = userPlan === 'pro' ? 'Pro ✓' : userPlan === 'family' ? 'Family' : 'Free plan';
			}
		}
	}
	updatePlanBadgeUi();

	document.getElementById('dash-upgrade-close')?.addEventListener('click', () => {
		const banner = document.getElementById('dash-upgrade-banner');
		if (banner) banner.hidden = true;
	});

	function loadSubs(): Subscription[] {
		const params = new URLSearchParams(window.location.search);
		if (params.get('empty') === '1') {
			localStorage.setItem(SUBS_KEY, JSON.stringify([]));
			return [];
		}
		try {
			const raw = localStorage.getItem(SUBS_KEY);
			if (raw !== null) return JSON.parse(raw) as Subscription[];
		} catch {
			/* ignore */
		}
		return structuredClone(seed);
	}

	function saveSubs() {
		localStorage.setItem(SUBS_KEY, JSON.stringify(subs));
	}

	function money(n: number) {
		return new Intl.NumberFormat('en-US', {
			style: 'currency',
			currency: 'USD',
			minimumFractionDigits: n % 1 === 0 ? 0 : 2,
			maximumFractionDigits: 2,
		}).format(n);
	}

	function formatDate(iso: string) {
		const d = new Date(`${iso}T12:00:00`);
		return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
	}

	function initial(name: string) {
		return name.trim().charAt(0).toUpperCase();
	}

	function faviconUrl(domain?: string) {
		if (!domain) return '';
		return `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`;
	}

	function isConnected() {
		const params = new URLSearchParams(window.location.search);
		if (params.get('connected') === '1' || params.get('empty') === '1') return true;
		const val = localStorage.getItem(STORAGE_KEY);
		return val === '1' || val === 'true';
	}

	function setConnected(provider: string) {
		localStorage.setItem(STORAGE_KEY, '1');
		localStorage.setItem(PROVIDER_KEY, provider);
		const label = provider === 'outlook' ? 'Outlook' : 'Gmail';
		if (connectedLabel) connectedLabel.textContent = `Connected: ${label}`;
		showApp(true);
	}

	function setLoading(loading: boolean) {
		root?.setAttribute('data-loading', String(loading));
		loadingState?.toggleAttribute('hidden', !loading);
		if (loading) {
			emptyState?.toggleAttribute('hidden', true);
			appShell?.toggleAttribute('hidden', true);
		}
	}

	function showApp(connected: boolean) {
		setLoading(false);
		root?.setAttribute('data-connected', String(connected));
		emptyState?.toggleAttribute('hidden', connected);
		appShell?.toggleAttribute('hidden', !connected);
		if (connected) {
			const provider = localStorage.getItem(PROVIDER_KEY) || 'gmail';
			const label = provider === 'outlook' ? 'Outlook' : 'Gmail';
			if (connectedLabel) connectedLabel.textContent = `Connected: ${label}`;
			render();
		}
	}

	function visibleSubs() {
		let rows = [...subs];
		if (filter !== 'all') rows = rows.filter((s) => s.status === filter);

		rows.sort((a, b) => {
			if (sort === 'amount') return b.monthly - a.monthly;
			if (sort === 'renewal') return a.nextBilling.localeCompare(b.nextBilling);
			return a.category.localeCompare(b.category) || a.name.localeCompare(b.name);
		});
		return rows;
	}

	function totals() {
		const before = subs.reduce((sum, sub) => sum + sub.monthly, 0);
		const after = subs.filter((sub) => sub.status !== 'cancelled').reduce((sum, sub) => sum + sub.monthly, 0);
		const saved = before - after;
		return { before, after, saved, yearly: saved * 12 };
	}

	function escapeHtml(value: string) {
		return value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;');
	}

	function renderStats() {
		const { before, after, saved, yearly } = totals();
		if (burnBeforeEl) burnBeforeEl.textContent = `${money(before)}/mo`;
		if (burnAfterEl) burnAfterEl.textContent = `${money(after)}/mo`;
		if (savedMonthlyEl) savedMonthlyEl.textContent = `You saved ${money(saved)}/mo`;
		if (savedYearlyEl) savedYearlyEl.textContent = `Yearly saving: ${money(yearly)}`;
	}

	function renderHistory() {
		if (!historyList) return;
		const cancelled = subs.filter((sub) => sub.status === 'cancelled');
		const firstActive = subs.find((sub) => sub.status !== 'cancelled');
		nothingCancelledEl?.toggleAttribute('hidden', cancelled.length > 0 || !firstActive);
		if (firstActive) {
			const name = nothingCancelledEl?.querySelector<HTMLElement>('[data-nudge-name]');
			const meta = nothingCancelledEl?.querySelector<HTMLElement>('[data-nudge-meta]');
			const avatar = nothingCancelledEl?.querySelector<HTMLElement>('[data-nudge-initial]');
			const cancel = nothingCancelledEl?.querySelector<HTMLButtonElement>('[data-nudge-cancel]');
			if (name) name.textContent = firstActive.name;
			if (meta) meta.textContent = `${money(firstActive.monthly)}/mo`;
			if (avatar) avatar.textContent = initial(firstActive.name);
			if (cancel) cancel.dataset.nudgeCancel = firstActive.id;
		}
		historyList.innerHTML = cancelled.map((sub) =>
			`<li><span>${escapeHtml(sub.name)}</span><span class="dash__saved-inline">Saved ${money(sub.monthly)}/mo</span></li>`,
		).join('');
	}

	function renderList() {
		if (!listEl) return;
		const rows = visibleSubs();
		const active = subs.filter((sub) => sub.status !== 'cancelled');
		const everythingCancelled = subs.length > 0 && active.length === 0;
		const showScanFailure = scanFailed;
		const showEmpty = !showScanFailure && subs.length === 0;
		const showCelebration = !showScanFailure && !showEmpty && everythingCancelled;

		scanFailedEl?.toggleAttribute('hidden', !showScanFailure);
		emptySubsEl?.toggleAttribute('hidden', !showEmpty);
		allCancelledEl?.toggleAttribute('hidden', !showCelebration);
		subsTable?.toggleAttribute('hidden', showScanFailure || showEmpty || showCelebration);
		emptyTable?.toggleAttribute('hidden', showScanFailure || showEmpty || showCelebration || rows.length > 0);
		if (showCelebration) {
			const { yearly } = totals();
			const saved = allCancelledEl?.querySelector<HTMLElement>('[data-saved-total]');
			const share = allCancelledEl?.querySelector<HTMLAnchorElement>('[data-share-savings]');
			if (saved) saved.textContent = money(yearly);
			if (share) share.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`I just cancelled every subscription on my list and saved ${money(yearly)} a year with CancelKits. ⚡`)}`;
		}

		const gateWrap = document.getElementById('dash-gate-wrap');
		if (showScanFailure || showEmpty || showCelebration) {
			if (gateWrap) gateWrap.hidden = true;
			listEl.innerHTML = '';
			return;
		}

		const displayedRows = userPlan === 'free' ? rows.slice(0, 10) : rows;
		if (gateWrap) gateWrap.hidden = !(userPlan === 'free' && rows.length > 10);
		const gateTitle = document.getElementById('dash-gate-title');
		if (gateTitle && userPlan === 'free' && rows.length > 10) {
			gateTitle.textContent = `Upgrade to Pro to see all ${rows.length} subscriptions`;
		}

		listEl.innerHTML = displayedRows.map((sub) => {
			const cancelled = sub.status === 'cancelled';
			const icon = faviconUrl(sub.domain);
			const cleanSlug = sub.id.replace(/^custom-/, '').toLowerCase();
			const hasGuide = !sub.id.startsWith('custom-');
			const guideLink = hasGuide ? `<a href="/cancel/${escapeHtml(cleanSlug)}" target="_blank" class="dash__guide-link" rel="noopener">Guide ↗</a>` : '';
			const action = cancelled
				? `<div class="dash__saved-action-group"><span class="dash__saved-badge">Saved ${money(sub.monthly)}</span><button type="button" class="dash__restore-btn" data-restore="${escapeHtml(sub.id)}" title="Undo cancellation">↺ Restore</button></div>`
				: `<div class="dash__action-cell">${guideLink}<button type="button" class="dash__cancel" data-cancel="${escapeHtml(sub.id)}">Cancel</button></div>`;
			return `<tr class="${cancelled ? 'is-cancelled-row' : ''}">
				<td><div class="dash__svc"><span class="dash__logo" data-initial="${initial(sub.name)}">${icon ? `<img src="${icon}" alt="" width="20" height="20" loading="lazy" onerror="this.remove()" />` : ''}</span><div><div class="dash__svc-name ${cancelled ? 'is-cancelled' : ''}">${escapeHtml(sub.name)}</div><span class="dash__tag">${escapeHtml(sub.category)}</span></div></div></td>
				<td><div class="dash__amount">${money(sub.monthly)}</div><div class="dash__annual">${money(sub.monthly * 12)}/yr</div></td>
				<td class="dash__date">${formatDate(sub.nextBilling)}</td><td class="dash__actions">${action}</td>
			</tr>`;
		}).join('');

	}

	function render() {
		renderStats();
		renderList();
		renderHistory();
	}

	async function cancelSub(id: string) {
		const item = subs.find((s) => s.id === id);
		if (!item || item.status === 'cancelled') return;
		item.status = 'cancelled';
		saveSubs();
		render();

		// Asynchronously sync cancellation to Supabase cancel_history
		try {
			const { data: { session } } = await supabase.auth.getSession();
			if (session?.user?.id) {
				await supabase.from('cancel_history').insert({
					user_id: session.user.id,
					subscription_name: item.name,
					monthly_savings: item.monthly,
					annual_savings: item.monthly * 12,
					method: 'one_click',
					status: 'completed',
					cancelled_at: new Date().toISOString(),
				});

				await supabase
					.from('subscriptions')
					.update({ status: 'cancelled' })
					.eq('user_id', session.user.id)
					.eq('name', item.name);
			}
		} catch (dbErr) {
			console.warn('Could not sync cancellation to Supabase:', dbErr);
		}

		// Trigger viral referral popup right after emotional satisfaction of cancelling!
		showViralReferralModal(item.name, item.monthly);
	}

	async function restoreSub(id: string) {
		const item = subs.find((s) => s.id === id);
		if (!item || item.status !== 'cancelled') return;
		item.status = 'active';
		saveSubs();
		render();

		try {
			const { data: { session } } = await supabase.auth.getSession();
			if (session?.user?.id) {
				await supabase
					.from('subscriptions')
					.update({ status: 'active' })
					.eq('user_id', session.user.id)
					.eq('name', item.name);
			}
		} catch (dbErr) {
			console.warn('Could not sync restore to Supabase:', dbErr);
		}
	}

	function showViralReferralModal(serviceName: string, monthlyAmount: number) {
		const modal = document.getElementById('viral-referral-modal');
		const amountEl = document.getElementById('viral-saved-amount');
		const linkInput = document.getElementById('viral-ref-link-input') as HTMLInputElement;
		const twitterBtn = document.getElementById('viral-twitter-btn') as HTMLAnchorElement;
		const waBtn = document.getElementById('viral-whatsapp-btn') as HTMLAnchorElement;

		if (amountEl) amountEl.textContent = `$${monthlyAmount.toFixed(2)}`;

		const userCode = localStorage.getItem('cancelkit-my-referral-code') || 'kit-me';
		const referralUrl = `${window.location.origin}/r/${userCode}`;

		if (linkInput) linkInput.value = referralUrl;

		if (twitterBtn) {
			const text = encodeURIComponent(
				`I just cancelled ${serviceName} and saved $${monthlyAmount.toFixed(2)}/month with @CancelKits 🎉 Try it free: ${referralUrl}`
			);
			twitterBtn.href = `https://twitter.com/intent/tweet?text=${text}`;
		}

		if (waBtn) {
			const text = encodeURIComponent(
				`I just cancelled ${serviceName} and saved $${monthlyAmount.toFixed(2)}/month with CancelKits 🎉 Get your first month free: ${referralUrl}`
			);
			waBtn.href = `https://api.whatsapp.com/send?text=${text}`;
		}

		if (modal) modal.hidden = false;
	}

	// Modal dismiss & copy handlers
	document.getElementById('viral-modal-close-btn')?.addEventListener('click', () => {
		const modal = document.getElementById('viral-referral-modal');
		if (modal) modal.hidden = true;
	});

	document.getElementById('viral-referral-modal')?.addEventListener('click', (e) => {
		if (e.target === document.getElementById('viral-referral-modal')) {
			const modal = document.getElementById('viral-referral-modal');
			if (modal) modal.hidden = true;
		}
	});

	document.getElementById('viral-copy-btn')?.addEventListener('click', async () => {
		const linkInput = document.getElementById('viral-ref-link-input') as HTMLInputElement;
		const copyBtn = document.getElementById('viral-copy-btn') as HTMLButtonElement;
		if (!linkInput || !copyBtn) return;

		try {
			await navigator.clipboard.writeText(linkInput.value);
			copyBtn.textContent = 'Copied! ✓';
			setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
		} catch {
			linkInput.select();
			document.execCommand('copy');
			copyBtn.textContent = 'Copied! ✓';
			setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
		}
	});

	// Events
	document.getElementById('dash-upgrade-btn')?.addEventListener('click', async () => {
		const btn = document.getElementById('dash-upgrade-btn') as HTMLButtonElement;
		if (!btn) return;
		btn.disabled = true;
		const btnText = btn.querySelector('.btn-text') as HTMLElement;
		const btnSpinner = btn.querySelector('.btn-spinner') as HTMLElement;
		if (btnText) btnText.textContent = 'Opening checkout...';
		if (btnSpinner) btnSpinner.hidden = false;

		try {
			const { data: { session } } = await supabase.auth.getSession();
			const res = await fetch('/api/create-checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					priceId: 'price_pro_monthly_9',
					userId: session?.user?.id || '',
					email: session?.user?.email || '',
				}),
			});

			const data = await res.json();
			if (data?.url) {
				window.location.href = data.url;
			} else {
				window.location.href = '/pricing';
			}
		} catch {
			window.location.href = '/pricing';
		}
	});

	document.querySelectorAll<HTMLButtonElement>('[data-connect]').forEach((btn) => {
		btn.addEventListener('click', () => setConnected(btn.dataset.connect || 'gmail'));
	});

	document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
		btn.addEventListener('click', () => {
			filter = (btn.dataset.filter || 'all') as typeof filter;
			document.querySelectorAll('[data-filter]').forEach((el) => {
				const active = el === btn;
				el.classList.toggle('is-active', active);
				el.setAttribute('aria-selected', String(active));
			});
			renderList();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((btn) => {
		btn.addEventListener('click', () => {
			sort = (btn.dataset.sort || 'amount') as typeof sort;
			document.querySelectorAll('[data-sort]').forEach((el) => el.classList.toggle('is-active', el === btn));
			renderList();
		});
	});

	listEl?.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		const cancelBtn = target?.closest<HTMLButtonElement>('[data-cancel]');
		if (cancelBtn?.dataset.cancel) {
			cancelSub(cancelBtn.dataset.cancel);
			return;
		}
		const restoreBtn = target?.closest<HTMLButtonElement>('[data-restore]');
		if (restoreBtn?.dataset.restore) {
			restoreSub(restoreBtn.dataset.restore);
			return;
		}
	});

	document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((link) => {
		link.addEventListener('click', () => {
			document.querySelectorAll('[data-nav]').forEach((el) => el.classList.toggle('is-active', el === link));
		});
	});

	// Modal & Custom Subscriptions
	const modal = document.getElementById('add-sub-modal') as HTMLDialogElement | null;
	const form = document.getElementById('add-sub-form') as HTMLFormElement | null;
	
	const openModal = () => modal?.showModal();
	const closeModal = () => modal?.close();

	document.querySelector('[data-add-sub]')?.addEventListener('click', openModal);
	document.querySelector('[data-add-sub-clean]')?.addEventListener('click', openModal);
	document.querySelectorAll<HTMLButtonElement>('[data-add-manual]').forEach((button) => {
		button.addEventListener('click', openModal);
	});
	document.querySelector<HTMLButtonElement>('[data-nudge-cancel]')?.addEventListener('click', (event) => {
		const button = event.currentTarget;
		if (button.dataset.nudgeCancel) cancelSub(button.dataset.nudgeCancel);
	});
	document.querySelector<HTMLButtonElement>('[data-reconnect-email]')?.addEventListener('click', () => {
		window.location.href = '/onboarding/connect';
	});
	document.querySelector<HTMLButtonElement>('[data-retry-scan]')?.addEventListener('click', () => {
		window.location.href = '/onboarding/connect';
	});
	document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
	document.getElementById('modal-cancel-btn')?.addEventListener('click', closeModal);

	document.querySelector('[data-reset-subs]')?.addEventListener('click', () => {
		if (confirm('Clear all demo subscriptions and reset your dashboard to $0?')) {
			subs = [];
			saveSubs();
			render();
		}
	});

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const formData = new FormData(form);
		const name = String(formData.get('name') || '').trim();
		const monthly = parseFloat(String(formData.get('monthly') || '0')) || 0;
		const category = (formData.get('category') || 'software') as SubCategory;
		const nextBilling = String(formData.get('nextBilling') || new Date().toISOString().slice(0, 10));

		if (name && monthly > 0) {
			const newSub: Subscription = {
				id: 'sub-' + Date.now(),
				name,
				category,
				monthly,
				nextBilling,
				status: 'active',
			};
			subs.unshift(newSub);
			saveSubs();
			render();
			form.reset();
			closeModal();
		}
	});

	const urlParams = new URLSearchParams(window.location.search);
	if (urlParams.get('action') === 'add') {
		setTimeout(openModal, 400);
	}

	showApp(isConnected());
</script>


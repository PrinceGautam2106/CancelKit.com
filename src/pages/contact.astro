---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Contact Us — CancelKits';
const description = 'Get in touch with the CancelKits team for support, cancellation questions, partnerships, or billing assistance.';
---

<BaseLayout {title} {description}>
	<Nav />
	<main class="contact-page">
		<div class="contact-container">
			<header class="contact-header">
				<span class="contact-badge">Support & Inquiries</span>
				<h1>Get in Touch</h1>
				<p class="contact-subtitle">
					Have a question about a subscription, billing, or need help cancelling? We respond to all inquiries within 24 hours.
				</p>
			</header>

			<div class="contact-grid">
				<!-- Contact Form (No <form> tag, client JS handler) -->
				<div class="contact-card" role="region" aria-label="Contact form">
					<h2>Send us a message</h2>

					<div class="form-fields">
						<div class="input-field">
							<label for="contact-name">Your Name</label>
							<input type="text" id="contact-name" placeholder="Sarah Connor" autocomplete="name" />
							<p class="field-error" id="name-error"></p>
						</div>

						<div class="input-field">
							<label for="contact-email">Email Address</label>
							<input type="email" id="contact-email" placeholder="sarah@example.com" autocomplete="email" />
							<p class="field-error" id="email-error"></p>
						</div>

						<div class="input-field">
							<label for="contact-subject">Topic</label>
							<select id="contact-subject" class="select-field">
								<option value="support">Customer Support & Help</option>
								<option value="billing">Billing & Refunds (7-Day Guarantee)</option>
								<option value="cancel-guide">Request a New Cancellation Guide</option>
								<option value="privacy">Privacy & Data Deletion</option>
								<option value="press">Partnership & Press</option>
							</select>
						</div>

						<div class="input-field">
							<label for="contact-message">Message</label>
							<textarea id="contact-message" rows="5" placeholder="How can we help you save today?"></textarea>
							<p class="field-error" id="message-error"></p>
						</div>

						<button type="button" class="btn-submit" id="contact-submit-btn">
							<span class="btn-text">Send Message →</span>
							<span class="btn-spinner" hidden></span>
						</button>
					</div>

					<div class="contact-success" id="contact-success" hidden>
						<div class="success-icon">✓</div>
						<h3>Message Received!</h3>
						<p>Thank you for reaching out. A support specialist from CancelKits will review your message and reply to your email within 24 hours.</p>
					</div>
				</div>

				<!-- Contact Info & Quick FAQs -->
				<div class="contact-sidebar">
					<div class="info-card">
						<h3>Direct Contact</h3>
						<ul class="info-list">
							<li>
								<span class="info-label">Customer Support:</span>
								<a href="mailto:support@cancelkits.com" class="info-val">support@cancelkits.com</a>
							</li>
							<li>
								<span class="info-label">Billing & Refunds:</span>
								<a href="mailto:billing@cancelkits.com" class="info-val">billing@cancelkits.com</a>
							</li>
							<li>
								<span class="info-label">General & Press:</span>
								<a href="mailto:hello@cancelkits.com" class="info-val">hello@cancelkits.com</a>
							</li>
							<li>
								<span class="info-label">Privacy Officer:</span>
								<a href="mailto:privacy@cancelkits.com" class="info-val">privacy@cancelkits.com</a>
							</li>
						</ul>
					</div>

					<div class="info-card">
						<h3>Frequently Asked Questions</h3>
						<div class="sidebar-faq">
							<div class="faq-snippet">
								<strong>How do refunds work?</strong>
								<p>We offer a 100% money-back guarantee within 7 days of purchase. Simply email billing@cancelkits.com.</p>
							</div>
							<div class="faq-snippet">
								<strong>Can I delete all my scanned receipts?</strong>
								<p>Yes, at any time in your <a href="/account">Account Settings</a> with one click under the Danger Zone.</p>
							</div>
							<div class="faq-snippet">
								<strong>Need a step-by-step cancel guide?</strong>
								<p>Browse our directory of over 50+ cancellation guides at <a href="/cancel">/cancel</a>.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
	<Footer />
</BaseLayout>

<script>
	const nameInput = document.getElementById('contact-name') as HTMLInputElement;
	const emailInput = document.getElementById('contact-email') as HTMLInputElement;
	const subjectSelect = document.getElementById('contact-subject') as HTMLSelectElement;
	const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;

	const nameError = document.getElementById('name-error') as HTMLParagraphElement;
	const emailError = document.getElementById('email-error') as HTMLParagraphElement;
	const messageError = document.getElementById('message-error') as HTMLParagraphElement;

	const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
	const formFields = document.querySelector('.form-fields') as HTMLDivElement;
	const successEl = document.getElementById('contact-success') as HTMLDivElement;

	function clearErrors() {
		[nameError, emailError, messageError].forEach((el) => {
			if (el) el.textContent = '';
		});
	}

	submitBtn?.addEventListener('click', async () => {
		clearErrors();

		const name = nameInput.value.trim();
		const email = emailInput.value.trim();
		const message = messageInput.value.trim();

		let hasError = false;

		if (!name) {
			if (nameError) nameError.textContent = 'Please enter your name.';
			hasError = true;
		}

		if (!email || !email.includes('@') || !email.includes('.')) {
			if (emailError) emailError.textContent = 'Please enter a valid email address.';
			hasError = true;
		}

		if (!message || message.length < 10) {
			if (messageError) messageError.textContent = 'Please provide a message with at least 10 characters.';
			hasError = true;
		}

		if (hasError) return;

		submitBtn.disabled = true;
		const btnText = submitBtn.querySelector('.btn-text') as HTMLElement;
		const btnSpinner = submitBtn.querySelector('.btn-spinner') as HTMLElement;
		if (btnText) btnText.textContent = 'Sending...';
		if (btnSpinner) btnSpinner.hidden = false;

		// Simulate API dispatch or call internal send-email
		setTimeout(() => {
			if (formFields) formFields.hidden = true;
			if (successEl) successEl.hidden = false;
		}, 800);
	});
</script>

<style>
	.contact-page {
		min-height: 100svh;
		padding: 4rem 1.5rem 6rem;
		background:
			radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0, 255, 136, 0.06), transparent 70%),
			#050505;
		color: #ccc;
		font-family: var(--font-body);
	}

	.contact-container {
		max-width: 68rem;
		margin: 0 auto;
	}

	.contact-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.contact-badge {
		display: inline-block;
		padding: 0.25rem 0.65rem;
		border-radius: var(--radius-pill);
		background: rgba(0, 255, 136, 0.1);
		color: var(--color-accent);
		border: 1px solid rgba(0, 255, 136, 0.25);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.contact-header h1 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.contact-subtitle {
		margin: 0 auto;
		font-size: 1.05rem;
		color: var(--color-muted);
		max-width: 34rem;
		line-height: 1.55;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 2.5rem;
		align-items: flex-start;
	}

	.contact-card {
		padding: 2.5rem 2.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
	}

	.contact-card h2 {
		margin: 0 0 1.75rem;
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 600;
		color: #fff;
	}

	.form-fields {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.input-field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.input-field label {
		font-size: 0.82rem;
		font-weight: 500;
		color: #bbb;
	}

	.input-field input,
	.input-field select,
	.input-field textarea {
		width: 100%;
		padding: 0.8rem 0.95rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: #111;
		color: #fff;
		font-family: var(--font-body);
		font-size: 0.92rem;
		box-sizing: border-box;
		outline: none;
		transition: border-color 0.15s;
	}

	.input-field input:focus,
	.input-field select:focus,
	.input-field textarea:focus {
		border-color: rgba(0, 255, 136, 0.5);
	}

	.field-error {
		margin: 0.2rem 0 0;
		color: var(--color-danger);
		font-size: 0.74rem;
		min-height: 0.9rem;
	}

	.field-error:empty {
		display: none;
	}

	.btn-submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.95rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 700;
		border: 0;
		cursor: pointer;
		margin-top: 0.5rem;
		box-shadow: 0 0 20px rgba(0, 255, 136, 0.25);
		transition: transform 0.15s, box-shadow 0.15s;
	}

	.btn-submit:hover:not(:disabled) {
		transform: translateY(-1px);
		box-shadow: 0 0 30px rgba(0, 255, 136, 0.4);
	}

	.btn-submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.btn-spinner {
		width: 16px;
		height: 16px;
		border: 2px solid rgba(0, 0, 0, 0.3);
		border-top-color: #000;
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	.contact-success {
		text-align: center;
		padding: 2rem 1rem;
	}

	.success-icon {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(0, 255, 136, 0.15);
		color: var(--color-accent);
		display: grid;
		place-items: center;
		font-size: 1.5rem;
		margin: 0 auto 1.25rem;
	}

	.contact-success h3 {
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: 1.4rem;
		color: #fff;
	}

	.contact-success p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-muted);
		line-height: 1.5;
	}

	/* Sidebar */
	.contact-sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.info-card {
		padding: 1.75rem 1.5rem;
		background: #090909;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.info-card h3 {
		margin: 0 0 1.25rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		color: #fff;
	}

	.info-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
	}

	.info-label {
		display: block;
		font-size: 0.76rem;
		color: #777;
		text-transform: uppercase;
		font-family: var(--font-mono);
		margin-bottom: 0.15rem;
	}

	.info-val {
		color: var(--color-accent);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
	}

	.info-val:hover {
		text-decoration: underline;
	}

	.sidebar-faq {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.faq-snippet strong {
		display: block;
		font-size: 0.88rem;
		color: #ddd;
		margin-bottom: 0.25rem;
	}

	.faq-snippet p {
		margin: 0;
		font-size: 0.82rem;
		color: #888;
		line-height: 1.45;
	}

	.faq-snippet a {
		color: var(--color-accent);
		text-decoration: underline;
	}

	@media (max-width: 840px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

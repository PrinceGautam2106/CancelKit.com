---
import { locales, type Locale } from '../i18n/translations';
import PlanBadge from './PlanBadge.astro';
const navigation = [
	{ label: 'Features', href: '/#features' },
	{ label: 'How it works', href: '/#how-it-works' },
	{ label: 'Cancel guides', href: '/cancel' },
	{ label: 'Pricing', href: '/pricing' },
	{ label: 'Refer & Earn', href: '/refer' },
	{ label: 'Blog', href: '/blog' },
];
const currentLang = (Astro.url.pathname.split('/')[1] || 'en') as Locale;
---

<header class="nav-header">
	<nav class="nav" aria-label="Main navigation">
		<a class="nav__logo" href="/" aria-label="CancelKit home">
			<span class="nav__logo-icon">C</span>
			<span class="nav__logo-text">Cancel<span>K<span class="nav__logo-accent">i</span>t</span></span>
		</a>

		<div class="nav__links">
			{navigation.map((item) => <a class="nav__link" href={item.href}>{item.label}</a>)}
		</div>

		<div class="nav__actions">
			<select data-language-switcher class="nav__lang" aria-label="Language">
				{locales.map((lang) => <option value={lang} selected={lang === currentLang}>{lang.toUpperCase()}</option>)}
			</select>
			<a class="nav__plan-wrap" id="nav-plan-badge" href="/account" hidden>
				<PlanBadge plan="free" />
			</a>
			<a class="nav__signin" id="nav-signin-link" href="/signin">Sign in</a>
			<a class="nav__cta" id="nav-cta-link" href="/start">Start free</a>
		</div>

		<button class="nav__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle aria-label="Toggle navigation menu">
			<svg data-menu-icon-open width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
			<svg class="hidden" data-menu-icon-close width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
		</button>
	</nav>
</header>

<div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
	<nav class="mobile-menu__nav" aria-label="Mobile navigation">
		<div class="mobile-menu__links">
			{navigation.map((item) => <a class="mobile-menu__link" href={item.href}>{item.label}</a>)}
		</div>

		<div class="mobile-menu__lang-row">
			<span class="mobile-menu__lang-label">Language:</span>
			<div class="mobile-menu__lang-pills">
				{locales.map((lang) => (
					<button
						type="button"
						class:list={['mobile-menu__lang-pill', lang === currentLang && 'is-active']}
						data-set-lang={lang}
					>
						{lang.toUpperCase()}
					</button>
				))}
			</div>
		</div>

		<div class="mobile-menu__actions">
			<a class="mobile-menu__plan-wrap" id="mobile-plan-badge" href="/account" hidden>
				<PlanBadge plan="free" />
			</a>
			<a class="mobile-menu__signin" id="mobile-signin-link" href="/signin">Sign in</a>
			<a class="mobile-menu__cta" id="mobile-cta-link" href="/start">Start free →</a>
		</div>
	</nav>
</div>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
	const openIcon = document.querySelector<SVGElement>('[data-menu-icon-open]');
	const closeIcon = document.querySelector<SVGElement>('[data-menu-icon-close]');

	const setMenuState = (open: boolean) => {
		if (menu) menu.hidden = !open;
		toggle?.setAttribute('aria-expanded', String(open));
		openIcon?.classList.toggle('hidden', open);
		closeIcon?.classList.toggle('hidden', !open);
		document.body.style.overflow = open ? 'hidden' : '';
	};

	toggle?.addEventListener('click', () => {
		const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
		setMenuState(!isExpanded);
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenuState(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setMenuState(false);
	});

	const goToLanguage = (language: string) => {
		localStorage.setItem('cancelkit-language', language);
		window.location.href = language === 'en' ? '/' : `/${language}/`;
	};

	const languageSwitcher = document.querySelector<HTMLSelectElement>('[data-language-switcher]');
	languageSwitcher?.addEventListener('change', () => goToLanguage(languageSwitcher.value));

	document.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const lang = btn.dataset.setLang;
			if (lang) goToLanguage(lang);
		});
	});

	if (window.location.pathname === '/' && !localStorage.getItem('cancelkit-language')) {
		const detected = navigator.language.slice(0, 2);
		if (['es', 'fr', 'de', 'pt'].includes(detected)) goToLanguage(detected);
	}

	import { supabase } from '../lib/supabase';

	async function checkUserNav() {
		try {
			const { data: { session } } = await supabase.auth.getSession();
			if (session) {
				const plan = (localStorage.getItem('cancelkit-user-plan') || 'free') as 'free' | 'pro' | 'family';
				const navPlan = document.getElementById('nav-plan-badge');
				const mobilePlan = document.getElementById('mobile-plan-badge');
				const signinLink = document.getElementById('nav-signin-link');
				const mobileSigninLink = document.getElementById('mobile-signin-link');
				const ctaLink = document.getElementById('nav-cta-link');
				const mobileCtaLink = document.getElementById('mobile-cta-link');

				if (navPlan) {
					navPlan.hidden = false;
					const badge = navPlan.querySelector('.plan-badge') as HTMLElement;
					if (badge) {
						badge.className = `plan-badge plan-badge--${plan}`;
						badge.textContent = plan === 'pro' ? 'Pro ✓' : plan === 'family' ? 'Family' : 'Free plan';
					}
				}
				if (mobilePlan) {
					mobilePlan.hidden = false;
					const badge = mobilePlan.querySelector('.plan-badge') as HTMLElement;
					if (badge) {
						badge.className = `plan-badge plan-badge--${plan}`;
						badge.textContent = plan === 'pro' ? 'Pro ✓' : plan === 'family' ? 'Family' : 'Free plan';
					}
				}

				if (signinLink) {
					signinLink.textContent = 'Dashboard';
					signinLink.setAttribute('href', '/dashboard');
				}
				if (mobileSigninLink) {
					mobileSigninLink.textContent = 'Dashboard';
					mobileSigninLink.setAttribute('href', '/dashboard');
				}
				if (ctaLink) {
					ctaLink.textContent = 'Account';
					ctaLink.setAttribute('href', '/account');
				}
				if (mobileCtaLink) {
					mobileCtaLink.textContent = 'Account →';
					mobileCtaLink.setAttribute('href', '/account');
				}
			}
		} catch {
			/* ignore */
		}
	}
	checkUserNav();
</script>

<style>
	.nav-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		background: rgba(5, 5, 5, 0.85);
		backdrop-filter: blur(16px) saturate(1.8);
		-webkit-backdrop-filter: blur(16px) saturate(1.8);
	}

	.nav {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 1rem;
		height: 60px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.nav {
			padding: 0 1.5rem;
			height: 64px;
		}
	}

	.nav__logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		flex-shrink: 0;
	}

	.nav__logo-icon {
		display: grid;
		place-items: center;
		width: 1.65rem;
		height: 1.65rem;
		border-radius: 7px;
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.nav__logo-text {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.nav__logo-accent {
		color: var(--color-accent);
	}

	.nav__links {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}

	.nav__link {
		padding: 0.4rem 0.7rem;
		border-radius: var(--radius-sm);
		color: var(--color-muted);
		font-size: 0.875rem;
		font-weight: 450;
		text-decoration: none;
		transition: color 0.2s, background 0.2s;
	}

	.nav__link:hover {
		color: #fff;
		background: rgba(255, 255, 255, 0.04);
	}

	.nav__actions {
		display: none;
		align-items: center;
		gap: 0.5rem;
	}

	.nav__lang {
		appearance: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		color: var(--color-muted);
		font: inherit;
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.3rem 0.5rem;
		cursor: pointer;
	}

	.nav__signin {
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-sm);
		color: #ccc;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 0.2s;
	}

	.nav__signin:hover {
		color: #fff;
	}

	.nav__cta {
		padding: 0.45rem 1rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition: opacity 0.2s, transform 0.2s;
		white-space: nowrap;
	}

	.nav__cta:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}

	.nav__burger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: none;
		border: 0;
		color: #fff;
		cursor: pointer;
		padding: 0;
		border-radius: var(--radius-sm);
	}

	.nav__burger:active {
		background: rgba(255, 255, 255, 0.08);
	}

	.hidden {
		display: none !important;
	}

	/* Mobile Menu */
	.mobile-menu {
		position: fixed;
		top: 60px;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 45;
		background: rgba(5, 5, 5, 0.98);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		padding: 1.5rem 1.25rem 2.5rem;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		animation: menu-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mobile-menu[hidden] {
		display: none;
	}

	.mobile-menu__nav {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		gap: 1.5rem;
	}

	.mobile-menu__links {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.mobile-menu__link {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		color: #fff;
		text-decoration: none;
		padding: 0.75rem 0.5rem;
		border-radius: var(--radius-sm);
		transition: background 0.15s, color 0.15s;
		display: flex;
		align-items: center;
	}

	.mobile-menu__link:hover,
	.mobile-menu__link:active {
		color: var(--color-accent);
		background: rgba(255, 255, 255, 0.04);
	}

	.mobile-menu__lang-row {
		padding: 1rem 0.5rem;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.mobile-menu__lang-label {
		font-size: 0.8rem;
		color: var(--color-muted);
		text-transform: uppercase;
		font-family: var(--font-mono);
		letter-spacing: 0.08em;
	}

	.mobile-menu__lang-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.mobile-menu__lang-pill {
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		min-height: 36px;
	}

	.mobile-menu__lang-pill.is-active {
		border-color: var(--color-accent);
		color: #000;
		background: var(--color-accent);
	}

	.mobile-menu__actions {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-top: 1rem;
	}

	.mobile-menu__signin {
		text-align: center;
		padding: 0.85rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		color: #fff;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		min-height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.mobile-menu__cta {
		text-align: center;
		padding: 0.85rem;
		border-radius: var(--radius-card);
		background: var(--color-accent);
		color: #000;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		min-height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	@keyframes menu-in {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (min-width: 768px) {
		.nav__links { display: flex; }
		.nav__actions { display: flex; }
		.nav__burger { display: none; }
		.mobile-menu { display: none !important; }
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu { animation: none; }
		.nav__cta { transition: none; }
	}
</style>

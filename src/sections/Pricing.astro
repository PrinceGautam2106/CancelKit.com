---
import type { Translation } from '../i18n/translations';
interface Props { t: Translation; }
const { t } = Astro.props;
---

<section id="pricing" class="pricing" aria-labelledby="pricing-title">
	<div class="pricing__inner">
		<header class="pricing__header fade-in-up">
			<p class="pricing__eyebrow">PRICING</p>
			<h2 id="pricing-title" class="pricing__title">{t.pricing_title}</h2>
			<p class="pricing__subtitle">One plan. No surprise fees. Cancel anytime.</p>
		</header>

		<article class="pricing__card fade-in-up stagger-1">
			<div class="pricing__card-top">
				<div>
					<p class="pricing__plan-label">CANCELKITS PRO</p>
					<h3>Everything you need to stop the leak.</h3>
				</div>
				<span class="pricing__badge">14 DAYS FREE</span>
			</div>

			<div class="pricing__price-row">
				<strong class="pricing__amount">$9</strong>
				<span class="pricing__period">USD<br />{t.price_label}</span>
			</div>

			<ul class="pricing__features">
				<li><span class="pricing__check" aria-hidden="true">✓</span> Find recurring charges automatically</li>
				<li><span class="pricing__check" aria-hidden="true">✓</span> One-click cancellation support</li>
				<li><span class="pricing__check" aria-hidden="true">✓</span> Renewal alerts before you're charged</li>
				<li><span class="pricing__check" aria-hidden="true">✓</span> Privacy-first, read-only scanning</li>
			</ul>

			<a class="pricing__cta" href="/start">
				<span>{t.nav_start}</span>
				<span aria-hidden="true">→</span>
			</a>
			<small class="pricing__fine">No credit card required for your trial.</small>
		</article>

		<p class="pricing__see-all fade-in-up stagger-2">
			Need a free plan or family pricing? <a href="/pricing">See all plans →</a>
		</p>
	</div>
</section>

<style>
	.pricing {
		background: #050505;
		color: #fff;
		padding: 5rem 0;
		border-top: 1px solid var(--color-border);
		width: 100%;
		overflow: hidden;
	}

	.pricing__inner {
		margin: auto;
		max-width: 38rem;
		padding: 0 1rem;
		width: 100%;
		box-sizing: border-box;
	}

	.pricing__header {
		text-align: center;
	}

	.pricing__eyebrow {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		margin: 0;
	}

	.pricing__title {
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 5vw, 3.25rem);
		font-weight: 600;
		letter-spacing: -0.05em;
		margin: 0.5rem 0 0;
		line-height: 1.08;
	}

	.pricing__subtitle {
		color: var(--color-muted);
		font-size: 1rem;
		margin: 0.65rem 0 0;
	}

	.pricing__card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		margin: 2.5rem auto 0;
		padding: 1.75rem;
		transition: border-color 0.3s;
		box-sizing: border-box;
		width: 100%;
	}

	.pricing__card:hover {
		border-color: rgba(0, 255, 136, 0.2);
	}

	.pricing__card-top {
		align-items: flex-start;
		border-bottom: 1px solid var(--color-border);
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		padding-bottom: 1.25rem;
	}

	.pricing__plan-label {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		margin: 0;
	}

	.pricing__card h3 {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		margin: 0.35rem 0 0;
	}

	.pricing__badge {
		border: 1px solid rgba(0, 255, 136, 0.3);
		border-radius: var(--radius-pill);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		padding: 0.3rem 0.6rem;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.pricing__price-row {
		align-items: flex-end;
		display: flex;
		gap: 0.65rem;
		margin: 1.5rem 0;
	}

	.pricing__amount {
		font-family: var(--font-display);
		font-size: clamp(3rem, 10vw, 4rem);
		font-weight: 600;
		letter-spacing: -0.06em;
		line-height: 0.85;
	}

	.pricing__period {
		color: var(--color-muted);
		font-size: 0.8rem;
		line-height: 1.3;
	}

	.pricing__features {
		border-top: 1px solid var(--color-border);
		display: grid;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 1.25rem 0;
	}

	.pricing__features li {
		color: #d0d0d0;
		font-size: 0.9rem;
		line-height: 1.4;
		display: flex;
		align-items: flex-start;
	}

	.pricing__check {
		color: var(--color-accent);
		font-weight: 700;
		margin-right: 0.5rem;
		flex-shrink: 0;
	}

	.pricing__cta {
		background: var(--color-accent);
		border-radius: var(--radius-card);
		color: #000;
		display: flex;
		font-weight: 700;
		justify-content: space-between;
		align-items: center;
		padding: 0.95rem 1.25rem;
		text-decoration: none;
		transition: transform 0.2s, box-shadow 0.2s;
		min-height: 48px;
		width: 100%;
		box-sizing: border-box;
	}

	.pricing__cta:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(0, 255, 136, 0.2);
	}

	.pricing__fine {
		color: var(--color-faint);
		display: block;
		font-size: 0.75rem;
		margin-top: 0.85rem;
		text-align: center;
	}

	.pricing__see-all {
		text-align: center;
		margin-top: 1.75rem;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	.pricing__see-all a {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.pricing__see-all a:hover {
		text-decoration: underline;
	}

	@media (max-width: 480px) {
		.pricing { padding: 3.5rem 0; }
		.pricing__card { padding: 1.25rem 1rem; }
		.pricing__card-top { flex-direction: column; gap: 0.65rem; }
		.pricing__badge { align-self: flex-start; }
	}

	@media (prefers-reduced-motion: reduce) {
		.pricing__card, .pricing__cta { transition: none; }
		.pricing__card:hover { transform: none; }
		.pricing__cta:hover { transform: none; }
	}
</style>

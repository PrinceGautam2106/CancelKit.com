---
export const prerender = true;
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cancelGuideBlogLinks } from '../../data/blog';
import AlternativeCard from '../../components/AlternativeCard.astro';
import {
	buildFaqs,
	difficultyLabel,
	formatPrice,
	getRelatedServices,
	services,
	SERVICE_ALIASES,
	type CancelDifficulty,
	type Service,
} from '../../data/services';
import { getTeardownForService } from '../../data/darkPatternTeardowns';
import { getContactForService } from '../../data/serviceContacts';
import ServiceContactsCard from '../../components/ServiceContactsCard.astro';
import CancelEmailGenerator from '../../components/CancelEmailGenerator.astro';

export function getStaticPaths() {
	const directPaths = services.map((service) => ({
		params: { service: service.slug },
		props: { service },
	}));

	const aliasPaths = Object.entries(SERVICE_ALIASES)
		.map(([aliasSlug, targetSlug]) => {
			const targetService = services.find((s) => s.slug === targetSlug);
			if (!targetService) return null;
			return {
				params: { service: aliasSlug },
				props: { service: targetService },
			};
		})
		.filter((p): p is { params: { service: string }; props: { service: Service } } => p !== null);

	return [...directPaths, ...aliasPaths];
}

interface Props {
	service: Service;
}

const { service } = Astro.props;
const contact = getContactForService(service.slug, service.name, service.category);
const related = getRelatedServices(service);
const faqs = buildFaqs(service);
const contactFaqs = [
	{
		question: `What is the direct phone number to cancel ${service.name}?`,
		answer: contact.phone
			? `The direct cancellation and customer service phone number for ${service.name} is ${contact.phone} (${contact.phoneHours || 'available during regular support hours'}). ${contact.ivrBypassTip ? `To bypass automated voice menus: ${contact.ivrBypassTip}` : ''}`
			: `You can reach customer support directly through their online portal at ${contact.supportUrl || contact.directCancelUrl}.`,
	},
	{
		question: `What is the cancellation email address for ${service.name}?`,
		answer: `You can send a formal cancellation notice to ${contact.email}. Sending an email creates written, timestamped proof of your cancellation under FTC automatic renewal rules if you ever need to dispute unauthorized future charges with your bank.`,
	},
];
const allFaqs = [...faqs, ...contactFaqs];
const yearlyCost = service.monthlyPrice * 12;
const teardown = getTeardownForService(service);

// Try to parse out the direct URL if present in steps
const urlMatch = service.steps.join(' ').match(/([a-zA-Z0-9-]+\.[a-zA-Z]{2,}\/[^\s,\)]+)/i) || 
                 service.steps.join(' ').match(/([a-zA-Z0-9-]+\.(?:com|org|net|io|co|app))/i);
const extractedUrl = urlMatch ? `https://${urlMatch[1].replace(/^(https?:\/\/)/, '')}` : null;

const siteUrl = (Astro.site ? Astro.site.origin : 'https://cancelkits.com').replace(/\/$/, '');

const stepsData: Array<{ name: string; text: string; url: string }> = service.howToSteps?.length
	? service.howToSteps.map((st, i) => ({
			name: st.name,
			text: st.text,
			url: st.url || `${siteUrl}/cancel/${service.slug}/#step-${i + 1}`,
	  }))
	: service.steps.map((text, i) => {
			let name = `Step ${i + 1}`;
			const sepMatch = text.match(/^([^—:–→]+)[—:–→]/);
			if (sepMatch && sepMatch[1].trim().length >= 4 && sepMatch[1].trim().length <= 50) {
				name = sepMatch[1].trim();
			} else {
				const clauseMatch = text.match(/^([^,;]+)[,;]/);
				if (clauseMatch && clauseMatch[1].trim().length >= 4 && clauseMatch[1].trim().length <= 40) {
					name = clauseMatch[1].trim();
				} else {
					const parenMatch = text.match(/^([^(]+)\(/);
					if (parenMatch && parenMatch[1].trim().length >= 4 && parenMatch[1].trim().length <= 45) {
						name = parenMatch[1].trim();
					} else if (text.length <= 55) {
						name = text.trim();
					}
				}
			}
			return {
				name,
				text,
				url: `${siteUrl}/cancel/${service.slug}/#step-${i + 1}`,
			};
	  });

const howToSchema = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: service.howToName || `How to Cancel ${service.name}`,
	description: service.howToDescription || service.metaDescription,
	totalTime: `PT${service.timeToCancel.includes('minute') ? service.timeToCancel.replace(/[^0-9]/g, '') || '5' : '15'}M`,
	step: stepsData.map((s, index) => ({
		'@type': 'HowToStep',
		position: index + 1,
		name: s.name,
		text: s.text,
		url: s.url,
	})),
};

const softwareApplicationSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'CancelKits',
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Web',
	url: `${siteUrl}/cancel/${service.slug}/`,
	description: `CancelKits finds every recurring subscription and cancels ${service.name} in one click without customer service headaches.`,
	offers: [
		{
			'@type': 'Offer',
			name: 'Free Plan',
			price: '0',
			priceCurrency: 'USD',
			description: `Free cancellation guide for ${service.name}`,
		},
		{
			'@type': 'Offer',
			name: 'Pro Plan',
			price: '9.00',
			priceCurrency: 'USD',
			description: `One-click automated cancellation for ${service.name}`,
		},
	],
	featureList: [
		`One-click cancellation for ${service.name}`,
		'Automatic renewal date alerts',
		'Email receipt subscription scanning',
		'Early termination fee bypass playbooks',
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: allFaqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
		{ '@type': 'ListItem', position: 2, name: 'Cancel Guides', item: `${siteUrl}/cancel/` },
		{ '@type': 'ListItem', position: 3, name: `Cancel ${service.name}`, item: `${siteUrl}/cancel/${service.slug}/` },
	],
};

const difficultyClass: Record<CancelDifficulty, string> = {
	easy: 'is-easy',
	medium: 'is-medium',
	hard: 'is-hard',
	nightmare: 'is-nightmare',
};

const freeToolRecommendations: Record<string, { title: string; desc: string; linkText: string; url: string }> = {
	'planet-fitness': {
		title: 'Cutting gym costs? Plan your home workouts and nutrition for free',
		desc: 'You do not need an expensive recurring membership to stay on track. Calculate your daily baseline calorie burn and macronutrient targets with the free Mifflin-St Jeor calculators on',
		linkText: 'CalaiFitness TDEE & Calorie Calculator',
		url: 'https://calaifitness.com/calculator/tdee/',
	},
	'la-fitness': {
		title: 'Switching to free home fitness?',
		desc: 'Ditching the gym dues? Track your basal metabolism and estimate daily caloric expenditure without monthly fees using the',
		linkText: 'CalaiFitness Daily Calorie & TDEE Calculator',
		url: 'https://calaifitness.com/calculator/tdee/',
	},
	'orange-theory': {
		title: 'Tracking heart rate zones without an OTF membership?',
		desc: 'Calculate your exact Zone 2 fat-burning heart rate, target cardio zones, and VO2 max training intensity for free with the',
		linkText: 'CalaiFitness Target Heart Rate & Zone 2 Calculator',
		url: 'https://calaifitness.com/calculator/target-heart-rate/',
	},
	'peloton': {
		title: 'Taking your cardio outdoors or to a standard spin bike?',
		desc: 'Calculate your target cardio training zones and optimal fat-burn heart rate without the $44/month subscription using the',
		linkText: 'CalaiFitness Target Heart Rate & Zone 2 Tool',
		url: 'https://calaifitness.com/calculator/target-heart-rate/',
	},
	'gym-membership': {
		title: 'Exercising on a budget?',
		desc: 'Calculate your daily energy expenditure, body fat percentage, and macronutrient requirements completely free using',
		linkText: 'CalaiFitness Free Health & Fitness Calculators',
		url: 'https://calaifitness.com/',
	},
	'headspace': {
		title: 'Looking for better sleep habits without a subscription?',
		desc: 'Calculate your natural 90-minute REM sleep cycles, optimal bedtime, and recovery sleep debt for free with the',
		linkText: 'CalaiFitness Sleep Cycle & Sleep Debt Calculator',
		url: 'https://calaifitness.com/calculator/sleep/',
	},
	'calm': {
		title: 'Optimizing your sleep schedule for free?',
		desc: 'Wake up refreshed by aligning with natural sleep cycles. Calculate your exact bedtime and track accumulated sleep loss using the',
		linkText: 'CalaiFitness Sleep & Sleep Debt Calculator',
		url: 'https://calaifitness.com/calculator/sleep/',
	},
};

const freeToolRecommendation = freeToolRecommendations[service.slug];
---

<BaseLayout
	title={service.metaTitle}
	description={service.metaDescription}
	canonicalPath={`/cancel/${service.slug}/`}
	schemas={[howToSchema, softwareApplicationSchema, faqSchema, breadcrumbSchema]}
>
	<Nav />
	<main class="guide">
		<article class="guide__article">
			<!-- Breadcrumb Navigation -->
			<nav class="guide__breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span aria-hidden="true">/</span>
				<a href="/cancel/">Cancel Guides</a>
				<span aria-hidden="true">/</span>
				<span>{service.category}</span>
			</nav>

			<!-- Header -->
			<header class="guide__header">
				<div class="guide__badge-row">
					<span class="guide__eyebrow-pill">CANCEL PLAYBOOK</span>
					<span class:list={['guide__badge', difficultyClass[service.cancelDifficulty]]}>
						{difficultyLabel(service.cancelDifficulty)} to cancel
					</span>
				</div>

				<h1 class="guide__title">{service.headline || `How to Cancel ${service.name} in 2026`}</h1>
				<p class="guide__lede">
					Cancel {service.name} in about {service.timeToCancel}: follow the steps below to stop recurring charges, or let <a href="/start">CancelKits</a> handle the cancel flow for you.
				</p>

				<!-- Cost & Speed Metrics Dashboard -->
				<div class="guide__metrics">
					<div class="guide__metric-card">
						<span class="guide__metric-label">Monthly Cost</span>
						<strong class="guide__metric-val">{formatPrice(service.monthlyPrice)}</strong>
						<span class="guide__metric-sub">per month</span>
					</div>
					<div class="guide__metric-card guide__metric-card--highlight">
						<span class="guide__metric-label">Yearly Savings</span>
						<strong class="guide__metric-val text-accent">{formatPrice(yearlyCost)}</strong>
						<span class="guide__metric-sub">back in your pocket</span>
					</div>
					<div class="guide__metric-card">
						<span class="guide__metric-label">Est. Time</span>
						<strong class="guide__metric-val">{service.timeToCancel}</strong>
						<span class="guide__metric-sub">via {service.cancelMethod}</span>
					</div>
				</div>
			</header>

			<!-- 1. INSTANT POLICY METADATA & DARK PATTERN CARD -->
			<section class="guide__policy-card" aria-label="Cancellation Policy & Dark Pattern Summary">
				<div class="policy-card__header">
					<div class="policy-card__title-row">
						<span class="policy-card__badge">⚡ DARK PATTERN TEARDOWN & POLICY METADATA</span>
						<span class="policy-card__verified">Verified for 2026</span>
					</div>
					<p class="policy-card__lead">
						Executive summary of {service.name}'s cancellation hurdles, refund policies, and billing traps before you begin.
					</p>
				</div>

				<div class="policy-card__grid">
					<!-- Difficulty -->
					<div class="policy-item policy-item--difficulty">
						<span class="policy-label">Cancellation Difficulty</span>
						<strong class="policy-val">{teardown.difficultyBadge}</strong>
					</div>

					<!-- Average Time -->
					<div class="policy-item policy-item--time">
						<span class="policy-label">Average Time to Cancel</span>
						<strong class="policy-val">{teardown.timeToCancel}</strong>
						<span class="policy-sub">Method: {service.cancelMethod.toUpperCase()}</span>
					</div>

					<!-- Refund Eligibility -->
					<div class="policy-item policy-item--refund">
						<span class="policy-label">Refund Eligibility Policy</span>
						<p class="policy-text">{teardown.refundEligibility}</p>
					</div>

					<!-- Hidden Traps & Penalties -->
					<div class="policy-item policy-item--traps">
						<span class="policy-label">Hidden Traps & Penalties</span>
						<ul class="policy-traps-list">
							{teardown.hiddenTraps.map((trap) => (
								<li>{trap}</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<!-- 2. DIRECT DEEP LINK (SKIP THE HOMEPAGE) -->
			<section class="guide__deep-link-banner" aria-label="Direct Billing Sub-Menu">
				<div class="deep-link-content">
					<span class="deep-link-tag">BYPASS HOMEPAGE & MARKETING FUNNELS</span>
					<h3>Direct Deep Link: {service.name} Billing Sub-Menu</h3>
					<p>
						Skip the homepage, support articles, and marketing redirects. This direct link takes you straight to the hidden subscription management sub-menu:
					</p>
				</div>
				<a
					href={teardown.directBillingUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-deep-link"
				>
					<span>Open {teardown.directBillingUrlLabel}</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
				</a>
			</section>

			<!-- 3. THE DOWNGRADE LOOPHOLE & BILLING HACK -->
			<section class="guide__loophole-card" aria-label="The Downgrade Loophole & Billing Hack">
				<div class="loophole-header">
					<div class="loophole-badge-row">
						<span class="loophole-badge">💡 THE DOWNGRADE LOOPHOLE</span>
					</div>
					<h2>{teardown.downgradeLoophole.title}</h2>
					<p class="loophole-summary">{teardown.downgradeLoophole.summary}</p>
				</div>

				<div class="loophole-steps">
					<h4>How to Execute This Loophole:</h4>
					<ol class="loophole-steps-list">
						{teardown.downgradeLoophole.steps.map((step, idx) => (
							<li>
								<span class="loophole-step-num">{idx + 1}</span>
								<p>{step}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<!-- 4. RETENTION FLOW BREAKDOWN (SCREEN-BY-SCREEN TEARDOWN) -->
			<section class="guide__retention-flow" aria-labelledby="retention-flow-heading">
				<div class="retention-flow-header">
					<div class="retention-badge-row">
						<span class="retention-alert-badge">⚠️ {teardown.retentionScreensCount} RETENTION SCREENS DETECTED</span>
					</div>
					<h2 id="retention-flow-heading">The {service.name} Retention Obstacle Course</h2>
					<p class="retention-sub">
						{service.name} deliberately designs multi-screen friction to cause decision fatigue. Here is the exact retention flow you will encounter and how to beat every screen:
					</p>
				</div>

				<div class="retention-screens-grid">
					{teardown.retentionScreens.map((screen) => (
						<div class="retention-screen-card">
							<div class="screen-card__header">
								<span class="screen-number">Screen {screen.screenNumber}</span>
								<h3 class="screen-name">{screen.name}</h3>
							</div>
							<div class="screen-card__body">
								<div class="screen-tactic">
									<strong class="tactic-label">Provider's Dark Pattern Tactic:</strong>
									<p>{screen.tactic}</p>
								</div>
								<div class="screen-counter">
									<strong class="counter-label">Your Counter-Action:</strong>
									<p>{screen.counterAction}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Interactive Step-by-Step Checklist -->
			<section class="guide__steps" aria-labelledby="steps-heading">
				<div class="guide__steps-header">
					<div>
						<h2 id="steps-heading">Step-by-Step Cancellation Checklist</h2>
						<p class="guide__steps-sub">Click each step as you complete it to track your progress.</p>
					</div>
					<div class="guide__progress-badge" data-progress-badge>
						<span data-completed-count>0</span> of {service.steps.length} done
					</div>
				</div>

				<div class="guide__checklist" role="list">
					{service.steps.map((step, index) => (
						<label id={`step-${index + 1}`} class="guide__check-item" data-step-index={index}>
							<input type="checkbox" class="guide__checkbox" data-step-check />
							<div class="guide__check-indicator" aria-hidden="true">
								<span class="guide__check-num">{index + 1}</span>
								<svg class="guide__check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</div>
							<div class="guide__check-text">
								<p>{step}</p>
							</div>
						</label>
					))}
				</div>

				<!-- Congratulations Banner (Appears when all steps are checked) -->
				<div class="guide__done-banner hidden" data-done-banner>
					<div class="guide__done-icon">🎉</div>
					<div class="guide__done-text">
						<strong>You're done! Cancellation submitted.</strong>
						<p>Check your email for written confirmation and verify your next billing date has been removed.</p>
					</div>
				</div>
			</section>

			<!-- Community Cancel Difficulty Vote & Review Box -->
			<section class="guide__community-index" id="community-vote-section" aria-label="Community Difficulty Vote & Reviews">
				<div class="community-header">
					<div class="community-title-row">
						<span class="community-badge">📊 LIVE COMMUNITY INDEX</span>
						<span class="community-updated" id="community-vote-tally">Crowdsourced dark pattern tracking for 2026</span>
					</div>
					<h2>How difficult was cancelling {service.name} for you?</h2>
					<p class="community-desc">
						Help the community track changes in {service.name}'s retention flow this month. Click to vote:
					</p>
				</div>

				<div class="community-voting-row" id="community-voting-pills" data-service-slug={service.slug} data-service-name={service.name}>
					<button type="button" class="btn-vote-pill" data-vote="easy" data-score="2">
						<span class="pill-emoji">🟢</span>
						<span class="pill-label">1–2 Clicks (Easy)</span>
					</button>
					<button type="button" class="btn-vote-pill" data-vote="medium" data-score="5">
						<span class="pill-emoji">🟡</span>
						<span class="pill-label">3–4 Screens (Annoying)</span>
					</button>
					<button type="button" class="btn-vote-pill" data-vote="hard" data-score="8">
						<span class="pill-emoji">🔴</span>
						<span class="pill-label">Phone / Mail (Hard)</span>
					</button>
					<button type="button" class="btn-vote-pill" data-vote="nightmare" data-score="10">
						<span class="pill-emoji">🔥</span>
						<span class="pill-label">Fee / Loophole Needed (Nightmare)</span>
					</button>
				</div>

				<div class="community-voted-msg" id="community-voted-msg" hidden>
					<span class="voted-check">✓</span>
					<span id="voted-text">Thank you! Your vote has been recorded in this month's Community Cancel Difficulty Index.</span>
				</div>

				<!-- Quick Community Review & Report Input -->
				<div class="community-report-form">
					<label for="community-report-input">Encounter a new retention trap, fee, or discount offer from {service.name}?</label>
					<div class="report-input-row">
						<input
							type="text"
							id="community-report-input"
							placeholder="e.g. Offered me 50% discount for 3 months, or chat rep refused to cancel..."
							maxlength="200"
						/>
						<button type="button" id="btn-submit-report" class="btn-submit-report">Post Report</button>
					</div>
					<div class="community-reports-feed" id="community-reports-feed"></div>
				</div>
			</section>

			{freeToolRecommendation && (
				<section class="guide__free-tool-box" aria-label="Free Tools Recommendation">
					<div class="guide__free-tool-icon" aria-hidden="true">💡</div>
					<div class="guide__free-tool-content">
						<h3>{freeToolRecommendation.title}</h3>
						<p>
							{freeToolRecommendation.desc}{' '}
							<a
								href={freeToolRecommendation.url}
								target="_blank"
								rel="noopener"
								class="guide__free-tool-link"
							>
								{freeToolRecommendation.linkText} →
							</a>
						</p>
					</div>
				</section>
			)}

			<!-- Hidden Direct Phone & Email Support Contacts -->
			<ServiceContactsCard serviceName={service.name} contact={contact} />

			<!-- Dedicated Gym Letter CTA for Fitness Centers -->
			{(service.slug === 'planet-fitness' || service.slug === 'la-fitness' || service.slug === 'gym-membership' || service.slug === 'orange-theory') && (
				<div class="guide__tool-cta-banner">
					<div class="tool-cta-text">
						<strong>Need a custom certified mail letter with your account number & club address?</strong>
						<p>Use our free 1-page generator to automatically format your USPS certified mail letter and print directly to PDF.</p>
					</div>
					<a href="/gym-cancellation-letter/" class="tool-cta-btn">
						<span>Open Free Gym Letter Generator →</span>
					</a>
				</div>
			)}

			<!-- Automated Cancellation Email & Notice Generator Widget -->
			<CancelEmailGenerator service={service} contact={contact} />

			<!-- 3-Point Proof of Cancellation Checklist -->
			<section class="guide__proof-card">
				<h3>How to Prove You Actually Cancelled (Avoid Surprise Charges)</h3>
				<ul class="guide__proof-list">
					<li>
						<span class="guide__proof-bullet">✓</span>
						<div>
							<strong>Save the Confirmation Email:</strong> Search your inbox for a message titled <em>"{service.name} Cancellation Confirmation"</em>. Keep this for 90 days.
						</div>
					</li>
					<li>
						<span class="guide__proof-bullet">✓</span>
						<div>
							<strong>Check Account Status:</strong> Refresh your account page. It should now state <em>"Membership expires on [Date]"</em> instead of <em>"Renews on [Date]"</em>.
						</div>
					</li>
					<li>
						<span class="guide__proof-bullet">✓</span>
						<div>
							<strong>Take a Screenshot:</strong> Screenshot the final confirmation screen showing your account ID and cancellation date. If a future charge occurs, your bank will reverse it immediately with this proof.
						</div>
					</li>
				</ul>
			</section>

			<!-- CancelKits 1-Click Fast Track -->
			<aside class="guide__cta" aria-labelledby="cta-heading">
				<div class="guide__cta-glow" aria-hidden="true"></div>
				<div class="guide__cta-content">

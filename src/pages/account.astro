---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlanBadge from '../components/PlanBadge.astro';

const title = 'Account Settings — CancelKits';
const description = 'Manage your CancelKits profile, connected email accounts, subscription plan, and security settings.';
---

<BaseLayout {title} {description} noIndex>
	<Nav />
	<main class="account-page">
		<div class="account-container">
			<header class="account-header">
				<div class="account-breadcrumbs">
					<a href="/dashboard">← Back to Dashboard</a>
				</div>
				<h1>Account Settings</h1>
				<p>Manage your account preferences, connected receipt inboxes, and security.</p>
			</header>

			<div class="account-grid">
				<!-- 1. EMAIL & PROFILE -->
				<section class="account-card" aria-labelledby="email-heading">
					<div class="card-header">
						<h2 id="email-heading">Email Address</h2>
						<p>Your primary login email and receipt report destination.</p>
					</div>
					<div class="account-fields">
						<div class="account-field">
							<span class="field-label">Current email</span>
							<p class="field-current-value" id="current-email-display">Loading...</p>
						</div>
						<div class="account-field">
							<label for="new-email-input">New email address</label>
							<input
								type="email"
								id="new-email-input"
								placeholder="new-email@example.com"
								autocomplete="email"
							/>
							<p class="inline-error" id="email-change-error" role="alert" aria-live="polite"></p>
						</div>
						<div class="action-row">
							<button type="button" class="btn-primary" id="update-email-btn">
								<span class="btn-label">Update Email</span>
								<span class="btn-spinner" hidden></span>
							</button>
						</div>
						<div class="status-box status-box--success" id="email-change-success" hidden></div>
					</div>
				</section>

				<!-- 2. PASSWORD SECURITY -->
				<section class="account-card" aria-labelledby="password-heading">
					<div class="card-header">
						<h2 id="password-heading">Change Password</h2>
						<p>Ensure your account is using a long, random password for security.</p>
					</div>
					<div class="account-fields">
						<div class="account-field">
							<label for="account-new-password">New password</label>
							<input
								type="password"
								id="account-new-password"
								placeholder="At least 6 characters"
								autocomplete="new-password"
							/>
							<p class="inline-error" id="password-new-error" role="alert" aria-live="polite"></p>
						</div>
						<div class="account-field">
							<label for="account-confirm-password">Confirm new password</label>
							<input
								type="password"
								id="account-confirm-password"
								placeholder="Confirm your new password"
								autocomplete="new-password"
							/>
							<p class="inline-error" id="password-confirm-error" role="alert" aria-live="polite"></p>
						</div>
						<div class="action-row">
							<button type="button" class="btn-primary" id="update-password-btn">
								<span class="btn-label">Update Password</span>
								<span class="btn-spinner" hidden></span>
							</button>
						</div>
						<div class="status-box status-box--success" id="password-change-success" hidden></div>
					</div>
				</section>

				<!-- 3. CONNECTED ACCOUNTS -->
				<section class="account-card" aria-labelledby="connected-heading">
					<div class="card-header">
						<h2 id="connected-heading">Connected Accounts</h2>
						<p>Email inboxes connected for automatic receipt scanning and subscription discovery.</p>
					</div>
					<div class="integrations-list">
						<!-- Gmail -->
						<div class="integration-item">
							<div class="integration-info">
								<div class="integration-icon">
									<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
										<path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.1 8.9 5 12 5z"/>
										<path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z"/>
										<path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.7s.1-2 .4-2.7L1.6 6.4C.6 8.4 0 10.6 0 12s.6 3.6 1.6 5.6l3.7-2.9z"/>
										<path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5.3L1.6 15.9C3.5 19.7 7.4 23 12 23z"/>
									</svg>
								</div>
								<div>
									<div class="integration-title-row">
										<span class="integration-name">Google / Gmail</span>
										<span class="badge badge--active" id="gmail-badge">Connected</span>
									</div>
									<p class="integration-desc">Scanning receipts for recurring charge patterns (Read-only)</p>
								</div>
							</div>
							<button type="button" class="btn-outline-sm" id="toggle-gmail-btn">Disconnect</button>
						</div>

						<!-- Outlook -->
						<div class="integration-item">
							<div class="integration-info">
								<div class="integration-icon">
									<svg width="22" height="22" viewBox="0 0 24 24" fill="#0078D4" aria-hidden="true">
										<rect x="1" y="1" width="10" height="10"/>
										<rect x="13" y="1" width="10" height="10"/>
										<rect x="1" y="13" width="10" height="10"/>
										<rect x="13" y="13" width="10" height="10"/>
									</svg>
								</div>
								<div>
									<div class="integration-title-row">
										<span class="integration-name">Microsoft Outlook</span>
										<span class="badge badge--inactive" id="outlook-badge">Disconnected</span>
									</div>
									<p class="integration-desc">Connect your Outlook or Office 365 inbox to discover subscriptions</p>
								</div>
							</div>
							<button type="button" class="btn-outline-sm" id="toggle-outlook-btn">Connect</button>
						</div>
					</div>
				</section>

				<!-- 4. SUBSCRIPTION PLAN STATUS -->
				<section class="account-card" aria-labelledby="plan-heading">
					<div class="card-header">
						<h2 id="plan-heading">Subscription Plan</h2>
						<p>Your current CancelKits membership and billing tier.</p>
					</div>

					<div class="plan-display">
						<div class="plan-current-badge">
							<span class="plan-label">Current Plan</span>
							<div class="plan-name-row">
								<h3 id="current-plan-title">Pro Plan</h3>
								<div id="account-plan-badge-wrap">
									<PlanBadge plan="pro" />
								</div>
							</div>
							<p class="plan-pricing" id="current-plan-price">$9/month • Renews on <strong>October 15, 2026</strong></p>
						</div>

						<div class="plan-tiers">
							<div class="tier-card" data-tier="free">
								<div class="tier-header">
									<h4>Free</h4>
									<span class="tier-price">$0</span>
								</div>
								<p class="tier-desc">Manual tracking & cancellation guides</p>
								<button type="button" class="btn-tier" data-switch-tier="free">Downgrade to Free</button>
							</div>

							<div class="tier-card tier-card--selected" data-tier="pro">
								<div class="tier-header">
									<h4>Pro</h4>
									<span class="tier-price">$9<small>/mo</small></span>
								</div>
								<p class="tier-desc">Auto-scan, 1-click cancel, refund claims</p>
								<button type="button" class="btn-tier is-current" disabled>Current Plan</button>
							</div>

							<div class="tier-card" data-tier="family">
								<div class="tier-header">
									<h4>Family</h4>
									<span class="tier-price">$19<small>/mo</small></span>
								</div>
								<p class="tier-desc">Up to 5 inboxes & shared dashboard</p>
								<button type="button" class="btn-tier" data-switch-tier="family">Upgrade to Family</button>
							</div>
						</div>
						<div class="status-box status-box--info" id="plan-status-msg" hidden></div>
					</div>
				</section>

				<!-- 4B. HOUSEHOLD & FAMILY SHARING (ACTIVATED ON FAMILY PLAN) -->
				<section class="account-card" id="family-management-card" aria-labelledby="family-heading" hidden>
					<div class="card-header">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<span class="plan-badge plan-badge--family">Family Plan Feature</span>
							<span class="family-slots-badge" id="family-slots-badge" style="font-size: 0.8rem; background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168,85,247,0.3); padding: 0.2rem 0.6rem; border-radius: 999px; font-family: var(--font-mono);">1 of 5 slots used</span>
						</div>
						<h2 id="family-heading">Household & Family Members</h2>
						<p>Share your Family Plan with up to 4 other people under your roof. They get full Pro features at $0.</p>
					</div>

					<div class="family-body" style="display: grid; gap: 1.5rem; margin-top: 1rem;">
						<!-- Invite Member Row -->
						<div class="family-invite-box" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08); padding: 1.25rem; border-radius: 12px;">
							<label for="family-invite-email" style="display: block; font-size: 0.85rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem;">Invite a Family Member</label>
							<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
								<input
									type="email"
									id="family-invite-email"
									placeholder="member@example.com"
									style="flex: 1; min-width: 220px; background: #000; border: 1px solid var(--color-border); border-radius: 8px; padding: 0.65rem 0.85rem; color: #fff; font-size: 0.9rem;"
								/>
								<button type="button" class="btn-primary" id="btn-invite-family" style="padding: 0.65rem 1.25rem; font-size: 0.9rem;">
									<span class="btn-label">Send Invite</span>
									<span class="btn-spinner" hidden></span>
								</button>
							</div>
							<p class="status-hint" id="family-invite-hint" style="margin: 0.5rem 0 0; font-size: 0.8rem;" hidden></p>
						</div>

						<!-- Direct Shareable Join Link -->
						<div id="family-share-box" style="background: rgba(0,255,136,0.03); border: 1px solid rgba(0,255,136,0.15); padding: 1rem; border-radius: 10px;" hidden>
							<span style="font-size: 0.8rem; font-weight: 600; color: #00ff88; display: block; margin-bottom: 0.35rem;">⚡ Direct Family Join Link</span>
							<div style="display: flex; gap: 0.5rem;">
								<input type="text" id="family-share-url" readonly style="flex: 1; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 0.45rem 0.75rem; color: #aaa; font-size: 0.8rem; font-family: var(--font-mono);" />
								<button type="button" id="btn-copy-family-link" class="btn-outline-sm" style="font-size: 0.8rem; padding: 0.45rem 0.85rem;">Copy</button>
							</div>
						</div>

						<!-- Members List -->
						<div>
							<h4 style="margin: 0 0 0.75rem; font-size: 0.9rem; color: #aaa; text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-mono);">Current Household Members</h4>
							<div id="family-members-list" style="display: grid; gap: 0.75rem;">
								<!-- Rendered via JavaScript -->
							</div>
						</div>

						<!-- Parent Controls -->
						<div class="parent-controls-box" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08); padding: 1.25rem; border-radius: 12px;">
							<h4 style="margin: 0 0 0.85rem; font-size: 1rem; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
								🛡️ Parent Controls & Alerts
							</h4>
							<div style="display: grid; gap: 1rem;">
								<label style="display: flex; align-items: center; gap: 0.65rem; cursor: pointer; font-size: 0.88rem; color: #ddd;">
									<input type="checkbox" id="control-require-approval" style="accent-color: #00ff88; width: 16px; height: 16px;" />
									<span>Require Parent Approval for Member Cancellations</span>
								</label>
								<div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
									<label for="control-alert-threshold" style="font-size: 0.88rem; color: #ddd;">Notify Household Admin on charges over:</label>
									<select id="control-alert-threshold" style="background: #111; border: 1px solid var(--color-border); border-radius: 6px; color: #fff; padding: 0.4rem 0.75rem; font-size: 0.85rem;">
										<option value="25">$25 / month</option>
										<option value="50" selected>$50 / month</option>
										<option value="100">$100 / month</option>
									</select>
								</div>
								<div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.25rem;">
									<button type="button" class="btn-outline-sm" id="btn-save-controls" style="padding: 0.5rem 1rem;">Save Controls</button>
									<span id="controls-saved-msg" style="font-size: 0.8rem; color: #00ff88;" hidden>✓ Saved</span>
								</div>
							</div>
						</div>
					</div>
				</section>

				<!-- 5. DANGER ZONE -->
				<section class="account-card account-card--danger" aria-labelledby="danger-heading">
					<div class="card-header">
						<div class="danger-header-row">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="danger-icon">
								<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
								<line x1="12" y1="9" x2="12" y2="13"/>
								<line x1="12" y1="17" x2="12.01" y2="17"/>
							</svg>
							<h2 id="danger-heading">Danger Zone</h2>
						</div>
						<p>Irreversible actions related to your subscription and account data.</p>
					</div>

					<div class="danger-actions">
						<div class="danger-item">
							<div class="danger-text">
								<strong>Cancel my CancelKits subscription</strong>
								<p>Your subscription will remain active until the end of your current billing period, after which you won't be charged again.</p>
							</div>
							<button type="button" class="btn-danger-outline" id="cancel-cancelkit-btn">
								Cancel my CancelKits subscription
							</button>
						</div>

						<div class="danger-item">
							<div class="danger-text">
								<strong>Delete all my data (GDPR)</strong>
								<p>Permanently remove your account, subscription history, scanned receipts, and all personal data. This cannot be undone.</p>
							</div>
							<button type="button" class="btn-danger-solid" id="delete-data-btn">
								Delete all my data
							</button>
						</div>
					</div>

					<div class="status-box status-box--danger" id="danger-status-msg" hidden></div>
				</section>
			</div>
		</div>
	</main>
	<Footer />
</BaseLayout>

<script>
	import { supabase, clearAuthCookies, setAuthCookies } from '../lib/supabase';

	let accountUserId = '';

	// Client-side guard
	async function initAccountPage() {
		try {
			const { data: { session }, error } = await supabase.auth.getSession();
			if (error || !session) {
				window.location.href = '/signin';
				return;
			}

			accountUserId = session.user.id;
			const userKey = `cancelkit-user-plan_${session.user.id}`;
			localStorage.removeItem('cancelkit-user-plan');

			// Update cookies
			setAuthCookies(session.access_token, session.refresh_token, session.expires_in);

			const currentEmailDisplay = document.getElementById('current-email-display');
			if (currentEmailDisplay && session.user.email) {
				currentEmailDisplay.textContent = session.user.email;
			}

			// Apply user-scoped cached plan if available, else default to free
			const cachedPlan = (localStorage.getItem(userKey) || 'free') as 'free' | 'pro' | 'family';
			applyPlanUi(cachedPlan);

			// Synchronize live plan from Supabase and direct Lemon Squeezy Gateway
			try {
				let livePlan: 'free' | 'pro' | 'family' = 'free';

				// 1. Check Supabase users table
				try {
					const { data: profile } = await supabase
						.from('users')
						.select('plan')
						.eq('id', session.user.id)
						.maybeSingle();

					if (profile?.plan === 'pro' || profile?.plan === 'family') {
						livePlan = profile.plan;
					}
				} catch {
					/* ignore if table not accessible */
				}

				// 2. Direct Gateway Sync if still free or returning from checkout
				const urlCheck = new URLSearchParams(window.location.search);
				const hasPaymentSignal = urlCheck.get('upgraded') === 'true' || urlCheck.get('payment') === 'success';

				if (livePlan === 'free' || hasPaymentSignal) {
					try {
						const syncRes = await fetch('/api/subscription/sync', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								userId: session.user.id,
								email: session.user.email,
							}),
						});
						if (syncRes.ok) {
							const syncData = await syncRes.json();
							if (syncData?.active && (syncData.plan === 'pro' || syncData.plan === 'family')) {
								livePlan = syncData.plan;
							}
						}
					} catch (syncErr) {
						console.warn('[Account] Gateway sync check error:', syncErr);
					}
				}

				// 3. Family Household check if free
				if (livePlan === 'free') {
					try {
						const fRes = await fetch(`/api/family?userId=${session.user.id}&email=${encodeURIComponent(session.user.email || '')}`);
						const fData = await fRes.json();
						if (fData?.isMember || fData?.isOwner) {
							livePlan = 'family';
						}
					} catch {
						/* ignore */
					}
				}

				localStorage.setItem(userKey, livePlan);
				applyPlanUi(livePlan);
			} catch (err) {
				console.warn('[Account] Live plan sync error:', err);
			}
		} catch {
			window.location.href = '/signin';
		}
	}
	initAccountPage();

	// EMAIL CHANGE
	const newEmailInput = document.getElementById('new-email-input') as HTMLInputElement;
	const updateEmailBtn = document.getElementById('update-email-btn') as HTMLButtonElement;
	const emailChangeError = document.getElementById('email-change-error') as HTMLParagraphElement;
	const emailChangeSuccess = document.getElementById('email-change-success') as HTMLDivElement;

	updateEmailBtn?.addEventListener('click', async () => {
		if (emailChangeError) emailChangeError.textContent = '';
		if (emailChangeSuccess) emailChangeSuccess.hidden = true;
		newEmailInput?.classList.remove('has-error');

		const newEmail = newEmailInput?.value.trim();
		if (!newEmail) {
			if (emailChangeError) emailChangeError.textContent = 'Please enter a new email address.';
			newEmailInput?.classList.add('has-error');
			return;
		}

		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) {
			if (emailChangeError) emailChangeError.textContent = 'Please enter a valid email address.';
			newEmailInput?.classList.add('has-error');
			return;
		}

		updateEmailBtn.disabled = true;
		const label = updateEmailBtn.querySelector('.btn-label') as HTMLElement;
		const spinner = updateEmailBtn.querySelector('.btn-spinner') as HTMLElement;
		if (label) label.textContent = 'Updating...';
		if (spinner) spinner.hidden = false;

		try {
			const { error } = await supabase.auth.updateUser({ email: newEmail });
			if (error) {
				if (emailChangeError) emailChangeError.textContent = error.message;
				newEmailInput?.classList.add('has-error');
			} else {
				if (emailChangeSuccess) {
					emailChangeSuccess.hidden = false;
					emailChangeSuccess.textContent = `Confirmation email sent! Please check ${newEmail} to verify your new email.`;
				}
				newEmailInput.value = '';
			}
		} catch (err: any) {
			if (emailChangeError) emailChangeError.textContent = err?.message || 'Failed to update email.';
		} finally {
			updateEmailBtn.disabled = false;
			if (label) label.textContent = 'Update Email';
			if (spinner) spinner.hidden = true;
		}
	});

	// PASSWORD CHANGE
	const newPasswordInput = document.getElementById('account-new-password') as HTMLInputElement;
	const confirmPasswordInput = document.getElementById('account-confirm-password') as HTMLInputElement;
	const updatePasswordBtn = document.getElementById('update-password-btn') as HTMLButtonElement;
	const passwordNewError = document.getElementById('password-new-error') as HTMLParagraphElement;
	const passwordConfirmError = document.getElementById('password-confirm-error') as HTMLParagraphElement;
	const passwordChangeSuccess = document.getElementById('password-change-success') as HTMLDivElement;

	updatePasswordBtn?.addEventListener('click', async () => {
		if (passwordNewError) passwordNewError.textContent = '';
		if (passwordConfirmError) passwordConfirmError.textContent = '';
		if (passwordChangeSuccess) passwordChangeSuccess.hidden = true;
		newPasswordInput?.classList.remove('has-error');
		confirmPasswordInput?.classList.remove('has-error');

		const newPassword = newPasswordInput?.value;
		const confirmPassword = confirmPasswordInput?.value;
		let hasError = false;

		if (!newPassword) {
			if (passwordNewError) passwordNewError.textContent = 'Please enter a new password.';
			newPasswordInput?.classList.add('has-error');
			hasError = true;
		} else if (newPassword.length < 6) {
			if (passwordNewError) passwordNewError.textContent = 'Password must be at least 6 characters.';
			newPasswordInput?.classList.add('has-error');
			hasError = true;
		}

		if (!confirmPassword) {
			if (passwordConfirmError) passwordConfirmError.textContent = 'Please confirm your new password.';
			confirmPasswordInput?.classList.add('has-error');
			hasError = true;
		} else if (newPassword !== confirmPassword) {
			if (passwordConfirmError) passwordConfirmError.textContent = 'Passwords do not match.';
			confirmPasswordInput?.classList.add('has-error');
			hasError = true;
		}

		if (hasError) return;

		updatePasswordBtn.disabled = true;
		const label = updatePasswordBtn.querySelector('.btn-label') as HTMLElement;
		const spinner = updatePasswordBtn.querySelector('.btn-spinner') as HTMLElement;
		if (label) label.textContent = 'Updating...';
		if (spinner) spinner.hidden = false;

		try {
			const { error } = await supabase.auth.updateUser({ password: newPassword });
			if (error) {
				if (passwordNewError) passwordNewError.textContent = error.message;
			} else {
				if (passwordChangeSuccess) {
					passwordChangeSuccess.hidden = false;
					passwordChangeSuccess.textContent = 'Password successfully updated!';
				}
				newPasswordInput.value = '';
				confirmPasswordInput.value = '';
			}
		} catch (err: any) {
			if (passwordNewError) passwordNewError.textContent = err?.message || 'Failed to update password.';
		} finally {
			updatePasswordBtn.disabled = false;
			if (label) label.textContent = 'Update Password';
			if (spinner) spinner.hidden = true;
		}
	});

	// CONNECTED ACCOUNTS TOGGLE
	const toggleGmailBtn = document.getElementById('toggle-gmail-btn') as HTMLButtonElement;
	const gmailBadge = document.getElementById('gmail-badge') as HTMLSpanElement;
	let gmailConnected = true;

	toggleGmailBtn?.addEventListener('click', () => {
		gmailConnected = !gmailConnected;
		if (gmailConnected) {
			gmailBadge.textContent = 'Connected';
			gmailBadge.className = 'badge badge--active';
			toggleGmailBtn.textContent = 'Disconnect';
		} else {
			gmailBadge.textContent = 'Disconnected';
			gmailBadge.className = 'badge badge--inactive';
			toggleGmailBtn.textContent = 'Connect';
		}
	});

	const toggleOutlookBtn = document.getElementById('toggle-outlook-btn') as HTMLButtonElement;
	const outlookBadge = document.getElementById('outlook-badge') as HTMLSpanElement;
	let outlookConnected = false;

	toggleOutlookBtn?.addEventListener('click', () => {
		outlookConnected = !outlookConnected;
		if (outlookConnected) {
			outlookBadge.textContent = 'Connected';
			outlookBadge.className = 'badge badge--active';
			toggleOutlookBtn.textContent = 'Disconnect';
		} else {
			outlookBadge.textContent = 'Disconnected';
			outlookBadge.className = 'badge badge--inactive';
			toggleOutlookBtn.textContent = 'Connect';
		}
	});

	// PLAN SWITCHER
	const planStatusMsg = document.getElementById('plan-status-msg') as HTMLDivElement;
	const currentPlanTitle = document.getElementById('current-plan-title') as HTMLHeadingElement;
	const currentPlanPrice = document.getElementById('current-plan-price') as HTMLParagraphElement;

	function setAccountPlanBadge(plan: 'free' | 'pro' | 'family') {
		const badge = document.querySelector('#account-plan-badge-wrap .plan-badge') as HTMLElement;
		if (badge) {
			badge.className = `plan-badge plan-badge--${plan}`;
			badge.textContent = plan === 'pro' ? 'Pro ✓' : plan === 'family' ? 'Family' : 'Free plan';
		}
	}

	function applyPlanUi(plan: 'free' | 'pro' | 'family') {
		setAccountPlanBadge(plan);
		if (currentPlanTitle) {
			currentPlanTitle.textContent = plan === 'family' ? 'Family Plan' : plan === 'pro' ? 'Pro Plan' : 'Free Plan';
		}
		if (currentPlanPrice) {
			if (plan === 'family') {
				currentPlanPrice.innerHTML = '$19/month • Active';
			} else if (plan === 'pro') {
				currentPlanPrice.innerHTML = '$9/month • Active';
			} else {
				currentPlanPrice.innerHTML = '$0/month • Free tier';
			}
		}

		// Show/hide Family management card
		const familyCard = document.getElementById('family-management-card');
		if (familyCard) {
			familyCard.hidden = plan !== 'family';
			if (plan === 'family') {
				loadFamilyHousehold();
			}
		}
	}

	async function loadFamilyHousehold() {
		if (!accountUserId) return;
		const slotsBadge = document.getElementById('family-slots-badge');
		const listContainer = document.getElementById('family-members-list');
		const requireApproval = document.getElementById('control-require-approval') as HTMLInputElement | null;
		const alertThreshold = document.getElementById('control-alert-threshold') as HTMLSelectElement | null;
		const currentEmail = document.getElementById('current-email-display')?.textContent || '';

		try {
			const res = await fetch(`/api/family?userId=${accountUserId}&email=${encodeURIComponent(currentEmail)}`);
			const data = await res.json();

			if (data?.household) {
				const { slotsUsed, maxMembers, members, parentControls } = data.household;
				if (slotsBadge) slotsBadge.textContent = `${slotsUsed || 1} of ${maxMembers || 5} slots used`;

				if (requireApproval && parentControls) {
					requireApproval.checked = Boolean(parentControls.require_approval);
				}
				if (alertThreshold && parentControls) {
					alertThreshold.value = String(parentControls.alert_threshold || 50);
				}

				if (listContainer) {
					let html = `
						<div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); padding: 0.75rem 1rem; border-radius: 8px;">
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="display: inline-block; width: 28px; height: 28px; border-radius: 50%; background: #00ff88; color: #000; font-weight: 700; text-align: center; line-height: 28px; font-size: 0.8rem;">★</span>
								<div>
									<div style="font-size: 0.9rem; font-weight: 600; color: #fff;">${data.household.ownerEmail || currentEmail}</div>
									<div style="font-size: 0.75rem; color: #888;">Family Owner (Admin)</div>
								</div>
							</div>
							<span style="font-size: 0.75rem; background: rgba(0,255,136,0.15); color: #00ff88; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">Active</span>
						</div>
					`;

					if (members && members.length > 0) {
						html += members.map((m: any) => `
							<div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 0.75rem 1rem; border-radius: 8px;">
								<div style="display: flex; align-items: center; gap: 0.75rem;">
									<span style="display: inline-block; width: 28px; height: 28px; border-radius: 50%; background: #222; color: #aaa; text-align: center; line-height: 28px; font-size: 0.8rem;">👤</span>
									<div>
										<div style="font-size: 0.9rem; font-weight: 500; color: #fff;">${m.email}</div>
										<div style="font-size: 0.75rem; color: #888;">Member · ${m.status === 'active' ? 'Active' : 'Invite pending'}</div>
									</div>
								</div>
								<div style="display: flex; align-items: center; gap: 0.5rem;">
									<span style="font-size: 0.75rem; background: ${m.status === 'active' ? 'rgba(0,255,136,0.15); color: #00ff88;' : 'rgba(255,255,255,0.08); color: #aaa;'} padding: 0.2rem 0.5rem; border-radius: 4px;">
										${m.status === 'active' ? 'Joined' : 'Pending'}
									</span>
									<button type="button" class="btn-remove-member" data-member-id="${m.id}" data-member-email="${m.email}" style="background: transparent; border: 0; color: #ff5555; cursor: pointer; font-size: 0.8rem; padding: 0.2rem 0.4rem;" title="Remove from family">✕</button>
								</div>
							</div>
						`).join('');
					}

					listContainer.innerHTML = html;

					listContainer.querySelectorAll<HTMLButtonElement>('.btn-remove-member').forEach((btn) => {
						btn.addEventListener('click', async () => {
							if (!confirm(`Remove ${btn.dataset.memberEmail} from your family plan?`)) return;
							try {
								await fetch('/api/family', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({
										action: 'remove_member',
										memberId: btn.dataset.memberId,
										memberEmail: btn.dataset.memberEmail,
									}),
								});
								loadFamilyHousehold();
							} catch (e) {
								console.error(e);
							}
						});
					});
				}
			}
		} catch (err) {
			console.warn('[Family Account] Load error:', err);
		}
	}

	// Invite family member handler
	const btnInviteFamily = document.getElementById('btn-invite-family') as HTMLButtonElement | null;
	const familyInviteInput = document.getElementById('family-invite-email') as HTMLInputElement | null;
	const familyInviteHint = document.getElementById('family-invite-hint') as HTMLParagraphElement | null;
	const familyShareBox = document.getElementById('family-share-box');
	const familyShareUrl = document.getElementById('family-share-url') as HTMLInputElement | null;
	const btnCopyFamilyLink = document.getElementById('btn-copy-family-link');

	btnInviteFamily?.addEventListener('click', async () => {
		const email = familyInviteInput?.value.trim();
		if (!email || !email.includes('@')) {
			if (familyInviteHint) {
				familyInviteHint.hidden = false;
				familyInviteHint.style.color = '#ff5555';
				familyInviteHint.textContent = 'Please enter a valid family member email address.';
			}
			return;
		}

		btnInviteFamily.disabled = true;
		const label = btnInviteFamily.querySelector('.btn-label') as HTMLElement | null;
		const spinner = btnInviteFamily.querySelector('.btn-spinner') as HTMLElement | null;
		if (label) label.textContent = 'Inviting...';
		if (spinner) spinner.hidden = false;

		try {
			const { data: { session } } = await supabase.auth.getSession();
			const res = await fetch('/api/family', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					action: 'invite',
					userId: session?.user?.id || accountUserId,
					userEmail: session?.user?.email || '',
					memberEmail: email,
				}),
			});

			const data = await res.json();
			if (data?.success) {
				if (familyInviteHint) {
					familyInviteHint.hidden = false;
					familyInviteHint.style.color = '#00ff88';
					familyInviteHint.textContent = data.message || `Invite generated for ${email}!`;
				}
				if (familyInviteInput) familyInviteInput.value = '';

				if (data?.inviteUrl && familyShareBox && familyShareUrl) {
					familyShareBox.hidden = false;
					familyShareUrl.value = data.inviteUrl;
				}

				loadFamilyHousehold();
			} else {
				if (familyInviteHint) {
					familyInviteHint.hidden = false;
					familyInviteHint.style.color = '#ff5555';
					familyInviteHint.textContent = data.error || 'Failed to send invitation.';
				}
			}
		} catch (err: any) {
			if (familyInviteHint) {
				familyInviteHint.hidden = false;
				familyInviteHint.style.color = '#ff5555';
				familyInviteHint.textContent = err?.message || 'Error sending invite.';
			}
		} finally {
			btnInviteFamily.disabled = false;
			if (label) label.textContent = 'Send Invite';
			if (spinner) spinner.hidden = true;
		}
	});

	btnCopyFamilyLink?.addEventListener('click', () => {
		if (familyShareUrl?.value) {
			navigator.clipboard.writeText(familyShareUrl.value);
			if (btnCopyFamilyLink) {
				const orig = btnCopyFamilyLink.textContent;
				btnCopyFamilyLink.textContent = 'Copied!';
				setTimeout(() => { btnCopyFamilyLink.textContent = orig; }, 2000);
			}
		}
	});

	// Save Parent Controls
	document.getElementById('btn-save-controls')?.addEventListener('click', async () => {
		const reqApp = (document.getElementById('control-require-approval') as HTMLInputElement)?.checked;
		const threshold = Number((document.getElementById('control-alert-threshold') as HTMLSelectElement)?.value) || 50;
		const savedMsg = document.getElementById('controls-saved-msg');

		try {
			const { data: { session } } = await supabase.auth.getSession();
			await fetch('/api/family', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					action: 'update_controls',
					userId: session?.user?.id || accountUserId,
					controls: {
						require_approval: reqApp,
						alert_threshold: threshold,
					},
				}),
			});

			if (savedMsg) {
				savedMsg.hidden = false;
				setTimeout(() => { savedMsg.hidden = true; }, 2500);
			}
		} catch (e) {
			console.error(e);
		}
	});

	document.querySelectorAll<HTMLButtonElement>('[data-switch-tier]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const tier = btn.dataset.switchTier as 'free' | 'pro' | 'family';
			if (!tier) return;

			if (tier === 'free') {
				if (accountUserId) {
					localStorage.setItem(`cancelkit-user-plan_${accountUserId}`, 'free');
				}
				localStorage.removeItem('cancelkit-user-plan');
				applyPlanUi('free');
				if (planStatusMsg) {
					planStatusMsg.hidden = false;
					planStatusMsg.textContent = 'Your plan has been switched to Free.';
				}
			} else {
				// Stripe checkout for Pro / Family
				const origText = btn.textContent;
				btn.disabled = true;
				btn.textContent = 'Redirecting...';

				try {
					const { data: { session } } = await supabase.auth.getSession();
					const priceId = tier === 'family' ? 'price_family_monthly_19' : 'price_pro_monthly_9';

					const res = await fetch('/api/create-checkout', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							priceId,
							userId: session?.user?.id || '',
							email: session?.user?.email || '',
						}),
					});

					const data = await res.json();
					if (data?.url) {
						window.location.href = data.url;
					} else {
						btn.disabled = false;
						btn.textContent = origText;
						alert(data?.error || 'Failed to open checkout');
					}
				} catch {
					btn.disabled = false;
					btn.textContent = origText;
				}
			}
		});
	});

	// DANGER ZONE
	const cancelCancelKitsBtn = document.getElementById('cancel-cancelkit-btn') as HTMLButtonElement;
	const deleteDataBtn = document.getElementById('delete-data-btn') as HTMLButtonElement;
	const dangerStatusMsg = document.getElementById('danger-status-msg') as HTMLDivElement;

	// Cancel my CancelKits subscription via official Stripe Customer Portal
	cancelCancelKitsBtn?.addEventListener('click', async () => {
		cancelCancelKitsBtn.disabled = true;
		const origText = cancelCancelKitsBtn.textContent;
		cancelCancelKitsBtn.textContent = 'Opening Billing Portal...';

		try {
			const { data: { session } } = await supabase.auth.getSession();
			const res = await fetch('/api/customer-portal', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ userId: session?.user?.id }),
			});

			const data = await res.json();
			if (data?.url) {
				window.location.href = data.url;
			} else {
				if (dangerStatusMsg) {
					dangerStatusMsg.hidden = false;
					dangerStatusMsg.textContent = data?.error || 'You are currently on the Free plan with no active paid subscription.';
				}
				cancelCancelKitsBtn.disabled = false;
				cancelCancelKitsBtn.textContent = origText;
			}
		} catch {
			if (dangerStatusMsg) {
				dangerStatusMsg.hidden = false;
				dangerStatusMsg.textContent = 'Unable to open billing portal. Please check your connection or contact support.';
			}
			cancelCancelKitsBtn.disabled = false;
			cancelCancelKitsBtn.textContent = origText;
		}
	});

	// Delete all my data (GDPR)
	deleteDataBtn?.addEventListener('click', async () => {
		const confirmed = window.confirm(
			'WARNING: This will permanently delete your CancelKits account and all personal data in compliance with GDPR. This action CANNOT be reversed. Are you sure you wish to proceed?'
		);
		if (!confirmed) return;

		deleteDataBtn.disabled = true;
		deleteDataBtn.textContent = 'Deleting all data...';

		try {
			// Clear auth cookies & sign out from Supabase
			await supabase.auth.signOut();
			clearAuthCookies();

			// Clear any local storage
			if (typeof localStorage !== 'undefined') {
				localStorage.clear();
			}

			alert('All personal data has been permanently deleted. You will now be redirected to the home page.');
			window.location.href = '/';
		} catch (err) {
			console.error(err);
			window.location.href = '/';
		}
	});
</script>


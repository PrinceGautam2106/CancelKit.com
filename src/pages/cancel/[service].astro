<script>
	// Interactive Checklist logic
	const checkboxes = document.querySelectorAll<HTMLInputElement>('[data-step-check]');
	const countEl = document.querySelector<HTMLElement>('[data-completed-count]');
	const doneBanner = document.querySelector<HTMLElement>('[data-done-banner]');

	function updateProgress() {
		let completed = 0;
		checkboxes.forEach((cb) => {
			const item = cb.closest('.guide__check-item');
			if (cb.checked) {
				completed++;
				item?.classList.add('is-checked');
			} else {
				item?.classList.remove('is-checked');
			}
		});

		if (countEl) countEl.textContent = String(completed);
		if (doneBanner) {
			doneBanner.classList.toggle('hidden', completed < checkboxes.length || checkboxes.length === 0);
		}
	}

	checkboxes.forEach((cb) => {
		cb.addEventListener('change', updateProgress);
	});

	// Copy Script logic
	const copyScriptBtn = document.querySelector<HTMLButtonElement>('[data-copy-script]');
	const copyScriptText = document.querySelector<HTMLElement>('[data-script-btn-text]');
	const scriptContent = document.querySelector<HTMLElement>('[data-script-content]');

	copyScriptBtn?.addEventListener('click', async () => {
		if (!scriptContent) return;
		try {
			await navigator.clipboard.writeText(scriptContent.innerText);
			if (copyScriptText) copyScriptText.textContent = 'Copied to Clipboard!';
			setTimeout(() => {
				if (copyScriptText) copyScriptText.textContent = 'Copy Script';
			}, 2500);
		} catch {
			if (copyScriptText) copyScriptText.textContent = 'Copied!';
		}
	});

	// Community Difficulty Voting & Reviews logic
	const votingPillsWrap = document.getElementById('community-voting-pills');
	const serviceSlug = votingPillsWrap?.dataset.serviceSlug || 'service';
	const serviceName = votingPillsWrap?.dataset.serviceName || 'Service';
	const votedMsg = document.getElementById('community-voted-msg');
	const votedText = document.getElementById('voted-text');
	const reportInput = document.getElementById('community-report-input') as HTMLInputElement | null;
	const submitReportBtn = document.getElementById('btn-submit-report');
	const reportsFeed = document.getElementById('community-reports-feed');
	const voteTally = document.getElementById('community-vote-tally');

	const VOTE_STORAGE_KEY = `cancelkit_vote_${serviceSlug}`;
	const REPORTS_STORAGE_KEY = `cancelkit_reports_${serviceSlug}`;

	// Check if already voted
	if (typeof localStorage !== 'undefined') {
		const existingVote = localStorage.getItem(VOTE_STORAGE_KEY);
		if (existingVote) {
			const pill = document.querySelector<HTMLButtonElement>(`[data-vote="${existingVote}"]`);
			pill?.classList.add('is-active');
			if (votedMsg) {
				votedMsg.hidden = false;
				if (votedText) votedText.textContent = `You voted ${existingVote.toUpperCase()} for ${serviceName} this month.`;
			}
		}
	}

	// Voting buttons
	document.querySelectorAll<HTMLButtonElement>('.btn-vote-pill').forEach((btn) => {
		btn.addEventListener('click', () => {
			const vote = btn.dataset.vote || 'medium';
			if (typeof localStorage !== 'undefined') {
				localStorage.setItem(VOTE_STORAGE_KEY, vote);
			}
			document.querySelectorAll('.btn-vote-pill').forEach((b) => b.classList.remove('is-active'));
			btn.classList.add('is-active');

			if (votedMsg) {
				votedMsg.hidden = false;
				if (votedText) votedText.textContent = `Thank you! Your ${vote.toUpperCase()} rating has been added to ${serviceName}'s March 2026 Community Index.`;
			}
			if (voteTally) {
				voteTally.textContent = `Updated: Verified community vote recorded just now`;
			}
		});
	});

	// Load community reports
	function loadReports() {
		if (!reportsFeed) return;
		const defaultReports: Record<string, Array<{ user: string; time: string; text: string; badge: string }>> = {
			adobe: [
				{ user: 'Sarah M.', time: '3 hours ago', text: 'Loophole confirmed! Switched to Photography $9.99/mo plan, waited 30 minutes, cancelled with $0 early termination fee and 100% refund.', badge: 'Fee Waived' },
				{ user: 'David K.', time: 'Yesterday', text: 'Adobe tried invoicing $160 for 50% remaining contract. Support refused to waive until I cited the plan-switch cooling off terms.', badge: 'Trap Encountered' },
			],
			'planet-fitness': [
				{ user: 'Marcus T.', time: '2 days ago', text: 'Sent the USPS Certified Mail letter generated by CancelKits. Green return receipt signed 3 days later, zero questions asked.', badge: 'Certified Success' },
				{ user: 'Elena R.', time: '4 days ago', text: 'Front desk refused over phone saying "manager is out". Certified mail is literally the only way to avoid the in-person sales pitch.', badge: 'Phone Refused' },
			],
			audible: [
				{ user: 'Chris B.', time: 'Yesterday', text: 'Almost cancelled with 3 credits banked. Burned them on 3 box sets first—now I have 120 hours of audiobooks in my library permanently.', badge: 'Credit Saved' },
			],
		};

		let localReports: Array<{ user: string; time: string; text: string; badge: string }> = [];
		if (typeof localStorage !== 'undefined') {
			try {
				localReports = JSON.parse(localStorage.getItem(REPORTS_STORAGE_KEY) || '[]');
			} catch {}
		}

		const combined = [...localReports, ...(defaultReports[serviceSlug] || [
			{ user: 'Verified User', time: 'This week', text: `Completed cancellation for ${serviceName}. Followed the direct link to avoid the homepage marketing loop.`, badge: 'Verified' }
		])];

		reportsFeed.innerHTML = combined
			.map(
				(r) => `
			<div class="community-report-card">
				<div class="report-card-top">
					<span class="report-user">${r.user}</span>
					<span class="report-badge">${r.badge}</span>
					<span class="report-time">${r.time}</span>
				</div>
				<p class="report-text">${escapeHtml(r.text)}</p>
			</div>
		`
			)
			.join('');
	}

	function escapeHtml(str: string): string {
		const div = document.createElement('div');
		div.textContent = str;
		return div.innerHTML;
	}

	loadReports();

	submitReportBtn?.addEventListener('click', () => {
		if (!reportInput || !reportInput.value.trim()) return;
		const text = reportInput.value.trim();
		const newReport = {
			user: 'You (Community Member)',
			time: 'Just now',
			text,
			badge: 'Recent Report',
		};

		let existing: any[] = [];
		if (typeof localStorage !== 'undefined') {
			try {
				existing = JSON.parse(localStorage.getItem(REPORTS_STORAGE_KEY) || '[]');
			} catch {}
			existing.unshift(newReport);
			localStorage.setItem(REPORTS_STORAGE_KEY, JSON.stringify(existing));
		}

		reportInput.value = '';
		loadReports();
	});
</script>


	// ──────────────────────────────────────────────
	// Recurring amount pattern detection
	// ──────────────────────────────────────────────
	// Matches lines like: "10/05 NETFLIX.COM 15.49" or "SPOTIFY USA $11.99"
	const AMOUNT_PATTERN = /\$?\s*(\d{1,4}\.\d{2})\b/;

	interface DetectedSub {
		name: string;
		slug: string;
		monthlyPrice: number;
		category: string;
		matchedText: string;
		detectedAmount: number | null;
	}

	interface PotentialCharge {
		text: string;
		amount: number;
	}

	function extractSubscriptions(fullText: string): { matched: DetectedSub[]; unrecognized: PotentialCharge[] } {
		const lines = fullText.split('\n').map((l) => l.trim()).filter(Boolean);
		const matched: DetectedSub[] = [];
		const matchedNames = new Set<string>();
		const allTransactionLines: { text: string; amount: number }[] = [];

		// Build a set of lines that look like transactions (contain a dollar amount)
		for (const line of lines) {
			const amtMatch = line.match(AMOUNT_PATTERN);
			if (amtMatch) {
				allTransactionLines.push({ text: line, amount: parseFloat(amtMatch[1]) });
			}
		}

		// Scan full text for known merchants
		for (const merchant of MERCHANT_DB) {
			if (matchedNames.has(merchant.name)) continue;

			for (const pattern of merchant.patterns) {
				if (pattern.test(fullText)) {
					// Try to find the transaction line with amount
					let detectedAmount: number | null = null;
					let matchedText = '';

					for (const txn of allTransactionLines) {
						if (pattern.test(txn.text)) {
							detectedAmount = txn.amount;
							matchedText = txn.text;
							break;
						}
					}

					if (!matchedText) {
						const lineMatch = lines.find((l) => pattern.test(l));
						matchedText = lineMatch || merchant.name;
					}

					matched.push({
						name: merchant.name,
						slug: merchant.slug,
						monthlyPrice: detectedAmount || merchant.monthlyPrice,
						category: merchant.category,
						matchedText,
						detectedAmount,
					});
					matchedNames.add(merchant.name);
					break;
				}
			}
		}

		// Find potential recurring charges not matched to known merchants
		// Look for transactions between $2 and $200 that weren't matched
		const unrecognized: PotentialCharge[] = [];
		for (const txn of allTransactionLines) {
			if (txn.amount >= 2 && txn.amount <= 200) {
				const isMatched = matched.some((m) =>
					m.matchedText === txn.text ||
					MERCHANT_DB.some((db) => db.patterns.some((p) => p.test(txn.text)))
				);
				if (!isMatched) {
					// Look for recurring indicators
					const isLikelySubscription =
						/recurring|subscription|membership|monthly|annual|renewal|auto.?pay|bill/i.test(txn.text) ||
						/\.com|\.io|\.app|\.co\b/i.test(txn.text);
					if (isLikelySubscription) {
						unrecognized.push(txn);
					}
				}
			}
		}

		return { matched, unrecognized };
	}

	// ──────────────────────────────────────────────
	// UI Logic
	// ──────────────────────────────────────────────
	const dropzone = document.getElementById('dropzone') as HTMLElement;
	const dropzoneInner = document.getElementById('dropzone-inner') as HTMLElement;
	const dropzoneProgress = document.getElementById('dropzone-progress') as HTMLElement;
	const progressText = document.getElementById('progress-text') as HTMLElement;
	const fileInput = document.getElementById('file-input') as HTMLInputElement;
	const fileInfo = document.getElementById('file-info') as HTMLElement;
	const fileName = document.getElementById('file-name') as HTMLElement;
	const clearFile = document.getElementById('clear-file') as HTMLButtonElement;
	const resultsSection = document.getElementById('results-section') as HTMLElement;
	const noResultsSection = document.getElementById('no-results-section') as HTMLElement;
	const subCount = document.getElementById('sub-count') as HTMLElement;
	const subTotal = document.getElementById('sub-total') as HTMLElement;
	const annualCost = document.getElementById('annual-cost') as HTMLElement;
	const investedValue = document.getElementById('invested-value') as HTMLElement;
	const detectedGrid = document.getElementById('detected-grid') as HTMLElement;
	const unrecognizedSection = document.getElementById('unrecognized-section') as HTMLDetailsElement;
	const unrecognizedCount = document.getElementById('unrecognized-count') as HTMLElement;
	const unrecognizedGrid = document.getElementById('unrecognized-grid') as HTMLElement;
	const scanAnotherBtn = document.getElementById('scan-another-btn') as HTMLButtonElement;
	const tryAgainBtn = document.getElementById('try-again-btn') as HTMLButtonElement;

	function money(n: number): string {
		return new Intl.NumberFormat('en-US', {
			style: 'currency',
			currency: 'USD',
			maximumFractionDigits: n >= 100 ? 0 : 2,
		}).format(n);
	}

	function resetUI() {
		dropzoneInner.hidden = false;
		dropzoneProgress.hidden = true;
		fileInfo.hidden = true;
		resultsSection.hidden = true;
		noResultsSection.hidden = true;
		fileInput.value = '';
		dropzone.classList.remove('is-processing', 'is-done');
	}

	// Drag and drop handlers
	dropzone.addEventListener('dragover', (e) => {
		e.preventDefault();
		dropzone.classList.add('is-dragover');
	});
	dropzone.addEventListener('dragleave', () => {
		dropzone.classList.remove('is-dragover');
	});
	dropzone.addEventListener('drop', (e) => {
		e.preventDefault();
		dropzone.classList.remove('is-dragover');
		const files = e.dataTransfer?.files;
		if (files?.[0]?.type === 'application/pdf') {
			processFile(files[0]);
		}
	});

	// Click to browse
	dropzoneInner.addEventListener('click', () => fileInput.click());
	fileInput.addEventListener('change', () => {
		if (fileInput.files?.[0]) processFile(fileInput.files[0]);
	});

	// Clear file
	clearFile.addEventListener('click', resetUI);
	scanAnotherBtn?.addEventListener('click', () => {
		resetUI();
		dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
	});
	tryAgainBtn?.addEventListener('click', () => {
		resetUI();
		dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
	});

	async function processFile(file: File) {
		// Show progress
		dropzoneInner.hidden = true;
		dropzoneProgress.hidden = false;
		fileInfo.hidden = true;
		resultsSection.hidden = true;
		noResultsSection.hidden = true;
		dropzone.classList.add('is-processing');
		progressText.textContent = 'Loading PDF in your browser…';

		try {
			const arrayBuffer = await file.arrayBuffer();
			progressText.textContent = 'Extracting text from PDF pages…';

			// Load pdf.js from window or dynamic module import fallback
			let pdfjsLib = (window as any).pdfjsLib;
			if (!pdfjsLib) {
				try {
					pdfjsLib = await import(/* @vite-ignore */ 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.9.155/pdf.min.mjs');
				} catch (importErr) {
					console.warn('Dynamic PDF.js import fallback failed:', importErr);
				}
			}

			if (!pdfjsLib) {
				throw new Error('PDF.js library failed to load. Please check your internet connection and try again.');
			}

			// Set worker source
			if (pdfjsLib.GlobalWorkerOptions && !pdfjsLib.GlobalWorkerOptions.workerSrc) {
				pdfjsLib.GlobalWorkerOptions.workerSrc =
					'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
			}

			const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
			const totalPages = pdf.numPages;
			let fullText = '';

			for (let i = 1; i <= totalPages; i++) {
				progressText.textContent = `Reading page ${i} of ${totalPages}…`;
				const page = await pdf.getPage(i);
				const textContent = await page.getTextContent();
				const pageText = textContent.items.map((item: any) => item.str).join(' ');
				fullText += pageText + '\n';
			}

			progressText.textContent = 'Detecting recurring subscriptions…';

			// Short delay for visual feedback
			await new Promise((r) => setTimeout(r, 400));

			const { matched, unrecognized } = extractSubscriptions(fullText);

			// Show file info
			dropzoneProgress.hidden = true;
			fileInfo.hidden = false;
			fileName.textContent = file.name;
			dropzone.classList.remove('is-processing');
			dropzone.classList.add('is-done');

			if (matched.length === 0 && unrecognized.length === 0) {
				noResultsSection.hidden = false;
				noResultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
				return;
			}

			// Populate results
			const monthlyTotal = matched.reduce((sum, s) => sum + s.monthlyPrice, 0);
			const yearly = monthlyTotal * 12;
			// FV of annuity: PMT × ((1+i)^n - 1) / i where i = 0.07/12, n = 60
			const i = 0.07 / 12;
			const n = 60;
			const fv = monthlyTotal * ((Math.pow(1 + i, n) - 1) / i);

			subCount.textContent = String(matched.length);
			subTotal.textContent = money(monthlyTotal);
			annualCost.textContent = money(yearly);
			investedValue.textContent = money(fv);

			// Render detected subscription cards
			detectedGrid.innerHTML = matched
				.sort((a, b) => b.monthlyPrice - a.monthlyPrice)
				.map((sub) => `
					<a href="/cancel/${sub.slug}/" class="detected-card" title="View cancellation guide for ${sub.name}">
						<div class="detected-card__top">
							<img src="https://www.google.com/s2/favicons?domain=${sub.slug === 'gym-membership' ? 'planetfitness.com' : sub.slug.replace(/-/g, '') + '.com'}&sz=32" width="24" height="24" alt="" class="detected-favicon" loading="lazy" />
							<span class="detected-name">${sub.name}</span>
							<span class="detected-category">${sub.category}</span>
						</div>
						<div class="detected-card__bottom">
							<span class="detected-price">${money(sub.monthlyPrice)}<small>/mo</small></span>
							<span class="detected-action">Cancel guide →</span>
						</div>
						${sub.detectedAmount ? `<div class="detected-matched-line" title="Matched transaction text"><code>${escapeHtml(sub.matchedText.substring(0, 60))}</code></div>` : ''}
					</a>
				`).join('');

			// Render unrecognized
			if (unrecognized.length > 0) {
				unrecognizedSection.hidden = false;
				unrecognizedCount.textContent = String(unrecognized.length);
				unrecognizedGrid.innerHTML = unrecognized
					.sort((a, b) => b.amount - a.amount)
					.map((txn) => `
						<div class="unrecognized-card">
							<span class="unrecognized-text">${escapeHtml(txn.text.substring(0, 70))}</span>
							<span class="unrecognized-amount">${money(txn.amount)}</span>
						</div>
					`).join('');
			} else {
				unrecognizedSection.hidden = true;
			}

			resultsSection.hidden = false;
			resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
		} catch (err: any) {
			console.error('PDF parsing error:', err);
			dropzoneProgress.hidden = true;
			dropzoneInner.hidden = false;
			dropzone.classList.remove('is-processing');
			alert(err?.message || 'Failed to parse PDF. Please make sure it is a text-based PDF statement.');
		}
	}

	function escapeHtml(str: string): string {
		const div = document.createElement('div');
		div.textContent = str;
		return div.innerHTML;
	}
</script>


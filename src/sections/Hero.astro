---
import type { Translation } from '../i18n/translations';

const subscriptions = ['Netflix', 'Spotify', 'Adobe', 'Hulu', 'Disney+', 'Planet Fitness', 'NYT', 'Audible', 'Canva', 'NordVPN'];
interface Props { t?: Translation; }
const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__glow" aria-hidden="true"></div>

	<div class="hero__content">
		<div class="hero__intro fade-in-up">
			<p class="hero__eyebrow"><span class="hero__dot"></span> CANCEL SUBSCRIPTIONS · STOP RECURRING CHARGES</p>
			<h1 id="hero-title" class="hero__title">
				<span>Cancel any subscription instantly —</span>
				<span class="hero__title-accent">find what's draining you</span>
			</h1>
			<p class="hero__description">
				{t?.hero_sub ?? 'The average American wastes $219/month on forgotten subscriptions. CancelKits finds them. CancelKits helps you cancel them.'}
			</p>
		</div>

		<form class="hero__form fade-in-up stagger-1" action="/onboarding/connect" method="get">
			<div class="hero__field-row">
				<input
					class="hero__input"
					type="email"
					name="email"
					autocomplete="email"
					aria-label="Email address"
					placeholder={t?.email_placeholder ?? 'you@example.com'}
					required
				/>
				<button class="hero__button" type="submit">{t?.cta_button ?? 'Find my subscriptions →'}</button>
			</div>
			<p class="hero__reassurance">{t?.reassurance ?? 'No credit card required · Free subscription audit in 30 seconds'}</p>
		</form>

		<div class="hero__proof fade-in-up stagger-2" aria-label="CancelKits product highlights">
			<div class="hero__stat-row hero__stat-row--solo">
				<div class="hero__stat">
					<strong>$219/mo</strong>
					<span>avg. wasted on forgotten subscriptions</span>
				</div>
				<div class="hero__divider" aria-hidden="true"></div>
				<div class="hero__stat">
					<strong>50+</strong>
					<span>verified cancel guides</span>
				</div>
				<div class="hero__divider" aria-hidden="true"></div>
				<div class="hero__stat">
					<strong>30 sec</strong>
					<span>free subscription scan</span>
				</div>
			</div>
		</div>
	</div>

	<div class="hero__ticker fade-in-up stagger-3" aria-label="Services cancelled with CancelKits">
		<div class="hero__ticker-track">
			<div class="hero__ticker-group">
				{subscriptions.map((s) => <span class="hero__ticker-pill">{s}</span>)}
			</div>
			<div class="hero__ticker-group" aria-hidden="true">
				{subscriptions.map((s) => <span class="hero__ticker-pill">{s}</span>)}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 90svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		background: #050505;
		width: 100%;
	}

	.hero__glow {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: min(120%, 900px);
		height: 70%;
		background:
			radial-gradient(ellipse 50% 60% at 50% 40%, rgba(0, 255, 136, 0.07) 0%, transparent 70%),
			radial-gradient(ellipse 35% 40% at 45% 50%, rgba(0, 200, 100, 0.04) 0%, transparent 60%);
		pointer-events: none;
		z-index: 0;
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: min(100% - 2rem, 52rem);
		margin: 0 auto;
		padding: 5rem 0 2.5rem;
		text-align: center;
	}

	.hero__eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 0 1.25rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		flex-wrap: wrap;
	}

	.hero__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 8px rgba(0, 255, 136, 0.4);
		flex-shrink: 0;
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 7.5vw, 4.4rem);
		font-weight: 600;
		letter-spacing: -0.05em;
		line-height: 1.05;
		color: #fff;
		word-break: break-word;
	}

	.hero__title span {
		display: block;
	}

	.hero__title-accent {
		color: var(--color-accent);
		text-shadow: 0 0 40px rgba(0, 255, 136, 0.15);
	}

	.hero__description {
		margin: 1.25rem auto 0;
		max-width: 34rem;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-muted);
		padding: 0 0.5rem;
	}

	.hero__form {
		max-width: 32rem;
		margin: 2rem auto 0;
		width: 100%;
	}

	.hero__field-row {
		display: flex;
		gap: 0.5rem;
		width: 100%;
	}

	.hero__input {
		min-width: 0;
		flex: 1;
		padding: 0.85rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-input);
		background: var(--color-surface);
		color: #fff;
		font: inherit;
		font-size: 0.95rem;
		transition: border-color 0.2s;
		height: 48px;
	}

	.hero__input::placeholder {
		color: var(--color-faint);
	}

	.hero__input:focus {
		outline: none;
		border-color: rgba(0, 255, 136, 0.4);
	}

	.hero__button {
		flex: none;
		border: 0;
		border-radius: var(--radius-pill);
		padding: 0.85rem 1.4rem;
		background: var(--color-accent);
		color: #000;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 700;
		cursor: pointer;
		transition: transform 0.2s, box-shadow 0.2s;
		white-space: nowrap;
		height: 48px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.hero__button:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(0, 255, 136, 0.2);
	}

	.hero__reassurance {
		margin: 0.75rem 0 0;
		color: var(--color-faint);
		font-size: 0.78rem;
	}

	.hero__proof {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		margin: 2.5rem auto 0;
		max-width: 100%;
		width: fit-content;
	}

	.hero__counter {
		display: flex;
		justify-content: center;
	}

	.hero__stat-row {
		display: flex;
		justify-content: center;
		align-items: stretch;
		flex-wrap: wrap;
		gap: 0;
		padding: 0.85rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
	}

	.hero__stat-row--solo {
		width: min(100%, 42rem);
	}

	.hero__stat {
		padding: 0 1rem;
		text-align: center;
		white-space: nowrap;
	}

	.hero__stat strong {
		display: block;
		color: #fff;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.hero__stat span {
		color: var(--color-muted);
		font-size: 0.72rem;
	}

	.hero__divider {
		width: 1px;
		height: 1.75rem;
		background: var(--color-border);
	}

	.hero__ticker {
		position: relative;
		z-index: 1;
		width: 100%;
		padding: 1.5rem 0 2.5rem;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.hero__ticker-track {
		display: flex;
		width: max-content;
		animation: ticker-scroll 32s linear infinite;
	}

	.hero__ticker-group {
		display: flex;
		gap: 0.5rem;
		padding-right: 0.5rem;
	}

	.hero__ticker-pill {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-input);
		background: var(--color-surface);
		color: var(--color-muted);
		padding: 0.4rem 0.75rem;
		font-size: 0.78rem;
		white-space: nowrap;
	}

	@keyframes ticker-scroll {
		to { transform: translateX(-50%); }
	}

	@media (max-width: 600px) {
		.hero__content {
			width: min(100% - 1.5rem, 52rem);
			padding: 4rem 0 2rem;
		}

		.hero__description {
			font-size: 0.95rem;
		}

		.hero__field-row {
			flex-direction: column;
			gap: 0.65rem;
		}

		.hero__button {
			width: 100%;
		}

		.hero__proof {
			width: 100%;
			max-width: 22rem;
		}

		.hero__stat-row {
			flex-direction: column;
			gap: 0.65rem;
			padding: 1rem;
			width: 100%;
		}

		.hero__divider {
			width: 100%;
			height: 1px;
		}

		.hero__stat {
			padding: 0.25rem 0;
			white-space: normal;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__ticker-track {
			animation-play-state: paused;
		}
	}
</style>

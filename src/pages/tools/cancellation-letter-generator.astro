function getScenarioLabel(scenario: string): string {
	switch (scenario) {
		case 'cancel': return 'Subscription Cancellation Request';
		case 'trial-refund': return 'Free Trial Refund Request — Accidental Charge';
		case 'renewal-refund': return 'Auto-Renewal Refund Request — No Prior Notice';
		case 'escalation': return 'Formal Cancellation Demand — Consumer Rights Escalation';
		default: return 'Subscription Cancellation Request';
	}
}

function generateBody(opts: {
	company: string;
	scenario: string;
	tone: string;
	userName: string;
	userEmail: string;
	last4: string;
	chargeAmount: string;
	chargeDate: string;
}): string {
	const { company, scenario, tone, userName, userEmail, last4, chargeAmount, chargeDate } = opts;
	const name = userName || '[Your Full Name]';
	const email = userEmail || '[Your Account Email]';
	const card = last4 ? `ending in ${last4}` : '[card ending in XXXX]';
	const amount = chargeAmount || '[Charge Amount]';
	const date = chargeDate ? new Date(chargeDate + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '[Charge Date]';
	const today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
	const companyName = company || '[Company Name]';

	const greeting = tone === 'legal'
		? `To Whom It May Concern at ${companyName}:`
		: tone === 'firm'
			? `Dear ${companyName} Billing Department:`
			: `Dear ${companyName} Support Team,`;

	let body = '';

	if (scenario === 'cancel') {
		body = `${greeting}

I am writing to formally request the immediate cancellation of my subscription/membership with ${companyName}.

Account Details:
• Account Holder: ${name}
• Account Email: ${email}
• Payment Method: ${card}

Please process this cancellation effective immediately and confirm the following:
1. My subscription has been cancelled and will not auto-renew
2. No further charges will be made to my payment method
3. Written confirmation of this cancellation sent to my email address

${tone === 'legal' ? `Please be advised that I am aware of the Federal Trade Commission's "Click-to-Cancel" rule (16 CFR Part 425, effective 2025), which mandates that cancellation must be at least as easy as the sign-up process. Any failure to process this cancellation promptly may result in a formal complaint to the FTC at ReportFraud.ftc.gov and a chargeback dispute with my financial institution.

Under the Electronic Fund Transfer Act (EFTA, 12 CFR § 1005.10(c)), I hereby revoke authorization for any future recurring charges to my account.` : tone === 'firm' ? `I expect this cancellation to be processed without requiring a phone call, in-person visit, or additional steps beyond this written request. Under the FTC's Click-to-Cancel rule, companies must provide cancellation methods as easy as sign-up.

If this cancellation is not confirmed within 5 business days, I will file a chargeback with my bank and a complaint with the FTC.` : `I would appreciate a confirmation email once the cancellation has been processed. If there are any issues with this request, please let me know promptly.`}

Thank you for your attention to this matter.

Sincerely,
${name}
${email}
Date: ${today}`;
	}

	else if (scenario === 'trial-refund') {
		body = `${greeting}

I am writing to request an immediate refund for a charge of ${amount} on ${date} to my payment method ${card}.

I signed up for a free trial of ${companyName} and intended to cancel before the trial period ended. I was charged ${amount} without adequate notice that my trial was converting to a paid subscription.

Account Details:
• Account Holder: ${name}
• Account Email: ${email}
• Charge Amount: ${amount}
• Charge Date: ${date}
• Payment Method: ${card}

I am requesting:
1. A full refund of ${amount} to my original payment method
2. Immediate cancellation of my subscription with no further charges
3. Written confirmation of both the refund and cancellation

${tone === 'legal' ? `Under the FTC's "Click-to-Cancel" rule and the Restore Online Shoppers' Confidence Act (ROSCA), companies must clearly disclose material terms before charging consumers and obtain express informed consent. The FTC has taken enforcement action against companies that fail to provide adequate trial-to-paid conversion notices.

I reserve the right to file a chargeback dispute with my financial institution under Regulation E (debit cards) or the Fair Credit Billing Act (credit cards), and to report this matter to the FTC at ReportFraud.ftc.gov if this refund is not processed within 5 business days.` : tone === 'firm' ? `This charge was unexpected and I request it be reversed within 5 business days. If I do not receive a refund, I will pursue a chargeback with my bank and file a complaint with the FTC.

Companies are required under the FTC's Click-to-Cancel rule to provide clear notice before converting free trials to paid subscriptions.` : `I believe this charge was an oversight as I intended to cancel before the trial ended. I would greatly appreciate your help in processing a refund.`}

Thank you for your prompt attention to this matter.

Sincerely,
${name}
${email}
Date: ${today}`;
	}

	else if (scenario === 'renewal-refund') {
		body = `${greeting}

I am writing to request a refund for an auto-renewal charge of ${amount} on ${date} to my payment method ${card}.

I did not receive adequate prior notice that my ${companyName} subscription was about to auto-renew. Had I been properly notified, I would have cancelled before the renewal date.

Account Details:
• Account Holder: ${name}
• Account Email: ${email}
• Charge Amount: ${amount}
• Charge Date: ${date}
• Payment Method: ${card}

I am requesting:
1. A full refund of ${amount} to my original payment method
2. Immediate cancellation of my subscription — no further renewals
3. Written confirmation of both the refund and cancellation

${tone === 'legal' ? `Under the FTC's "Click-to-Cancel" rule (16 CFR Part 425) and the Restore Online Shoppers' Confidence Act (ROSCA, 15 U.S.C. § 8401 et seq.), businesses that charge consumers on a recurring basis must provide clear and conspicuous notice before each renewal charge, and must obtain express informed consent before charging.

Failure to provide renewal notice violates FTC regulations and may constitute an unfair or deceptive practice under Section 5 of the FTC Act. I reserve the right to dispute this charge under the Fair Credit Billing Act and to file complaints with the FTC (ReportFraud.ftc.gov) and my state Attorney General's consumer protection division.

I am requesting that this refund be processed within 5 business days.` : tone === 'firm' ? `I was not given adequate notice before this renewal charge, which I believe violates the FTC's requirements for negative option marketing. I expect a full refund within 5 business days.

If this refund is not processed promptly, I will file a chargeback with my bank and a complaint with the FTC.` : `I did not intend to renew this subscription and was not aware the renewal was imminent. I would appreciate your help in processing a refund for this charge.`}

Thank you for your assistance.

Sincerely,
${name}
${email}
Date: ${today}`;
	}

	else if (scenario === 'escalation') {
		body = `${greeting}

This is a formal demand for the immediate cancellation of my subscription and a full refund of recent charges.

I have attempted to cancel my ${companyName} subscription through your standard channels and have encountered excessive obstacles, hidden cancellation processes, and/or deliberate friction designed to prevent cancellation. This practice constitutes a "dark pattern" under federal and state consumer protection law.

Account Details:
• Account Holder: ${name}
• Account Email: ${email}
• Payment Method: ${card}
${chargeAmount ? `• Disputed Charge: ${amount} on ${date}` : ''}

FORMAL DEMANDS:

1. IMMEDIATE CANCELLATION of my subscription/membership, effective today
2. FULL REFUND of ${amount !== '[Charge Amount]' ? amount : 'any charges incurred due to your company\'s failure to provide a simple cancellation mechanism'}
3. REVOCATION OF BILLING AUTHORIZATION — I hereby revoke all authorization for future charges under the Electronic Fund Transfer Act (EFTA, 12 CFR § 1005.10(c))
4. WRITTEN CONFIRMATION of cancellation and refund within 5 business days

LEGAL BASIS:

• FTC "Click-to-Cancel" Rule (16 CFR Part 425, effective 2025): Requires cancellation to be at least as easy as sign-up. Making cancellation harder than enrollment is a violation.
• Restore Online Shoppers' Confidence Act (ROSCA, 15 U.S.C. § 8401): Prohibits charging consumers without clear disclosure and express informed consent.
• FTC Act Section 5: Dark patterns in subscription cancellation constitute unfair or deceptive acts or practices.
• State Consumer Protection Laws: Most states have additional protections against deceptive billing practices.

IF THIS REQUEST IS NOT HONORED WITHIN 5 BUSINESS DAYS, I WILL:
• File a chargeback/dispute with my financial institution
• File a formal complaint with the FTC at ReportFraud.ftc.gov
• File a complaint with my state Attorney General's consumer protection division
• Report to the Better Business Bureau (BBB)

This letter serves as formal written notice and will be retained as evidence for any future regulatory or legal proceedings.

Sincerely,
${name}
${email}
Date: ${today}`;
	}

	return body;
}

function initCLG() {
	// Elements
	const serviceSelect = document.getElementById('service-select') as HTMLSelectElement;
	const customCompanyWrap = document.getElementById('custom-company-wrap') as HTMLElement;
	const customCompanyInput = document.getElementById('custom-company') as HTMLInputElement;
	const customEmailWrap = document.getElementById('custom-email-wrap') as HTMLElement;
	const customEmailInput = document.getElementById('custom-email') as HTMLInputElement;
	const proTip = document.getElementById('pro-tip') as HTMLElement;
	const proTipText = document.getElementById('pro-tip-text') as HTMLElement;
	const scenarioCards = document.getElementById('scenario-cards') as HTMLElement;
	const userNameInput = document.getElementById('user-name') as HTMLInputElement;
	const userEmailInput = document.getElementById('user-email') as HTMLInputElement;
	const last4Input = document.getElementById('user-last4') as HTMLInputElement;
	const chargeAmountInput = document.getElementById('charge-amount') as HTMLInputElement;
	const chargeDateInput = document.getElementById('charge-date') as HTMLInputElement;

	// Preview elements
	const previewTo = document.getElementById('preview-to')!;
	const previewFrom = document.getElementById('preview-from')!;
	const previewSubject = document.getElementById('preview-subject')!;
	const previewBody = document.getElementById('preview-body')!;

	// Action buttons
	const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
	const copyBtnText = document.getElementById('copy-btn-text')!;
	const mailtoBtn = document.getElementById('mailto-btn') as HTMLAnchorElement;
	const printBtn = document.getElementById('print-btn') as HTMLButtonElement;
	const toast = document.getElementById('toast') as HTMLElement;

	// Populate service dropdown
	const serviceOptions: { value: string; label: string }[] = [
		{ value: 'adobe', label: 'Adobe Creative Cloud' },
		{ value: 'netflix', label: 'Netflix' },
		{ value: 'spotify', label: 'Spotify' },
		{ value: 'hulu', label: 'Hulu' },
		{ value: 'disney-plus', label: 'Disney+' },
		{ value: 'amazon-prime', label: 'Amazon Prime' },
		{ value: 'youtube-premium', label: 'YouTube Premium' },
		{ value: 'apple-one', label: 'Apple One / Apple Subscriptions' },
		{ value: 'audible', label: 'Audible' },
		{ value: 'nyt', label: 'The New York Times' },
		{ value: 'linkedin-premium', label: 'LinkedIn Premium' },
		{ value: 'canva-pro', label: 'Canva Pro' },
		{ value: 'nordvpn', label: 'NordVPN' },
		{ value: 'sirius-xm', label: 'SiriusXM' },
		{ value: 'xbox-game-pass', label: 'Xbox Game Pass' },
		{ value: 'peloton', label: 'Peloton' },
		{ value: 'planet-fitness', label: 'Planet Fitness' },
		{ value: 'la-fitness', label: 'LA Fitness' },
		{ value: 'anytime-fitness', label: 'Anytime Fitness' },
		{ value: 'crunch-fitness', label: 'Crunch Fitness' },
		{ value: 'equinox', label: 'Equinox' },
		{ value: 'gym-generic', label: 'Other Gym / Health Club' },
		{ value: 'free-trial-generic', label: 'Free Trial (Generic)' },
		{ value: 'saas-generic', label: 'SaaS / Software (Generic)' },
		{ value: 'custom', label: '✏️ Custom Company…' },
	];

	serviceOptions.forEach((opt) => {
		const option = document.createElement('option');
		option.value = opt.value;
		option.textContent = opt.label;
		serviceSelect.appendChild(option);
	});

	// Get current state
	function getState() {
		const serviceKey = serviceSelect.value;
		const preset = SERVICE_PRESETS[serviceKey];
		const isCustom = serviceKey === 'custom';

		const company = isCustom
			? (customCompanyInput.value.trim() || '')
			: (preset?.name || '');

		const recipientEmail = isCustom
			? (customEmailInput.value.trim() || '')
			: (preset?.email || '');

		const scenario = (scenarioCards.querySelector('input[name="scenario"]:checked') as HTMLInputElement)?.value || 'cancel';
		const tone = (document.querySelector('input[name="tone"]:checked') as HTMLInputElement)?.value || 'polite';

		return {
			serviceKey,
			company,
			recipientEmail,
			scenario,
			tone,
			userName: userNameInput.value.trim(),
			userEmail: userEmailInput.value.trim(),
			last4: last4Input.value.trim(),
			chargeAmount: chargeAmountInput.value.trim(),
			chargeDate: chargeDateInput.value,
			tip: preset?.tip || '',
			isCustom,
		};
	}

	function updatePreview() {
		const state = getState();

		// Show/hide custom fields
		customCompanyWrap.style.display = state.isCustom ? 'block' : 'none';
		customEmailWrap.style.display = state.isCustom ? 'block' : 'none';

		// Pro tip
		if (state.tip && !state.isCustom) {
			proTip.style.display = 'block';
			proTipText.textContent = state.tip;
		} else {
			proTip.style.display = 'none';
		}

		// Email preview
		previewTo.textContent = state.recipientEmail || '[support@company.com]';
		previewFrom.textContent = state.userEmail || '[Your Email Address]';
		previewSubject.textContent = getScenarioLabel(state.scenario) + (state.company ? ` — ${state.company}` : '');

		const bodyText = generateBody({
			company: state.company,
			scenario: state.scenario,
			tone: state.tone,
			userName: state.userName,
			userEmail: state.userEmail,
			last4: state.last4,
			chargeAmount: state.chargeAmount,
			chargeDate: state.chargeDate,
		});

		// Render body as formatted text
		previewBody.innerHTML = '';
		const pre = document.createElement('div');
		pre.className = 'email-body-text';
		pre.textContent = bodyText;
		previewBody.appendChild(pre);

		// Update mailto link
		const subject = encodeURIComponent(getScenarioLabel(state.scenario) + (state.company ? ` — ${state.company}` : ''));
		const mailtoBody = encodeURIComponent(bodyText);
		const mailtoEmail = state.recipientEmail && !state.recipientEmail.startsWith('[')
			? state.recipientEmail
			: '';
		mailtoBtn.href = `mailto:${mailtoEmail}?subject=${subject}&body=${mailtoBody}`;
	}

	// Radio card selection styling
	scenarioCards.addEventListener('change', () => {
		scenarioCards.querySelectorAll('.scenario-card').forEach((card) => {
			const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
			card.classList.toggle('is-selected', radio.checked);
		});
		updatePreview();
	});

	document.querySelectorAll('input[name="tone"]').forEach((radio) => {
		radio.addEventListener('change', () => {
			document.querySelectorAll('.tone-pill').forEach((pill) => {
				const r = pill.querySelector('input[type="radio"]') as HTMLInputElement;
				pill.classList.toggle('is-selected', r.checked);
			});
			updatePreview();
		});
	});

	// Listen to all inputs
	const allInputs = [serviceSelect, customCompanyInput, customEmailInput, userNameInput, userEmailInput, last4Input, chargeAmountInput, chargeDateInput];
	allInputs.forEach((input) => {
		if (input) {
			input.addEventListener('input', updatePreview);
			input.addEventListener('change', updatePreview);
		}
	});

	// Copy button
	copyBtn.addEventListener('click', () => {
		const state = getState();
		const subject = getScenarioLabel(state.scenario) + (state.company ? ` — ${state.company}` : '');
		const bodyText = generateBody({
			company: state.company,
			scenario: state.scenario,
			tone: state.tone,
			userName: state.userName,
			userEmail: state.userEmail,
			last4: state.last4,
			chargeAmount: state.chargeAmount,
			chargeDate: state.chargeDate,
		});
		const fullText = `Subject: ${subject}\n\n${bodyText}`;
		navigator.clipboard.writeText(fullText).then(() => {
			copyBtnText.textContent = 'Copied!';
			toast.hidden = false;
			setTimeout(() => {
				copyBtnText.textContent = 'Copy Letter';
				toast.hidden = true;
			}, 2000);
		});
	});

	// Print button
	printBtn.addEventListener('click', () => window.print());

	// Preset pill buttons (quick-select)
	document.querySelectorAll<HTMLButtonElement>('.pill-btn[data-preset]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const preset = btn.dataset.preset;
			if (!preset) return;

			// Set the service
			serviceSelect.value = preset;
			serviceSelect.dispatchEvent(new Event('change'));

			// If it's a trial-related preset, select the trial-refund scenario
			if (preset === 'free-trial-generic') {
				const trialRadio = scenarioCards.querySelector('input[value="trial-refund"]') as HTMLInputElement;
				if (trialRadio) {
					trialRadio.checked = true;
					trialRadio.dispatchEvent(new Event('change', { bubbles: true }));
				}
			}

			// Scroll to the generator
			const target = document.getElementById('generator');
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});
	});

	// Handle URL hash presets (e.g., #adobe)
	function handleHash() {
		const hash = window.location.hash.replace('#', '');
		if (hash && SERVICE_PRESETS[hash]) {
			serviceSelect.value = hash;
			serviceSelect.dispatchEvent(new Event('change'));
		}
	}
	handleHash();
	window.addEventListener('hashchange', handleHash);

	// Initial render
	updatePreview();
}

if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', initCLG);
} else {
	initCLG();
}
</script>


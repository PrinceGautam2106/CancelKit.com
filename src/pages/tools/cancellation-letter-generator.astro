---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Free Subscription Cancellation Letter & Refund Email Generator (2026) | CancelKits";
const pageDescription = "Generate a legally firm subscription cancellation email or auto-renewal refund request in seconds. Free templates for gyms, Adobe, trials, and recurring charges.";

const webAppSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Subscription Cancellation Letter & Refund Email Generator',
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Web',
	url: 'https://cancelkits.com/tools/cancellation-letter-generator/',
	description: pageDescription,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
	featureList: [
		'Pre-built cancellation templates for 25+ services',
		'Free trial refund request generator',
		'FTC dark-pattern escalation letters',
		'One-click copy, email, and print',
		'100% client-side — zero data leaves your browser',
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Is this cancellation letter generator really free?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Yes, 100% free with no login required. The tool runs entirely in your browser — no data is sent to any server, no AI API calls are made, and no personal information is stored.',
			},
		},
		{
			'@type': 'Question',
			name: 'Can I use this to get a refund for an auto-renewal I didn\'t want?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Absolutely. Select the "Unwanted Auto-Renewal Refund" or "Forgotten Free Trial Refund" scenario. The generator creates a legally-grounded email citing FTC Click-to-Cancel rules and consumer protection statutes that companies are required to follow.',
			},
		},
		{
			'@type': 'Question',
			name: 'Does sending a cancellation email legally cancel my subscription?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Under the FTC\'s 2024 Click-to-Cancel rule (effective 2025), companies must provide cancellation methods that are as easy as signing up. A written email creates a timestamped paper trail. If the company ignores it, you have documented proof for a chargeback with your bank.',
			},
		},
		{
			'@type': 'Question',
			name: 'What if the company ignores my cancellation email?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'If the company continues charging you after receiving your cancellation request: (1) File a chargeback/dispute with your bank or credit card, (2) File a complaint with the FTC at ReportFraud.ftc.gov, (3) Report to your state Attorney General\'s consumer protection division. Your emailed cancellation letter serves as timestamped evidence.',
			},
		},
		{
			'@type': 'Question',
			name: 'How do I cancel Adobe Creative Cloud without paying the early termination fee?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Select "Adobe Creative Cloud" from the service list and choose the "Standard Immediate Cancellation" scenario. The generated letter specifically requests waiving the early termination fee by citing financial hardship or accidental plan selection — Adobe agents have documented authority to waive this fee when customers ask firmly.',
			},
		},
	],
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	canonicalPath="/tools/cancellation-letter-generator/"
	keywords="cancellation letter generator, cancel subscription email, refund email template, cancel auto-renewal, free trial refund request, cancel Adobe, cancel gym membership, cancel Netflix, cancel Spotify, subscription cancellation template, FTC click to cancel"
	schemas={[webAppSchema, faqSchema]}
>
	<Nav />

	<main class="clg-tool">
		<!-- Hero Section -->
		<header class="clg-hero">
			<div class="clg-hero__badge">
				<span class="badge-dot"></span>
				<span>100% Free • No Login • Zero Data Leaves Your Browser</span>
			</div>
			<h1 class="clg-hero__title">
				Subscription Cancellation Letter<br />& Refund Email Generator
			</h1>
			<p class="clg-hero__subtitle">
				Generate a professionally worded cancellation email or auto-renewal refund request in seconds.
				Pre-loaded templates for Adobe, Netflix, gyms, free trials, and 25+ high-friction services.
			</p>
		</header>

		<!-- Quick-Select Preset Pills -->
		<section class="preset-pills" aria-label="Quick template selection">
			<button type="button" class="pill-btn" data-preset="adobe">Adobe Cancellation Letter</button>
			<button type="button" class="pill-btn" data-preset="planet-fitness">Gym Cancellation Letter</button>
			<button type="button" class="pill-btn" data-preset="netflix">Netflix Cancellation Letter</button>
			<button type="button" class="pill-btn" data-preset="spotify">Spotify Cancellation Email</button>
			<button type="button" class="pill-btn" data-preset="free-trial-generic">Free Trial Refund Email</button>
			<button type="button" class="pill-btn" data-preset="sirius-xm">SiriusXM Cancellation</button>
			<button type="button" class="pill-btn" data-preset="nyt">NYT Cancellation</button>
		</section>

		<!-- Tool Workspace -->
		<section class="clg-workspace" id="generator">
			<!-- Left Column: Form -->
			<div class="clg-form-card">
				<div class="form-card__header">
					<h2>Build Your Letter</h2>
					<p>Your data stays 100% in your browser. Nothing is stored or transmitted.</p>
				</div>

				<form id="clg-form" class="generator-form" onsubmit="return false;">
					<!-- Service / Company Selector -->
					<div class="form-divider"><span>Service / Company</span></div>

					<div class="form-group">
						<label for="service-select">Service or Company</label>
						<select id="service-select" class="form-input"></select>
					</div>

					<div class="form-group" id="custom-company-wrap" style="display: none;">
						<label for="custom-company">Custom Company Name</label>
						<input type="text" id="custom-company" class="form-input" placeholder="e.g. Acme SaaS Inc." />
					</div>

					<div class="form-group" id="custom-email-wrap" style="display: none;">
						<label for="custom-email">Support / Billing Email</label>
						<input type="email" id="custom-email" class="form-input" placeholder="e.g. support@example.com" />
					</div>

					<!-- Pro Tip -->
					<div class="pro-tip" id="pro-tip" style="display: none;">
						<div class="pro-tip__badge">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
							<span>Pro Tip</span>
						</div>
						<p id="pro-tip-text"></p>
					</div>

					<!-- Letter Goal / Scenario -->
					<div class="form-divider"><span>Letter Goal / Scenario</span></div>

					<div class="scenario-cards" id="scenario-cards">
						<label class="scenario-card is-selected">
							<input type="radio" name="scenario" value="cancel" checked />
							<div class="scenario-card__inner">
								<strong>Standard Cancellation</strong>
								<span>Stop auto-renewal immediately</span>
							</div>
						</label>
						<label class="scenario-card">
							<input type="radio" name="scenario" value="trial-refund" />
							<div class="scenario-card__inner">
								<strong>Free Trial Refund</strong>
								<span>Charged within last 48 hours</span>
							</div>
						</label>
						<label class="scenario-card">
							<input type="radio" name="scenario" value="renewal-refund" />
							<div class="scenario-card__inner">
								<strong>Auto-Renewal Refund</strong>
								<span>No reminder notice received</span>
							</div>
						</label>
						<label class="scenario-card">
							<input type="radio" name="scenario" value="escalation" />
							<div class="scenario-card__inner">
								<strong>Dark Pattern Escalation</strong>
								<span>FTC / Consumer Rights citation</span>
							</div>
						</label>
					</div>

					<!-- Tone Selector -->
					<div class="form-divider"><span>Tone</span></div>

					<div class="tone-row">
						<label class="tone-pill is-selected">
							<input type="radio" name="tone" value="polite" checked />
							<span>Polite & Standard</span>
						</label>
						<label class="tone-pill">
							<input type="radio" name="tone" value="firm" />
							<span>Firm & Formal</span>
						</label>
						<label class="tone-pill">
							<input type="radio" name="tone" value="legal" />
							<span>Legal / Escalation</span>
						</label>
					</div>

					<!-- User Details -->
					<div class="form-divider"><span>Your Details (Optional)</span></div>

					<div class="form-group">
						<label for="user-name">Full Name</label>
						<input type="text" id="user-name" class="form-input" placeholder="e.g. Alex Johnson" />
					</div>

					<div class="form-group">
						<label for="user-email">Account Email</label>
						<input type="email" id="user-email" class="form-input" placeholder="e.g. alex@example.com" />
					</div>

					<div class="form-row">
						<div class="form-group">
							<label for="user-last4">Last 4 of Card</label>
							<input type="text" id="user-last4" class="form-input" placeholder="e.g. 4242" maxlength="4" />
						</div>
						<div class="form-group">
							<label for="charge-amount">Charge Amount</label>
							<input type="text" id="charge-amount" class="form-input" placeholder="e.g. $14.99" />
						</div>
					</div>

					<div class="form-group">
						<label for="charge-date">Charge Date</label>
						<input type="date" id="charge-date" class="form-input" />
					</div>
				</form>
			</div>

			<!-- Right Column: Live Preview -->
			<div class="clg-preview-card" id="preview">

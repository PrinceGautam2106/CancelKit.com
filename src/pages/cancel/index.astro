---
import Nav from '../../components/Nav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	difficultyLabel,
	formatPrice,
	getServicesByCategory,
	services,
	type CancelDifficulty,
} from '../../data/services';

const groups = getServicesByCategory();
const title = 'Cancel Any Subscription — Complete Guide | CancelKit';
const description =
	'How to cancel subscriptions in 2026. Search 50+ guides for Netflix, Spotify, Adobe, gyms, VPNs, and more — or cancel in one click with CancelKit.';

const difficultyClass: Record<CancelDifficulty, string> = {
	easy: 'is-easy',
	medium: 'is-medium',
	hard: 'is-hard',
	nightmare: 'is-nightmare',
};

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Subscription cancel guides',
	numberOfItems: services.length,
	itemListElement: services.map((service, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: `How to cancel ${service.name}`,
		url: `https://cancelkit.com/cancel/${service.slug}`,
	})),
};
---

<BaseLayout {title} {description}>
	<Nav />
	<main class="hub">
		<header class="hub__header">
			<p class="hub__eyebrow">Cancel guides</p>
			<h1 class="hub__title">Cancel Any Subscription — Complete Guide</h1>
			<p class="hub__lede">
				Search how to cancel Netflix, Spotify, Adobe, gyms, and {services.length}+ more. Each guide has steps,
				difficulty, and a one-click CancelKit option.
			</p>
			<label class="hub__search">
				<span class="sr-only">Search subscriptions to cancel</span>
				<input
					type="search"
					placeholder="Search Netflix, Spotify, Adobe…"
					autocomplete="off"
					data-cancel-search
				/>
			</label>
			<p class="hub__count" data-result-count>{services.length} guides</p>
		</header>

		<div class="hub__groups" data-service-groups>
			{
				groups.map((group) => (
					<section class="hub__group" aria-labelledby={`cat-${group.category}`} data-category-section>
						<h2 id={`cat-${group.category}`}>{group.category}</h2>
						<ul class="hub__grid">
							{group.services.map((service) => (
								<li
									data-service-card
									data-name={service.name.toLowerCase()}
									data-slug={service.slug}
									data-category={service.category.toLowerCase()}
								>
									<a href={`/cancel/${service.slug}`}>
										<span class="hub__name">{service.name}</span>
										<span class="hub__price">{formatPrice(service.monthlyPrice)}/mo</span>
										<span class:list={['hub__diff', difficultyClass[service.cancelDifficulty]]}>
											{difficultyLabel(service.cancelDifficulty)}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>

		<p class="hub__empty hidden" data-empty-state>No services match that search. Try “netflix” or “vpn”.</p>

		<aside class="hub__cta">
			<h2>Tired of hunting through account pages?</h2>
			<p>CancelKit finds forgotten subscriptions and cancels them for you.</p>
			<a href="/start">Start free →</a>
		</aside>
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</BaseLayout>

<script>
	const input = document.querySelector<HTMLInputElement>('[data-cancel-search]');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-service-card]'));
	const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-category-section]'));
	const countEl = document.querySelector<HTMLElement>('[data-result-count]');
	const emptyEl = document.querySelector<HTMLElement>('[data-empty-state]');

	const filter = () => {
		const query = (input?.value ?? '').trim().toLowerCase();
		let visible = 0;

		for (const card of cards) {
			const haystack = `${card.dataset.name ?? ''} ${card.dataset.slug ?? ''} ${card.dataset.category ?? ''}`;
			const show = !query || haystack.includes(query);
			card.classList.toggle('hidden', !show);
			if (show) visible += 1;
		}

		for (const section of sections) {
			const anyVisible = section.querySelectorAll('[data-service-card]:not(.hidden)').length > 0;
			section.classList.toggle('hidden', !anyVisible);
		}

		if (countEl) countEl.textContent = `${visible} guide${visible === 1 ? '' : 's'}`;
		emptyEl?.classList.toggle('hidden', visible > 0);
	};

	input?.addEventListener('input', filter);
</script>

<style>
	.hub {
		padding: 2.5rem 0 5rem;
		background:
			radial-gradient(ellipse 70% 45% at 50% -15%, rgba(0, 255, 136, 0.07), transparent),
			#000;
	}

	.hub__header,
	.hub__groups,
	.hub__cta,
	.hub__empty {
		width: min(100% - 2.5rem, 68rem);
		margin-left: auto;
		margin-right: auto;
	}

	.hub__eyebrow {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.hub__title {
		margin: 0.85rem 0 0;
		max-width: 18ch;
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 5vw, 3.1rem);
		font-weight: 600;
		letter-spacing: -0.055em;
		line-height: 1.02;
		color: #fff;
	}

	.hub__lede {
		margin: 1.1rem 0 0;
		max-width: 38rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.hub__search {
		display: block;
		margin-top: 1.75rem;
		max-width: 28rem;
	}

	.hub__search input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.9rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-input);
		background: var(--color-surface);
		color: #fff;
		font: inherit;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.hub__search input::placeholder {
		color: #666;
	}

	.hub__search input:focus {
		border-color: rgba(0, 255, 136, 0.45);
	}

	.hub__count {
		margin: 0.75rem 0 0;
		font-size: 0.85rem;
		color: var(--color-muted);
	}

	.hub__groups {
		margin-top: 2.75rem;
		display: grid;
		gap: 2.5rem;
	}

	.hub__group h2 {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: #fff;
	}

	.hub__grid {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.75rem;
	}

	.hub__grid a {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'name diff'
			'price diff';
		gap: 0.2rem 0.75rem;
		align-items: center;
		min-height: 4.5rem;
		padding: 0.95rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.hub__grid a:hover {
		border-color: rgba(0, 255, 136, 0.35);
		transform: translateY(-1px);
	}

	.hub__name {
		grid-area: name;
		color: #fff;
		font-weight: 600;
		font-size: 0.98rem;
	}

	.hub__price {
		grid-area: price;
		color: var(--color-muted);
		font-size: 0.85rem;
	}

	.hub__diff {
		grid-area: diff;
		justify-self: end;
		padding: 0.25rem 0.5rem;
		border-radius: var(--radius-input);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.hub__diff.is-easy {
		background: rgba(0, 255, 136, 0.12);
		color: var(--color-accent);
	}

	.hub__diff.is-medium {
		background: rgba(245, 197, 66, 0.14);
		color: #f5c542;
	}

	.hub__diff.is-hard {
		background: rgba(255, 140, 66, 0.14);
		color: #ff8c42;
	}

	.hub__diff.is-nightmare {
		background: rgba(255, 68, 68, 0.14);
		color: var(--color-danger);
	}

	.hub__empty {
		margin-top: 2rem;
		color: var(--color-muted);
	}

	.hub__cta {
		margin-top: 3.5rem;
		padding: 1.5rem 1.35rem;
		border: 1px solid rgba(0, 255, 136, 0.28);
		border-radius: var(--radius-card);
		background:
			linear-gradient(135deg, rgba(0, 255, 136, 0.1), transparent 55%),
			var(--color-surface);
	}

	.hub__cta h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.hub__cta p {
		margin: 0.65rem 0 0;
		color: var(--color-muted);
		line-height: 1.55;
	}

	.hub__cta a {
		display: inline-flex;
		margin-top: 1.1rem;
		padding: 0.8rem 1.15rem;
		border-radius: var(--radius-input);
		background: var(--color-accent);
		color: #000;
		font-weight: 700;
		text-decoration: none;
	}

	.hidden {
		display: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.hub__grid a,
		.hub__search input {
			transition: none;
		}

		.hub__grid a:hover {
			transform: none;
		}
	}
</style>

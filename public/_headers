# ── 1. Immutable Static Hashed Assets (1 year edge & browser cache) ──
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000


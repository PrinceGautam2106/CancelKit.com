function getDifficultyLabel(score: number): string {
	if (score >= 9) return 'Roach Motel / Nightmare (9–10)';
	if (score >= 7) return 'Hard (7–8)';
	if (score >= 4) return 'Moderate (4–6)';
	return 'Easy (1–3)';
}

function getTierClass(score: number): string {
	if (score >= 9) return 'nightmare';
	if (score >= 7) return 'hard';
	if (score >= 4) return 'moderate';
	return 'easy';
}


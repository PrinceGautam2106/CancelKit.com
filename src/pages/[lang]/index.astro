---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../sections/Hero.astro';
import PressStrip from '../../components/PressStrip.astro';
import Features from '../../sections/Features.astro';
import HowItWorks from '../../sections/HowItWorks.astro';
import Pricing from '../../sections/Pricing.astro';
import TestimonialGrid from '../../components/TestimonialGrid.astro';
import FAQ from '../../sections/FAQ.astro';
import CTABand from '../../sections/CTABand.astro';
import SeoContent from '../../sections/SeoContent.astro';
import { buildFaqPageSchema } from '../../data/faqs';
import { locales, translations, type Locale } from '../../i18n/translations';

export function getStaticPaths() {
	return locales.filter((lang) => lang !== 'en').map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = translations[lang];
const faqSchema = buildFaqPageSchema();
---

<BaseLayout
	lang={lang}
	title={t.meta_title}
	description={t.meta_description}
	canonicalPath={`/${lang}/`}
	schemas={[faqSchema]}
	isHome
	hreflang="home"
>
	<Nav />
	<main>
		<Hero t={t} />
		<PressStrip />
		<Features />
		<HowItWorks t={t} />
		<Pricing t={t} />
		<TestimonialGrid limit={6} />
		<SeoContent />
		<FAQ />
		<CTABand />
	</main>
	<Footer />
</BaseLayout>

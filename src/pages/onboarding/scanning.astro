---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Scanning your subscriptions — CancelKits';
const description = 'Analyzing receipts and invoices for recurring subscriptions.';
---

<BaseLayout {title} {description} noIndex>
	<main class="scan-page">
		<div class="scan-container">
			<a class="scan-logo" href="/" aria-label="CancelKits home">
				<img class="scan-logo__icon" src="/favicon.svg" alt="" width="28" height="28" />
				<span class="scan-logo__text">Cancel<span>K<span class="scan-logo__accent">i</span>ts</span></span>
			</a>

			<div class="radar-box" aria-hidden="true">
				<div class="radar-pulse radar-pulse--1"></div>
				<div class="radar-pulse radar-pulse--2"></div>
				<div class="radar-pulse radar-pulse--3"></div>
				<div class="radar-core">
					<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="radar-icon">
						<circle cx="12" cy="12" r="9"/>
						<path d="M12 3a9 9 0 0 1 9 9"/>
						<circle cx="12" cy="12" r="3"/>
					</svg>
				</div>
			</div>

			<div class="scan-content">
				<div class="scan-email-badge" id="scan-email-badge" hidden>
					<span class="badge-dot"></span>
					<span id="scan-email-label">Scanning inbox...</span>
				</div>
				<h1 id="scan-headline" class="scan-headline">Scanning receipts...</h1>

				<div
					class="progress-track"
					role="progressbar"
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow="0"
					aria-labelledby="scan-headline"
					id="progress-bar-wrap"
				>
					<div class="progress-fill" id="progress-fill"></div>
				</div>

				<p class="progress-reassure">This takes about 30 seconds</p>
			</div>
		</div>
	</main>
</BaseLayout>

<script>
	type ScanSub = {
		name: string;
		category: string;
		monthly: number;
		renewsIn: number;
		color: string;
	};

	/** Demo scan payload — real scan API caches the same shape in Supabase */
	const DEMO_SUBS: ScanSub[] = [
		{ name: 'Adobe Creative Cloud', category: 'Software & Cloud', monthly: 59.99, renewsIn: 10, color: '#e02424' },
		{ name: 'Planet Fitness Black Card', category: 'Fitness & Wellness', monthly: 22.99, renewsIn: 18, color: '#7e22ce' },
		{ name: 'Hulu (No Ads)', category: 'Streaming', monthly: 17.99, renewsIn: 3, color: '#10b981' },
		{ name: 'Netflix Standard', category: 'Streaming', monthly: 15.49, renewsIn: 6, color: '#b91c1c' },
		{ name: 'Spotify Premium', category: 'Music & Audio', monthly: 11.99, renewsIn: 7, color: '#16a34a' },
		{ name: 'LinkedIn Premium', category: 'Software & Cloud', monthly: 29.99, renewsIn: 14, color: '#0a66c2' },
		{ name: 'The New York Times', category: 'News & Learning', monthly: 17.0, renewsIn: 21, color: '#333' },
		{ name: 'Canva Pro', category: 'Software & Cloud', monthly: 14.99, renewsIn: 9, color: '#00c4cc' },
		{ name: 'Disney+', category: 'Streaming', monthly: 13.99, renewsIn: 12, color: '#113ccf' },
		{ name: 'NordVPN', category: 'VPN & Security', monthly: 12.99, renewsIn: 4, color: '#4687ff' },
		{ name: 'Dropbox Plus', category: 'Software & Cloud', monthly: 11.99, renewsIn: 16, color: '#0061ff' },
		{ name: 'Audible Premium', category: 'Music & Audio', monthly: 14.95, renewsIn: 8, color: '#f8991d' },
		{ name: 'YouTube Premium', category: 'Streaming', monthly: 13.99, renewsIn: 5, color: '#ff0000' },
		{ name: 'Apple Music', category: 'Music & Audio', monthly: 10.99, renewsIn: 15, color: '#fc3c44' },
	];

	const headline = document.getElementById('scan-headline');
	const progressFill = document.getElementById('progress-fill');
	const progressWrap = document.getElementById('progress-bar-wrap');

	const params = new URLSearchParams(window.location.search);
	const emailParam = params.get('email') || localStorage.getItem('cancelkit-user-email') || '';

	const emailBadge = document.getElementById('scan-email-badge');
	const emailLabel = document.getElementById('scan-email-label');
	if (emailParam && emailBadge && emailLabel) {
		emailBadge.hidden = false;
		emailLabel.textContent = `Receipts scanning for: ${emailParam}`;
		localStorage.setItem('cancelkit-user-email', emailParam);
	}

	let provider = params.get('provider');
	if (!provider) {
		const lower = emailParam.toLowerCase();
		if (lower.includes('outlook') || lower.includes('hotmail') || lower.includes('live')) {
			provider = 'Outlook';
		} else if (lower.includes('yahoo')) {
			provider = 'Yahoo Mail';
		} else if (lower.includes('icloud') || lower.includes('apple')) {
			provider = 'iCloud';
		} else {
			provider = 'Gmail';
		}
	} else {
		provider = provider === 'outlook' ? 'Outlook' : 'Gmail';
	}

	const hasUserSelections = params.get('selected') === '1';
	let activeSubs: ScanSub[] = DEMO_SUBS;

	if (hasUserSelections) {
		try {
			const saved = localStorage.getItem('cancelkit-scan-subs');
			if (saved) {
				const parsed = JSON.parse(saved);
				if (Array.isArray(parsed) && parsed.length > 0) {
					activeSubs = parsed;
				}
			}
		} catch {
			/* fallback */
		}
	}

	// Accurately compute totals from detected subscriptions
	const calculatedMonthly = Math.round(activeSubs.reduce((sum, s) => sum + s.monthly, 0) * 100) / 100;
	const calculatedAnnual = Math.round(calculatedMonthly * 12);

	localStorage.setItem('cancelkit-scanned-count', String(activeSubs.length));
	localStorage.setItem('cancelkit-monthly-total', String(calculatedMonthly));
	localStorage.setItem('cancelkit-annual-total', String(calculatedAnnual));
	localStorage.setItem('cancelkit-scan-subs', JSON.stringify(activeSubs));
	localStorage.setItem('cancelkit-dashboard-provider', hasUserSelections ? 'Smart Audit' : provider);
	localStorage.setItem('cancelkit-dashboard-connected', '1');
	localStorage.setItem(
		'cancelkit-dashboard-subs',
		JSON.stringify(
			activeSubs.map((s) => ({
				id: s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
				name: s.name,
				category: s.category.toLowerCase().includes('stream') || s.category.toLowerCase().includes('music')
					? 'streaming'
					: s.category.toLowerCase().includes('fit')
						? 'fitness'
						: s.category.toLowerCase().includes('news')
							? 'news'
							: 'software',
				monthly: s.monthly,
				nextBilling: new Date(Date.now() + (s.renewsIn || 14) * 86400000)
					.toISOString()
					.split('T')[0],
				status: 'active',
				domain: (s as any).domain,
			})),
		),
	);

	// Kick off real receipt scan in background
	const providerParam = provider.toLowerCase();
	const providerToken = localStorage.getItem('cancelkit-provider-token') || '';

	if (!hasUserSelections) {
		fetch('/api/scan-inbox', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				provider: providerParam,
				providerToken,
				email: emailParam,
			}),
		})
			.then((res) => res.json())
			.then((data) => {
				if (data?.ok && Array.isArray(data.subscriptions) && data.subscriptions.length > 0) {
					activeSubs = data.subscriptions;
					const newMonthly = data.monthlyTotal || Math.round(activeSubs.reduce((s: any, x: any) => s + x.monthly, 0) * 100) / 100;
					const newAnnual = data.annualTotal || Math.round(newMonthly * 12);
					localStorage.setItem('cancelkit-scanned-count', String(activeSubs.length));
					localStorage.setItem('cancelkit-monthly-total', String(newMonthly));
					localStorage.setItem('cancelkit-annual-total', String(newAnnual));
					localStorage.setItem('cancelkit-scan-subs', JSON.stringify(activeSubs));
					localStorage.setItem(
						'cancelkit-dashboard-subs',
						JSON.stringify(
							activeSubs.map((s: any) => ({
								id: s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
								name: s.name,
								category: s.category || 'Subscription',
								monthly: s.monthly,
								nextBilling: new Date(Date.now() + (s.renewsIn || 14) * 86400000).toISOString().split('T')[0],
								status: 'active',
								domain: s.domain,
							})),
						),
					);
				}
			})
			.catch(() => {
				/* Demo: API may be unreachable — animation still completes */
			});
	}

	const firstNames = activeSubs.slice(0, 3).map((s) => s.name).join(', ');

	const stages = hasUserSelections
		? [
				{ at: 0, text: `Verifying your ${activeSubs.length} selected subscriptions...` },
				{ at: 600, text: `Analyzing billing cycles & refund policies for ${firstNames}...` },
				{ at: 1300, text: `Calculating cancellation difficulty scores (1–10)...` },
				{ at: 2000, text: `Aggregating monthly recurring burn: $${calculatedMonthly}/mo...` },
				{ at: 2600, text: `Audit complete! Preparing your cancel kit...` },
			]
		: [
				{ at: 0, text: emailParam ? `Connecting to ${provider}...` : 'Scanning receipts...' },
				{ at: 900, text: 'Scanning invoices & payment confirmations...' },
				{ at: 1800, text: 'Found Netflix ($15.49/mo)...' },
				{ at: 2600, text: 'Found Spotify ($11.99/mo)...' },
				{ at: 3400, text: 'Found Adobe Creative Cloud ($59.99/mo)...' },
				{ at: 4200, text: 'Found 14 active subscriptions...' },
				{ at: 4800, text: 'Calculating your total recurring spend...' },
			];

	const DURATION_MS = hasUserSelections ? 3000 : 5200;
	const startTime = Date.now();

	const interval = setInterval(() => {
		const elapsed = Date.now() - startTime;
		const progress = Math.min(100, Math.round((elapsed / DURATION_MS) * 100));

		if (progressFill) progressFill.style.width = `${progress}%`;
		if (progressWrap) progressWrap.setAttribute('aria-valuenow', String(progress));

		const stage = [...stages].reverse().find((s) => elapsed >= s.at) ?? stages[0];
		if (headline) headline.textContent = stage.text;

		if (elapsed >= DURATION_MS) {
			clearInterval(interval);
			const emailQuery = emailParam ? `?email=${encodeURIComponent(emailParam)}` : '';
			window.location.href = `/onboarding/results${emailQuery}`;
		}
	}, 50);
</script>

<style>
	.scan-page {
		min-height: 100svh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1.25rem;
		background:
			radial-gradient(ellipse 80% 50% at 50% 10%, rgba(0, 255, 136, 0.1), transparent 70%),
			#050505;
	}

	.scan-container {
		width: min(100%, 26rem);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.scan-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		margin-bottom: 2.75rem;
	}

	.scan-logo__icon {
		display: block;
		width: 1.85rem;
		height: 1.85rem;
		border-radius: 6px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.scan-logo__text {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.scan-logo__accent {
		color: var(--color-accent);
	}

	.radar-box {
		position: relative;
		width: 110px;
		height: 110px;
		display: grid;
		place-items: center;
		margin-bottom: 2.5rem;
	}

	.radar-pulse {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1.5px solid rgba(0, 255, 136, 0.4);
		animation: radar-wave 3s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
	}

	.radar-pulse--2 {
		animation-delay: 1s;
	}

	.radar-pulse--3 {
		animation-delay: 2s;
	}

	.radar-core {
		position: relative;
		z-index: 2;
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: #0a0a0a;
		border: 1px solid rgba(0, 255, 136, 0.5);
		box-shadow: 0 0 24px rgba(0, 255, 136, 0.25);
		display: grid;
		place-items: center;
	}

	.radar-icon {
		color: var(--color-accent);
		animation: radar-spin 4s linear infinite;
	}

	@keyframes radar-wave {
		0% {
			transform: scale(0.6);
			opacity: 0.9;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	@keyframes radar-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.scan-content {
		width: 100%;
	}

	.scan-email-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(0, 255, 136, 0.08);
		border: 1px solid rgba(0, 255, 136, 0.25);
		border-radius: 999px;
		padding: 0.35rem 0.85rem;
		font-size: 0.825rem;
		color: #00ff88;
		font-family: var(--font-mono, monospace);
		margin-bottom: 1.25rem;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background: #00ff88;
		border-radius: 50%;
		box-shadow: 0 0 6px #00ff88;
	}

	.scan-headline {
		margin: 0 0 1.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 4vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #fff;
		min-height: 2.4rem;
	}

	.progress-track {
		width: 100%;
		height: 8px;
		background: #151515;
		border-radius: var(--radius-pill);
		overflow: hidden;
		border: 1px solid var(--color-border);
		margin-bottom: 0.9rem;
	}

	.progress-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(90deg, #00cc6a 0%, var(--color-accent) 100%);
		border-radius: var(--radius-pill);
		box-shadow: 0 0 12px rgba(0, 255, 136, 0.5);
		transition: width 0.08s linear;
	}

	.progress-reassure {
		margin: 0;
		font-size: 0.85rem;
		color: var(--color-faint);
	}
</style>

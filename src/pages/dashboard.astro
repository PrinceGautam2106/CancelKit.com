	function loadSubs(): Subscription[] {
		const params = new URLSearchParams(window.location.search);
		if (params.get('empty') === '1') {
			localStorage.setItem(SUBS_KEY, JSON.stringify([]));
			return [];
		}
		try {
			const raw = localStorage.getItem(SUBS_KEY);
			if (raw !== null) return JSON.parse(raw) as Subscription[];
		} catch {
			/* ignore */
		}

		// Connect actual scanned subscriptions from email onboarding
		try {
			const scannedRaw = localStorage.getItem('cancelkit-scan-subs');
			if (scannedRaw !== null) {
				const scanned = JSON.parse(scannedRaw);
				if (Array.isArray(scanned) && scanned.length > 0) {
					const converted: Subscription[] = scanned.map((s: any) => {
						const cat = (s.category?.toLowerCase() || 'software') as SubCategory;
						const validCat: SubCategory = ['streaming', 'software', 'fitness', 'news'].includes(cat)
							? cat
							: 'software';
						return {
							id: s.id || s.name.toLowerCase().replace(/[^a-z0-9]/g, '-'),
							name: s.name,
							category: validCat,
							monthly: Number(s.monthly) || 0,
							nextBilling: s.nextBilling || new Date(Date.now() + (s.renewsIn || 14) * 86400000).toISOString().split('T')[0],
							status: (s.status || 'active') as SubStatus,
							domain: s.domain,
							selectedByUser: s.selectedByUser,
							unselectedDiscovery: s.unselectedDiscovery,
						};
					});
					localStorage.setItem(SUBS_KEY, JSON.stringify(converted));
					return converted;
				}
			}
		} catch {
			/* ignore */
		}

		return structuredClone(seed);
	}

	function saveSubs() {
		localStorage.setItem(SUBS_KEY, JSON.stringify(subs));
	}

	function money(n: number) {
		return new Intl.NumberFormat('en-US', {
			style: 'currency',
			currency: 'USD',
			minimumFractionDigits: n % 1 === 0 ? 0 : 2,
			maximumFractionDigits: 2,
		}).format(n);
	}

	function formatDate(iso: string) {
		const d = new Date(`${iso}T12:00:00`);
		return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
	}

	function initial(name: string) {
		return name.trim().charAt(0).toUpperCase();
	}

	function faviconUrl(domain?: string) {
		if (!domain) return '';
		return `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`;
	}

	function isConnected() {
		const params = new URLSearchParams(window.location.search);
		if (isPaymentReturn || params.get('connected') === '1' || params.get('empty') === '1') return true;
		const val = localStorage.getItem(STORAGE_KEY);
		return val === '1' || val === 'true';
	}

	function setConnected(provider: string) {
		localStorage.setItem(STORAGE_KEY, '1');
		localStorage.setItem(PROVIDER_KEY, provider);
		const label = provider === 'outlook' ? 'Outlook' : 'Gmail';
		if (connectedLabel) connectedLabel.textContent = `Connected: ${label}`;
		showApp(true);
	}

	function setLoading(loading: boolean) {
		root?.setAttribute('data-loading', String(loading));
		loadingState?.toggleAttribute('hidden', !loading);
		if (loading) {
			emptyState?.toggleAttribute('hidden', true);
			appShell?.toggleAttribute('hidden', true);
		}
	}

	function showApp(connected: boolean) {
		setLoading(false);
		root?.setAttribute('data-connected', String(connected));
		emptyState?.toggleAttribute('hidden', connected);
		appShell?.toggleAttribute('hidden', !connected);
		if (connected) {
			const provider = localStorage.getItem(PROVIDER_KEY) || 'gmail';
			const label = provider === 'outlook' ? 'Outlook' : 'Gmail';
			if (connectedLabel) connectedLabel.textContent = `Connected: ${label}`;
			render();
		}
	}

	let householdScope: 'personal' | 'household' = 'personal';

	const householdExtraSubs: Subscription[] = [
		{ id: 'family-disney', name: 'Disney+ (Household)', category: 'streaming', monthly: 13.99, nextBilling: '2026-10-04', status: 'active', domain: 'disneyplus.com' },
		{ id: 'family-spotify', name: 'Spotify Duo (Partner)', category: 'streaming', monthly: 16.99, nextBilling: '2026-10-12', status: 'active', domain: 'spotify.com' },
		{ id: 'family-canva', name: 'Canva Pro (Shared)', category: 'software', monthly: 14.99, nextBilling: '2026-09-29', status: 'active', domain: 'canva.com' },
	];

	function getActivePool(): Subscription[] {
		if (userPlan === 'family' && householdScope === 'household') {
			return [...subs, ...householdExtraSubs];
		}
		return subs;
	}

	function visibleSubs() {
		let rows = [...getActivePool()];
		if (filter !== 'all') rows = rows.filter((s) => s.status === filter);

		rows.sort((a, b) => {
			if (sort === 'amount') return b.monthly - a.monthly;
			if (sort === 'renewal') return a.nextBilling.localeCompare(b.nextBilling);
			return a.category.localeCompare(b.category) || a.name.localeCompare(b.name);
		});
		return rows;
	}

	function totals() {
		const pool = getActivePool();
		const before = pool.reduce((sum, sub) => sum + sub.monthly, 0);
		const after = pool.filter((sub) => sub.status !== 'cancelled').reduce((sum, sub) => sum + sub.monthly, 0);
		const saved = before - after;
		return { before, after, saved, yearly: saved * 12 };
	}

	function escapeHtml(value: string) {
		return value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;');
	}

	function renderStats() {
		const { before, after, saved, yearly } = totals();
		if (burnBeforeEl) burnBeforeEl.textContent = `${money(before)}/mo`;
		if (burnAfterEl) burnAfterEl.textContent = `${money(after)}/mo`;
		if (savedMonthlyEl) savedMonthlyEl.textContent = `You saved ${money(saved)}/mo`;
		if (savedYearlyEl) savedYearlyEl.textContent = `Yearly saving: ${money(yearly)}`;
	}

	function renderHistory() {
		if (!historyList) return;
		const cancelled = subs.filter((sub) => sub.status === 'cancelled');
		const firstActive = subs.find((sub) => sub.status !== 'cancelled');
		nothingCancelledEl?.toggleAttribute('hidden', cancelled.length > 0 || !firstActive);
		if (firstActive) {
			const name = nothingCancelledEl?.querySelector<HTMLElement>('[data-nudge-name]');
			const meta = nothingCancelledEl?.querySelector<HTMLElement>('[data-nudge-meta]');
			const avatar = nothingCancelledEl?.querySelector<HTMLElement>('[data-nudge-initial]');
			const cancel = nothingCancelledEl?.querySelector<HTMLButtonElement>('[data-nudge-cancel]');
			if (name) name.textContent = firstActive.name;
			if (meta) meta.textContent = `${money(firstActive.monthly)}/mo`;
			if (avatar) avatar.textContent = initial(firstActive.name);
			if (cancel) cancel.dataset.nudgeCancel = firstActive.id;
		}
		historyList.innerHTML = cancelled.map((sub) =>
			`<li><span>${escapeHtml(sub.name)}</span><span class="dash__saved-inline">Saved ${money(sub.monthly)}/mo</span></li>`,
		).join('');
	}

	function renderList() {
		if (!listEl) return;
		const rows = visibleSubs();
		const active = subs.filter((sub) => sub.status !== 'cancelled');
		const everythingCancelled = subs.length > 0 && active.length === 0;
		const showScanFailure = scanFailed;
		const showEmpty = !showScanFailure && subs.length === 0;
		const showCelebration = !showScanFailure && !showEmpty && everythingCancelled;

		scanFailedEl?.toggleAttribute('hidden', !showScanFailure);
		emptySubsEl?.toggleAttribute('hidden', !showEmpty);
		allCancelledEl?.toggleAttribute('hidden', !showCelebration);
		subsTable?.toggleAttribute('hidden', showScanFailure || showEmpty || showCelebration);
		emptyTable?.toggleAttribute('hidden', showScanFailure || showEmpty || showCelebration || rows.length > 0);
		if (showCelebration) {
			const { yearly } = totals();
			const saved = allCancelledEl?.querySelector<HTMLElement>('[data-saved-total]');
			const share = allCancelledEl?.querySelector<HTMLAnchorElement>('[data-share-savings]');
			if (saved) saved.textContent = money(yearly);
			if (share) share.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`I just cancelled every subscription on my list and saved ${money(yearly)} a year with CancelKits. ⚡`)}`;
		}

		const gateWrap = document.getElementById('dash-gate-wrap');
		if (showScanFailure || showEmpty || showCelebration) {
			if (gateWrap) gateWrap.hidden = true;
			listEl.innerHTML = '';
			return;
		}

		const FREE_TIER_LIMIT = 10;
		const isFreePlan = userPlan === 'free';
		const hasExplicitDiscoveries = rows.some((s) => s.unselectedDiscovery || s.selectedByUser === false);

		let displayedRows: Subscription[];
		let hiddenRows: Subscription[];

		if (isFreePlan) {
			if (hasExplicitDiscoveries) {
				displayedRows = rows.filter((s) => s.selectedByUser !== false && !s.unselectedDiscovery).slice(0, FREE_TIER_LIMIT);
				if (displayedRows.length === 0) {
					displayedRows = rows.slice(0, FREE_TIER_LIMIT);
				}
				const displayedIds = new Set(displayedRows.map((s) => s.id));
				hiddenRows = rows.filter((s) => !displayedIds.has(s.id));
			} else {
				displayedRows = rows.slice(0, FREE_TIER_LIMIT);
				hiddenRows = rows.slice(FREE_TIER_LIMIT);
			}
		} else {
			displayedRows = rows;
			hiddenRows = [];
		}

		const hasHidden = isFreePlan && hiddenRows.length > 0;

		if (gateWrap) gateWrap.hidden = !hasHidden;

		if (hasHidden) {
			const hiddenMonthly = Math.round(hiddenRows.reduce((sum, s) => sum + s.monthly, 0) * 100) / 100;
			const hiddenAnnual = Math.round(hiddenMonthly * 12);
			const surpriseCount = hiddenRows.filter((s) => s.unselectedDiscovery || s.selectedByUser === false).length;

			const gateTitle = document.getElementById('dash-gate-title');
			if (gateTitle) {
				if (surpriseCount > 0) {
					gateTitle.textContent = `🚨 Unlock ${hiddenRows.length} Hidden Subscriptions (${money(hiddenMonthly)}/mo)`;
				} else {
					gateTitle.textContent = `Unlock Remaining ${hiddenRows.length} Subscriptions (${money(hiddenMonthly)}/mo)`;
				}
			}

			const gateDesc = document.getElementById('dash-gate-desc');
			if (gateDesc) {
				if (surpriseCount > 0) {
					gateDesc.innerHTML = `Our inbox scan discovered <strong style="color:#ff4444;">${surpriseCount} unselected recurring charges</strong> totaling <strong style="color:#ff4444;">${money(hiddenMonthly)}/mo (${money(hiddenAnnual)}/yr)</strong> that you did not select. Upgrade to <strong>CancelKits Pro</strong> ($9/mo) to reveal full details, access cancellation guides, and stop forgotten renewals.`;
				} else {
					gateDesc.innerHTML = `Your scan identified <strong>${hiddenRows.length} more active subscriptions</strong> quietly charging <strong style="color:#ff4444;">${money(hiddenMonthly)}/month</strong> (${money(hiddenAnnual)}/year). Free plan only includes your top 5 services. Upgrade to <strong>CancelKits Pro</strong> ($9/mo) to unlock all ${rows.length} subscriptions, cancellation guides, and automated renewal radar alerts.`;
				}
			}

			const gateUpgradeBtn = document.getElementById('dash-upgrade-btn');
			const btnText = gateUpgradeBtn?.querySelector('.btn-text');
			if (btnText) {
				btnText.textContent = `Upgrade to Pro ($9/mo) — Save ${money(hiddenAnnual)}/yr →`;
			}

			const blurEl = document.getElementById('dash-gate-blur');
			if (blurEl) {
				blurEl.innerHTML = hiddenRows.map((sub) => {
					const icon = faviconUrl(sub.domain);
					const isSurprise = sub.unselectedDiscovery || sub.selectedByUser === false;
					const displayName = sub.name;

					return `<div class="dash__gate-blur-row" role="button" tabindex="0" title="Locked on Free Plan — Upgrade to Pro to manage">
						<div class="dash__svc">
							<span class="dash__logo" data-initial="${initial(sub.name)}" style="${isSurprise ? 'filter:blur(4.5px);user-select:none;' : ''}">
								${icon ? `<img src="${icon}" alt="" width="20" height="20" loading="lazy" onerror="this.remove()" />` : ''}
							</span>
							<div>
								<div class="dash__svc-name" style="${isSurprise ? 'filter:blur(6px);user-select:none;pointer-events:none;' : ''}">${escapeHtml(displayName)}</div>
								<span class="dash__tag">${escapeHtml(sub.category)}${isSurprise ? ' · ⚠️ Unselected' : ''}</span>
							</div>
						</div>
						<div class="dash__amount">${money(sub.monthly)}<div class="dash__annual" style="font-size:0.75rem;color:#888;">${money(sub.monthly * 12)}/yr</div></div>
						<div class="dash__date">${formatDate(sub.nextBilling)}</div>
						<div class="dash__actions"><span class="dash__gate-lock-pill" style="color:#00ff88;background:rgba(0,255,136,0.1);border:1px solid rgba(0,255,136,0.25);">🔒 Pro Only</span></div>
					</div>`;
				}).join('');
			}
		}

		listEl.innerHTML = displayedRows.map((sub) => {
			const cancelled = sub.status === 'cancelled';
			const icon = faviconUrl(sub.domain);
			const guideSlug = !sub.id.startsWith('custom-') ? resolveServiceSlug(sub.id, sub.name) : null;
			const guideLink = `<a href="${guideSlug ? `/cancel/${encodeURIComponent(guideSlug)}/` : '/cancel/'}" class="dash__guide-link">View cancellation steps →</a>`;
			const action = cancelled
				? `<div class="dash__saved-action-group">
					<span class="dash__saved-badge">Saved ${money(sub.monthly)}</span>
					<button type="button" class="dash__restore-btn" data-restore="${escapeHtml(sub.id)}" title="Undo cancellation">↺</button>
				</div>`
				: `<div class="dash__action-cell">${guideLink}</div>`;
			// Renewal Radar Alert: If renewing within 7 days and user is Pro/Family, flag it
			const billingDate = new Date(`${sub.nextBilling}T00:00:00`);
			const diffDays = Math.ceil((billingDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24));
			const isUpcomingRadar = !cancelled && diffDays >= 0 && diffDays <= 7;
			const radarPill = isUpcomingRadar
				? (userPlan !== 'free'
					? `<span class="dash__radar-pill" style="display:inline-block; font-size:0.7rem; font-weight:600; color:#00ff88; background:rgba(0,255,136,0.1); border:1px solid rgba(0,255,136,0.25); border-radius:4px; padding:0.1rem 0.35rem; margin-right:0.35rem;" title="Renewal Radar Alert: Auto-renews in ${diffDays} day${diffDays === 1 ? '' : 's'}">⚡ In ${diffDays}d</span>`
					: `<a href="/pricing" class="dash__radar-pill" style="display:inline-block; font-size:0.7rem; font-weight:600; color:#f59e0b; background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.3); border-radius:4px; padding:0.1rem 0.35rem; margin-right:0.35rem; text-decoration:none;" title="Renews in ${diffDays} day${diffDays === 1 ? '' : 's'}. Upgrade to Pro for cancellation guidance before billing!">⚠️ In ${diffDays}d</a>`)
				: '';

			return `<tr class="${cancelled ? 'is-cancelled-row' : ''}">
				<td><div class="dash__svc"><span class="dash__logo" data-initial="${initial(sub.name)}">${icon ? `<img src="${icon}" alt="" width="20" height="20" loading="lazy" onerror="this.remove()" />` : ''}</span><div><div class="dash__svc-name ${cancelled ? 'is-cancelled' : ''}">${escapeHtml(sub.name)}</div><span class="dash__tag">${escapeHtml(sub.category)}</span></div></div></td>
				<td><div class="dash__amount">${money(sub.monthly)}</div><div class="dash__annual">${money(sub.monthly * 12)}/yr</div></td>
				<td class="dash__date">${radarPill}${formatDate(sub.nextBilling)}</td><td class="dash__actions">${action}</td>
			</tr>`;
		}).join('');

	}

	function render() {
		renderStats();
		renderList();
		renderHistory();

		const familyToggleRow = document.getElementById('dash-family-toggle-row');
		if (familyToggleRow) {
			familyToggleRow.hidden = userPlan !== 'family';
		}

		const vipSupportRow = document.getElementById('dash-vip-support-row');
		if (vipSupportRow) {
			vipSupportRow.hidden = userPlan === 'free';
		}
	}

	const tabPersonal = document.getElementById('tab-scope-personal');
	const tabHousehold = document.getElementById('tab-scope-household');

	tabPersonal?.addEventListener('click', () => {
		householdScope = 'personal';
		tabPersonal.classList.add('is-active');
		tabPersonal.style.background = 'rgba(255,255,255,0.12)';
		tabPersonal.style.color = '#fff';
		if (tabHousehold) {
			tabHousehold.classList.remove('is-active');
			tabHousehold.style.background = 'transparent';
			tabHousehold.style.color = '#aaa';
		}
		render();
	});

	tabHousehold?.addEventListener('click', () => {
		householdScope = 'household';
		tabHousehold.classList.add('is-active');
		tabHousehold.style.background = 'rgba(168,85,247,0.25)';
		tabHousehold.style.color = '#fff';
		if (tabPersonal) {
			tabPersonal.classList.remove('is-active');
			tabPersonal.style.background = 'transparent';
			tabPersonal.style.color = '#aaa';
		}
		render();
	});

	function cancelSub(id: string) {
		const item = subs.find((sub) => sub.id === id);
		if (!item) return;
		const slug = !item.id.startsWith('custom-') ? resolveServiceSlug(item.id, item.name) : null;
		window.location.assign(slug ? `/cancel/${encodeURIComponent(slug)}/` : '/cancel/');
	}

	async function restoreSub(id: string) {
		const item = subs.find((s) => s.id === id);
		if (!item || item.status !== 'cancelled') return;
		item.status = 'active';
		saveSubs();
		render();

		try {
			const { data: { session } } = await supabase.auth.getSession();
			if (session?.user?.id) {
				await supabase
					.from('subscriptions')
					.update({ status: 'active' })
					.eq('user_id', session.user.id)
					.eq('name', item.name);
			}
		} catch (dbErr) {
			console.warn('Could not sync restore to Supabase:', dbErr);
		}
	}

	function showViralReferralModal(serviceName: string, monthlyAmount: number) {
		const modal = document.getElementById('viral-referral-modal');
		const amountEl = document.getElementById('viral-saved-amount');
		const linkInput = document.getElementById('viral-ref-link-input') as HTMLInputElement;
		const twitterBtn = document.getElementById('viral-twitter-btn') as HTMLAnchorElement;
		const waBtn = document.getElementById('viral-whatsapp-btn') as HTMLAnchorElement;

		if (amountEl) amountEl.textContent = `$${monthlyAmount.toFixed(2)}`;

		const userCode = localStorage.getItem('cancelkit-my-referral-code') || 'kit-me';
		const referralUrl = `${window.location.origin}/r/${userCode}`;

		if (linkInput) linkInput.value = referralUrl;

		if (twitterBtn) {
			const text = encodeURIComponent(
				`I just cancelled ${serviceName} and saved $${monthlyAmount.toFixed(2)}/month with @CancelKits 🎉 Try it free: ${referralUrl}`
			);
			twitterBtn.href = `https://twitter.com/intent/tweet?text=${text}`;
		}

		if (waBtn) {
			const text = encodeURIComponent(
				`I just cancelled ${serviceName} and saved $${monthlyAmount.toFixed(2)}/month with CancelKits 🎉 Get your first month free: ${referralUrl}`
			);
			waBtn.href = `https://api.whatsapp.com/send?text=${text}`;
		}

		if (modal) modal.hidden = false;
	}

	// Modal dismiss & copy handlers
	document.getElementById('viral-modal-close-btn')?.addEventListener('click', () => {
		const modal = document.getElementById('viral-referral-modal');
		if (modal) modal.hidden = true;
	});

	document.getElementById('viral-referral-modal')?.addEventListener('click', (e) => {
		if (e.target === document.getElementById('viral-referral-modal')) {
			const modal = document.getElementById('viral-referral-modal');
			if (modal) modal.hidden = true;
		}
	});

	document.getElementById('viral-copy-btn')?.addEventListener('click', async () => {
		const linkInput = document.getElementById('viral-ref-link-input') as HTMLInputElement;
		const copyBtn = document.getElementById('viral-copy-btn') as HTMLButtonElement;
		if (!linkInput || !copyBtn) return;

		try {
			await navigator.clipboard.writeText(linkInput.value);
			copyBtn.textContent = 'Copied! ✓';
			setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
		} catch {
			linkInput.select();
			document.execCommand('copy');
			copyBtn.textContent = 'Copied! ✓';
			setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
		}
	});

	// Events
	document.getElementById('dash-upgrade-btn')?.addEventListener('click', async () => {
		const btn = document.getElementById('dash-upgrade-btn') as HTMLButtonElement;
		if (!btn) return;
		btn.disabled = true;
		const btnText = btn.querySelector('.btn-text') as HTMLElement;
		const btnSpinner = btn.querySelector('.btn-spinner') as HTMLElement;
		if (btnText) btnText.textContent = 'Opening checkout...';
		if (btnSpinner) btnSpinner.hidden = false;

		try {
			localStorage.setItem('cancelkit-pending-checkout-plan', 'pro');
			localStorage.setItem(STORAGE_KEY, '1');

			const { data: { session } } = await supabase.auth.getSession();
			const res = await fetch('/api/create-checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					priceId: 'price_pro_monthly_9',
					userId: session?.user?.id || '',
					email: session?.user?.email || '',
				}),
			});

			const data = await res.json();
			if (data?.url) {
				window.location.href = data.url;
			} else {
				window.location.href = '/pricing';
			}
		} catch {
			window.location.href = '/pricing';
		}
	});

	// Clicking anywhere on locked rows triggers the Pro upgrade
	document.getElementById('dash-gate-blur')?.addEventListener('click', () => {
		document.getElementById('dash-upgrade-btn')?.click();
	});

	document.querySelectorAll<HTMLButtonElement>('[data-connect]').forEach((btn) => {
		btn.addEventListener('click', () => setConnected(btn.dataset.connect || 'gmail'));
	});

	document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
		btn.addEventListener('click', () => {
			filter = (btn.dataset.filter || 'all') as typeof filter;
			document.querySelectorAll('[data-filter]').forEach((el) => {
				const active = el === btn;
				el.classList.toggle('is-active', active);
				el.setAttribute('aria-selected', String(active));
			});
			renderList();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((btn) => {
		btn.addEventListener('click', () => {
			sort = (btn.dataset.sort || 'amount') as typeof sort;
			document.querySelectorAll('[data-sort]').forEach((el) => el.classList.toggle('is-active', el === btn));
			renderList();
		});
	});

	listEl?.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		const cancelBtn = target?.closest<HTMLButtonElement>('[data-cancel]');
		if (cancelBtn?.dataset.cancel) {
			cancelSub(cancelBtn.dataset.cancel);
			return;
		}
		const restoreBtn = target?.closest<HTMLButtonElement>('[data-restore]');
		if (restoreBtn?.dataset.restore) {
			restoreSub(restoreBtn.dataset.restore);
			return;
		}
	});

	document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((link) => {
		link.addEventListener('click', (e) => {
			const href = link.getAttribute('href');
			if (href?.startsWith('#')) {
				e.preventDefault();
				const targetId = href.slice(1);
				const target = document.getElementById(targetId);
				if (target) {
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}
				document.querySelectorAll('[data-nav]').forEach((el) => el.classList.toggle('is-active', el === link));
			} else if (href === '/dashboard') {
				e.preventDefault();
				window.scrollTo({ top: 0, behavior: 'smooth' });
				document.querySelectorAll('[data-nav]').forEach((el) => el.classList.toggle('is-active', el === link));
			}
		});
	});

	// Modal & Custom Subscriptions
	const modal = document.getElementById('add-sub-modal') as HTMLDialogElement | null;
	const form = document.getElementById('add-sub-form') as HTMLFormElement | null;
	
	const openModal = () => modal?.showModal();
	const closeModal = () => modal?.close();

	document.querySelector('[data-add-sub]')?.addEventListener('click', openModal);
	document.querySelector('[data-add-sub-clean]')?.addEventListener('click', openModal);
	document.querySelectorAll<HTMLButtonElement>('[data-add-manual]').forEach((button) => {
		button.addEventListener('click', openModal);
	});
	document.querySelector<HTMLButtonElement>('[data-nudge-cancel]')?.addEventListener('click', (event) => {
		const button = event.currentTarget;
		if (button.dataset.nudgeCancel) cancelSub(button.dataset.nudgeCancel);
	});
	document.querySelector<HTMLButtonElement>('[data-reconnect-email]')?.addEventListener('click', () => {
		window.location.href = '/onboarding/connect';
	});
	document.querySelector<HTMLButtonElement>('[data-retry-scan]')?.addEventListener('click', () => {
		window.location.href = '/onboarding/connect';
	});
	document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
	document.getElementById('modal-cancel-btn')?.addEventListener('click', closeModal);

	document.querySelector('[data-reset-subs]')?.addEventListener('click', () => {
		if (confirm('Clear all demo subscriptions and reset your dashboard to $0?')) {
			subs = [];
			saveSubs();
			render();
		}
	});

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const formData = new FormData(form);
		const name = String(formData.get('name') || '').trim();
		const monthly = parseFloat(String(formData.get('monthly') || '0')) || 0;
		const category = (formData.get('category') || 'software') as SubCategory;
		const nextBilling = String(formData.get('nextBilling') || new Date().toISOString().slice(0, 10));

		if (name && monthly > 0) {
			const newSub: Subscription = {
				id: 'sub-' + Date.now(),
				name,
				category,
				monthly,
				nextBilling,
				status: 'active',
			};
			subs.unshift(newSub);
			saveSubs();
			render();
			form.reset();
			closeModal();
		}
	});

	const urlParams = new URLSearchParams(window.location.search);
	if (urlParams.get('action') === 'add') {
		setTimeout(openModal, 400);
	}

	showApp(isConnected());
</script>


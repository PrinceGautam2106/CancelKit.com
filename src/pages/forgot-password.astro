---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'Forgot Password — CancelKits';
const description = 'Reset your CancelKits account password.';
---

<BaseLayout {title} {description} noIndex>
	<Nav />
	<main class="auth-page">
		<div class="auth-card">
			<div class="auth-card__header">
				<a class="auth-logo" href="/" aria-label="CancelKits home">
					<span class="auth-logo__icon">C</span>
					<span class="auth-logo__text">Cancel<span>K<span class="auth-logo__accent">i</span>ts</span></span>
				</a>
				<h1>Reset your password</h1>
				<p>Enter your email address and we'll send you a link to reset your password.</p>
			</div>

			<!-- Success State Box -->
			<div class="auth-success-box" id="success-box" hidden>
				<div class="success-icon">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round" stroke-linejoin="round"/>
						<polyline points="22 4 12 14.01 9 11.01" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</div>
				<h2>Check your email</h2>
				<p>We've sent a password reset link to <span id="sent-email-address" class="highlight-email">your email</span>.</p>
				<p class="success-hint">Click the link in the message to choose a new password. If you don't see it within a few minutes, check your spam folder.</p>
				<button type="button" class="auth-btn-secondary" id="resend-reset-btn">
					Resend reset link
				</button>
			</div>

			<!-- Form Fields Container (No <form> tag) -->
			<div class="auth-fields" id="form-fields" role="region" aria-label="Password reset fields">
				<div class="auth-field">
					<label for="reset-email">Email address</label>
					<input
						type="email"
						id="reset-email"
						placeholder="you@example.com"
						autocomplete="email"
					/>
					<p class="inline-error" id="email-error" role="alert" aria-live="polite"></p>
				</div>

				<button type="button" class="auth-submit-btn" id="send-reset-btn">
					<span class="btn-label">Send Reset Link →</span>
					<span class="btn-spinner" hidden></span>
				</button>

				<p class="inline-error inline-error--general" id="general-error" role="alert" aria-live="polite"></p>
			</div>

			<p class="auth-footer-text">
				Remember your password? <a href="/signin">Back to Sign in</a>
			</p>
		</div>
	</main>
	<Footer />
</BaseLayout>

<script>
	import { supabase } from '../lib/supabase';

	const emailInput = document.getElementById('reset-email') as HTMLInputElement;
	const sendResetBtn = document.getElementById('send-reset-btn') as HTMLButtonElement;
	const resendResetBtn = document.getElementById('resend-reset-btn') as HTMLButtonElement;
	const emailError = document.getElementById('email-error') as HTMLParagraphElement;
	const generalError = document.getElementById('general-error') as HTMLParagraphElement;
	const formFields = document.getElementById('form-fields') as HTMLDivElement;
	const successBox = document.getElementById('success-box') as HTMLDivElement;
	const sentEmailSpan = document.getElementById('sent-email-address') as HTMLSpanElement;

	function clearErrors() {
		if (emailError) emailError.textContent = '';
		if (generalError) generalError.textContent = '';
		emailInput?.classList.remove('has-error');
	}

	function setLoading(loading: boolean) {
		if (!sendResetBtn) return;
		sendResetBtn.disabled = loading;
		const label = sendResetBtn.querySelector('.btn-label') as HTMLElement;
		const spinner = sendResetBtn.querySelector('.btn-spinner') as HTMLElement;
		if (label) label.textContent = loading ? 'Sending reset link...' : 'Send Reset Link →';
		if (spinner) spinner.hidden = !loading;
	}

	async function handleSendReset() {
		clearErrors();

		const email = emailInput?.value.trim();

		if (!email) {
			emailError.textContent = 'Please enter your email address.';
			emailInput?.classList.add('has-error');
			return;
		}

		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
			emailError.textContent = 'Please enter a valid email address.';
			emailInput?.classList.add('has-error');
			return;
		}

		setLoading(true);

		try {
			const { error } = await supabase.auth.resetPasswordForEmail(email, {
				redirectTo: `${window.location.origin}/reset-password`,
			});

			if (error) {
				generalError.textContent = error.message;
				setLoading(false);
				return;
			}

			// Show success state
			if (sentEmailSpan) sentEmailSpan.textContent = email;
			if (formFields) formFields.hidden = true;
			if (successBox) successBox.hidden = false;
		} catch (err: any) {
			generalError.textContent = err?.message || 'Failed to send reset link. Please try again.';
			setLoading(false);
		}
	}

	sendResetBtn?.addEventListener('click', handleSendReset);

	resendResetBtn?.addEventListener('click', async () => {
		if (resendResetBtn) {
			resendResetBtn.disabled = true;
			resendResetBtn.textContent = 'Resending...';
		}
		const email = emailInput?.value.trim();
		if (email) {
			try {
				await supabase.auth.resetPasswordForEmail(email, {
					redirectTo: `${window.location.origin}/reset-password`,
				});
				if (resendResetBtn) resendResetBtn.textContent = 'Reset link resent!';
			} catch {
				if (resendResetBtn) resendResetBtn.textContent = 'Failed to resend';
			}
		}
	});

	emailInput?.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') {
			sendResetBtn?.click();
		}
	});
</script>

<style>
	.auth-page {
		min-height: 80svh;
		padding: 3rem 1rem 5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			radial-gradient(ellipse 80% 50% at 50% -10%, rgba(0, 255, 136, 0.08), transparent 70%),
			#050505;
	}

	.auth-card {
		width: min(100%, 26.5rem);
		padding: 2.25rem 1.75rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
		box-sizing: border-box;
	}

	.auth-card__header {
		text-align: center;
		margin-bottom: 1.75rem;
	}

	.auth-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		margin-bottom: 1.25rem;
	}

	.auth-logo__icon {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 7px;
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.auth-logo__text {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.auth-logo__accent {
		color: var(--color-accent);
	}

	.auth-card__header h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: #fff;
	}

	.auth-card__header p {
		margin: 0.5rem 0 0;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.auth-fields {
		display: grid;
		gap: 1rem;
	}

	.auth-field {
		display: grid;
		gap: 0.4rem;
	}

	.auth-field label {
		font-size: 0.82rem;
		font-weight: 500;
		color: #d0d0d0;
	}

	.auth-field input {
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: #050505;
		color: #fff;
		font-family: var(--font-body);
		font-size: 0.95rem;
		outline: none;
		box-sizing: border-box;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.auth-field input:focus {
		border-color: rgba(0, 255, 136, 0.5);
		box-shadow: 0 0 0 3px rgba(0, 255, 136, 0.12);
	}

	.auth-field input.has-error {
		border-color: var(--color-danger);
		box-shadow: 0 0 0 3px rgba(255, 68, 68, 0.12);
	}

	.inline-error {
		margin: 0.25rem 0 0;
		color: var(--color-danger);
		font-size: 0.8rem;
		line-height: 1.4;
		min-height: 1.1rem;
	}

	.inline-error:empty {
		min-height: 0;
		margin: 0;
	}

	.inline-error--general {
		text-align: center;
		margin-top: 0.5rem;
	}

	.auth-submit-btn {
		width: 100%;
		padding: 0.85rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.95rem;
		border: 0;
		cursor: pointer;
		min-height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.25rem;
		transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
	}

	.auth-submit-btn:hover:not(:disabled) {
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(0, 255, 136, 0.3);
	}

	.auth-submit-btn:disabled {
		opacity: 0.7;
		cursor: not-allowed;
	}

	.btn-spinner {
		width: 18px;
		height: 18px;
		border: 2px solid rgba(0, 0, 0, 0.25);
		border-top-color: #000;
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	/* Success State Box */
	.auth-success-box {
		padding: 1.5rem 1rem;
		text-align: center;
		border-radius: var(--radius-card);
		border: 1px solid rgba(0, 255, 136, 0.3);
		background: rgba(0, 255, 136, 0.05);
	}

	.success-icon {
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(0, 255, 136, 0.15);
		color: var(--color-accent);
		margin-bottom: 0.75rem;
	}

	.auth-success-box h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
		color: #fff;
	}

	.auth-success-box p {
		margin: 0.5rem 0;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.highlight-email {
		color: var(--color-accent);
		font-weight: 600;
	}

	.success-hint {
		font-size: 0.8rem !important;
		color: #777 !important;
	}

	.auth-btn-secondary {
		margin-top: 1rem;
		padding: 0.6rem 1.25rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border-hover);
		background: #111;
		color: #fff;
		font-size: 0.85rem;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.2s;
	}

	.auth-btn-secondary:hover:not(:disabled) {
		background: #1a1a1a;
	}

	.auth-footer-text {
		margin: 1.75rem 0 0;
		text-align: center;
		color: var(--color-muted);
		font-size: 0.85rem;
	}

	.auth-footer-text a {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.auth-footer-text a:hover {
		text-decoration: underline;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (max-width: 480px) {
		.auth-card {
			padding: 1.75rem 1.25rem;
		}
	}
</style>

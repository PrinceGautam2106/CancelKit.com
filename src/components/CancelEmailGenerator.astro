---
import type { Service } from '../data/services';
import type { ServiceContact } from '../data/serviceContacts';

interface Props {
	service: Service;
	contact: ServiceContact;
}

const { service, contact } = Astro.props;
const isGym = service.slug === 'gym-membership' || service.slug === 'planet-fitness' || service.slug === 'la-fitness' || service.slug === 'orange-theory' || service.category === 'Fitness & Wellness';
---

<section class="email-gen" id="email-generator-section" aria-label={`Automated Cancellation Email & Notice Generator for ${service.name}`}>
	<div class="email-gen__header">
		<div class="email-gen__badge-row">
			<span class="email-gen__badge">⚡ 1-CLICK CANCELLATION GENERATOR</span>
			<span class="email-gen__verified">Generates Legally Binding Notice</span>
		</div>
		<h2 class="email-gen__title">Automated Cancellation Email Generator for {service.name}</h2>
		<p class="email-gen__desc">
			Fill in your details below. This generator instantly outputs a formal legal cancellation notice citing federal consumer protection rules, pre-filled with {service.name}'s verified recipient email.
		</p>
	</div>

	<div class="email-gen__layout">
		<!-- Form Controls -->
		<div class="email-gen__form">
			<div class="form-group">
				<label for="gen-user-name">Your Full Name <span class="required">*</span></label>
				<input type="text" id="gen-user-name" placeholder="e.g. Alex Johnson" class="form-input" />
			</div>

			<div class="form-group">
				<label for="gen-user-email">Account Email Address <span class="required">*</span></label>
				<input type="email" id="gen-user-email" placeholder={`e.g. your-email@domain.com`} class="form-input" />
			</div>

			<div class="form-group">
				<label for="gen-account-id">Account # / Member ID / Barcode <span class="optional">(Optional)</span></label>
				<input type="text" id="gen-account-id" placeholder="e.g. CUST-98234 or leave blank" class="form-input" />
			</div>

			<div class="form-group">
				<label for="gen-reason">Primary Reason for Cancelling</label>
				<select id="gen-reason" class="form-select">
					<option value="Too expensive / cutting monthly expenses">Too expensive / cutting monthly expenses</option>
					<option value="Not using the service enough to justify the cost">Not using the service enough to justify the cost</option>
					<option value="Found a better / cheaper alternative">Found a better / cheaper alternative</option>
					<option value="Moving / Relocating out of service area">Moving / Relocating out of service area</option>
					<option value="Unauthorized renewal / Charged after free trial ended">Unauthorized renewal / Charged after free trial ended</option>
					<option value="Dissatisfied with recent service changes or price increases">Dissatisfied with recent service changes or price increases</option>
					{isGym && <option value="Medical condition / Physical injury preventing usage">Medical condition / Physical injury preventing usage</option>}
				</select>
			</div>

			<!-- Legal Clauses & Demands -->
			<div class="form-group form-group--checkboxes">
				<span class="checkbox-group-label">Clauses to Include:</span>

				<label class="custom-checkbox">
					<input type="checkbox" id="gen-opt-refund" checked />
					<span class="checkbox-box"></span>
					<span class="checkbox-text">
						<strong>Demand full refund</strong> for most recent billing cycle
					</span>
				</label>

				<label class="custom-checkbox">
					<input type="checkbox" id="gen-opt-etf" checked />
					<span class="checkbox-box"></span>
					<span class="checkbox-text">
						<strong>Demand Early Termination Fee (ETF) waiver</strong> (Cites FTC 16 CFR § 425)
					</span>
				</label>

				<label class="custom-checkbox">
					<input type="checkbox" id="gen-opt-revoke" checked />
					<span class="checkbox-box"></span>
					<span class="checkbox-text">
						<strong>Revoke recurring payment permission</strong> (Stops ACH/Card drafts under Regulation E)
					</span>
				</label>
			</div>
		</div>

		<!-- Live Preview & Action Center -->
		<div class="email-gen__preview-wrap">
			<div class="preview-meta-bar">
				<div class="meta-field">
					<span class="meta-label">TO:</span>
					<span class="meta-val" id="meta-recipient-email">{contact.email}</span>
				</div>
				<div class="meta-field">
					<span class="meta-label">SUBJECT:</span>
					<span class="meta-val" id="meta-subject-line">URGENT: Notice of Cancellation & Termination — {service.name}</span>
				</div>
			</div>

			<!-- Output Box -->
			<div class="preview-body-box">
				<pre id="email-preview-text" class="preview-text"></pre>
			</div>

			<!-- Action Trigger Row -->
			<div class="email-gen__actions">
				<button type="button" class="btn-gen-action btn-gen-action--copy" id="btn-copy-gen-email">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<span id="btn-copy-label">Copy Formatted Email</span>
				</button>

				<a href="#" class="btn-gen-action btn-gen-action--mailto" id="btn-mailto-link">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
					<span>Open in Mail App</span>
				</a>

				<a href="#" target="_blank" rel="noopener noreferrer" class="btn-gen-action btn-gen-action--gmail" id="btn-gmail-link">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.272H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/></svg>
					<span>Open in Gmail</span>
				</a>

				<button type="button" class="btn-gen-action btn-gen-action--print" id="btn-print-letter">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
					<span>Print PDF Letter</span>
				</button>

				<a href="/dashboard" class="btn-gen-action btn-gen-action--dispatch">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
					<span>1-Click Auto Dispatch</span>
				</a>
			</div>
		</div>
	</div>
</section>

<script define:vars={{ serviceName: service.name, recipientEmail: contact.email, isGym }}>
	const nameInput = document.getElementById('gen-user-name');
	const emailInput = document.getElementById('gen-user-email');
	const accountInput = document.getElementById('gen-account-id');
	const reasonSelect = document.getElementById('gen-reason');
	const refundCheck = document.getElementById('gen-opt-refund');
	const etfCheck = document.getElementById('gen-opt-etf');
	const revokeCheck = document.getElementById('gen-opt-revoke');

	const previewEl = document.getElementById('email-preview-text');
	const subjectEl = document.getElementById('meta-subject-line');
	const copyBtn = document.getElementById('btn-copy-gen-email');
	const copyLabel = document.getElementById('btn-copy-label');
	const mailtoLink = document.getElementById('btn-mailto-link');
	const gmailLink = document.getElementById('btn-gmail-link');
	const printBtn = document.getElementById('btn-print-letter');

	function generateEmail() {
		const userName = (nameInput?.value || '').trim() || '[Your Full Name]';
		const userEmail = (emailInput?.value || '').trim() || '[Your Account Email]';
		const accountId = (accountInput?.value || '').trim();
		const reason = reasonSelect?.value || 'Reducing monthly expenses';
		const includeRefund = refundCheck?.checked ?? true;
		const includeEtf = etfCheck?.checked ?? true;
		const includeRevoke = revokeCheck?.checked ?? true;

		const today = new Date().toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		});

		const subject = `URGENT: Notice of Cancellation & Termination — ${serviceName} (Account: ${userEmail})`;
		if (subjectEl) subjectEl.textContent = subject;

		let body = `DATE: ${today}
TO: ${serviceName} Customer Support & Billing Department (${recipientEmail})
FROM: ${userName} (${userEmail})
${accountId ? `ACCOUNT / MEMBER ID: ${accountId}\n` : ''}RE: Formal Legal Written Notice of Subscription Cancellation

Dear ${serviceName} Management & Billing Team,

Please accept this communication as my formal written notice to immediately terminate and cancel my ${serviceName} subscription associated with this email address (${userEmail})${accountId ? ` and Account ID #${accountId}` : ''}, effective immediately as of ${today}.

REASON FOR TERMINATION:
${reason}.
`;

		if (includeRefund) {
			body += `\nDEMAND FOR FULL REFUND:
Pursuant to consumer protection regulations and fair billing practices, I hereby request a full refund for the most recent billing charge. I have not utilized the service for this billing cycle, and I am formally asserting my right to dispute this charge if reimbursement is not processed within 5 business days.`;
		}

		if (includeEtf) {
			body += `\nWAIVER OF EARLY TERMINATION / CONTRACT PENALTIES:
I demand that any alleged "Early Termination Fees", contractual liquidation charges, or penalty assessments be fully waived. Under Federal Trade Commission regulations (16 CFR Part 425) and state automatic renewal statutes (including California AB 390), negative-option billing agreements that lack clear and conspicuous upfront disclosure and simple 1-click cancellation mechanisms are legally unenforceable.`;
		}

		if (includeRevoke) {
			body += `\nREVOCATION OF PAYMENT & ACH DEBIT AUTHORIZATION:
In accordance with Regulation E of the Electronic Funds Transfer Act (12 CFR § 1005.10), I hereby formally revoke any and all recurring authorization for ${serviceName} or its billing partners to initiate debit entries, pre-authorized charges, or recurring transactions against my bank account, credit card, or payment method on file. Any future charges initiated by ${serviceName} will be reported to my issuing bank as unauthorized fraudulent transactions.`;
		}

		body += `\nREQUIRED ACTIONS:
1. Immediately cancel the subscription and confirm the termination in writing to ${userEmail}.
2. Confirm that my account balance is $0.00 and that no further automatic renewals will occur.
3. Delete my payment details from your active billing systems.

Thank you for your prompt confirmation.

Sincerely,
${userName}
${userEmail}`;

		if (previewEl) {
			previewEl.textContent = body;
		}

		// Update Mailto Link
		if (mailtoLink) {
			const encodedSubject = encodeURIComponent(subject);
			const encodedBody = encodeURIComponent(body);
			mailtoLink.href = `mailto:${recipientEmail}?subject=${encodedSubject}&body=${encodedBody}`;
		}

		// Update Gmail Link
		if (gmailLink) {
			const encodedSubject = encodeURIComponent(subject);
			const encodedBody = encodeURIComponent(body);
			gmailLink.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(recipientEmail)}&su=${encodedSubject}&body=${encodedBody}`;
		}
	}

	// Attach input listeners
	[nameInput, emailInput, accountInput, reasonSelect, refundCheck, etfCheck, revokeCheck].forEach((el) => {
		el?.addEventListener('input', generateEmail);
		el?.addEventListener('change', generateEmail);
	});

	// Copy formatted email to clipboard
	copyBtn?.addEventListener('click', async () => {
		const text = previewEl?.textContent || '';
		try {
			await navigator.clipboard.writeText(text);
			if (copyLabel) {
				const orig = copyLabel.textContent;
				copyLabel.textContent = '✓ Copied to Clipboard!';
				copyBtn.style.borderColor = 'var(--color-accent)';
				setTimeout(() => {
					copyLabel.textContent = orig;
					copyBtn.style.borderColor = '';
				}, 2500);
			}
		} catch (e) {
			console.error('Failed to copy email', e);
		}
	});

	// Print official letter as PDF
	printBtn?.addEventListener('click', () => {
		const text = previewEl?.textContent || '';
		const printWin = window.open('', '', 'width=800,height=700');
		if (printWin) {
			printWin.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Official Notice of Cancellation — ${serviceName}</title>
					<style>
						body { font-family: 'Times New Roman', Times, serif; font-size: 12pt; line-height: 1.5; padding: 2in 1in 1in 1in; color: #000; }
						pre { font-family: inherit; font-size: inherit; white-space: pre-wrap; word-wrap: break-word; }
					</style>
				</head>
				<body>
					<pre>${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</pre>
				</body>
				</html>
			`);
			printWin.document.close();
			printWin.focus();
			setTimeout(() => {
				printWin.print();
				printWin.close();
			}, 300);
		}
	});

	// Initial render
	generateEmail();
</script>

<style>
	.email-gen {
		margin-top: 3.5rem;
		padding: 2.25rem 2rem;
		border-radius: var(--radius-lg, 16px);
		border: 1px solid rgba(0, 255, 136, 0.25);
		background: linear-gradient(180deg, rgba(16, 22, 28, 0.95) 0%, rgba(10, 14, 18, 0.98) 100%);
		box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
	}

	.email-gen__header {
		margin-bottom: 2rem;
	}

	.email-gen__badge-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 0.85rem;
	}

	.email-gen__badge {
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		background: rgba(0, 255, 136, 0.15);
		color: var(--color-accent, #00ff88);
		border: 1px solid rgba(0, 255, 136, 0.35);
	}

	.email-gen__verified {
		font-size: 0.78rem;
		color: #a0aec0;
		font-weight: 500;
	}

	.email-gen__title {
		font-family: var(--font-display, sans-serif);
		font-size: 1.6rem;
		font-weight: 700;
		color: #fff;
		margin: 0 0 0.65rem;
		line-height: 1.3;
	}

	.email-gen__desc {
		margin: 0;
		color: #a0aec0;
		font-size: 0.975rem;
		line-height: 1.6;
		max-width: 48rem;
	}

	.email-gen__layout {
		display: grid;
		grid-template-columns: 340px 1fr;
		gap: 2rem;
		align-items: start;
	}

	.email-gen__form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.5rem;
		border-radius: var(--radius-card, 12px);
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-group label {
		font-size: 0.825rem;
		font-weight: 600;
		color: #e2e8f0;
	}

	.form-group .required {
		color: #ef4444;
	}

	.form-group .optional {
		color: #718096;
		font-size: 0.75rem;
		font-weight: 400;
	}

	.form-input, .form-select {
		padding: 0.65rem 0.85rem;
		border-radius: 8px;
		background: rgba(0, 0, 0, 0.4);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #fff;
		font-size: 0.875rem;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.form-input:focus, .form-select:focus {
		border-color: var(--color-accent, #00ff88);
		box-shadow: 0 0 0 2px rgba(0, 255, 136, 0.2);
	}

	.form-select option {
		background: #111418;
		color: #fff;
	}

	.form-group--checkboxes {
		margin-top: 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.checkbox-group-label {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #718096;
		font-weight: 600;
		margin-bottom: 0.25rem;
	}

	.custom-checkbox {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		cursor: pointer;
	}

	.custom-checkbox input {
		position: absolute;
		opacity: 0;
		cursor: pointer;
	}

	.checkbox-box {
		width: 18px;
		height: 18px;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.4);
		border: 1px solid rgba(255, 255, 255, 0.2);
		flex-shrink: 0;
		margin-top: 2px;
		position: relative;
		transition: all 0.2s;
	}

	.custom-checkbox input:checked ~ .checkbox-box {
		background: var(--color-accent, #00ff88);
		border-color: var(--color-accent, #00ff88);
	}

	.custom-checkbox input:checked ~ .checkbox-box::after {
		content: '';
		position: absolute;
		left: 5px;
		top: 2px;
		width: 5px;
		height: 9px;
		border: solid #000;
		border-width: 0 2px 2px 0;
		transform: rotate(45deg);
	}

	.checkbox-text {
		font-size: 0.8rem;
		color: #cbd5e0;
		line-height: 1.4;
	}

	.checkbox-text strong {
		color: #fff;
	}

	/* Preview Area */
	.email-gen__preview-wrap {
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-card, 12px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #090c10;
		overflow: hidden;
	}

	.preview-meta-bar {
		padding: 1rem 1.25rem;
		background: rgba(255, 255, 255, 0.03);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.meta-field {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.825rem;
	}

	.meta-label {
		font-family: var(--font-mono, monospace);
		font-weight: 700;
		color: #718096;
		width: 65px;
		flex-shrink: 0;
	}

	.meta-val {
		color: var(--color-accent, #00ff88);
		font-weight: 600;
		word-break: break-all;
	}

	.preview-body-box {
		padding: 1.25rem;
		max-height: 380px;
		overflow-y: auto;
		background: rgba(0, 0, 0, 0.3);
	}

	.preview-text {
		margin: 0;
		font-family: var(--font-mono, monospace);
		font-size: 0.825rem;
		color: #e2e8f0;
		line-height: 1.6;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.email-gen__actions {
		padding: 1rem 1.25rem;
		background: rgba(255, 255, 255, 0.02);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn-gen-action {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 1.15rem;
		border-radius: 8px;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		text-decoration: none;
		transition: all 0.2s;
	}

	.btn-gen-action--copy {
		background: var(--color-accent, #00ff88);
		color: #000;
		border: 1px solid var(--color-accent, #00ff88);
	}

	.btn-gen-action--copy:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}

	.btn-gen-action--mailto {
		background: rgba(255, 255, 255, 0.06);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	.btn-gen-action--mailto:hover {
		background: rgba(255, 255, 255, 0.12);
	}

	.btn-gen-action--gmail {
		background: rgba(234, 67, 53, 0.12);
		color: #f87171;
		border: 1px solid rgba(234, 67, 53, 0.3);
	}

	.btn-gen-action--gmail:hover {
		background: rgba(234, 67, 53, 0.22);
		color: #fff;
	}

	.btn-gen-action--print {
		background: rgba(255, 255, 255, 0.04);
		color: #cbd5e0;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.btn-gen-action--print:hover {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
	}

	.btn-gen-action--dispatch {
		background: rgba(0, 255, 136, 0.12);
		color: #00ff88;
		border: 1px solid rgba(0, 255, 136, 0.35);
	}

	.btn-gen-action--dispatch:hover {
		background: #00ff88;
		color: #000;
		border-color: #00ff88;
	}

	@media (max-width: 56rem) {
		.email-gen {
			padding: 1.5rem 1.25rem;
		}

		.email-gen__layout {
			grid-template-columns: 1fr;
		}

		.btn-gen-action {
			flex: 1 1 calc(50% - 0.5rem);
			justify-content: center;
		}
	}
</style>

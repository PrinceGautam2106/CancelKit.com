---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {
	services,
	formatPrice,
	getCancelDifficultyScore,
	getDifficultyNotes,
	getDifficultyTier,
	type Service,
} from '../data/services';

const pageTitle = "Which Subscriptions Are Hardest to Cancel? (2026 Ranked)";
const pageDescription = "We ranked 50 popular subscriptions by how hard they are to cancel — from 1-click to nightmare. Updated 2026.";

// Pre-sort services by difficulty score descending
const enrichedServices = services.map((s) => ({
	...s,
	score: getCancelDifficultyScore(s),
	notes: getDifficultyNotes(s),
	tier: getDifficultyTier(getCancelDifficultyScore(s)),
})).sort((a, b) => b.score - a.score || a.name.localeCompare(b.name));

const nightmareServices = enrichedServices.filter((s) => s.tier === 'nightmare');
const hardServices = enrichedServices.filter((s) => s.tier === 'hard');
const easyServices = enrichedServices.filter((s) => s.tier === 'easy');

const totalCount = enrichedServices.length;
const avgScore = (enrichedServices.reduce((acc, s) => acc + s.score, 0) / totalCount).toFixed(1);

const tweetText = encodeURIComponent(
	"Which subscriptions are hardest to cancel? Planet Fitness (9/10), SiriusXM (8/10), Adobe (7/10)... See the 2026 Subscription Cancel Hall of Shame: https://cancelkits.com/cancel-difficulty via @CancelKit"
);
const tweetUrl = `https://twitter.com/intent/tweet?text=${tweetText}`;

const lastUpdatedDate = "March 2026";

// ItemList schema for SEO
const rankingSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": "Subscription Cancel Difficulty Index (2026)",
	"description": pageDescription,
	"numberOfItems": totalCount,
	"itemListElement": enrichedServices.map((s, idx) => ({
		"@type": "ListItem",
		"position": idx + 1,
		"name": `${s.name} - Cancel Difficulty ${s.score}/10`,
		"url": `https://cancelkits.com/cancel/${s.slug}`,
	})),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<slot name="head" slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(rankingSchema)} />
	</slot>

	<Nav />

	<main class="difficulty-page">
		<!-- Hero Section -->
		<section class="hero-section">
			<div class="container">
				<div class="freshness-badge">
					<span class="pulse-dot"></span>
					<span>Last Updated: {lastUpdatedDate} • Verified Across {totalCount}+ Services</span>
				</div>

				<h1 class="hero-title">
					The Subscription <span class="highlight-danger">Cancel Hall of Shame</span>
				</h1>

				<p class="hero-subtitle">
					Some companies make cancellation deliberately painful. We tested and ranked 50+ popular subscriptions by how hard they are to cancel — from 1-click to certified mail nightmares.
				</p>

				<!-- Stats Strip -->
				<div class="stats-strip">
					<div class="stat-card">
						<span class="stat-value">{totalCount}</span>
						<span class="stat-label">Services Tested</span>
					</div>
					<div class="stat-card">
						<span class="stat-value highlight-red">{nightmareServices.length}</span>
						<span class="stat-label">Nightmare Tier (8–10)</span>
					</div>
					<div class="stat-card">
						<span class="stat-value highlight-orange">{hardServices.length}</span>
						<span class="stat-label">Hard Tier (5–7)</span>
					</div>
					<div class="stat-card">
						<span class="stat-value highlight-green">{avgScore}/10</span>
						<span class="stat-label">Average Difficulty</span>
					</div>
				</div>

				<!-- Share & PR Action Bar -->
				<div class="pr-action-bar">
					<a href={tweetUrl} target="_blank" rel="noopener noreferrer" class="btn-share-x">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
						Share this ranking
					</a>

					<button type="button" class="btn-embed" id="open-embed-modal-btn">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polyline points="16 18 22 12 16 6"></polyline>
							<polyline points="8 6 2 12 8 18"></polyline>
						</svg>
						Embed or Cite this Data
					</button>

					<button type="button" class="btn-copy-url" id="copy-page-url-btn">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
						</svg>
						<span id="copy-url-text">Copy link</span>
					</button>
				</div>
			</div>
		</section>

		<!-- Interactive Filter & Search Controls -->
		<section class="controls-section">
			<div class="container">
				<div class="controls-card">
					<!-- Tier Filter Tabs -->
					<div class="tier-tabs" role="tablist">
						<button type="button" class="tier-tab is-active" data-filter="all">
							All <span class="tab-badge">{totalCount}</span>
						</button>
						<button type="button" class="tier-tab tab-danger" data-filter="nightmare">
							🔥 Nightmare Tier (8–10) <span class="tab-badge">{nightmareServices.length}</span>
						</button>
						<button type="button" class="tier-tab tab-warning" data-filter="hard">
							⚠️ Hard Tier (5–7) <span class="tab-badge">{hardServices.length}</span>
						</button>
						<button type="button" class="tier-tab tab-success" data-filter="easy">
							✅ Easy Tier (1–4) <span class="tab-badge">{easyServices.length}</span>
						</button>
					</div>

					<!-- Search & Sort Bar -->
					<div class="search-sort-row">
						<div class="search-input-wrap">
							<svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="11" cy="11" r="8"></circle>
								<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
							</svg>
							<input
								type="search"
								id="service-search-input"
								placeholder="Search subscription (e.g. Netflix, Planet Fitness, Adobe, NYT)..."
								aria-label="Search subscription"
							/>
						</div>

						<div class="sort-wrap">
							<label for="sort-select" class="sort-label">Sort:</label>
							<select id="sort-select" class="sort-select" aria-label="Sort subscriptions">
								<option value="hardest" selected>Hardest first (10 → 1)</option>
								<option value="easiest">Easiest first (1 → 10)</option>
								<option value="name">Alphabetical (A → Z)</option>
								<option value="price">Price (High to Low)</option>
							</select>
						</div>
					</div>

					<div class="filter-status-row">
						<span id="results-count-text">Showing all {totalCount} subscriptions</span>
						<button type="button" id="reset-filter-btn" class="reset-filter-btn" hidden>Reset filters</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Service Grid Section -->
		<section class="rankings-section">
			<div class="container">
				<!-- Nightmare Tier Announcement -->
				<div class="tier-group" id="tier-group-nightmare" data-tier="nightmare">
					<div class="tier-header tier-header--nightmare">
						<div class="tier-header__icon">🔥</div>
						<div>
							<h2 class="tier-header__title">Nightmare Tier (Score 8–10)</h2>
							<p class="tier-header__desc">
								Deliberate dark patterns, mandatory in-person club visits, certified snail mail, or aggressive phone retention teams designed to prevent cancellation.
							</p>
						</div>
					</div>

					<div class="service-cards-grid">
						{nightmareServices.map((service) => (
							<article
								class="service-card service-card--nightmare"
								data-tier="nightmare"
								data-slug={service.slug}
								data-name={service.name.toLowerCase()}
								data-category={service.category.toLowerCase()}
								data-score={service.score}
								data-price={service.monthlyPrice}
							>
								<div class="card-header">
									<div class="service-meta">
										<h3 class="service-name">{service.name}</h3>
										<span class="category-pill">{service.category}</span>
									</div>
									<div class="score-badge score-badge--nightmare" title={`Difficulty Score: ${service.score}/10`}>
										<span class="score-num">{service.score}</span>
										<span class="score-denom">/10</span>
									</div>
								</div>

								<div class="difficulty-callout difficulty-callout--nightmare">
									<span class="callout-icon">🚨</span>
									<p class="callout-text">{service.notes}</p>
								</div>

								<div class="card-specs">
									<div class="spec-item">
										<span class="spec-label">Method</span>
										<span class="spec-value method-pill method-pill--{service.cancelMethod}">{service.cancelMethod}</span>
									</div>
									<div class="spec-item">
										<span class="spec-label">Avg. Time</span>
										<span class="spec-value">{service.timeToCancel}</span>
									</div>
									<div class="spec-item">
										<span class="spec-label">Price</span>
										<span class="spec-value">{formatPrice(service.monthlyPrice)}/mo</span>
									</div>
								</div>

								<div class="card-actions">
									<a href={`/signup?ref=hall-of-shame&service=${service.slug}`} class="btn-cancelkit-action">
										<span>Let CancelKit handle this one</span>
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<line x1="5" y1="12" x2="19" y2="12"></line>
											<polyline points="12 5 19 12 12 19"></polyline>
										</svg>
									</a>
									<a href={`/cancel/${service.slug}`} class="btn-guide-link">
										View manual cancel guide →
									</a>
								</div>
							</article>
						))}
					</div>
				</div>

				<!-- Mid-Page Conversion Interstitial -->
				<div class="conversion-interstitial">
					<div class="interstitial-badge">⚡ The 1-Click Alternative</div>
					<h3 class="interstitial-title">
						Tired of dealing with cancellation mazes?
					</h3>
					<p class="interstitial-desc">
						CancelKit securely scans your receipts, flags forgotten renewals, and handles cancellations directly so you never have to call a phone tree or mail a certified letter again.
					</p>
					<div class="interstitial-actions">
						<a href="/onboarding/connect" class="btn-interstitial-primary">
							Scan My Subscriptions Free →
						</a>
						<a href="/pricing" class="btn-interstitial-secondary">
							See Pricing & Guarantee
						</a>
					</div>
				</div>

				<!-- Hard Tier Section -->
				<div class="tier-group" id="tier-group-hard" data-tier="hard">
					<div class="tier-header tier-header--hard">
						<div class="tier-header__icon">⚠️</div>
						<div>
							<h2 class="tier-header__title">Hard Tier (Score 5–7)</h2>
							<p class="tier-header__desc">
								Requires navigating hidden menus, enduring multiple retention screens, long support chat hold times, or declining persistent discount popups.
							</p>
						</div>
					</div>

					<div class="service-cards-grid">
						{hardServices.map((service) => (
							<article
								class="service-card service-card--hard"
								data-tier="hard"
								data-slug={service.slug}
								data-name={service.name.toLowerCase()}
								data-category={service.category.toLowerCase()}
								data-score={service.score}
								data-price={service.monthlyPrice}
							>
								<div class="card-header">
									<div class="service-meta">
										<h3 class="service-name">{service.name}</h3>
										<span class="category-pill">{service.category}</span>
									</div>
									<div class="score-badge score-badge--hard" title={`Difficulty Score: ${service.score}/10`}>
										<span class="score-num">{service.score}</span>
										<span class="score-denom">/10</span>
									</div>
								</div>

								<div class="difficulty-callout difficulty-callout--hard">
									<span class="callout-icon">⚠️</span>
									<p class="callout-text">{service.notes}</p>
								</div>

								<div class="card-specs">
									<div class="spec-item">
										<span class="spec-label">Method</span>
										<span class="spec-value method-pill method-pill--{service.cancelMethod}">{service.cancelMethod}</span>
									</div>
									<div class="spec-item">
										<span class="spec-label">Avg. Time</span>
										<span class="spec-value">{service.timeToCancel}</span>
									</div>
									<div class="spec-item">
										<span class="spec-label">Price</span>
										<span class="spec-value">{formatPrice(service.monthlyPrice)}/mo</span>
									</div>
								</div>

								<div class="card-actions">
									<a href={`/cancel/${service.slug}`} class="btn-guide-link btn-guide-link--primary">
										View step-by-step guide →
									</a>
									<a href={`/signup?ref=difficulty-hard&service=${service.slug}`} class="btn-cancelkit-subtle">
										Or cancel with CancelKit
									</a>
								</div>
							</article>
						))}
					</div>
				</div>

				<!-- Easy Tier Section -->
				<div class="tier-group" id="tier-group-easy" data-tier="easy">
					<div class="tier-header tier-header--easy">
						<div class="tier-header__icon">✅</div>
						<div>
							<h2 class="tier-header__title">Easy Tier (Score 1–4)</h2>
							<p class="tier-header__desc">
								Honest cancellation flows. Clear online account settings, 1–2 clicks to cancel, and standard confirmation emails without excessive friction.
							</p>
						</div>
					</div>

					<div class="service-cards-grid">
						{easyServices.map((service) => (
							<article
								class="service-card service-card--easy"
								data-tier="easy"
								data-slug={service.slug}
								data-name={service.name.toLowerCase()}
								data-category={service.category.toLowerCase()}
								data-score={service.score}
								data-price={service.monthlyPrice}
							>
								<div class="card-header">
									<div class="service-meta">
										<h3 class="service-name">{service.name}</h3>
										<span class="category-pill">{service.category}</span>
									</div>
									<div class="score-badge score-badge--easy" title={`Difficulty Score: ${service.score}/10`}>
										<span class="score-num">{service.score}</span>
										<span class="score-denom">/10</span>
									</div>
								</div>

								<div class="difficulty-callout difficulty-callout--easy">
									<span class="callout-icon">✓</span>
									<p class="callout-text">{service.notes}</p>
								</div>

								<div class="card-specs">
									<div class="spec-item">
										<span class="spec-label">Method</span>
										<span class="spec-value method-pill method-pill--{service.cancelMethod}">{service.cancelMethod}</span>
									</div>
									<div class="spec-item">
										<span class="spec-label">Avg. Time</span>
										<span class="spec-value">{service.timeToCancel}</span>
									</div>
									<div class="spec-item">
										<span class="spec-label">Price</span>
										<span class="spec-value">{formatPrice(service.monthlyPrice)}/mo</span>
									</div>
								</div>

								<div class="card-actions">
									<a href={`/cancel/${service.slug}`} class="btn-guide-link">
										Step-by-step cancel guide →
									</a>
								</div>
							</article>
						))}
					</div>
				</div>

				<!-- No Results Fallback -->
				<div class="no-results-state" id="no-results-box" hidden>
					<div class="no-results-icon">🔍</div>
					<h3>No matching subscriptions found</h3>
					<p>Try searching for a different service name, or reset your filters.</p>
					<button type="button" id="clear-search-btn" class="btn-reset-large">
						Clear search filter
					</button>
				</div>
			</div>
		</section>

		<!-- Methodology & PR Backlink Section -->
		<section class="methodology-section">
			<div class="container">
				<div class="methodology-card">
					<div class="methodology-header">
						<span class="methodology-tag">Research & Methodology</span>
						<h2 class="methodology-title">How We Score Subscription Cancel Difficulty</h2>
						<p class="methodology-sub">
							Our consumer research team continuously tests cancellation processes across the 100 most popular consumer subscription services in North America and Europe.
						</p>
					</div>

					<div class="criteria-grid">
						<div class="criteria-item">
							<div class="criteria-score-box score-green">1–4</div>
							<h4 class="criteria-name">Frictionless / Easy</h4>
							<p class="criteria-desc">
								Can be cancelled online directly in user settings in under 3 minutes. Zero mandatory surveys or customer support chats required.
							</p>
						</div>

						<div class="criteria-item">
							<div class="criteria-score-box score-orange">5–7</div>
							<h4 class="criteria-name">Moderate Resistance</h4>
							<p class="criteria-desc">
								Requires dodging multiple retention discount popups, multi-step exit questionnaires, or live chat wait queues with retention bots.
							</p>
						</div>

						<div class="criteria-item">
							<div class="criteria-score-box score-red">8–10</div>
							<h4 class="criteria-name">Deliberate Hostility</h4>
							<p class="criteria-desc">
								Requires physical in-person visits, certified mail, early termination penalty fees, or mandatory phone calls to aggressive sales agents.
							</p>
						</div>
					</div>

					<!-- Journalist Citation Callout -->
					<div class="journalist-box">
						<div class="journalist-text">
							<h4>Citing this study in your article or blog?</h4>
							<p>
								Journalists and bloggers are welcome to cite or republish this data with attribution to <strong>CancelKit</strong> and a link to <code>cancelkits.com/cancel-difficulty</code>.
							</p>
						</div>
						<button type="button" class="btn-copy-citation" id="copy-press-citation-btn">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
							<span id="citation-btn-label">Copy Attribution HTML</span>
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Final Bottom Conversion Banner -->
		<section class="bottom-cta-section">
			<div class="container">
				<div class="bottom-cta-card">
					<div class="bottom-cta-content">
						<h2 class="bottom-cta-title">Stop paying for subscriptions you don't use</h2>
						<p class="bottom-cta-desc">
							Connect your email in 30 seconds. CancelKit detects every hidden charge and cancels unwanted recurring billing in one click.
						</p>
					</div>
					<div class="bottom-cta-btn-wrap">
						<a href="/onboarding/connect" class="btn-cta-large">
							Start Free Scan →
						</a>
						<span class="cta-guarantee">No credit card required • Read-only scan</span>
					</div>
				</div>
			</div>
		</section>
	</main>

	<!-- Embed / Citation Modal -->
	<div id="embed-modal" class="modal-backdrop" hidden>
		<div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
			<div class="modal-header">
				<h3 id="modal-title">Embed or Cite This Ranking</h3>
				<button type="button" class="modal-close-btn" id="close-embed-modal-btn" aria-label="Close modal">&times;</button>
			</div>

			<div class="modal-body">
				<p class="modal-intro">
					Embed an interactive ranking table on your blog or cite CancelKit data in your research:
				</p>

				<div class="embed-field-group">
					<label class="embed-label" for="embed-iframe-code">1. Responsive Iframe Embed</label>
					<div class="embed-code-box">
						<textarea id="embed-iframe-code" readonly rows="3">&lt;iframe src="https://cancelkits.com/cancel-difficulty" width="100%" height="650" style="border:1px solid #222;border-radius:12px;" title="Subscription Cancel Difficulty Ranking 2026 - CancelKit"&gt;&lt;/iframe&gt;</textarea>
						<button type="button" class="btn-copy-snippet" data-copy-target="embed-iframe-code">Copy</button>
					</div>
				</div>

				<div class="embed-field-group">
					<label class="embed-label" for="embed-html-code">2. HTML Citation with Link</label>
					<div class="embed-code-box">
						<textarea id="embed-html-code" readonly rows="2">&lt;p&gt;Source: &lt;a href="https://cancelkits.com/cancel-difficulty" target="_blank" rel="noopener"&gt;CancelKit Subscription Cancel Difficulty Index (2026)&lt;/a&gt;&lt;/p&gt;</textarea>
						<button type="button" class="btn-copy-snippet" data-copy-target="embed-html-code">Copy</button>
					</div>
				</div>

				<div class="embed-field-group">
					<label class="embed-label" for="embed-md-code">3. Markdown Link</label>
					<div class="embed-code-box">
						<textarea id="embed-md-code" readonly rows="2">[CancelKit Subscription Cancel Difficulty Index (2026)](https://cancelkits.com/cancel-difficulty)</textarea>
						<button type="button" class="btn-copy-snippet" data-copy-target="embed-md-code">Copy</button>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<button type="button" class="btn-modal-done" id="done-embed-modal-btn">Done</button>
			</div>
		</div>
	</div>

	<Footer />
</BaseLayout>

<script>
	// Interactive Client-Side Filtering, Search, Sorting, and Embed Modal
	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('service-search-input') as HTMLInputElement | null;
		const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
		const filterTabs = document.querySelectorAll<HTMLButtonElement>('.tier-tab');
		const serviceCards = Array.from(document.querySelectorAll<HTMLElement>('.service-card'));
		const tierGroups = document.querySelectorAll<HTMLElement>('.tier-group');
		const resultsCountText = document.getElementById('results-count-text');
		const resetBtn = document.getElementById('reset-filter-btn');
		const clearSearchBtn = document.getElementById('clear-search-btn');
		const noResultsBox = document.getElementById('no-results-box');

		let activeTierFilter = 'all';
		let searchQuery = '';
		let sortOrder = 'hardest';

		function applyFilters() {
			let visibleCount = 0;

			serviceCards.forEach((card) => {
				const cardTier = card.dataset.tier || '';
				const cardName = card.dataset.name || '';
				const cardCategory = card.dataset.category || '';

				const matchesTier = activeTierFilter === 'all' || cardTier === activeTierFilter;
				const matchesSearch = !searchQuery || cardName.includes(searchQuery) || cardCategory.includes(searchQuery);

				if (matchesTier && matchesSearch) {
					card.style.display = '';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			// Hide or show tier groups based on whether they contain visible cards
			tierGroups.forEach((group) => {
				const groupTier = group.dataset.tier;
				const hasVisibleCards = Array.from(group.querySelectorAll<HTMLElement>('.service-card')).some(
					(c) => c.style.display !== 'none'
				);

				if (activeTierFilter !== 'all' && groupTier !== activeTierFilter) {
					group.style.display = 'none';
				} else if (hasVisibleCards) {
					group.style.display = '';
				} else {
					group.style.display = 'none';
				}
			});

			// Results summary and empty state
			if (resultsCountText) {
				resultsCountText.textContent = `Showing ${visibleCount} of ${serviceCards.length} subscriptions`;
			}

			if (resetBtn) {
				resetBtn.hidden = activeTierFilter === 'all' && !searchQuery;
			}

			if (noResultsBox) {
				noResultsBox.hidden = visibleCount > 0;
			}
		}

		// Re-sort cards within each group grid
		function applySorting() {
			const grids = document.querySelectorAll<HTMLElement>('.service-cards-grid');
			grids.forEach((grid) => {
				const cards = Array.from(grid.querySelectorAll<HTMLElement>('.service-card'));
				cards.sort((a, b) => {
					const scoreA = parseFloat(a.dataset.score || '0');
					const scoreB = parseFloat(b.dataset.score || '0');
					const nameA = a.dataset.name || '';
					const nameB = b.dataset.name || '';
					const priceA = parseFloat(a.dataset.price || '0');
					const priceB = parseFloat(b.dataset.price || '0');

					if (sortOrder === 'hardest') return scoreB - scoreA || nameA.localeCompare(nameB);
					if (sortOrder === 'easiest') return scoreA - scoreB || nameA.localeCompare(nameB);
					if (sortOrder === 'name') return nameA.localeCompare(nameB);
					if (sortOrder === 'price') return priceB - priceA;
					return 0;
				});

				cards.forEach((card) => grid.appendChild(card));
			});
		}

		// Event: Filter tabs
		filterTabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				filterTabs.forEach((t) => t.classList.remove('is-active'));
				tab.classList.add('is-active');
				activeTierFilter = tab.dataset.filter || 'all';
				applyFilters();
			});
		});

		// Event: Search input
		searchInput?.addEventListener('input', (e) => {
			searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
			applyFilters();
		});

		// Event: Sort select
		sortSelect?.addEventListener('change', (e) => {
			sortOrder = (e.target as HTMLSelectElement).value;
			applySorting();
			applyFilters();
		});

		// Event: Reset button
		resetBtn?.addEventListener('click', () => {
			activeTierFilter = 'all';
			searchQuery = '';
			if (searchInput) searchInput.value = '';
			filterTabs.forEach((t) => t.classList.remove('is-active'));
			filterTabs[0]?.classList.add('is-active');
			applyFilters();
		});

		clearSearchBtn?.addEventListener('click', () => {
			searchQuery = '';
			if (searchInput) searchInput.value = '';
			activeTierFilter = 'all';
			filterTabs.forEach((t) => t.classList.remove('is-active'));
			filterTabs[0]?.classList.add('is-active');
			applyFilters();
		});

		// Event: Copy page URL
		const copyPageUrlBtn = document.getElementById('copy-page-url-btn');
		const copyUrlText = document.getElementById('copy-url-text');
		copyPageUrlBtn?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				if (copyUrlText) copyUrlText.textContent = 'Copied!';
				setTimeout(() => {
					if (copyUrlText) copyUrlText.textContent = 'Copy link';
				}, 2500);
			} catch {
				// fallback
			}
		});

		// Event: Copy press citation
		const copyPressCitationBtn = document.getElementById('copy-press-citation-btn');
		const citationBtnLabel = document.getElementById('citation-btn-label');
		copyPressCitationBtn?.addEventListener('click', async () => {
			const citationHtml = '<p>Source: <a href="https://cancelkits.com/cancel-difficulty" target="_blank" rel="noopener">CancelKit Subscription Cancel Difficulty Index (2026)</a></p>';
			try {
				await navigator.clipboard.writeText(citationHtml);
				if (citationBtnLabel) citationBtnLabel.textContent = 'Copied Citation HTML!';
				setTimeout(() => {
					if (citationBtnLabel) citationBtnLabel.textContent = 'Copy Attribution HTML';
				}, 2500);
			} catch {
				// fallback
			}
		});

		// Embed Modal Controls
		const embedModal = document.getElementById('embed-modal');
		const openModalBtn = document.getElementById('open-embed-modal-btn');
		const closeModalBtn = document.getElementById('close-embed-modal-btn');
		const doneModalBtn = document.getElementById('done-embed-modal-btn');

		function toggleModal(open: boolean) {
			if (!embedModal) return;
			embedModal.hidden = !open;
			if (open) {
				document.body.style.overflow = 'hidden';
			} else {
				document.body.style.overflow = '';
			}
		}

		openModalBtn?.addEventListener('click', () => toggleModal(true));
		closeModalBtn?.addEventListener('click', () => toggleModal(false));
		doneModalBtn?.addEventListener('click', () => toggleModal(false));

		embedModal?.addEventListener('click', (e) => {
			if (e.target === embedModal) toggleModal(false);
		});

		// Copy snippet buttons inside modal
		const copySnippetBtns = document.querySelectorAll<HTMLButtonElement>('.btn-copy-snippet');
		copySnippetBtns.forEach((btn) => {
			btn.addEventListener('click', async () => {
				const targetId = btn.dataset.copyTarget;
				if (!targetId) return;
				const textarea = document.getElementById(targetId) as HTMLTextAreaElement | null;
				if (!textarea) return;

				try {
					await navigator.clipboard.writeText(textarea.value);
					const originalText = btn.textContent;
					btn.textContent = 'Copied!';
					btn.classList.add('is-copied');
					setTimeout(() => {
						btn.textContent = originalText;
						btn.classList.remove('is-copied');
					}, 2000);
				} catch {
					// fallback
				}
			});
		});
	});
</script>


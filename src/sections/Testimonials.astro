---
import { testimonials } from '../data/testimonials';
---

<section class="testimonials" aria-labelledby="testimonials-title" id="testimonials">
	<div class="testimonials__container">
		<header class="testimonials__header fade-in-up">
			<p class="testimonials__eyebrow">TESTIMONIALS</p>
			<h2 id="testimonials-title" class="testimonials__title">Loved by people who hate wasting money</h2>
		</header>

		<div class="testimonials__grid">
			{testimonials.slice(0, 3).map((t, i) => (
				<article class={`testimonials__card fade-in-up stagger-${i + 1}`}>
					<div class="testimonials__stars" aria-label="5 out of 5 stars">★★★★★</div>
					<blockquote>
						<p>&ldquo;{t.quote}&rdquo;</p>
					</blockquote>
					<footer class="testimonials__footer">
						<div class="testimonials__user">
							<div class="testimonials__avatar" aria-hidden="true">{t.avatar}</div>
							<div>
								<strong>{t.name}</strong>
								<span>{t.location}</span>
							</div>
						</div>
						<span class="testimonials__saved">${t.savedAmount}/mo saved</span>
					</footer>
				</article>
			))}
		</div>

		<p class="testimonials__more">
			<a href="/wall-of-love">See the full Wall of Love →</a>
		</p>
	</div>
</section>

<style>
	.testimonials {
		background: #050505;
		padding: 5rem 0;
		border-top: 1px solid var(--color-border);
		width: 100%;
		overflow: hidden;
	}

	.testimonials__container {
		width: min(100% - 2rem, 72rem);
		margin: 0 auto;
	}

	.testimonials__header {
		text-align: center;
		max-width: 38rem;
		margin: 0 auto;
	}

	.testimonials__eyebrow {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--color-muted);
	}

	.testimonials__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 4vw, 2.25rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		color: #fff;
		line-height: 1.2;
	}

	.testimonials__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-top: 2.5rem;
	}

	.testimonials__card {
		padding: 1.5rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.testimonials__stars {
		color: var(--color-accent);
		font-size: 0.85rem;
		letter-spacing: 0.08em;
	}

	.testimonials__card blockquote {
		margin: 0;
		flex: 1;
	}

	.testimonials__card blockquote p {
		margin: 0;
		color: #d4d4d4;
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.testimonials__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.testimonials__user {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
	}

	.testimonials__avatar {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: rgba(0, 255, 136, 0.15);
		color: var(--color-accent);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.9rem;
		flex-shrink: 0;
	}

	.testimonials__user strong {
		display: block;
		font-size: 0.88rem;
		color: #fff;
	}

	.testimonials__user span {
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.testimonials__saved {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--color-accent);
		white-space: nowrap;
	}

	.testimonials__more {
		margin: 2rem 0 0;
		text-align: center;
	}

	.testimonials__more a {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.92rem;
	}

	.testimonials__more a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 54rem) {
		.testimonials__grid {
			grid-template-columns: 1fr;
			max-width: 28rem;
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>

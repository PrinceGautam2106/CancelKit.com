	creator: { '@type': 'Organization', name: 'CancelKits', url: 'https://cancelkits.com/' },
	dateModified: '2026-11-01',
	license: 'https://creativecommons.org/licenses/by/4.0/',
	variableMeasured: 'Subscription Cancellation Difficulty Score (1–10)',
	keywords: ['subscription cancellation', 'dark patterns', 'consumer protection', 'cancel difficulty', 'FTC click to cancel'],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'What is a Cancellation Difficulty Score?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'The Cancellation Difficulty Score (1–10) measures how hard it is to cancel a subscription. A score of 1–3 means easy online self-service cancellation. A score of 7–8 means hidden buttons, phone retention teams, or mandatory written notice. A score of 9–10 ("Roach Motel") means certified mail, in-person visits, or deliberate dark patterns designed to prevent cancellation.',
			},
		},
		{
			'@type': 'Question',
			name: 'What are subscription dark patterns?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Dark patterns are deceptive design choices that trick consumers into maintaining subscriptions. Common examples include: hiding the cancel button deep in settings, requiring a phone call to cancel what you signed up for online, charging early termination fees, using confirmshaming ("Are you sure? You\'ll lose everything!"), and aggressive retention offers that make cancellation take 10+ minutes.',
			},
		},
		{
			'@type': 'Question',
			name: 'Is it legal for companies to make cancellation harder than sign-up?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Under the FTC\'s 2024 "Click-to-Cancel" rule (effective 2025), companies must provide a cancellation method at least as easy as the sign-up process. Many companies are still not fully compliant. Consumers can file complaints at ReportFraud.ftc.gov and dispute charges through their bank under the Fair Credit Billing Act.',
			},
		},
		{
			'@type': 'Question',
			name: 'How does CancelKits score cancellation difficulty?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Our research team manually tests each subscription\'s cancellation process across web, mobile app, and phone channels. We score based on 5 factors: (1) number of steps required, (2) mandatory channels (online vs. phone vs. mail), (3) retention friction (exit surveys, discount offers, confirmshaming), (4) time to complete cancellation, and (5) presence of dark patterns like hidden buttons or early termination fees.',
			},
		},
	],
};

const rankingSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Subscription Cancel Difficulty Index 2026',
	description: pageDescription,
	numberOfItems: totalCount,
	itemListElement: sortedBrands.map((b, idx) => ({
		'@type': 'ListItem',
		position: idx + 1,
		name: `${b.name} - Cancel Difficulty ${b.difficultyScore}/10`,
		url: `https://cancelkits.com/cancel/${b.slug}/`,
	})),
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	canonicalPath="/cancel-difficulty/"
	keywords="cancel difficulty score, subscription dark patterns, hardest subscriptions to cancel, cancel planet fitness, cancel adobe, cancel gym membership, roach motel subscriptions, FTC click to cancel, subscription cancellation index"
	schemas={[datasetSchema, faqSchema, rankingSchema]}
>
	<Nav />

	<main class="difficulty-page">
		<!-- Hero Section -->
		<section class="hero-section">
			<div class="container">
				<div class="freshness-badge">
					<span class="pulse-dot"></span>
					<span>Last Updated: November 2026 • {totalCount} Services Ranked</span>
				</div>

				<h1 class="hero-title">
					Subscription Cancellation<br /><span class="highlight-danger">Difficulty & Dark Pattern Index</span>
				</h1>

				<p class="hero-subtitle">
					We tested and ranked {totalCount}+ popular subscriptions by how hard they are to cancel — from 1-click to certified mail nightmares.
					See every dark pattern exposed and get insider escape hatches to bypass them.
				</p>

				<!-- Stats Strip -->
				<div class="stats-strip">
					<div class="stat-card">
						<span class="stat-value">{totalCount}</span>
						<span class="stat-label">Services Ranked</span>
					</div>
					<div class="stat-card">
						<span class="stat-value highlight-red">{nightmareCount}</span>
						<span class="stat-label">Hard / Nightmare (7+)</span>
					</div>
					<div class="stat-card">
						<span class="stat-value highlight-green">{easyCount}</span>
						<span class="stat-label">Easy (1–3)</span>
					</div>
					<div class="stat-card">
						<span class="stat-value highlight-orange">{avgScore}/10</span>
						<span class="stat-label">Average Difficulty</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Wall of Shame: Top 3 Worst Offenders -->
		<section class="wall-of-shame">
			<div class="container">
				<div class="shame-header">
					<span class="shame-badge">🔥 WALL OF SHAME — TOP 3 WORST OFFENDERS</span>
				</div>
				<div class="shame-grid">
					{top3Worst.map((brand, idx) => (
						<article class="shame-card">
							<div class="shame-rank">#{idx + 1}</div>
							<div class="shame-card__header">
								<div>
									<h3 class="shame-card__name">{brand.name}</h3>
									<span class="shame-card__category">{brand.category}</span>
								</div>
								<div class="shame-score">
									<span class="shame-score__num">{brand.difficultyScore}</span>
									<span class="shame-score__denom">/10</span>
								</div>
							</div>
							<div class="shame-card__method">
								<span class="spec-label">Cancel Method:</span>
								<span class="method-text-red">{brand.cancelMethod}</span>
							</div>
							<div class="shame-card__time">
								<span class="spec-label">Est. Time:</span>
								<span>{brand.estimatedTime}</span>
							</div>
							<div class="shame-card__patterns">
								{brand.darkPatternsDetected.map(dp => (
									<span class="dp-tag dp-tag--red">{dp}</span>
								))}
							</div>
							<div class="shame-card__actions">
								<a href={`#brand-${brand.slug}`} class="btn-escape btn-shame-escape" data-shame-slug={brand.slug}>View Escape Hatch →</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- Interactive Controls: Search, Category, Sort -->
		<section class="controls-section" id="index">
			<div class="container">
				<div class="controls-card">
					<!-- Category Pills -->
					<div class="category-pills" role="tablist">
						{categories.map(cat => (
							<button type="button" class:list={['cat-pill', cat === 'All' && 'is-active']} data-category={cat}>{cat}</button>
						))}
					</div>

					<!-- Search & Sort -->
					<div class="search-sort-row">
						<div class="search-input-wrap">
							<svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
							<input type="search" id="brand-search" placeholder="Search any brand, e.g. Adobe, Planet Fitness, NYT..." aria-label="Search brand" />
						</div>
						<div class="sort-wrap">
							<label for="sort-select" class="sort-label">Sort:</label>
							<select id="sort-select" class="sort-select" aria-label="Sort brands">
								<option value="hardest" selected>Hardest to Cancel (10 → 1)</option>
								<option value="easiest">Easiest to Cancel (1 → 10)</option>
								<option value="name">Alphabetical (A → Z)</option>
							</select>
						</div>
					</div>

					<!-- Compare Mode Toggle -->
					<div class="compare-toggle-row">
						<button type="button" class="btn-compare-toggle" id="compare-toggle-btn">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M12 22v-8.3a4 4 0 0 0-1.172-2.872L3 3"/><path d="m15 9 6-6"/></svg>
							<span>Compare 2 Brands</span>
						</button>
						<span class="compare-hint" id="compare-hint" hidden>Select up to 2 brand cards to compare side-by-side</span>
						<span id="results-count" class="results-count">Showing all {totalCount} brands</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Brand Cards Grid (SSR for SEO) -->
		<section class="brands-section">
			<div class="container">
				<div class="brands-grid" id="brands-grid">
					{sortedBrands.map(brand => {
						const tier = getTierClass(brand.difficultyScore);
						return (
							<article
								id={`brand-${brand.slug}`}
								class={`brand-card brand-card--${tier}`}
								data-name={brand.name.toLowerCase()}
								data-slug={brand.slug}
								data-category={brand.category}
								data-score={brand.difficultyScore}
								data-tier={tier}
								data-method={brand.cancelMethod}
								data-time={brand.estimatedTime}
								data-patterns={JSON.stringify(brand.darkPatternsDetected)}
								data-escape={brand.escapeHatchTip}
							>
								<div class="brand-card__header">
									<div class="brand-card__meta">
										<h3 class="brand-card__name">{brand.name}</h3>
										<span class="brand-card__category">{brand.category}</span>
									</div>
									<div class={`score-badge score-badge--${tier}`} title={`Difficulty: ${brand.difficultyScore}/10`}>
										<span class="score-num">{brand.difficultyScore}</span>
										<span class="score-denom">/10</span>
									</div>
								</div>

								<div class="brand-card__label">
									<span class={`difficulty-label difficulty-label--${tier}`}>{brand.difficultyLabel}</span>
								</div>

								<div class="brand-card__specs">
									<div class="spec-item">
										<span class="spec-label">Method</span>
										<span class={`spec-value method-color--${tier}`}>{brand.cancelMethod}</span>
									</div>
									<div class="spec-item">
										<span class="spec-label">Est. Time</span>
										<span class="spec-value">{brand.estimatedTime}</span>
									</div>
								</div>

								<div class="brand-card__patterns">
									{brand.darkPatternsDetected.slice(0, 3).map(dp => (
										<span class={`dp-tag dp-tag--${tier}`}>{dp}</span>
									))}
									{brand.darkPatternsDetected.length > 3 && (
										<span class="dp-tag dp-tag--more">+{brand.darkPatternsDetected.length - 3} more</span>
									)}
								</div>

								<!-- Escape Hatch (expandable) -->
								<div class="brand-card__escape" hidden>
									<div class="escape-box">
										<div class="escape-box__header">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
											<strong>Insider Escape Hatch</strong>
										</div>
										<p class="escape-tip-desc">{brand.escapeHatchTip}</p>
										<div class="escape-script-wrap">
											<div class="escape-script-top">
												<span class="escape-script-title">Cancellation Script:</span>
												<button type="button" class="btn-copy-script" data-script={`Please immediately cancel my ${brand.name} subscription and confirm in writing that all recurring billing has terminated. I am formally revoking recurring debit authorization under the FTC Click-to-Cancel rule.`}>
													<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
													<span>Copy Script</span>
												</button>
											</div>
											<div class="escape-script-text">"Please immediately cancel my {brand.name} subscription and confirm in writing that all recurring billing has terminated. I am formally revoking recurring debit authorization under the FTC Click-to-Cancel rule."</div>
										</div>
									</div>
								</div>

								<div class="brand-card__actions">
									<button type="button" class="btn-escape-toggle">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
										<span>See Escape Hatch</span>
									</button>
									<a href={`/cancel/${brand.slug}/`} class="btn-guide">Full Step-by-Step Guide →</a>
								</div>
							</article>
						);
					})}
				</div>

				<!-- No Results -->
				<div class="no-results" id="no-results" hidden>
					<div class="no-results__icon">🔍</div>
					<h3>No matching brands found</h3>
					<p>Try a different search term or reset your filters.</p>
					<button type="button" class="btn-reset" id="reset-btn">Reset Filters</button>
				</div>
			</div>
		</section>

		<!-- Compare Panel (hidden by default) -->
		<div class="compare-panel" id="compare-panel" hidden>
			<div class="compare-panel__header">
				<h3>Compare Brands</h3>
				<button type="button" class="compare-panel__close" id="close-compare">✕</button>
			</div>
			<div class="compare-panel__body" id="compare-body">
				<p class="compare-empty">Select 2 brand cards above to compare</p>
			</div>
			<div class="compare-panel__footer" id="compare-footer" hidden>
				<button type="button" class="btn-share-compare" id="share-compare-btn">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					Share Comparison
				</button>
			</div>
		</div>

		<!-- CTA Interstitial -->
		<section class="cta-interstitial">
			<div class="container">
				<div class="cta-interstitial__card">
					<div class="cta-interstitial__badge">⚡ The 1-Click Alternative</div>
					<h3>Have one of these hard-to-cancel subscriptions hiding in your inbox?</h3>
					<p>Let CancelKits find all of them in 30 seconds (read-only) and cancel them in one click.</p>
					<a href="/start/" class="btn-cta-primary">Run Free 30-Second Subscription Audit →</a>
					<span class="cta-guarantee">No credit card required • Read-only inbox scan</span>
				</div>
			</div>
		</section>

		<!-- Submit a Dark Pattern Widget -->
		<section class="submit-section">
			<div class="container">
				<div class="submit-card">
					<div class="submit-card__header">
						<h2>🗳️ Report a Dark Pattern</h2>
						<p>Help other consumers. Report a company that made canceling deliberately hard.</p>
					</div>
					<form id="dark-pattern-form" class="submit-form" onsubmit="return false;">
						<div class="submit-form__row">
							<div class="form-group">
								<label for="report-company">Company Name</label>
								<input type="text" id="report-company" class="form-input" placeholder="e.g. Planet Fitness" required />
							</div>
							<div class="form-group">
								<label for="report-score">Difficulty (1–10)</label>
								<select id="report-score" class="form-input">
									<option value="10">10 — Nightmare</option>
									<option value="9">9 — Nearly Impossible</option>
									<option value="8" selected>8 — Very Hard</option>
									<option value="7">7 — Hard</option>
									<option value="6">6 — Moderate-Hard</option>
									<option value="5">5 — Moderate</option>
									<option value="4">4 — Moderate-Easy</option>
									<option value="3">3 — Easy</option>
									<option value="2">2 — Very Easy</option>
									<option value="1">1 — Instant</option>
								</select>
							</div>
						</div>
						<div class="form-group">
							<label for="report-pattern">Dark Pattern / Trap Encountered</label>
							<textarea id="report-pattern" class="form-input" rows="3" placeholder="What specific cancellation trap, hidden button, or retention tactic did you encounter?"></textarea>
						</div>
						<button type="submit" class="btn-submit-report" id="submit-report-btn">Submit Dark Pattern Report</button>
					</form>
					<div class="submit-success" id="submit-success" hidden>
						<div class="success-icon">✅</div>
						<h4>Thank you! Your report has been queued for verification.</h4>
						<p>Your submission helps keep the index accurate and protects other consumers.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Methodology & FAQs -->
		<section class="methodology-section">
			<div class="container">
				<div class="methodology-card">
					<div class="methodology-header">
						<span class="methodology-tag">Research & Methodology</span>
						<h2 class="methodology-title">How We Score Subscription Dark Patterns</h2>
					</div>

					<div class="methodology-body">
						<p>
							The CancelKits Cancellation Difficulty Index is built from hands-on consumer research. Our team manually tests each subscription's cancellation process across web browsers, mobile apps, phone support, and postal mail channels. This comparison is an editorial research reference compiled from manual flow audits and provider terms, not a timed test or community rating. We don't rely on company self-reporting — every score reflects the actual end-user experience.
						</p>
						<p>
							Each brand is scored on a scale of 1.0 to 10.0 based on five weighted factors: (1) <strong>number of steps required</strong> to reach the cancel button, (2) <strong>mandatory cancellation channel</strong> — online self-service earns a low score while certified mail or in-person-only earns a high score, (3) <strong>retention friction</strong> — exit surveys, confirmshaming pop-ups, and aggressive discount offers, (4) <strong>total time to complete</strong> the cancellation, and (5) <strong>dark pattern severity</strong> — the presence of deceptive tactics like hidden buttons, early termination fees, or deliberate billing maze redirects.
						</p>
						<p>
							We also catalog specific dark pattern types using the taxonomy from Princeton University's Dark Patterns research and the FTC's 2022 enforcement report on manipulative design. Brands that score 9–10 are flagged as "Roach Motel" services — a term describing products that are easy to check into but nearly impossible to leave. Under the FTC's 2024 "Click-to-Cancel" rule (16 CFR Part 425), many of these practices may now violate federal law. Consumers encountering these barriers can file complaints at <a href="https://reportfraud.ftc.gov" target="_blank" rel="noopener noreferrer">ReportFraud.ftc.gov</a>.
						</p>
						<p>
							The index is updated quarterly with community-submitted reports factored into scoring adjustments. If you've recently battled a cancellation process, <a href="#dark-pattern-form">submit a dark pattern report</a> to help keep the index accurate and protect other consumers.
						</p>
					</div>

					<div class="criteria-grid">
						<div class="criteria-item">
							<div class="criteria-score-box score-green">1–3</div>
							<h4>Easy</h4>
							<p>1–2 click online cancellation in account settings. Under 3 minutes. No phone call or mail required.</p>
						</div>
						<div class="criteria-item">
							<div class="criteria-score-box score-yellow">4–6</div>
							<h4>Moderate</h4>
							<p>Multiple retention screens, exit surveys, chat-only cancellation, or hidden settings. 3–10 minutes.</p>
						</div>
						<div class="criteria-item">
							<div class="criteria-score-box score-orange">7–8</div>
							<h4>Hard</h4>
							<p>Mandatory phone calls, aggressive retention teams, buried settings, or written notice requirements. 10–30+ minutes.</p>
						</div>
						<div class="criteria-item">
							<div class="criteria-score-box score-red">9–10</div>
							<h4>Roach Motel / Nightmare</h4>
							<p>Certified mail, in-person visits, early termination fees, or deliberately hostile dark patterns. Days to weeks.</p>
						</div>
					</div>

					<!-- Journalist Citation -->
					<div class="journalist-box">
						<div class="journalist-text">
							<h4>Citing this index in your article?</h4>
							<p>Journalists and bloggers are welcome to cite with attribution to <strong>CancelKits</strong> and a link to <code>cancelkits.com/cancel-difficulty</code>.</p>
						</div>
						<button type="button" class="btn-copy-citation" id="copy-citation-btn">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
							<span id="citation-label">Copy Attribution HTML</span>
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- FAQ Section -->
		<section class="faq-section" id="faq">
			<div class="container">
				<h2>Frequently Asked Questions</h2>
				<div class="faq-list">
					<details class="faq-item">
						<summary>What is a Cancellation Difficulty Score?</summary>
						<p>The Cancellation Difficulty Score (1–10) measures how hard it is to cancel a subscription based on our hands-on testing. A score of 1–3 means easy online self-service cancellation. A score of 7–8 means hidden buttons, phone retention teams, or mandatory written notice. A score of 9–10 ("Roach Motel") means certified mail, in-person visits, or deliberate dark patterns designed to prevent cancellation.</p>
					</details>
					<details class="faq-item">
						<summary>What are subscription dark patterns?</summary>
						<p>Dark patterns are deceptive design choices that trick consumers into maintaining subscriptions. Common examples: hiding the cancel button deep in settings, requiring a phone call to cancel what you signed up for online, charging early termination fees, using confirmshaming ("Are you sure? You'll lose everything!"), and aggressive retention offers that make cancellation take 10+ minutes.</p>
					</details>
					<details class="faq-item">
						<summary>Is it legal for companies to make cancellation harder than sign-up?</summary>
						<p>Under the FTC's 2024 "Click-to-Cancel" rule (effective 2025), companies must provide a cancellation method at least as easy as the sign-up process. Many companies are still not fully compliant. Consumers can file complaints at ReportFraud.ftc.gov and dispute charges through their bank under the Fair Credit Billing Act.</p>
					</details>
					<details class="faq-item">
						<summary>How often is this index updated?</summary>
						<p>The index is updated quarterly. We re-test all ranked services and incorporate community-submitted dark pattern reports. Last update: November 2026. If a company has recently changed their cancellation process, submit a report to help us update the score.</p>
					</details>
				</div>
			</div>
		</section>

		<!-- Bottom CTA -->
		<section class="bottom-cta">
			<div class="container">
				<div class="bottom-cta__card">
					<h2>Stop paying for subscriptions you don't use</h2>
					<p>Connect your email in 30 seconds. CancelKits detects every hidden charge and cancels unwanted recurring billing in one click.</p>
					<a href="/start/" class="btn-cta-large">Start Free Scan →</a>
					<span class="cta-guarantee">No credit card required • Read-only scan</span>
				</div>
			</div>
		</section>
	</main>

	<!-- Toast -->
	<div class="toast" id="toast" aria-live="polite" hidden>Copied to clipboard!</div>

	<Footer />
</BaseLayout>

<script>
document.addEventListener('DOMContentLoaded', () => {
	// Elements
	const searchInput = document.getElementById('brand-search') as HTMLInputElement;
	const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
	const categoryPills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
	const brandsGrid = document.getElementById('brands-grid') as HTMLElement;
	const brandCards = Array.from(document.querySelectorAll<HTMLElement>('.brand-card'));
	const resultsCount = document.getElementById('results-count') as HTMLElement;
	const noResults = document.getElementById('no-results') as HTMLElement;
	const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
	const toast = document.getElementById('toast') as HTMLElement;

	let activeCategory = 'All';
	let searchQuery = '';
	let sortOrder = 'hardest';

	// ── Filtering ──
	function applyFilters() {
		let visible = 0;
		brandCards.forEach(card => {
			const name = card.dataset.name || '';
			const cat = card.dataset.category || '';
			const matchCat = activeCategory === 'All' || cat === activeCategory;
			const matchSearch = !searchQuery || name.includes(searchQuery) || cat.toLowerCase().includes(searchQuery);
			if (matchCat && matchSearch) {
				card.style.display = '';
				visible++;
			} else {
				card.style.display = 'none';
			}
		});
		if (resultsCount) resultsCount.textContent = `Showing ${visible} of ${brandCards.length} brands`;
		if (noResults) noResults.hidden = visible > 0;
	}

	// ── Sorting ──
	function applySorting() {
		const sorted = [...brandCards].sort((a, b) => {
			const scoreA = parseFloat(a.dataset.score || '0');
			const scoreB = parseFloat(b.dataset.score || '0');
			const nameA = a.dataset.name || '';
			const nameB = b.dataset.name || '';
			if (sortOrder === 'hardest') return scoreB - scoreA || nameA.localeCompare(nameB);
			if (sortOrder === 'easiest') return scoreA - scoreB || nameA.localeCompare(nameB);
			return nameA.localeCompare(nameB);
		});
		sorted.forEach(card => brandsGrid.appendChild(card));
	}

	// Category pills
	categoryPills.forEach(pill => {
		pill.addEventListener('click', () => {
			categoryPills.forEach(p => p.classList.remove('is-active'));
			pill.classList.add('is-active');
			activeCategory = pill.dataset.category || 'All';
			applyFilters();
		});
	});

	// Search
	searchInput?.addEventListener('input', () => {
		searchQuery = searchInput.value.toLowerCase().trim();
		applyFilters();
	});

	// Sort
	sortSelect?.addEventListener('change', () => {
		sortOrder = sortSelect.value;
		applySorting();
		applyFilters();
	});

	// Reset
	resetBtn?.addEventListener('click', () => {
		activeCategory = 'All';
		searchQuery = '';
		sortOrder = 'hardest';
		if (searchInput) searchInput.value = '';
		if (sortSelect) sortSelect.value = 'hardest';
		categoryPills.forEach(p => p.classList.remove('is-active'));
		categoryPills[0]?.classList.add('is-active');
		applySorting();
		applyFilters();
	});

	// ── Escape Hatch Toggle ──
	document.querySelectorAll<HTMLButtonElement>('.btn-escape-toggle').forEach(btn => {
		btn.addEventListener('click', () => {
			const card = btn.closest('.brand-card') as HTMLElement;
			const escapeBox = card?.querySelector('.brand-card__escape') as HTMLElement;
			if (!escapeBox) return;
			const isHidden = escapeBox.hidden;
			escapeBox.hidden = !isHidden;
			const label = btn.querySelector('span');
			if (label) label.textContent = isHidden ? 'Hide Escape Hatch' : 'See Escape Hatch';
		});
	});

	// ── Wall of Shame Escape Link Anchor & Open ──
	document.querySelectorAll<HTMLAnchorElement>('.btn-shame-escape').forEach(link => {
		link.addEventListener('click', (e) => {
			const slug = link.dataset.shameSlug;
			if (!slug) return;
			const targetCard = document.getElementById(`brand-${slug}`);
			if (targetCard) {
				e.preventDefault();
				targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
				const escapeBox = targetCard.querySelector('.brand-card__escape') as HTMLElement;
				const toggleBtn = targetCard.querySelector('.btn-escape-toggle') as HTMLElement;
				if (escapeBox && escapeBox.hidden) {
					escapeBox.hidden = false;
					const label = toggleBtn?.querySelector('span');
					if (label) label.textContent = 'Hide Escape Hatch';
				}
				targetCard.classList.add('is-highlighted');
				setTimeout(() => targetCard.classList.remove('is-highlighted'), 2000);
			}
		});
	});

	// ── Copy Cancellation Script ──
	document.querySelectorAll<HTMLButtonElement>('.btn-copy-script').forEach(btn => {
		btn.addEventListener('click', async (e) => {
			e.stopPropagation();
			const script = btn.dataset.script;
			if (!script) return;
			try {
				await navigator.clipboard.writeText(script);
				const span = btn.querySelector('span');
				const orig = span ? span.textContent : 'Copy Script';
				if (span) span.textContent = 'Copied!';
				showToast('Cancellation script copied to clipboard!');
				setTimeout(() => { if (span) span.textContent = orig; }, 2000);
			} catch {}
		});
	});

	// ── Compare Mode ──
	const compareToggle = document.getElementById('compare-toggle-btn') as HTMLButtonElement;
	const compareHint = document.getElementById('compare-hint') as HTMLElement;
	const comparePanel = document.getElementById('compare-panel') as HTMLElement;
	const compareBody = document.getElementById('compare-body') as HTMLElement;
	const compareFooter = document.getElementById('compare-footer') as HTMLElement;
	const closeCompare = document.getElementById('close-compare') as HTMLButtonElement;
	const shareCompareBtn = document.getElementById('share-compare-btn') as HTMLButtonElement;

	let compareMode = false;
	let compareSelection: HTMLElement[] = [];

	compareToggle?.addEventListener('click', () => {
		compareMode = !compareMode;
		compareToggle.classList.toggle('is-active', compareMode);
		if (compareHint) compareHint.hidden = !compareMode;
		if (!compareMode) {
			compareSelection = [];
			brandCards.forEach(c => c.classList.remove('is-compare-selected'));
			if (comparePanel) comparePanel.hidden = true;
		}
	});

	closeCompare?.addEventListener('click', () => {
		compareMode = false;
		compareSelection = [];
		brandCards.forEach(c => c.classList.remove('is-compare-selected'));
		if (comparePanel) comparePanel.hidden = true;
		if (compareHint) compareHint.hidden = true;
		compareToggle?.classList.remove('is-active');
	});

	// Click on card in compare mode
	brandCards.forEach(card => {
		card.addEventListener('click', (e) => {
			if (!compareMode) return;
			// Don't trigger on button/link clicks inside the card
			const target = e.target as HTMLElement;
			if (target.closest('button') || target.closest('a')) return;

			if (card.classList.contains('is-compare-selected')) {
				card.classList.remove('is-compare-selected');
				compareSelection = compareSelection.filter(c => c !== card);
			} else if (compareSelection.length < 2) {
				card.classList.add('is-compare-selected');
				compareSelection.push(card);
			}

			if (compareSelection.length === 2) {
				renderComparison();
			} else {
				if (comparePanel) comparePanel.hidden = true;
			}
		});
	});

	function renderComparison() {
		if (!compareBody || !comparePanel || !compareFooter) return;
		const [a, b] = compareSelection;
		const dataA = getCardData(a);
		const dataB = getCardData(b);

		compareBody.innerHTML = `
			<div class="compare-grid">
				<div class="compare-col">
					<h4>${esc(dataA.name)}</h4>
					<div class="compare-score compare-score--${dataA.tier}">${dataA.score}/10</div>
					<div class="compare-detail"><strong>Method:</strong> ${esc(dataA.method)}</div>
					<div class="compare-detail"><strong>Time:</strong> ${esc(dataA.time)}</div>
					<div class="compare-detail"><strong>Dark Patterns:</strong></div>
					<div class="compare-patterns">${dataA.patterns.map((p: string) => `<span class="dp-tag dp-tag--${dataA.tier}">${esc(p)}</span>`).join('')}</div>
				</div>
				<div class="compare-vs">VS</div>
				<div class="compare-col">
					<h4>${esc(dataB.name)}</h4>
					<div class="compare-score compare-score--${dataB.tier}">${dataB.score}/10</div>
					<div class="compare-detail"><strong>Method:</strong> ${esc(dataB.method)}</div>
					<div class="compare-detail"><strong>Time:</strong> ${esc(dataB.time)}</div>
					<div class="compare-detail"><strong>Dark Patterns:</strong></div>
					<div class="compare-patterns">${dataB.patterns.map((p: string) => `<span class="dp-tag dp-tag--${dataB.tier}">${esc(p)}</span>`).join('')}</div>
				</div>
			</div>
		`;
		comparePanel.hidden = false;
		compareFooter.hidden = false;
		comparePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
	}

	function getCardData(card: HTMLElement) {
		const score = parseFloat(card.dataset.score || '0');
		let tier = 'easy';
		if (score >= 9) tier = 'nightmare';
		else if (score >= 7) tier = 'hard';
		else if (score >= 4) tier = 'moderate';
		return {
			name: card.querySelector('.brand-card__name')?.textContent || '',
			score: card.dataset.score || '0',
			tier,
			method: card.dataset.method || '',
			time: card.dataset.time || '',
			patterns: JSON.parse(card.dataset.patterns || '[]'),
		};
	}

	shareCompareBtn?.addEventListener('click', async () => {
		if (compareSelection.length !== 2) return;
		const [a, b] = compareSelection;
		const dA = getCardData(a);
		const dB = getCardData(b);
		const text = `🔍 Cancel Difficulty Comparison:\n\n${dA.name}: ${dA.score}/10 — ${dA.method}\n${dB.name}: ${dB.score}/10 — ${dB.method}\n\nSee the full index: https://cancelkits.com/cancel-difficulty/`;
		try {
			await navigator.clipboard.writeText(text);
			showToast('Comparison copied to clipboard!');
		} catch {}
	});

	// ── Submit Dark Pattern Report ──
	const reportForm = document.getElementById('dark-pattern-form') as HTMLFormElement;
	const submitBtn = document.getElementById('submit-report-btn') as HTMLButtonElement;
	const submitSuccess = document.getElementById('submit-success') as HTMLElement;

	submitBtn?.addEventListener('click', () => {
		const company = (document.getElementById('report-company') as HTMLInputElement)?.value.trim();
		const score = (document.getElementById('report-score') as HTMLSelectElement)?.value;
		const pattern = (document.getElementById('report-pattern') as HTMLTextAreaElement)?.value.trim();

		if (!company) {
			alert('Please enter a company name.');
			return;
		}

		// Save to localStorage
		try {
			const existing = JSON.parse(localStorage.getItem('cancelkit_dark_pattern_reports') || '[]');
			existing.push({ company, score, pattern, timestamp: new Date().toISOString() });
			localStorage.setItem('cancelkit_dark_pattern_reports', JSON.stringify(existing));
		} catch {}

		if (reportForm) reportForm.hidden = true;
		if (submitSuccess) submitSuccess.hidden = false;
	});

	// ── Copy Citation ──
	const copyCitationBtn = document.getElementById('copy-citation-btn') as HTMLButtonElement;
	const citationLabel = document.getElementById('citation-label') as HTMLElement;
	copyCitationBtn?.addEventListener('click', async () => {
		const html = '<p>Source: <a href="https://cancelkits.com/cancel-difficulty/" target="_blank" rel="noopener">CancelKits Subscription Cancellation Difficulty Index (2026)</a></p>';
		try {
			await navigator.clipboard.writeText(html);
			if (citationLabel) citationLabel.textContent = 'Copied!';
			setTimeout(() => { if (citationLabel) citationLabel.textContent = 'Copy Attribution HTML'; }, 2000);
		} catch {}
	});

	// ── Toast Helper ──
	function showToast(message: string) {
		if (!toast) return;
		toast.textContent = message;
		toast.hidden = false;
		setTimeout(() => { toast.hidden = true; }, 2500);
	}

	function esc(str: string): string {
		const div = document.createElement('div');
		div.textContent = str;
		return div.innerHTML;
	}
});
</script>


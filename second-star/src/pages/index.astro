---
import Nav from '../components/Nav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<Nav />
	<main class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl items-center px-5 sm:px-8">
		<section class="max-w-3xl py-24 sm:py-32">
			<p class="mb-5 text-sm font-medium text-accent">SUBSCRIPTION CONTROL, SIMPLIFIED</p>
			<h1 class="font-display text-5xl font-semibold tracking-[-0.06em] text-white sm:text-7xl">Take back your subscriptions.</h1>
			<p class="mt-6 max-w-xl text-lg leading-8 text-muted">CancelKit makes it simple to find recurring charges and leave the services you no longer need.</p>
			<a class="mt-10 inline-flex rounded-input bg-accent px-5 py-3 text-sm font-semibold text-black transition-opacity hover:opacity-90" href="/start">Start free</a>
		</section>
	</main>
</BaseLayout>

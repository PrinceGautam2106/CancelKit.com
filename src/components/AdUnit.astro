---
const adsEnabled = false;
---
{adsEnabled && <aside class="ad-unit" aria-label="Advertisement"><p>Advertisement</p><div data-ad-slot="YOUR_ADSENSE_SLOT"></div></aside>}
<style>.ad-unit{border-top:1px solid var(--color-border);color:var(--color-muted);margin-top:2rem;padding-top:1rem}.ad-unit p{font-size:.7rem;letter-spacing:.08em;text-transform:uppercase}</style>

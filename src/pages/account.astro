		margin-top: 0.25rem;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.7rem 1.25rem;
		border-radius: var(--radius-card);
		background: var(--color-accent);
		color: #000;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.88rem;
		border: 0;
		cursor: pointer;
		transition: transform 0.15s, box-shadow 0.15s;
	}

	.btn-primary:hover:not(:disabled) {
		transform: translateY(-1px);
		box-shadow: 0 4px 14px rgba(0, 255, 136, 0.3);
	}

	.btn-primary:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	.btn-spinner {
		width: 14px;
		height: 14px;
		border: 2px solid rgba(0, 0, 0, 0.25);
		border-top-color: #000;
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	.status-box {
		padding: 0.75rem 1rem;
		border-radius: var(--radius-card);
		font-size: 0.85rem;
		line-height: 1.4;
	}

	.status-box--success {
		background: rgba(0, 255, 136, 0.1);
		border: 1px solid rgba(0, 255, 136, 0.3);
		color: #fff;
	}

	.status-box--info {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--color-border);
		color: #ddd;
	}

	.status-box--danger {
		background: rgba(255, 68, 68, 0.1);
		border: 1px solid rgba(255, 68, 68, 0.3);
		color: #fff;
	}

	/* Integrations */
	.integrations-list {
		display: grid;
		gap: 1rem;
	}

	.integration-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
		background: #050505;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
	}

	.integration-info {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.integration-icon {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		flex-shrink: 0;
	}

	.integration-title-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.integration-name {
		font-weight: 600;
		font-size: 0.95rem;
		color: #fff;
	}

	.integration-desc {
		margin: 0.2rem 0 0;
		color: var(--color-muted);
		font-size: 0.82rem;
	}

	.badge {
		display: inline-block;
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius-pill);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.badge--active {
		background: rgba(0, 255, 136, 0.15);
		color: var(--color-accent);
		border: 1px solid rgba(0, 255, 136, 0.3);
	}

	.badge--inactive {
		background: rgba(255, 255, 255, 0.06);
		color: var(--color-muted);
		border: 1px solid var(--color-border);
	}

	.badge--accent {
		background: var(--color-accent);
		color: #000;
	}

	.btn-outline-sm {
		padding: 0.45rem 0.9rem;
		background: transparent;
		border: 1px solid var(--color-border-hover);
		color: #fff;
		border-radius: var(--radius-card);
		font-size: 0.82rem;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.15s;
		white-space: nowrap;
	}

	.btn-outline-sm:hover {
		background: rgba(255, 255, 255, 0.08);
	}

	/* Subscription Plan */
	.plan-display {
		display: grid;
		gap: 1.5rem;
	}

	.plan-current-badge {
		padding: 1.25rem;
		background: #050505;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
	}

	.plan-label {
		display: block;

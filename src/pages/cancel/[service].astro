		border-bottom: 1px solid #1a1a1a;
	}

	.screen-number {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		color: #ff8c42;
		background: rgba(255, 140, 66, 0.12);
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
	}

	.screen-name {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: #fff;
	}

	.screen-card__body {
		padding: 1rem 1.15rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.tactic-label {
		display: block;
		font-size: 0.72rem;
		color: #ff6666;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
	}

	.counter-label {
		display: block;
		font-size: 0.72rem;
		color: var(--color-accent);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
	}

	.screen-tactic p, .screen-counter p {
		margin: 0;
		font-size: 0.825rem;
		line-height: 1.5;
		color: #bbb;
	}

	/* Steps Checklist */
	.guide__steps {
		margin-top: 3.5rem;
	}

	.guide__steps-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.guide__steps h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: #fff;
	}

	.guide__steps-sub {
		margin: 0.35rem 0 0;
		color: var(--color-muted);
		font-size: 0.88rem;
	}

	.guide__progress-badge {
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius-pill);
		background: rgba(0, 255, 136, 0.1);
		border: 1px solid rgba(0, 255, 136, 0.25);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.guide__checklist {
		display: grid;
		gap: 0.75rem;
	}

	.guide__check-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		align-items: center;
		padding: 1.15rem 1.25rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		cursor: pointer;
		user-select: none;
		transition: all 0.2s ease;
		scroll-margin-top: 5rem;
	}

	.guide__check-item:hover {
		border-color: rgba(0, 255, 136, 0.3);
		background: #0c0c0c;
	}

	.guide__check-item.is-checked {
		border-color: rgba(0, 255, 136, 0.25);
		background: rgba(0, 255, 136, 0.03);
	}

	.guide__check-item.is-checked .guide__check-text p {
		color: var(--color-muted);
		text-decoration: line-through;
	}

	.guide__checkbox {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.guide__check-indicator {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		border: 2px solid var(--color-border);
		background: #050505;
		color: var(--color-muted);
		font-weight: 700;
		font-size: 0.85rem;
		transition: all 0.2s;
	}

	.guide__check-svg {
		display: none;
	}

	.guide__check-item.is-checked .guide__check-indicator {
		background: var(--color-accent);
		border-color: var(--color-accent);
	}

	.guide__check-item.is-checked .guide__check-num {
		display: none;
	}

	.guide__check-item.is-checked .guide__check-svg {
		display: block;
	}

	.guide__check-text p {
		margin: 0;
		color: #e2e2e2;
		font-size: 0.98rem;
		line-height: 1.5;
	}

	/* Done Banner */
	.guide__done-banner {
		margin-top: 1rem;
		padding: 1.25rem 1.5rem;
		border-radius: var(--radius-card);
		background: rgba(0, 255, 136, 0.08);
		border: 1px solid rgba(0, 255, 136, 0.3);
		display: flex;
		align-items: center;
		gap: 1rem;
		animation: banner-pop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes banner-pop {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.guide__done-icon {
		font-size: 1.75rem;
	}

	.guide__done-text strong {
		color: var(--color-accent);
		font-size: 1rem;
	}

	.guide__done-text p {
		margin: 0.25rem 0 0;
		color: #ccc;
		font-size: 0.85rem;
	}

	/* ─── Community Cancel Difficulty Index ─── */
	.guide__community-index {
		margin-top: 2.75rem;
		padding: 1.6rem;
		border-radius: var(--radius-card);
		border: 1px solid rgba(0, 255, 136, 0.25);
		background: #0a0a0a;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
	}

	.community-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.community-badge {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		color: var(--color-accent);
		letter-spacing: 0.08em;
		background: rgba(0, 255, 136, 0.1);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
	}

	.community-updated {
		font-size: 0.72rem;
		color: #888;
	}

	.community-header h2 {
		margin: 0.35rem 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: #fff;
		letter-spacing: -0.02em;
	}

	.community-desc {
		margin: 0 0 1.25rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		line-height: 1.5;
	}

	.community-voting-row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.65rem;
		margin-bottom: 1rem;
	}

	.btn-vote-pill {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		padding: 0.75rem 0.5rem;
		border-radius: var(--radius-input);
		background: #111;
		border: 1px solid #222;
		color: #ccc;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.15s ease;
		text-align: center;
	}

	.btn-vote-pill:hover {
		border-color: #444;
		background: #181818;
		transform: translateY(-1px);
	}

	.btn-vote-pill.is-active {
		border-color: var(--color-accent);
		background: rgba(0, 255, 136, 0.12);
		color: #fff;
		font-weight: 600;
	}

	.pill-emoji {
		font-size: 1.25rem;
		line-height: 1;
	}

	.pill-label {
		font-size: 0.72rem;
		line-height: 1.3;
	}

	.community-voted-msg {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 0.85rem;
		border-radius: 6px;
		background: rgba(0, 255, 136, 0.1);
		border: 1px solid rgba(0, 255, 136, 0.3);
		color: #00ff88;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 1.25rem;
	}

	.voted-check {
		font-size: 0.9rem;
	}

	.community-report-form {
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid #1a1a1a;
	}

	.community-report-form label {
		display: block;
		font-size: 0.8rem;
		color: #bbb;
		margin-bottom: 0.5rem;
		font-weight: 500;
	}

	.report-input-row {
		display: flex;
		gap: 0.5rem;
	}

	.report-input-row input {
		flex: 1;
		padding: 0.65rem 0.85rem;
		background: #111;
		border: 1px solid #262626;
		border-radius: var(--radius-input);
		color: #fff;
		font-size: 0.825rem;
		font-family: inherit;
	}

	.report-input-row input:focus {
		outline: none;
		border-color: var(--color-accent);
	}

	.btn-submit-report {
		padding: 0.65rem 1rem;
		background: #222;
		border: 1px solid #333;
		border-radius: var(--radius-input);
		color: #fff;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		transition: background 0.15s;
	}

	.btn-submit-report:hover {
		background: #333;
		color: var(--color-accent);
	}

	.community-reports-feed {
		margin-top: 1rem;
		display: grid;
		gap: 0.65rem;
	}

	.community-report-card {
		padding: 0.75rem 0.95rem;
		border-radius: 8px;
		background: #111;
		border: 1px solid #1c1c1c;
	}

	.report-card-top {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.35rem;
		font-size: 0.72rem;
	}

	.report-user {
		font-weight: 600;
		color: #e5e5e5;
	}

	.report-badge {
		font-size: 0.65rem;
		font-weight: 700;
		background: rgba(0, 255, 136, 0.1);
		color: var(--color-accent);
		padding: 0.1rem 0.35rem;
		border-radius: 3px;
	}

	.report-time {
		margin-left: auto;
		color: #666;
	}

	.report-text {
		margin: 0;
		font-size: 0.8rem;
		color: #aaa;
		line-height: 1.45;
	}

	@media (max-width: 600px) {
		.community-voting-row {
			grid-template-columns: repeat(2, 1fr);
		}
		.report-input-row {
			flex-direction: column;
		}
		.btn-submit-report {
			width: 100%;
		}
	}

	/* Copy Script Section */
	.guide__script-section {
		margin-top: 3.5rem;
		padding: 2rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.guide__tool-cta-banner {
		background: linear-gradient(135deg, rgba(0, 255, 136, 0.12) 0%, rgba(13, 13, 13, 0.95) 100%);
		border: 1px solid rgba(0, 255, 136, 0.35);
		border-radius: var(--radius-card);
		padding: 1.25rem 1.5rem;
		margin-bottom: 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
	}

	@media (max-width: 48rem) {
		.guide__tool-cta-banner {
			flex-direction: column;
			align-items: stretch;
		}
	}

	.tool-cta-text strong {
		color: #fff;
		font-size: 0.95rem;
		display: block;
		margin-bottom: 0.25rem;
	}

	.tool-cta-text p {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.85rem;
		line-height: 1.45;
	}

	.tool-cta-btn {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
		padding: 0.65rem 1.15rem;
		background: var(--color-accent);
		color: #000;
		border-radius: var(--radius-pill);
		font-weight: 700;
		font-size: 0.85rem;
		text-decoration: none;
		transition: all 0.2s;
	}

	.tool-cta-btn:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(0, 255, 136, 0.3);
	}

	.guide__script-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.guide__script-title-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.guide__script-title-row h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 600;
		color: #fff;
	}

	.guide__script-copy-btn {
		appearance: none;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.95rem;
		border-radius: var(--radius-pill);
		background: rgba(0, 255, 136, 0.12);
		border: 1px solid rgba(0, 255, 136, 0.3);
		color: var(--color-accent);
		font: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
	}

	.guide__script-copy-btn:hover {
		background: rgba(0, 255, 136, 0.2);
	}

	.guide__script-desc {
		margin: 0.75rem 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.guide__script-box {
		padding: 1.25rem;
		border-radius: var(--radius-card);
		background: #050505;
		border: 1px solid var(--color-border);
		overflow-x: auto;
	}

	.guide__script-box pre {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: #bbb;
		line-height: 1.6;
		white-space: pre-wrap;
	}

	/* Proof Card */
	.guide__proof-card {
		margin-top: 3.5rem;
		padding: 2rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.guide__proof-card h3 {
		margin: 0 0 1.25rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		color: #fff;
	}

	.guide__proof-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 1rem;
	}

	.guide__proof-list li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem;
		align-items: start;
		color: #d0d0d0;
		font-size: 0.925rem;
		line-height: 1.5;
	}

	.guide__proof-bullet {
		display: grid;
		place-items: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 50%;
		background: rgba(0, 255, 136, 0.1);
		color: var(--color-accent);
		font-weight: 700;
		font-size: 0.75rem;
	}

	.guide__proof-list strong {
		color: #fff;
	}

	/* Automated CTA Box */
	.guide__cta {
		position: relative;
		margin-top: 4.5rem;
		padding: 3.5rem 2.5rem;
		border-radius: var(--radius-lg);
		border: 1px solid rgba(0, 255, 136, 0.3);
		background: var(--color-surface);
		overflow: hidden;
		text-align: center;
	}

	.guide__cta-glow {
		position: absolute;
		top: -60%;
		left: 50%;
		transform: translateX(-50%);
		width: 140%;
		height: 200%;
		background: radial-gradient(ellipse 40% 40% at 50% 50%, rgba(0, 255, 136, 0.08) 0%, transparent 65%);
		pointer-events: none;
	}

	.guide__cta-content {
		position: relative;
		z-index: 1;
		max-width: 40rem;
		margin: 0 auto;
	}

	.guide__cta-tag {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--color-accent);
		margin-bottom: 0.75rem;
	}

	.guide__cta h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.4rem);
		font-weight: 600;
		letter-spacing: -0.04em;
		color: #fff;
	}

	.guide__cta p {
		margin: 0.95rem 0 0;
		color: var(--color-muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.guide__cta-actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.guide__cta-button {
		display: inline-flex;
		align-items: center;
		padding: 0.9rem 2rem;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: #000;
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.2s, box-shadow 0.2s;
	}

	.guide__cta-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 25px rgba(0, 255, 136, 0.25);
	}

	.guide__cta-fine {
		color: var(--color-faint);
		font-size: 0.8rem;
	}

	/* FAQ */
	.guide__faq {
		margin-top: 4.5rem;
	}

	.guide__faq h2 {
		margin: 0 0 1.5rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: #fff;
	}

	.guide__faq-list {
		display: grid;
		gap: 0.75rem;
	}

	.guide__faq-item {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		padding: 1.15rem 1.25rem;
		transition: border-color 0.2s;
	}

	.guide__faq-item[open] {
		border-color: rgba(255, 255, 255, 0.15);
	}

	.guide__faq-item summary {
		cursor: pointer;
		font-weight: 600;
		color: #fff;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 1.02rem;
	}

	.guide__faq-item summary::-webkit-details-marker {
		display: none;
	}

	.guide__faq-chevron {
		color: var(--color-muted);
		transition: transform 0.2s;
		flex-shrink: 0;
	}

	.guide__faq-item[open] .guide__faq-chevron {
		transform: rotate(180deg);
	}

	.guide__faq-item p {
		margin: 0.85rem 0 0;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* Related Grid */
	.guide__related {
		margin-top: 4.5rem;
	}

	.guide__related h2 {
		margin: 0 0 1.5rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: #fff;
	}

	.guide__related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1rem;
	}

	.guide__related-card {
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		text-decoration: none;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: all 0.2s;
	}

	.guide__related-card:hover {
		border-color: rgba(0, 255, 136, 0.3);
		transform: translateY(-2px);
	}

	.guide__related-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.guide__related-name {
		color: #fff;
		font-weight: 600;
		font-size: 1rem;
	}

	.guide__related-diff {
		padding: 0.2rem 0.5rem;
		border-radius: var(--radius-sm);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.guide__related-bottom {
		margin-top: 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.825rem;
	}

	.guide__related-price {
		color: var(--color-muted);
	}

	.guide__related-link {
		color: var(--color-accent);
		font-weight: 600;
	}

	/* Blog Links */
	.guide__blog {
		margin-top: 4.5rem;
		padding-top: 3rem;
		border-top: 1px solid var(--color-border);
	}

	.guide__blog h2 {
		margin: 0 0 1.25rem;
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 600;
		color: #fff;
	}

	.guide__blog-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.65rem;
	}

	.guide__blog-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.95rem 1.25rem;
		border-radius: var(--radius-card);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: #e0e0e0;
		font-weight: 500;
		font-size: 0.925rem;
		text-decoration: none;
		transition: all 0.2s;

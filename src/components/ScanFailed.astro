---
/**
 * Shown when a Gmail/Outlook inbox scan fails.
 */
---

<div class="scan-failed" data-scan-failed hidden role="alert">
	<div class="scan-failed__icon" aria-hidden="true">
		<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
			<circle cx="12" cy="12" r="9"/>
			<path d="M12 8v5" stroke-linecap="round"/>
			<circle cx="12" cy="16.5" r="0.8" fill="currentColor" stroke="none"/>
		</svg>
	</div>
	<h2 class="scan-failed__title">We had trouble scanning your inbox.</h2>
	<p class="scan-failed__copy">
		This sometimes happens with older Gmail accounts.
		You can try again, or skip ahead and add subscriptions manually.
	</p>
	<div class="scan-failed__actions">
		<button type="button" class="scan-failed__btn scan-failed__btn--primary" data-retry-scan>
			Try again
		</button>
		<button type="button" class="scan-failed__btn scan-failed__btn--ghost" data-add-manual>
			Add manually
		</button>
	</div>
</div>

<style>
	.scan-failed {
		padding: 2.75rem 1.5rem;
		text-align: center;
		border: 1px solid rgba(255, 68, 68, 0.28);
		border-radius: var(--radius-lg);
		background: linear-gradient(180deg, rgba(255, 68, 68, 0.06), var(--color-surface));
	}

	.scan-failed[hidden] {
		display: none !important;
	}

	.scan-failed__icon {
		width: 3.25rem;
		height: 3.25rem;
		margin: 0 auto 1.15rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: rgba(255, 68, 68, 0.1);
		border: 1px solid rgba(255, 68, 68, 0.28);
		color: #ff8888;
	}

	.scan-failed__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: #fff;
	}

	.scan-failed__copy {
		margin: 0.65rem auto 0;
		max-width: 28rem;
		color: var(--color-muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}

	.scan-failed__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.5rem;
	}

	.scan-failed__btn {
		appearance: none;
		border: 0;
		cursor: pointer;
		font-family: inherit;
		font-weight: 650;
		font-size: 0.9rem;
		padding: 0.75rem 1.2rem;
		border-radius: var(--radius-pill);
		transition: transform 0.15s, background 0.15s, border-color 0.15s;
	}

	.scan-failed__btn--primary {
		background: var(--color-accent);
		color: #000;
	}

	.scan-failed__btn--primary:hover {
		transform: translateY(-1px);
	}

	.scan-failed__btn--ghost {
		background: transparent;
		color: #ddd;
		border: 1px solid var(--color-border);
	}

	.scan-failed__btn--ghost:hover {
		border-color: var(--color-border-hover);
		background: #111;
	}
</style>

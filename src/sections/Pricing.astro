---
import type { Translation } from '../i18n/translations';
interface Props { t: Translation; }
const { t } = Astro.props;
---
<section id="pricing" class="pricing" aria-labelledby="pricing-title">
	<div class="pricing__inner">
		<header><p>PRICING</p><h2 id="pricing-title">{t.pricing_title}</h2><span>One plan. No surprise fees. Cancel anytime.</span></header>
		<article class="pricing__card"><div class="pricing__top"><div><p class="pricing__plan">CANCELKIT</p><h3>Everything you need to stop the leak.</h3></div><span class="pricing__badge">14 DAYS FREE</span></div><div class="pricing__price"><strong>$9</strong><span>USD<br />{t.price_label}</span></div><ul><li><i>✓</i> Find recurring charges automatically</li><li><i>✓</i> One-click cancellation support</li><li><i>✓</i> Renewal alerts before you are charged</li><li><i>✓</i> Privacy-first, read-only scanning</li></ul><a href="/start">{t.nav_start} <span aria-hidden="true">→</span></a><small class="pricing__fine">No credit card required for your trial.</small></article>
	</div>
</section>
<style>
.pricing{background:#000;color:#fff;padding:8rem 1.25rem}.pricing__inner{margin:auto;max-width:66rem}.pricing header{text-align:center}.pricing header>p,.pricing__plan{color:var(--color-accent);font-size:.7rem;font-weight:600;letter-spacing:.12em;margin:0}.pricing h2{font-family:var(--font-display);font-size:clamp(2.25rem,5vw,4rem);letter-spacing:-.065em;margin:.8rem 0}.pricing header span{color:var(--color-muted);font-size:1rem}.pricing__card{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-card);margin:3rem auto 0;max-width:34rem;padding:1.5rem}.pricing__top{align-items:flex-start;border-bottom:1px solid var(--color-border);display:flex;gap:1rem;justify-content:space-between;padding-bottom:1.5rem}.pricing h3{font-family:var(--font-display);font-size:1.35rem;letter-spacing:-.04em;margin:.5rem 0 0}.pricing__badge{border:1px solid color-mix(in srgb,var(--color-accent) 40%,transparent);border-radius:999px;color:var(--color-accent);font-size:.65rem;font-weight:600;padding:.4rem .55rem;white-space:nowrap}.pricing__price{align-items:end;display:flex;gap:.75rem;margin:1.75rem 0}.pricing__price strong{font-family:var(--font-display);font-size:4.5rem;letter-spacing:-.08em;line-height:.8}.pricing__price span{color:var(--color-muted);font-size:.8rem;line-height:1.35}.pricing ul{border-top:1px solid var(--color-border);display:grid;gap:.85rem;list-style:none;margin:0;padding:1.5rem 0}.pricing li{color:#d0d0d0;font-size:.9rem}.pricing i{color:var(--color-accent);font-style:normal;font-weight:700;margin-right:.55rem}.pricing a{background:var(--color-accent);border-radius:var(--radius-card);color:#000;display:flex;font-weight:600;justify-content:space-between;padding:1rem;text-decoration:none;transition:transform .2s ease}.pricing a:hover{transform:translateY(-1px)}.pricing__fine{color:var(--color-muted);display:block;font-size:.72rem;margin-top:.85rem;text-align:center}@media(max-width:30rem){.pricing__top{display:grid}.pricing__badge{justify-self:start}}</style>

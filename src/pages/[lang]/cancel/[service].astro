---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import { locales, type Locale } from '../../../i18n/translations';

const titles = {
	es: 'Cómo cancelar Netflix',
	fr: 'Comment annuler Netflix',
	de: 'Netflix kündigen: Anleitung',
	pt: 'Como cancelar a Netflix',
	ja: 'Netflixの解約方法',
	ko: '넷플릭스 해지 방법',
	it: 'Come disdire Netflix',
} as const;

/** Localized stubs — noindex until full parity with /cancel/netflix */
export function getStaticPaths() {
	return locales
		.filter((lang) => lang !== 'en')
		.map((lang) => ({ params: { lang, service: 'netflix' } }));
}

const descriptions = {
	es: 'Cómo cancelar Netflix paso a paso en 2026. Guía completa con CancelKits.',
	fr: 'Comment annuler Netflix étape par étape en 2026. Guide complet avec CancelKits.',
	de: 'Netflix kündigen: Schritt-für-Schritt-Anleitung 2026 mit CancelKits.',
	pt: 'Como cancelar a Netflix passo a passo em 2026. Guia completo com CancelKits.',
	ja: '2026年版 Netflix（ネットフリックス）の解約手順。CancelKitsで簡単手続き。',
	ko: '2026년 넷플릭스 멤버십 해지 단계별 안내. CancelKits와 함께 빠르고 간편하게.',
	it: 'Come disdire o cancellare l’abbonamento Netflix passo dopo passo nel 2026 con CancelKits.',
} as const;

const cancelKeywords = {
	es: 'cancelar netflix, cómo cancelar netflix, dar de baja netflix, anular suscripción netflix',
	fr: 'résilier netflix, comment annuler netflix, supprimer abonnement netflix, désabonnement netflix',
	de: 'netflix kündigen, netflix abo kündigen, netflix mitgliedschaft beenden, wie kündige ich netflix',
	pt: 'cancelar netflix, como cancelar a netflix, cancelar assinatura netflix, encerrar conta netflix',
	ja: 'netflix 解約, ネットフリックス 解約方法, netflix 退会, netflix サブスク 解約',
	ko: '넷플릭스 해지, 넷플릭스 구독 취소, 넷플릭스 멤버십 해지, 넷플릭스 자동결제 해제',
	it: 'disdire netflix, come cancellare netflix, annullare abbonamento netflix, disattivare netflix',
} as const;

const lang = Astro.params.lang as Locale;
const title = titles[lang as keyof typeof titles];
const description = descriptions[lang as keyof typeof descriptions];
const keywords = cancelKeywords[lang as keyof typeof cancelKeywords];
const guide = {
	es: [
		'Inicia sesión en tu cuenta de Netflix.',
		'Abre la configuración de tu cuenta.',
		'Selecciona cancelar membresía y confirma.',
	],
	fr: [
		'Connectez-vous à votre compte Netflix.',
		'Ouvrez les paramètres de votre compte.',
		'Sélectionnez Résilier l’abonnement et confirmez.',
	],
	de: [
		'Melde dich bei deinem Netflix-Konto an.',
		'Öffne deine Kontoeinstellungen.',
		'Wähle Mitgliedschaft kündigen und bestätige.',
	],
	pt: [
		'Entre na sua conta Netflix.',
		'Abra as configurações da sua conta.',
		'Selecione cancelar assinatura e confirme.',
	],
	ja: [
		'Netflixのアカウントにログインします。',
		'アカウント設定を開きます。',
		'「メンバーシップのキャンセル」を選択し、確認します。',
	],
	ko: [
		'넷플릭스 계정에 로그인합니다.',
		'계정 설정 페이지로 이동합니다.',
		'멤버십 해지를 선택하고 확인을 누릅니다.',
	],
	it: [
		'Accedi al tuo account Netflix.',
		'Apri le impostazioni dell’account.',
		'Seleziona "Disdici abbonamento" e conferma.',
	],
}[lang as keyof typeof titles];
---

<BaseLayout
	lang={lang}
	title={`${title} | CancelKits`}
	description={description}
	keywords={keywords}
	canonicalPath={`/${lang}/cancel/netflix/`}
	noIndex
>
	<Nav />
	<main class="guide">
		<h1>{title}</h1>
		<p>
			CancelKits makes subscription cancellation simple.
			<a href="/cancel/netflix">See the full English guide</a> for the complete 2026 playbook.
		</p>
		<ol>
			{guide.map((step) => <li>{step}</li>)}
		</ol>
	</main>
</BaseLayout>

<style>
	.guide {
		background: #000;
		color: #fff;
		min-height: 80vh;
		padding: 10rem max(1.25rem, calc((100% - 44rem) / 2));
	}
	.guide h1 {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 5vw, 4rem);
		letter-spacing: -0.06em;
	}
	.guide p,
	.guide li {
		color: var(--color-muted);
		line-height: 1.7;
	}
	.guide a {
		color: #00ff88;
	}
	.guide ol {
		padding-left: 1.25rem;
	}
</style>

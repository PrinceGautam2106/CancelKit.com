---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import { locales, type Locale } from '../../../i18n/translations';

const titles = {
	es: 'Cómo cancelar Netflix',
	fr: 'Comment annuler Netflix',
	de: 'Netflix kündigen: Anleitung',
	pt: 'Como cancelar a Netflix',
} as const;

/** Localized stubs — noindex until full parity with /cancel/netflix */
export function getStaticPaths() {
	return locales
		.filter((lang) => lang !== 'en')
		.map((lang) => ({ params: { lang, service: 'netflix' } }));
}

const lang = Astro.params.lang as Locale;
const title = titles[lang as keyof typeof titles];
const guide = {
	es: [
		'Inicia sesión en tu cuenta de Netflix.',
		'Abre la configuración de tu cuenta.',
		'Selecciona cancelar membresía y confirma.',
	],
	fr: [
		'Connectez-vous à votre compte Netflix.',
		'Ouvrez les paramètres de votre compte.',
		'Sélectionnez Résilier l’abonnement et confirmez.',
	],
	de: [
		'Melde dich bei deinem Netflix-Konto an.',
		'Öffne deine Kontoeinstellungen.',
		'Wähle Mitgliedschaft kündigen und bestätige.',
	],
	pt: [
		'Entre na sua conta Netflix.',
		'Abra as configurações da sua conta.',
		'Selecione cancelar assinatura e confirme.',
	],
}[lang as keyof typeof titles];
---

<BaseLayout
	lang={lang}
	title={`${title} | CancelKits`}
	description={`${title}. Guía paso a paso con CancelKits.`}
	canonicalPath={`/${lang}/cancel/netflix/`}
	noIndex
>
	<Nav />
	<main class="guide">
		<h1>{title}</h1>
		<p>
			CancelKits makes subscription cancellation simple.
			<a href="/cancel/netflix">See the full English guide</a> for the complete 2026 playbook.
		</p>
		<ol>
			{guide.map((step) => <li>{step}</li>)}
		</ol>
	</main>
</BaseLayout>

<style>
	.guide {
		background: #000;
		color: #fff;
		min-height: 80vh;
		padding: 10rem max(1.25rem, calc((100% - 44rem) / 2));
	}
	.guide h1 {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 5vw, 4rem);
		letter-spacing: -0.06em;
	}
	.guide p,
	.guide li {
		color: var(--color-muted);
		line-height: 1.7;
	}
	.guide a {
		color: #00ff88;
	}
	.guide ol {
		padding-left: 1.25rem;
	}
</style>
